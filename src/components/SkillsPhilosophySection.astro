---
import type { Lang } from '../i18n/ui';
import { skillsData } from '../data/skills';
import { principlesData } from '../data/principles';
import { BELTS } from '../data/martialExperience';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = skillsData[lang];
const philosophy = [...data.philosophy].reverse();
const principles = principlesData[lang];
const sealColor = BELTS.rojo.color;
---

<section id="stack-filosofia" class="skills-section">
  <div class="container">
    <section class="human-section" aria-labelledby="human-title">
      <header class="human-header">
        <p class="eyebrow">{lang === 'es' ? 'FUERA DEL CÓDIGO' : lang === 'en' ? 'BEYOND THE CODE' : 'ALÉM DO CÓDIGO'}</p>
        <h2 id="human-title" class="human-title">
          {lang === 'es' ? 'La Dimensión Humana & Ética Operativa' : lang === 'en' ? 'The Human Dimension & Operational Ethics' : 'A Dimensão Humana & Ética Operacional'}
        </h2>
      </header>

      <div class="principles" style={`--seal-color: ${sealColor};`}>
        <p class="principles-label">{principles.label}</p>
        <ul class="principles-row">
          {principles.items.map((item) => (
            <li class="seal-item" style={`--chars: ${Math.max(2, [...item.hangul].length)};`}>
              <div class="seal-mark" lang="ko" aria-hidden="true">
                <span class="seal-hangul">{item.hangul}</span>
              </div>
              <p class="seal-name">{item.name}</p>
              <p class="seal-line">{item.line}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="human-rows">
        {philosophy.map((item) => (
          <article class="human-row">
            <div class="human-copy">
              <p class="human-meta">{item.subtitle}</p>
              <h3 class="human-row-title">{item.title}</h3>
              <p class="human-description">{item.description}</p>
            </div>
            <blockquote class="human-quote">“{item.quote}”</blockquote>
          </article>
        ))}
      </div>
    </section>

    <section class="stack-section" aria-labelledby="stack-title">
      <header class="stack-header">
        <p class="eyebrow">{lang === 'es' ? 'CRITERIO & HERRAMIENTAS' : lang === 'en' ? 'MINDSET & TOOLING' : 'CRITÉRIO & FERRAMENTAS'}</p>
        <h2 id="stack-title" class="stack-title">
          {lang === 'es' ? 'Stack Tecnológico & Filosofía de Trabajo' : lang === 'en' ? 'Tech Stack & Engineering Mindset' : 'Stack Tecnológico & Filosofia de Trabalho'}
        </h2>
        <p class="stack-subtitle">
          {lang === 'es'
            ? 'El software como medio para resolver fricciones de negocio, con código tipado, arquitectura limpia y criterio humano en el loop.'
            : lang === 'en'
            ? 'Software as a business-enabler: strictly typed code, clean architecture, and critical human-in-the-loop oversight.'
            : 'Software como habilitador de negócios: código tipado, arquitetura limpa e critério humano no loop.'}
        </p>
      </header>

      <div class="skills-grid">
        {data.categories.map((category) => (
          <article class="skill-column">
            <p class="skill-eyebrow">{category.badge}</p>
            <h3 class="skill-title">{category.title}</h3>
            <ul class="skill-items">
              {category.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>
  </div>
</section>

<style>
  .skills-section {
    padding: clamp(5rem, 9vw, 9rem) 0;
    background: var(--bg-primary);
  }

  .human-header { max-width: 58rem; margin-bottom: clamp(2.5rem, 5vw, 5rem); }
  .eyebrow, .human-meta, .skill-eyebrow, .skill-items {
    font-family: var(--font-mono, monospace);
  }
  .eyebrow {
    margin-bottom: 1.1rem;
    color: var(--text-muted);
    font-size: 0.72rem;
    letter-spacing: 0.11em;
    line-height: 1.5;
  }
  .human-title, .stack-title {
    max-width: 18ch;
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(2.7rem, 6vw, 5.8rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 0.99;
    text-wrap: balance;
  }
  .principles { margin-bottom: clamp(2.5rem, 5vw, 5rem); }
  .principles-label {
    margin-bottom: 1.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    letter-spacing: 0.11em;
    color: var(--text-muted);
  }
  .principles-row {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .seal-item {
    container-type: inline-size;
    min-width: 0;
  }
  .seal-mark {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border: 2px solid var(--seal-color);
    color: var(--seal-color);
  }
  .seal-hangul {
    font-family: 'Noto Sans KR', 'Malgun Gothic', 'Apple SD Gothic Neo', sans-serif;
    font-weight: 700;
    font-size: calc(72cqi / var(--chars));
    line-height: 1;
    white-space: nowrap;
  }
  .seal-name {
    margin-top: 1rem;
    font-family: var(--font-sans, sans-serif);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .seal-line {
    margin-top: 0.4rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .human-rows { border-top: 1px solid var(--border-strong); }
  .human-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.8fr);
    gap: clamp(2rem, 8vw, 9rem);
    align-items: center;
    padding: clamp(2rem, 4vw, 4rem) 0;
    border-bottom: 1px solid var(--border-strong);
  }
  .human-meta {
    margin-bottom: 0.9rem;
    color: var(--text-muted);
    font-size: 0.74rem;
    line-height: 1.6;
  }
  .human-row-title, .skill-title {
    font-family: var(--font-sans, sans-serif);
    font-size: clamp(1.3rem, 2vw, 1.8rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
    text-wrap: balance;
  }
  .human-description {
    max-width: 62ch;
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.7;
  }
  .human-quote {
    max-width: 19ch;
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(1.8rem, 3.2vw, 3rem);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .stack-section { margin-top: clamp(7rem, 14vw, 14rem); }
  .stack-header { max-width: 58rem; margin-bottom: clamp(3rem, 6vw, 6rem); }
  .stack-title { max-width: 22ch; }
  .stack-subtitle {
    max-width: 68ch;
    margin-top: 1.5rem;
    color: var(--text-muted);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.7;
  }
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
  }
  .skill-column {
    min-width: 0;
    padding-top: 1.3rem;
    border-top: 1px solid var(--border-strong);
  }
  .skill-eyebrow {
    min-height: 2.5em;
    margin-bottom: 1rem;
    color: var(--text-muted);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }
  .skill-title { min-height: 4.6em; font-size: clamp(1rem, 1.35vw, 1.25rem); }
  .skill-items {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: 1.25rem;
    color: var(--text-muted);
    font-size: 0.73rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  @media (max-width: 1000px) {
    .skills-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 2.5rem; }
    .skill-title { min-height: 0; }
  }
  @media (max-width: 900px) {
    .principles-row {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 0.5rem;
    }
    .seal-item {
      flex: 0 0 min(62vw, 14rem);
      scroll-snap-align: start;
    }
  }
  @media (max-width: 680px) {
    .human-row { grid-template-columns: 1fr; gap: 1.5rem; }
    .human-quote { max-width: 24ch; padding-left: 1rem; }
    .skills-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1.25rem; }
  }
  @media (max-width: 420px) {
    .skills-grid { grid-template-columns: 1fr; }
    .skill-eyebrow { min-height: 0; }
  }
</style>
