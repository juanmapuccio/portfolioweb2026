---
import type { Lang } from '../i18n/ui';
import { skillsData } from '../data/skills';
import { principlesData } from '../data/principles';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = skillsData[lang];
const philosophy = data.philosophy;
const principles = principlesData[lang];

const GLYPHS: Record<string, string> = {
  frontend: '</>',
  backend: '{ }',
  devops: '$_',
  business: '⌂',
  certifications: 'B2',
};
---<section
  id="stack-filosofia"
  data-fx="c"
  data-zone="dark"
  data-ch="6"
  class="skills-philo-section"
>
  <!-- ── Part 1: Sticky title (left) + Horizontal stack cards (right) ── -->
  <div class="skills-philo-split-layout">
    <!-- Sticky Left Column -->
    <div class="skills-sticky-column">
      <div class="skills-sticky-content">
        <span class="mono-badge">
          {lang === 'es' ? 'CRITERIO & HERRAMIENTAS' : lang === 'en' ? 'MINDSET & TOOLING' : 'CRITÉRIO & FERRAMENTAS'}
        </span>
        <h2 class="skills-headline">
          {lang === 'es' ? 'Stack Tecnológico & Filosofía de Trabajo' : lang === 'en' ? 'Tech Stack & Engineering Mindset' : 'Stack Tecnológico & Filosofia de Trabalho'}
        </h2>
        <p class="skills-lead-text">
          {lang === 'es'
            ? 'El software como medio para resolver fricciones de negocio, con código tipado, arquitectura limpia y criterio humano en el loop.'
            : lang === 'en'
            ? 'Software as a means to solve business friction, with typed code, clean architecture, and human judgment in the loop.'
            : 'O software como meio para resolver fricções de negócio, com código tipado, arquitetura limpa e critério humano no loop.'}
        </p>
      </div>
    </div>

    <!-- Right Column: vertical cards scrolling while left stays sticky -->
    <div class="skills-scrolling-column">
      <div class="skills-categories-header">
        <span class="mono-badge">
          {lang === 'es' ? 'STACK TÉCNICO · SCROLL HACIA ABAJO ↓' : lang === 'en' ? 'TECH STACK · SCROLL DOWN ↓' : 'STACK TÉCNICO · SCROLL PARA BAIXO ↓'}
        </span>
      </div>
      <div class="skills-categories-list">
        {data.categories.map((cat) => {
          const glyph = GLYPHS[cat.id] || '</>';
          return (
            <article class="skill-category-card">
              <div class="skill-card-top">
                <span class="skill-glyph-badge">{glyph}</span>
                <span class="mono-badge">{cat.badge}</span>
              </div>
              <div class="skill-category-body">
                <h3 class="skill-category-title">{cat.title}</h3>
                <p class="skill-category-desc">{cat.description}</p>
                <div class="skill-items-mono">
                  {cat.items.join(' · ')}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </div>

  <!-- ── Part 2: Fuera del Código — Cinematic Two-Act Experience ── -->
  <div class="human-dimension-section">
    <div class="human-dimension-inner">
      <header class="human-dimension-header">
        <span class="mono-badge">
          {lang === 'es' ? 'FUERA DEL CÓDIGO' : lang === 'en' ? 'BEYOND THE CODE' : 'ALÉM DO CÓDIGO'}
        </span>
        <h3 class="human-title">
          {lang === 'es' ? 'La Dimensión Humana & Ética Operativa' : lang === 'en' ? 'The Human Dimension & Operational Ethics' : 'A Dimensão Humana & Ética Operacional'}
        </h3>
        <p class="human-lead">
          {lang === 'es'
            ? 'La excelencia técnica no nace únicamente del dominio de sintaxis o librerías, sino del criterio para decidir cuándo automatizar, cómo proteger al usuario y con qué templanza responder ante una crisis en producción.'
            : lang === 'en'
            ? 'Technical excellence does not stem solely from mastering syntax or libraries, but from the judgment to know when to automate, how to protect the user, and with what composure to respond during a production crisis.'
            : 'A excelência técnica não nasce apenas do domínio de sintaxes ou bibliotecas, mas do critério para decidir quando automatizar, como proteger o usuário e com que compostura responder em uma crise em produção.'}
        </p>
      </header>

      <!-- Act I: Philosophy Pillars (Editorial Manifestos) -->
      <div class="philosophy-manifestos-grid">
        {philosophy.map((ph, idx) => (
          <article class="philosophy-manifesto-card">
            <div class="manifesto-card-header">
              <span class="manifesto-idx">0{idx + 1}</span>
              <div class="manifesto-titles">
                <h4 class="philosophy-card-title">{ph.title}</h4>
                <span class="philosophy-card-sub">{ph.subtitle}</span>
              </div>
            </div>
            <p class="philosophy-card-desc">{ph.description}</p>
            <blockquote class="philosophy-quote">
              "{ph.quote}"
            </blockquote>
          </article>
        ))}
      </div>

      <!-- Act II: Martial Tenets Banner (TKD Principles) -->
      <div class="tkd-principles-block">
        <div class="principles-header">
          <span class="mono-badge">{principles.label}</span>
          <span class="principles-subnote">
            {lang === 'es' ? 'Disciplina aplicada a la arquitectura de software' : lang === 'en' ? 'Discipline applied to software engineering' : 'Disciplina aplicada à arquitetura de software'}
          </span>
        </div>
        <div class="principles-grid">
          {principles.items.map((pr) => {
            const fontSize = pr.hangul.length > 2 ? '13px' : '18px';
            return (
              <div class="principle-card">
                <div class="principle-seal-box" style={`font-size: ${fontSize};`}>
                  {pr.hangul}
                </div>
                <div class="principle-content">
                  <span class="principle-name">{pr.name}</span>
                  <span class="principle-line">{pr.line}</span>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { registerFx, registerZone } from '../scripts/journey';

  // Scroll-engine consolidation (T3): this section owns the dark belt zone
  // (data-ch="6"). dark-tail-polish D2: the SAME root node now also carries
  // data-fx="c" so journey writes its curtain --p (top top → bottom bottom)
  // and the section's content assembles with the scroll instead of sitting
  // static through the whole pinned window (the complaint behind the "dead
  // tail"). Both roles are registered from this component's own root id,
  // exactly like ContactSection does.
  const skillsRoot = document.querySelector<HTMLElement>('#stack-filosofia');
  if (skillsRoot) {
    registerFx(skillsRoot);
    registerZone(skillsRoot);
  }
</script>

<style>
  .skills-philo-section {
    background: #1c1a17;
    color: #f2eee6;
    border-top: 1px solid rgba(242, 238, 230, 0.18);
    /* NO overflow:hidden here — it would break position:sticky */
    box-sizing: border-box;
  }

  .skills-philo-split-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    /* No align-items override — default stretch fills both cells to row height.
       align-self:start on the sticky column lets sticky work against the section. */
    max-width: 1600px;
    margin: 0 auto;
  }

  @media (max-width: 991px) {
    .skills-philo-split-layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Left Sticky Column */
  .skills-sticky-column {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    /* align-self:start so this cell's height = 100vh (not stretched to match
       the row), keeping the sticky track alive while the section scrolls */
    align-self: start;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 clamp(24px, 5vw, 72px);
    box-sizing: border-box;
  }

  @media (max-width: 991px) {
    .skills-sticky-column {
      position: relative;
      height: auto;
      padding: 64px 20px 32px;
    }
  }

  @media (max-width: 767px) {
    .skills-sticky-column {
      padding: 56px 20px 24px;
    }

    .skills-headline {
      font-size: clamp(30px, 8vw, 42px);
    }

    .skills-lead-text {
      font-size: 14.5px;
    }

    .skills-scrolling-column {
      padding: 32px 16px 56px;
    }

    .skill-category-card {
      padding: 24px 18px;
      gap: 16px;
    }

    .skill-category-title {
      font-size: 20px;
    }

    .skill-category-desc {
      font-size: 13.5px;
    }

    .skill-items-mono {
      font-size: 11px;
    }

    .human-dimension-section {
      padding: 64px 16px 80px;
    }

    .human-title {
      font-size: clamp(28px, 7.5vw, 38px);
    }

    .human-lead {
      font-size: 14px;
    }

    .philosophy-manifesto-card {
      padding: 24px 18px;
      gap: 16px;
    }

    .philosophy-card-title {
      font-size: 20px;
    }

    .philosophy-card-desc {
      font-size: 14px;
    }

    .philosophy-quote {
      font-size: 16px;
    }

    .tkd-principles-block {
      padding: 24px 16px;
      gap: 20px;
    }
  }

  .skills-sticky-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 520px;
  }

  .mono-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c9c3b7;
  }

  .skills-headline {
    margin: 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 300;
    font-size: clamp(36px, 4vw, 68px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: #f2eee6;
  }

  .skills-lead-text {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: #c9c3b7;
  }

  /* Right Scrolling Column */
  .skills-scrolling-column {
    display: flex;
    flex-direction: column;
    padding: clamp(48px, 6vh, 80px) clamp(24px, 4vw, 64px);
    border-left: 1px solid rgba(242, 238, 230, 0.18);
    box-sizing: border-box;
    min-width: 0;
  }

  @media (max-width: 991px) {
    .skills-scrolling-column {
      border-left: none;
      border-top: 1px solid rgba(242, 238, 230, 0.18);
      padding: 48px clamp(20px, 4vw, 64px) 80px;
    }
  }

  .skills-categories-header {
    margin-bottom: 32px;
  }

  /* Category List (Vertical Stack) */
  .skills-categories-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .skill-category-card {
    background: #23201c;
    border: 1px solid rgba(242, 238, 230, 0.14);
    border-radius: 4px;
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    box-sizing: border-box;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .skill-category-card:hover {
    transform: translateY(-2px);
    border-color: rgba(251, 191, 36, 0.4);
    background: #272420;
  }

  .skill-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  @media (max-width: 600px) {
    .skill-category-card {
      padding: 24px 20px;
    }
  }

  .skill-glyph-badge {
    font-family: var(--font-mono, monospace);
    font-size: 13px;
    font-weight: 600;
    color: #fbbf24;
    background: #1c1a17;
    border: 1px solid rgba(251, 191, 36, 0.35);
    padding: 4px 8px;
    border-radius: 2px;
  }

  .skill-category-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .skill-category-title {
    margin: 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 400;
    font-size: clamp(20px, 1.9vw, 28px);
    line-height: 1.15;
    color: #f2eee6;
  }

  .skill-category-desc {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: #c9c3b7;
  }

  .skill-items-mono {
    font-family: var(--font-mono, monospace);
    font-size: 11.5px;
    line-height: 1.7;
    color: #fbbf24;
    padding-top: 6px;
    border-top: 1px solid rgba(242, 238, 230, 0.08);
  }

  /* ── Part 2: Fuera del Código — Cinematic Two-Act Experience ── */
  .human-dimension-section {
    position: relative;
    border-top: 1px solid rgba(242, 238, 230, 0.14);
    background: radial-gradient(circle at 50% 0%, #25221d 0%, #171512 85%);
    padding: clamp(80px, 12vh, 160px) clamp(24px, 5vw, 72px);
    overflow: hidden;
  }

  .human-dimension-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(64px, 10vh, 110px);
  }

  /* Header */
  .human-dimension-header {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 820px;
  }

  .human-title {
    margin: 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 300;
    font-size: clamp(34px, 4.2vw, 64px);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: #f2eee6;
  }

  .human-lead {
    margin: 4px 0 0 0;
    font-size: clamp(15px, 1.2vw, 17.5px);
    line-height: 1.65;
    color: #a8a29e;
  }

  /* Act I: Philosophy Manifestos Grid */
  .philosophy-manifestos-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 56px);
  }

  @media (max-width: 880px) {
    .philosophy-manifestos-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  .philosophy-manifesto-card {
    background: rgba(35, 32, 28, 0.6);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(242, 238, 230, 0.1);
    border-radius: 4px;
    padding: clamp(32px, 4vw, 48px);
    display: flex;
    flex-direction: column;
    gap: 20px;
    box-sizing: border-box;
    transition: border-color 0.3s ease, transform 0.3s ease, background 0.3s ease;
  }

  .philosophy-manifesto-card:hover {
    border-color: rgba(251, 191, 36, 0.35);
    background: rgba(40, 36, 32, 0.85);
    transform: translateY(-3px);
  }

  .manifesto-card-header {
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }

  .manifesto-idx {
    font-family: var(--font-mono, monospace);
    font-size: 14px;
    font-weight: 700;
    color: #fbbf24;
    letter-spacing: 0.1em;
    padding-top: 4px;
  }

  .manifesto-titles {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .philosophy-card-title {
    margin: 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 400;
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.15;
    color: #f2eee6;
  }

  .philosophy-card-sub {
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    letter-spacing: 0.05em;
    color: #928d84;
    text-transform: uppercase;
  }

  .philosophy-card-desc {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.65;
    color: #c9c3b7;
  }

  .philosophy-quote {
    margin: 12px 0 0 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 300;
    font-style: italic;
    font-size: clamp(17px, 1.3vw, 20px);
    line-height: 1.45;
    color: #fbbf24;
    border-left: 2px solid #fbbf24;
    padding-left: 18px;
  }

  /* Act II: TKD Principles / Martial Tenets */
  .tkd-principles-block {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: clamp(32px, 4vw, 44px);
    background: #12110f;
    border: 1px solid rgba(242, 238, 230, 0.08);
    border-radius: 4px;
  }

  .principles-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 12px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(242, 238, 230, 0.08);
  }

  .principles-subnote {
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: #78716c;
    text-transform: uppercase;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(16px, 2.5vw, 28px);
  }

  @media (max-width: 1024px) {
    .principles-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .principles-grid {
      grid-template-columns: 1fr;
    }
  }

  .principle-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 20px 16px;
    background: rgba(255, 255, 255, 0.015);
    border: 1px solid rgba(242, 238, 230, 0.06);
    border-radius: 3px;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
  }

  .principle-card:hover {
    transform: translateY(-3px);
    border-color: rgba(239, 68, 68, 0.35);
    background: rgba(239, 68, 68, 0.03);
  }

  .principle-seal-box {
    width: 48px;
    height: 48px;
    border: 1.5px solid rgba(239, 68, 68, 0.65);
    background: rgba(239, 68, 68, 0.06);
    color: #ef4444;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    box-sizing: border-box;
    border-radius: 2px;
    letter-spacing: -0.05em;
    transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  .principle-card:hover .principle-seal-box {
    border-color: #ef4444;
    background: rgba(239, 68, 68, 0.14);
    box-shadow: 0 0 12px rgba(239, 68, 68, 0.25);
  }

  .principle-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .principle-name {
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #f2eee6;
  }

  .principle-line {
    font-size: 13px;
    line-height: 1.55;
    color: #928d84;
  }

  /* ── dark-tail-polish D2: journey reveals (data-fx="c" → --p) ──────────
     The registry scrubs --p across the curtain range (0 when the section top
     pins to the viewport, 1 when its bottom clears). The part-1 sticky
     column holds ~p 0→0.28 on desktop, the human-dimension block enters
     around p 0.55 and the TKD banner around p 0.83, so the beat map below
     assembles content just as each block arrives. Every threshold satisfies
     T + 1/K <= 1, so the reduced-motion freeze (--p: 1, journey.ts) renders
     every reveal fully visible; the @media pin below additionally guards the
     pre-freeze first paint.
     Mobile (≤991 unwinds the sticky into a single flow column): --p is
     normalized to THIS section's own scroll length, so the same thresholds
     keep the stagger order and pacing without a media-query retune.
     Categories and manifestos reveal through the independent translate/scale
     properties: they compose with each card's existing `:hover { transform:
     translateY(-Npx) }` lift instead of clobbering it. */
  .skill-category-card {
    opacity: clamp(0, calc((var(--p, 0) - 0.04) * 5), 1);
    translate: 0 calc((1 - clamp(0, calc((var(--p, 0) - 0.04) * 5), 1)) * 28px);
  }

  .skill-categories-list .skill-category-card:nth-child(2) {
    opacity: clamp(0, calc((var(--p, 0) - 0.10) * 5), 1);
    translate: 0 calc((1 - clamp(0, calc((var(--p, 0) - 0.10) * 5), 1)) * 28px);
  }

  .skill-categories-list .skill-category-card:nth-child(3) {
    opacity: clamp(0, calc((var(--p, 0) - 0.16) * 5), 1);
    translate: 0 calc((1 - clamp(0, calc((var(--p, 0) - 0.16) * 5), 1)) * 28px);
  }

  .skill-categories-list .skill-category-card:nth-child(4) {
    opacity: clamp(0, calc((var(--p, 0) - 0.22) * 5), 1);
    translate: 0 calc((1 - clamp(0, calc((var(--p, 0) - 0.22) * 5), 1)) * 28px);
  }

  .skill-categories-list .skill-category-card:nth-child(5) {
    opacity: clamp(0, calc((var(--p, 0) - 0.28) * 5), 1);
    translate: 0 calc((1 - clamp(0, calc((var(--p, 0) - 0.28) * 5), 1)) * 28px);
  }

  .human-dimension-header {
    opacity: clamp(0, calc((var(--p, 0) - 0.45) * 4), 1);
    transform: translateY(calc((1 - clamp(0, calc((var(--p, 0) - 0.45) * 4), 1)) * 22px));
  }

  .philosophy-manifesto-card {
    opacity: clamp(0, calc((var(--p, 0) - 0.5) * 4), 1);
    translate: 0 calc((1 - clamp(0, calc((var(--p, 0) - 0.5) * 4), 1)) * 26px);
    /* Settle, don't bounce: 0.97 → 1 scale with opacity. */
    scale: calc(0.97 + clamp(0, calc((var(--p, 0) - 0.5) * 4), 1) * 0.03);
  }

  .philosophy-manifestos-grid .philosophy-manifesto-card:nth-child(2) {
    opacity: clamp(0, calc((var(--p, 0) - 0.56) * 4), 1);
    translate: 0 calc((1 - clamp(0, calc((var(--p, 0) - 0.56) * 4), 1)) * 26px);
    scale: calc(0.97 + clamp(0, calc((var(--p, 0) - 0.56) * 4), 1) * 0.03);
  }

  .tkd-principles-block {
    opacity: clamp(0, calc((var(--p, 0) - 0.7) * 4), 1);
    transform: translateY(calc((1 - clamp(0, calc((var(--p, 0) - 0.7) * 4), 1)) * 26px));
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-category-card,
    .human-dimension-header,
    .philosophy-manifesto-card,
    .tkd-principles-block {
      opacity: 1 !important;
      transform: none !important;
      translate: none !important;
      scale: none !important;
    }
  }
</style>
