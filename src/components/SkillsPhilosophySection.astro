---
import type { Lang } from '../i18n/ui';
import { skillsData } from '../data/skills';
import { principlesData } from '../data/principles';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = skillsData[lang];
const philosophy = data.philosophy;
const principles = principlesData[lang];

const GLYPHS: Record<string, string> = {
  frontend: '</>',
  backend: '{ }',
  devops: '$_',
  business: '⌂',
  certifications: 'B2',
};
---

<section
  id="stack-filosofia"
  data-zone="dark"
  data-ch="6"
  class="skills-philo-section"
>
  <div class="skills-philo-split-layout">
    <!-- Sticky Left Column -->
    <div class="skills-sticky-column">
      <div class="skills-sticky-content">
        <span class="mono-badge">
          {lang === 'es' ? 'CRITERIO & HERRAMIENTAS' : lang === 'en' ? 'MINDSET & TOOLING' : 'CRITÉRIO & FERRAMENTAS'}
        </span>
        <h2 class="skills-headline">
          {lang === 'es' ? 'Stack Tecnológico & Filosofía de Trabajo' : lang === 'en' ? 'Tech Stack & Engineering Mindset' : 'Stack Tecnológico & Filosofia de Trabalho'}
        </h2>
        <p class="skills-lead-text">
          {lang === 'es'
            ? 'El software como medio para resolver fricciones de negocio, con código tipado, arquitectura limpia y criterio humano en el loop.'
            : lang === 'en'
            ? 'Software as a means to solve business friction, with typed code, clean architecture, and human judgment in the loop.'
            : 'O software como meio para resolver fricções de negócio, com código tipado, arquitetura limpa e critério humano no loop.'}
        </p>
      </div>
    </div>

    <!-- Scrolling Right Column -->
    <div class="skills-scrolling-column">
      <!-- 5 Technical Stack Categories -->
      <div class="skills-categories-header">
        <span class="mono-badge">
          {lang === 'es' ? 'STACK TÉCNICO · DESLIZAR HORIZONTALMENTE →' : lang === 'en' ? 'TECH STACK · SCROLL HORIZONTALLY →' : 'STACK TÉCNICO · DESLIZE HORIZONTALMENTE →'}
        </span>
      </div>
      <div class="skills-categories-list">
        {data.categories.map((cat) => {
          const glyph = GLYPHS[cat.id] || '</>';
          return (
            <article class="skill-category-card">
              <div class="skill-card-top">
                <span class="skill-glyph-badge">{glyph}</span>
                <span class="mono-badge">{cat.badge}</span>
              </div>
              <div class="skill-category-body">
                <h3 class="skill-category-title">{cat.title}</h3>
                <p class="skill-category-desc">{cat.description}</p>
                <div class="skill-items-mono">
                  {cat.items.join(' · ')}
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <!-- Section: Fuera del Código & Dimensión Humana -->
      <div class="human-dimension-wrapper">
        <div class="human-header">
          <span class="mono-badge">
            {lang === 'es' ? 'FUERA DEL CÓDIGO' : lang === 'en' ? 'BEYOND THE CODE' : 'ALÉM DO CÓDIGO'}
          </span>
          <h3 class="human-title">
            {lang === 'es' ? 'La Dimensión Humana & Ética Operativa' : lang === 'en' ? 'The Human Dimension & Operational Ethics' : 'A Dimensão Humana & Ética Operacional'}
          </h3>
        </div>

        <!-- Philosophy Articles -->
        <div class="philosophy-items-list">
          {philosophy.map((ph) => (
            <article class="philosophy-card">
              <h4 class="philosophy-card-title">{ph.title}</h4>
              <span class="philosophy-card-sub">{ph.subtitle}</span>
              <p class="philosophy-card-desc">{ph.description}</p>
              <blockquote class="philosophy-quote">
                “{ph.quote}”
              </blockquote>
            </article>
          ))}
        </div>

        <!-- 5 Korean Martial Tenets / Principles -->
        <div class="tkd-principles-block">
          <span class="mono-badge">{principles.label}</span>
          <div class="principles-grid">
            {principles.items.map((pr) => {
              const fontSize = pr.hangul.length > 2 ? '13px' : '19px';
              return (
                <div class="principle-card">
                  <div class="principle-seal-box" style={`font-size: ${fontSize};`}>
                    {pr.hangul}
                  </div>
                  <span class="principle-name">{pr.name}</span>
                  <span class="principle-line">{pr.line}</span>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .skills-philo-section {
    background: #1c1a17;
    color: #f2eee6;
    border-top: 1px solid rgba(242, 238, 230, 0.18);
    /* NO overflow:hidden here — it would break position:sticky */
    box-sizing: border-box;
  }

  .skills-philo-split-layout {
    display: grid;
    /* align-items: start is CRITICAL — without it both cells stretch to equal height
       and the sticky column has nothing to scroll against */
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    max-width: 1600px;
    margin: 0 auto;
  }

  @media (max-width: 991px) {
    .skills-philo-split-layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Left Sticky Column */
  .skills-sticky-column {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 clamp(24px, 5vw, 72px);
    box-sizing: border-box;
  }

  @media (max-width: 991px) {
    .skills-sticky-column {
      position: relative;
      height: auto;
      padding: 80px clamp(20px, 5vw, 72px) 40px;
    }
  }

  .skills-sticky-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 520px;
  }

  .mono-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c9c3b7;
  }

  .skills-headline {
    margin: 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 300;
    font-size: clamp(36px, 4vw, 68px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: #f2eee6;
  }

  .skills-lead-text {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: #c9c3b7;
  }

  /* Right Scrolling Column */
  .skills-scrolling-column {
    display: flex;
    flex-direction: column;
    padding: clamp(80px, 10vh, 120px) clamp(20px, 3.5vw, 56px) clamp(80px, 10vh, 120px);
    border-left: 1px solid rgba(242, 238, 230, 0.18);
    box-sizing: border-box;
    min-width: 0;
  }

  @media (max-width: 991px) {
    .skills-scrolling-column {
      border-left: none;
      border-top: 1px solid rgba(242, 238, 230, 0.18);
      padding: 48px clamp(20px, 4vw, 64px) 80px;
    }
  }

  /* Category List (Horizontal Scroll Track) */
  .skills-categories-header {
    margin-bottom: 16px;
  }

  .skills-categories-list {
    display: flex;
    flex-direction: row;
    gap: 20px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    padding-bottom: 24px;
    padding-top: 4px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: rgba(242, 238, 230, 0.28) rgba(255, 255, 255, 0.03);
  }

  .skills-categories-list::-webkit-scrollbar {
    height: 6px;
  }

  .skills-categories-list::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.03);
    border-radius: 3px;
  }

  .skills-categories-list::-webkit-scrollbar-thumb {
    background: rgba(242, 238, 230, 0.28);
    border-radius: 3px;
    transition: background 0.2s ease;
  }

  .skills-categories-list::-webkit-scrollbar-thumb:hover {
    background: #fbbf24;
  }

  .skill-category-card {
    flex: 0 0 clamp(300px, 34vw, 420px);
    scroll-snap-align: start;
    background: #23201c;
    border: 1px solid rgba(242, 238, 230, 0.14);
    border-radius: 4px;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-sizing: border-box;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .skill-category-card:hover {
    transform: translateY(-3px);
    border-color: rgba(251, 191, 36, 0.4);
    background: #272420;
  }

  .skill-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  @media (max-width: 600px) {
    .skill-category-card {
      flex: 0 0 clamp(270px, 80vw, 340px);
      padding: 22px 18px;
    }
  }

  .skill-glyph-badge {
    font-family: var(--font-mono, monospace);
    font-size: 13px;
    font-weight: 600;
    color: #fbbf24;
    background: #1c1a17;
    border: 1px solid rgba(251, 191, 36, 0.35);
    padding: 4px 8px;
    border-radius: 2px;
  }

  .skill-category-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .skill-category-title {
    margin: 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 400;
    font-size: clamp(20px, 1.9vw, 28px);
    line-height: 1.15;
    color: #f2eee6;
  }

  .skill-category-desc {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: #c9c3b7;
  }

  .skill-items-mono {
    font-family: var(--font-mono, monospace);
    font-size: 11.5px;
    line-height: 1.7;
    color: #fbbf24;
    padding-top: 6px;
    border-top: 1px solid rgba(242, 238, 230, 0.08);
  }

  /* Human Dimension */
  .human-dimension-wrapper {
    border-top: 1px solid rgba(242, 238, 230, 0.18);
    padding-top: 48px;
    display: flex;
    flex-direction: column;
    gap: 36px;
    margin-top: 24px;
  }

  .human-header {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .human-title {
    margin: 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 300;
    font-size: clamp(28px, 2.6vw, 42px);
    line-height: 1.05;
    color: #f2eee6;
  }

  .philosophy-items-list {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .philosophy-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .philosophy-card-title {
    margin: 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 400;
    font-size: 22px;
    line-height: 1.2;
    color: #f2eee6;
  }

  .philosophy-card-sub {
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    color: #c9c3b7;
  }

  .philosophy-card-desc {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: #c9c3b7;
  }

  .philosophy-quote {
    margin: 8px 0 0 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 300;
    font-style: italic;
    font-size: 19px;
    line-height: 1.35;
    color: #f2eee6;
    border-left: 2px solid #f2eee6;
    padding-left: 14px;
  }

  /* TKD Principles */
  .tkd-principles-block {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 12px;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 20px;
  }

  .principle-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .principle-seal-box {
    width: 60px;
    height: 60px;
    border: 2px solid #ef4444;
    color: #ef4444;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    box-sizing: border-box;
  }

  .principle-name {
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f2eee6;
  }

  .principle-line {
    font-size: 13px;
    line-height: 1.45;
    color: #c9c3b7;
  }
</style>
