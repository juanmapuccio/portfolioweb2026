---
import type { Lang } from '../i18n/ui';
import { skillsData } from '../data/skills';
import { Cpu, Terminal, Cloud, Layers, Compass, ShieldCheck, Sparkles, Check } from 'lucide-astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = skillsData[lang];

const iconMap: Record<string, any> = {
  frontend: Layers,
  backend: Terminal,
  devops: Cloud,
  business: Cpu,
};
---

<section id="stack-filosofia" class="skills-section">
  <div class="container">
    <div class="section-header">
      <div class="section-badge">
        <Compass size={14} />
        <span>{lang === 'es' ? 'CRITERIO & HERRAMIENTAS' : lang === 'en' ? 'MINDSET & TOOLING' : 'CRITÉRIO & FERRAMENTAS'}</span>
      </div>
      <h2 class="section-title">
        {lang === 'es' ? 'Stack Tecnológico & Filosofía de Trabajo' : lang === 'en' ? 'Tech Stack & Engineering Mindset' : 'Stack Tecnológico & Filosofia de Trabalho'}
      </h2>
      <p class="section-subtitle">
        {lang === 'es'
          ? 'El software como medio para resolver fricciones de negocio, con código tipado, arquitectura limpia y criterio humano en el loop.'
          : lang === 'en'
          ? 'Software as a business-enabler: strictly typed code, clean architecture, and critical human-in-the-loop oversight.'
          : 'Software como habilitador de negócios: código tipado, arquitetura limpa e critério humano no loop.'}
      </p>
    </div>

    <!-- Grid de Pilares de Habilidades y Tecnologías -->
    <div class="skills-grid">
      {data.categories.map((cat) => {
        const IconComponent = iconMap[cat.id] || Sparkles;
        return (
          <div class="skill-card">
            <div class="card-glow"></div>
            <div class="skill-card-header">
              <div class="skill-icon-wrapper">
                <IconComponent size={20} class="skill-icon" />
              </div>
              <span class="skill-badge">{cat.badge}</span>
            </div>

            <h3 class="skill-title">{cat.title}</h3>
            <p class="skill-desc">{cat.description}</p>

            <ul class="skill-items">
              {cat.items.map((item) => (
                <li class="skill-item">
                  <Check size={14} class="check-icon" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>

    <!-- Bloque de Filosofía & Dimensión Humana -->
    <div class="philosophy-wrapper">
      <div class="philosophy-header">
        <ShieldCheck size={18} class="shield-icon" />
        <h3 class="philosophy-section-title">
          {lang === 'es' ? 'La Dimensión Humana & Ética Operativa' : lang === 'en' ? 'The Human Dimension & Operational Ethics' : 'A Dimensão Humana & Ética Operacional'}
        </h3>
      </div>

      <div class="philosophy-grid">
        {data.philosophy.map((item) => (
          <div class="philosophy-card">
            <div class="philosophy-top">
              <h4 class="pillar-title">{item.title}</h4>
              <span class="pillar-subtitle">{item.subtitle}</span>
            </div>
            <p class="pillar-desc">{item.description}</p>
            <div class="pillar-quote">
              <p>“{item.quote}”</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .skills-section {
    padding: 5rem 0;
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-primary);
  }

  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent-cyan);
    background: color-mix(in srgb, var(--accent-cyan) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-cyan) 25%, transparent);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 1rem;
  }

  .section-title {
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-main);
    margin-bottom: 0.75rem;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Grid de Habilidades */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .skill-card {
    position: relative;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);
  }

  .skill-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent-cyan) 40%, var(--border-subtle));
    box-shadow: 0 12px 28px -8px rgba(0, 0, 0, 0.12);
  }

  .card-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--accent-cyan), transparent);
    opacity: 0;
    transition: opacity var(--transition);
  }

  .skill-card:hover .card-glow {
    opacity: 1;
  }

  .skill-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .skill-icon-wrapper {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--accent-cyan) 12%, transparent);
    color: var(--accent-cyan);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .skill-badge {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
  }

  .skill-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.5rem;
  }

  .skill-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  .skill-items {
    list-style: none;
    padding: 0;
    margin: auto 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-top: 1px solid var(--border-subtle);
    padding-top: 1rem;
  }

  .skill-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-main);
    font-weight: 500;
  }

  .check-icon {
    color: var(--accent-emerald);
    flex-shrink: 0;
  }

  /* Bloque de Filosofía */
  .philosophy-wrapper {
    background: color-mix(in srgb, var(--bg-surface-elevated) 40%, var(--bg-primary));
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
  }

  .philosophy-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.75rem;
  }

  .shield-icon {
    color: var(--accent-cyan);
  }

  .philosophy-section-title {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.01em;
  }

  .philosophy-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.75rem;
  }

  .philosophy-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
  }

  .philosophy-top {
    margin-bottom: 0.85rem;
  }

  .pillar-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.25rem;
  }

  .pillar-subtitle {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent-cyan);
  }

  .pillar-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .pillar-quote {
    margin-top: auto;
    padding: 0.75rem 1rem;
    background: color-mix(in srgb, var(--accent-cyan) 6%, transparent);
    border-left: 3px solid var(--accent-cyan);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 0.82rem;
    font-style: italic;
    color: var(--text-main);
  }

  @media (max-width: 768px) {
    .philosophy-wrapper {
      padding: 1.5rem;
    }
    .section-title {
      font-size: 1.8rem;
    }
  }
</style>
