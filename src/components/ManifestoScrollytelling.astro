---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const manifestoText = {
  es: "Cimientos en robótica y programación, forjados en la trinchera operativa más exigente. Hoy construyo y estabilizo software de negocio en producción.",
  en: "Foundations in robotics and programming, forged in demanding operational trenches. Today I build and stabilize production business software.",
  pt: "Alicerce em robótica e programação, forjado na trincheira operacional mais exigente. Hoje construo e estabilizo software de negócio em produção."
}[lang];

const words = manifestoText.split(' ').map((w, i, arr) => ({
  word: w,
  progressThreshold: (i / arr.length).toFixed(3)
}));
---

<section id="manifiesto" class="manifesto-scroll-section" data-scene="manifesto">
  <div class="manifesto-sticky-wrapper">
    <span class="manifesto-badge">
      {lang === 'es' ? 'Perfil' : lang === 'en' ? 'Profile' : 'Perfil'}
    </span>
    <p class="manifesto-paragraph">
      {words.map((item) => (
        <span class="manifesto-word" data-threshold={item.progressThreshold}>
          {item.word}{' '}
        </span>
      ))}
    </p>
  </div>
</section>

<script>
  import { registerFx } from '../scripts/journey';

  // Scroll-engine consolidation (T3): the manifesto no longer wires its own
  // scroll trigger — it registers the section with the journey registry and
  // subscribes through the onProgress callback, so the word reveal runs on
  // the same single engine as every other beat. The font-load refresh that
  // used to live here is module-level in journey.ts.
  //
  // Module scripts evaluate once, so this is a plain top-level call; the
  // registry's WeakSet keeps registration idempotent and the manifestoReady
  // check preserves the double-init guard semantics.
  const section = document.querySelector<HTMLElement>('.manifesto-scroll-section');
  const words = section ? Array.from(section.querySelectorAll<HTMLElement>('.manifesto-word')) : [];
  if (section && words.length && section.dataset.manifestoReady !== 'true') {
    // Reduced motion: nothing registers and manifestoReady stays unset, so
    // the CSS base opacity keeps the text fully readable (exact previous
    // behavior).
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      section.dataset.manifestoReady = 'true';

      // Desktop pins the section (160vh); mobile does not (height auto), so
      // the trigger range follows the viewport — passed through the
      // registry's additive start/end options.
      const isMobile = window.matchMedia('(max-width: 767px)').matches;

      registerFx(section, {
        start: isMobile ? 'top 80%' : undefined,
        end: isMobile ? 'bottom 45%' : undefined,
        onProgress: (p: number) => {
          words.forEach((w) => {
            const t = parseFloat(w.dataset.threshold || '0');
            // Word reveals smoothly based on scroll position exactly like Claude Design
            const opacity = Math.min(1, Math.max(0.12, (p * 1.15 - t) * 12));
            w.style.opacity = opacity.toString();
          });
        },
      });
    }
  }
</script>

<style>
  .manifesto-scroll-section {
    height: 160vh;
    position: relative;
    background: #f2eee6;
  }

  .manifesto-sticky-wrapper {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 32px;
    padding: 80px clamp(20px, 5vw, 72px) 40px;
    box-sizing: border-box;
  }

  .manifesto-badge {
    display: inline-block;
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6a645a;
  }

  .manifesto-paragraph {
    margin: 0;
    max-width: 1180px;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.27em;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 300;
    font-size: clamp(22px, min(3.1vw, 5.2vh), 48px);
    line-height: 1.22;
    letter-spacing: -0.015em;
    color: #1c1a17;
  }

  .manifesto-word {
    display: inline-block;
  }

  /* Dim words only once the scroll reveal is armed, so text stays readable without JS. */
  .manifesto-scroll-section[data-manifesto-ready] .manifesto-word {
    opacity: 0.12;
  }

  @media (max-width: 767px) {
    /* No pinning on mobile: the block costs only its own height. */
    .manifesto-scroll-section {
      height: auto;
    }
    .manifesto-sticky-wrapper {
      position: static;
      height: auto;
      gap: 20px;
      padding: 56px clamp(20px, 5vw, 72px) 56px;
    }
    .manifesto-paragraph {
      font-size: clamp(18px, 4.9vw, 24px);
      line-height: 1.36;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .manifesto-word {
      opacity: 1;
      transition: none;
    }
  }
</style>
