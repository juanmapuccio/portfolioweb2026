---
import { Image } from 'astro:assets';
import fotoPerfil from '../assets/fotojmPerfil.png';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import { projectsContent } from '../data/projects';
import { BELTS, martialExperienceData } from '../data/martialExperience';
import { skillsData } from '../data/skills';
import { contactData } from '../data/contact';
import { manifestoText } from '../data/manifesto';

interface Props {
  lang: Lang;
}

/**
 * Mobile-only (<=767px) immersive experience: six pinned scenes whose
 * --p / --v / --e custom properties are written by journey.ts registerScene
 * (the single scroll engine). Above 767px this whole tree is display:none and
 * never registered, so the desktop column is unchanged.
 */
const { lang } = Astro.props;
const t = useTranslations(lang);

const status = lang === 'es' ? 'Disponible · full-time' : lang === 'en' ? 'Available · full-time' : 'Disponível · full-time';
const cue = lang === 'es' ? 'Desplázate' : lang === 'en' ? 'Scroll' : 'Role';
const city = lang === 'pt' ? 'Rosário' : 'Rosario';
const nameLines = ['Juan', 'Manuel', 'Puccio'];

const words = manifestoText[lang].split(' ');

const projects = projectsContent[lang].map((project, i) => ({
  n: String(i + 1).padStart(2, '0'),
  name: project.name,
  badge: project.badge,
  description: project.description,
  impact: project.impact,
  tech: project.tech.join(' · '),
  url: project.url,
  domain: new URL(project.url).hostname,
}));
const projectsLabel = lang === 'es' ? 'Producción viva' : lang === 'en' ? 'Live production' : 'Em produção';
const projectsCount = lang === 'es' ? 'sistemas' : lang === 'en' ? 'systems' : 'sistemas';
const impactLabel = lang === 'es' ? 'Impacto' : lang === 'en' ? 'Impact' : 'Impacto';

const experience = martialExperienceData[lang];
const stages = experience.stages.map((stage, i) => ({
  i,
  years: stage.years,
  title: stage.title,
  place: stage.positions[0]?.org ?? '',
  color: BELTS[stage.beltKey]?.color ?? 'transparent',
}));

const skills = skillsData[lang];
const stack = skills.categories.slice(0, 4).map((category, i) => ({
  i,
  title: category.title,
  items: category.items.join(', '),
}));
const quote = skills.philosophy[1]?.quote ?? '';

const contact = contactData[lang];
const location = lang === 'pt' ? 'Rosário, Argentina' : 'Rosario, Argentina';
---

<div class="mobile-immersive">
  <!-- Viewport probe: 100svh, the same unit as the layers. journey.ts and the nav read its height. -->
  <div class="vh-probe" data-vh-probe aria-hidden="true"></div>
  <!-- 01 HERO -->
  <section id="m-top" class="scene scene-hero" data-scene="hero">
    <div class="layer hero-layer">
      <div class="hero-copy">
        <div class="mono hero-status">
          <span class="dot" aria-hidden="true"></span>
          <span>{status}</span>
        </div>
        <h1 class="hero-name">
          {nameLines.map((line) => <span>{line}</span>)}
        </h1>
        <p class="mono hero-role">{t('header.role')}</p>
      </div>
      <figure class="hero-portrait">
        <Image
          src={fotoPerfil}
          alt="Juan Manuel Puccio"
          class="hero-photo"
          width={420}
          height={525}
          format="webp"
          quality={80}
          loading="lazy"
        />
        <figcaption class="mono hero-fig"><span>Fig. 01</span><span>{city}, 2026</span></figcaption>
      </figure>
      <div class="mono hero-cue">{cue} ↓</div>
    </div>
  </section>

  <!-- 02 MANIFESTO -->
  <section id="m-manifiesto" class="scene scene-manifesto" data-scene="manifesto">
    <div class="layer manifesto-layer">
      <p class="manifesto-text" style={`--n: ${words.length + 2};`}>
        {words.map((word, i) => <span class="manifesto-word" style={`--i: ${i};`}>{word}</span>)}
      </p>
    </div>
  </section>

  <!-- 03 PROJECTS -->
  <section id="m-proyectos" class="scene scene-projects" data-scene="projects">
    <div class="layer projects-layer">
      <div class="mono row-head">
        <span>{projectsLabel}</span><span>{String(projects.length).padStart(2, '0')} {projectsCount}</span>
      </div>
      <div class="carousel" style={`--n: ${projects.length};`}>
        {projects.map((project) => (
          <a class="card" href={project.url} target="_blank" rel="noopener noreferrer">
            <div class="card-main">
              <div class="mono card-badge">{project.n} — {project.badge}</div>
              <div>
                <h3 class="card-name">{project.name}</h3>
                <p class="card-desc">{project.description}</p>
              </div>
              <div class="mono card-domain"><span class="dot" aria-hidden="true"></span>{project.domain} ↗</div>
            </div>
            <div class="card-impact">
              <div class="mono card-impact-label">{impactLabel}</div>
              <p class="card-impact-text">{project.impact}</p>
              <div class="mono card-tech">{project.tech}</div>
            </div>
          </a>
        ))}
      </div>
      <div class="progress-rule" aria-hidden="true"><div class="progress-fill"></div></div>
    </div>
  </section>

  <!-- 04 TRAYECTORIA -->
  <section id="m-trayectoria" class="scene scene-belts" data-scene="belts">
    <div class="layer belts-layer">
      <div>
        <div class="mono eyebrow">10º gup → 1º dan</div>
        <h2 class="belts-title">{experience.title}</h2>
      </div>
      <div class="belt-rows">
        {stages.map((stage) => (
          <div class="belt-row" style={`--i: ${stage.i};`}>
            <div class="mono belt-years">{stage.years}</div>
            <div>
              <div class="belt-bar" style={`--c: ${stage.color};`}></div>
              <div class="belt-meta"><span class="belt-title">{stage.title}</span><span class="belt-place">{stage.place}</span></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 05 STACK -->
  <section id="m-stack" class="scene scene-stack" data-scene="stack">
    <div class="layer stack-layer">
      <p class="stack-quote">“{quote}”</p>
      <div class="stack-grid">
        {stack.map((item) => (
          <div class="stack-item" style={`--i: ${item.i};`}>
            <div class="mono eyebrow">{item.title}</div>
            <div class="stack-items">{item.items}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 06 CONTACT -->
  <section id="m-contacto" class="scene scene-contact" data-scene="contact">
    <div class="layer contact-layer">
      <div class="mono contact-badge">{contact.badge}</div>
      <h2 class="contact-title">{contact.title}</h2>
      <div class="contact-list">
        {contact.channels.map((channel) => (
          <a class="contact-link" href={channel.url} target="_blank" rel="noopener noreferrer">
            <span class="contact-text">
              <span class="mono contact-name">{channel.name}</span>
              <span class="contact-label">{channel.label}</span>
            </span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
      <div class="mono contact-foot"><span>{location}</span><span>© 2026 Juan Manuel Puccio</span></div>
    </div>
  </section>
</div>

<script>
  import { registerScene } from '../scripts/journey';

  // journey.ts gates this on (max-width: 767px): scenes register on mobile and
  // are parked on desktop (replayed if the viewport later crosses 767px).
  document
    .querySelectorAll<HTMLElement>('.mobile-immersive [data-scene]')
    .forEach((scene) => registerScene(scene));
</script>

<style>
  .mobile-immersive {
    display: none;
    background: var(--bg-primary);
    color: var(--text-main);
    font-family: var(--font-sans);
  }

  @media (max-width: 767px) {
    .mobile-immersive {
      display: block;
    }
  }

  .vh-probe {
    position: fixed;
    top: 0;
    left: 0;
    width: 1px;
    height: 100svh;
    visibility: hidden;
    pointer-events: none;
  }

  .mono {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    flex: none;
    border-radius: 50%;
    background: var(--accent-emerald);
  }

  /* Scene stack: each section is tall, its layer sticks for the pinned span and
     the next scene overlaps by one viewport (margin-top: -100svh). */
  .scene {
    position: relative;
  }

  .scene + .scene {
    margin-top: -100svh;
  }

  /* svh everywhere (layers, overlap, entrance) so the URL bar collapsing never
     desyncs the scene math. Pinned span = height - 200svh (contact: - 100svh). */
  .scene-hero { height: 290svh; }
  .scene-manifesto { height: 310svh; z-index: 2; }
  .scene-projects { height: 420svh; z-index: 3; }
  .scene-belts { height: 360svh; z-index: 4; }
  .scene-stack { height: 290svh; z-index: 5; }
  .scene-contact { height: 180svh; z-index: 6; background: var(--panel-dark); color: var(--panel-dark-fg); }

  /* The exiting layer recedes with scale + brightness only (no blur: six
     full-viewport blurred layers are too heavy for phones). */
  .layer {
    position: sticky;
    top: 0;
    height: 100svh;
    box-sizing: border-box;
    overflow: hidden;
    overflow: clip;
    background: var(--bg-primary);
    padding: 60px 20px 0;
    transform: translateY(calc((1 - var(--v, 1)) * -100svh)) scale(calc(1 - var(--e, 0) * 0.14));
    filter: brightness(calc(1 - var(--e, 0) * 0.35));
  }

  /* Promote a layer only while its scene is on screen (journey.ts toggles data-active). */
  .scene[data-active] .layer {
    will-change: transform, clip-path;
  }

  .eyebrow {
    color: var(--text-dim);
  }

  /* 01 hero */
  .hero-layer {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    align-items: center;
    gap: 28px;
    perspective: 1400px;
  }

  .hero-copy {
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--p, 0) * 260px)) translateY(calc(var(--p, 0) * -12vh));
    opacity: calc(1 - var(--p, 0) * 1.6);
  }

  .hero-status {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    color: var(--text-muted);
  }

  .hero-name {
    margin: 0;
    display: flex;
    flex-direction: column;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(52px, min(17vw, 11svh), 84px);
    line-height: 0.9;
    letter-spacing: -0.035em;
  }

  .hero-role {
    margin: 24px 0 0;
    font-size: 12px;
    color: var(--text-dim);
  }

  .hero-portrait {
    justify-self: start;
    width: min(100%, 30svh, 56vw);
    margin: 0;
    transform-style: preserve-3d;
    transform: rotateY(calc(var(--p, 0) * -28deg)) translateZ(calc(var(--p, 0) * -400px)) scale(calc(1 - var(--p, 0) * 0.25));
    opacity: calc(1 - var(--p, 0) * 1.2);
  }

  .hero-photo {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center top;
    filter: grayscale(1) contrast(1.05);
    mix-blend-mode: multiply;
  }

  .hero-fig {
    display: flex;
    justify-content: space-between;
    margin-top: 10px;
    font-size: 10px;
    color: var(--text-dim);
  }

  .hero-cue {
    position: absolute;
    left: 20px;
    bottom: 28px;
    color: var(--text-dim);
    opacity: calc(1 - var(--p, 0) * 4);
  }

  /* 02 manifesto */
  .manifesto-layer {
    display: flex;
    align-items: center;
    padding-top: 0;
    clip-path: inset(calc((1 - var(--v, 1)) * 50%) 0 calc((1 - var(--v, 1)) * 50%) 0);
  }

  .manifesto-text {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.25em;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(27px, 7.6vw, 36px);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .manifesto-word {
    display: inline-block;
    opacity: clamp(0.1, calc(var(--p, 0) * var(--n) - var(--i)), 1);
  }

  /* 03 projects: the carousel translates with the vertical scroll progress, so
     the cards carry no inner scroller. */
  .projects-layer {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 22px;
    padding-inline: 0;
    clip-path: inset(calc((1 - var(--v, 1)) * 100%) 0 0 0);
  }

  .row-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-inline: 20px;
    color: var(--text-dim);
  }

  .carousel {
    display: flex;
    gap: 4vw;
    padding-left: 20px;
    transform: translateX(calc(var(--p, 0) * -1 * (86vw + 4vw) * (var(--n) - 1)));
  }

  .scene[data-active] .carousel {
    will-change: transform;
  }

  .card {
    flex: 0 0 86vw;
    height: min(68svh, 600px);
    display: grid;
    grid-template-rows: minmax(0, 1.25fr) minmax(0, 1fr);
    overflow: hidden;
    overflow: clip;
    background: var(--bg-surface);
    box-shadow: var(--shadow-card);
    color: var(--text-main);
    text-decoration: none;
  }

  .card-main {
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
    min-height: 0;
  }

  .card-badge {
    font-size: 10px;
    color: var(--text-dim);
  }

  .card-name {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(30px, 9vw, 40px);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .card-desc {
    margin: 10px 0 0;
    font-size: 14px;
    line-height: 1.45;
    color: var(--text-muted);
  }

  .card-domain {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-wrap: anywhere;
  }

  .card-impact {
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
    min-height: 0;
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-surface-elevated);
  }

  .card-impact-label {
    font-size: 10px;
    color: var(--text-dim);
  }

  .card-impact-text {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 16px;
    line-height: 1.25;
  }

  .card-tech {
    font-size: 10px;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--text-muted);
  }

  .progress-rule {
    position: relative;
    margin-inline: 20px;
    height: 1px;
    background: var(--border-subtle);
  }

  .progress-fill {
    position: absolute;
    inset: 0;
    background: var(--text-main);
    transform-origin: left;
    transform: scaleX(var(--p, 0));
  }

  /* 04 belts */
  .belts-layer {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 28px;
    background: var(--bg-surface-elevated);
    clip-path: inset(0 calc((1 - var(--v, 1)) * 100%) 0 0);
  }

  .belts-title {
    margin: 14px 0 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(28px, 8.4vw, 36px);
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .belt-rows {
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 2svh, 18px);
  }

  .belt-row {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    opacity: clamp(0.18, calc(var(--p, 0) * 6.5 - var(--i) + 0.4), 1);
  }

  .belt-years {
    letter-spacing: 0.06em;
    color: var(--text-dim);
  }

  .belt-bar {
    height: 10px;
    background: var(--c);
    box-shadow: inset 0 0 0 1px rgba(28, 26, 23, 0.12);
    transform-origin: left;
    transform: scaleX(clamp(0, calc(var(--p, 0) * 6.5 - var(--i)), 1));
  }

  .belt-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 8px;
  }

  .belt-title {
    font-family: var(--font-serif);
    font-size: 18px;
  }

  .belt-place {
    font-size: 13px;
    color: var(--text-muted);
    text-align: right;
  }

  /* 05 stack */
  .stack-layer {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 24px;
    perspective: 1400px;
    clip-path: inset(calc((1 - var(--v, 1)) * 38%) calc((1 - var(--v, 1)) * 38%));
  }

  .stack-quote {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(24px, 6.8vw, 30px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .stack-grid {
    display: grid;
    gap: 16px;
  }

  .stack-item {
    border-top: 1px solid var(--border-strong);
    padding-top: 12px;
    --k: clamp(0, calc(var(--i) * 0.12 + 0.5 - var(--p, 0)), 1);
    transform: translateY(calc(var(--k) * 120px)) rotateX(calc(var(--k) * 40deg));
    opacity: clamp(0, calc((var(--p, 0) - var(--i) * 0.12) * 3), 1);
  }

  .stack-items {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.5;
  }

  /* 06 contact */
  .contact-layer {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    padding: calc(60px + 4vh) 20px 28px;
    background: var(--panel-dark);
    color: var(--panel-dark-fg);
    perspective: 1400px;
    clip-path: circle(calc(var(--v, 1) * 150%) at 50% 100%);
  }

  .contact-badge {
    opacity: 0.7;
  }

  .contact-title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(32px, 9.6vw, 42px);
    line-height: 0.96;
    letter-spacing: -0.03em;
    transform: translateZ(calc((1 - min(var(--p, 0) * 2, 1)) * -320px));
    opacity: min(calc(var(--p, 0) * 2.4), 1);
  }

  .contact-list {
    display: grid;
  }

  .contact-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 12px 0;
    border-top: 1px solid rgba(242, 238, 230, 0.16);
    color: var(--panel-dark-fg);
    text-decoration: none;
  }

  .contact-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .contact-name {
    font-size: 10px;
    opacity: 0.65;
  }

  .contact-label {
    font-size: 15px;
    overflow-wrap: anywhere;
  }

  .contact-foot {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 10px;
    opacity: 0.6;
  }

  /* Touch feedback (mobile tree only). */
  .card,
  .contact-link {
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .card:active {
    background: var(--bg-surface-elevated);
    transform: scale(0.985);
  }

  .contact-link:active {
    background: rgba(242, 238, 230, 0.08);
  }

  .card:focus-visible {
    outline: 2px solid var(--text-main);
    outline-offset: -4px;
  }

  .contact-link:focus-visible {
    outline: 2px solid var(--panel-dark-fg);
    outline-offset: -2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .card,
    .contact-link {
      transition: transform 120ms ease-out, background-color 120ms ease-out;
    }
  }

  /* Reduced motion: journey.ts freezes --p/--v/--e; here the pinned stage is
     flattened to a plain readable column (no sticky overlap, no transforms) and
     the carousel becomes a native horizontal scroller. */
  @media (prefers-reduced-motion: reduce) {
    .scene {
      height: auto;
    }

    .scene + .scene {
      margin-top: 0;
    }

    .layer {
      position: relative;
      height: auto;
      min-height: 100svh;
      padding-bottom: 48px;
      clip-path: none;
      transform: none;
      filter: none;
      will-change: auto;
    }

    .scene :global(*) {
      transform: none !important;
      opacity: 1 !important;
    }

    .carousel {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-right: 20px;
    }

    .card {
      scroll-snap-align: start;
    }

    .card:active {
      transform: none;
    }

    .contact-badge,
    .contact-name,
    .contact-foot {
      opacity: 0.7 !important;
    }
  }
</style>
