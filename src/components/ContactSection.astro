---
import type { Lang } from '../i18n/ui';
import { contactData, CV_URL } from '../data/contact';
import { ArrowUpRight } from 'lucide-astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = contactData[lang];
const location = lang === 'es' ? 'Rosario, Argentina' : lang === 'en' ? 'Rosario, Argentina' : 'Rosário, Argentina';
const whatsappLabel = lang === 'es' ? 'CONVERSAR POR WHATSAPP' : lang === 'en' ? 'CHAT ON WHATSAPP' : 'CONVERSAR PELO WHATSAPP';
const cvLabel = lang === 'es' ? 'DESCARGAR CV' : lang === 'en' ? 'DOWNLOAD CV' : 'BAIXAR CV';
---

<section id="contacto" class="contact-section" aria-labelledby="contact-title">
  <div class="container contact-container">
    <div class="contact-intro">
      <p class="contact-eyebrow"><span class="status-dot" aria-hidden="true"></span>{data.badge}</p>
      <h2 id="contact-title" class="contact-title">{data.title}</h2>
      <p class="contact-subtitle">{data.subtitle}</p>
      <div class="contact-actions">
        <a href="https://wa.me/5493413192179" target="_blank" rel="noopener noreferrer" class="contact-action action-primary">
          {whatsappLabel}<ArrowUpRight size={17} aria-hidden="true" />
        </a>
        <a href={CV_URL} target="_blank" rel="noopener noreferrer" class="contact-action action-secondary">
          {cvLabel}<ArrowUpRight size={17} aria-hidden="true" />
        </a>
      </div>
    </div>

    <nav class="contact-rows" aria-label={lang === 'es' ? 'Canales de contacto' : lang === 'en' ? 'Contact channels' : 'Canais de contato'}>
      {data.channels.map((channel) => (
        <a
          class="contact-row"
          href={channel.url}
          target={channel.id === 'email' ? undefined : '_blank'}
          rel={channel.id === 'email' ? undefined : 'noopener noreferrer'}
          aria-label={`${channel.name}: ${channel.label}`}
        >
          <span class="contact-row-label">{channel.name}</span>
          <span class="contact-row-value">{channel.label}<ArrowUpRight size={20} aria-hidden="true" /></span>
        </a>
      ))}
    </nav>

    <footer class="contact-footer">
      <span>{location}</span>
      <span>© 2026 Juan Manuel Puccio</span>
    </footer>
  </div>
</section>

<style>
  .contact-section {
    padding: clamp(5rem, 10vw, 10rem) 0 2rem;
    background: #1c1a17;
    color: #f2eee6;
  }
  .contact-container { max-width: 1600px; }
  .contact-intro { max-width: 57rem; }
  .contact-eyebrow, .contact-row-label, .contact-action, .contact-footer {
    font-family: var(--font-mono, monospace);
  }
  .contact-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 1.5rem;
    color: #d2cbbf;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
  }
  .status-dot { width: 0.48rem; height: 0.48rem; flex: 0 0 auto; border-radius: 50%; background: #6d9c73; }
  .contact-title {
    max-width: 16ch;
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(3rem, 7vw, 6.7rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 0.98;
    text-wrap: balance;
  }
  .contact-subtitle {
    max-width: 66ch;
    margin-top: 1.6rem;
    color: #d2cbbf;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.7;
  }
  .contact-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2.3rem; }
  .contact-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    min-height: 3.4rem;
    padding: 0.9rem 1.2rem;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease;
  }
  .action-primary { background: #f2eee6; color: #1c1a17; border: 1px solid #f2eee6; }
  .action-secondary { color: #f2eee6; border: 1px solid rgba(242, 238, 230, 0.5); }
  .action-primary:hover { background: #d9d1c3; border-color: #d9d1c3; }
  .action-secondary:hover { background: rgba(242, 238, 230, 0.1); }
  .contact-action:focus-visible, .contact-row:focus-visible { outline: 2px solid #b6d3b8; outline-offset: 5px; }

  .contact-rows { margin-top: clamp(5rem, 10vw, 10rem); border-top: 1px solid rgba(242, 238, 230, 0.32); }
  .contact-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 6.3rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid rgba(242, 238, 230, 0.25);
    transition: color 180ms ease;
  }
  .contact-row:hover { color: #c9d8c7; }
  .contact-row-label { color: #c6bfb3; font-size: 0.68rem; letter-spacing: 0.06em; }
  .contact-row-value {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(1.35rem, 3vw, 2.35rem);
    line-height: 1.2;
    overflow-wrap: anywhere;
    text-align: right;
  }
  .contact-row-value :global(svg) { flex: 0 0 auto; }
  .contact-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    color: #c6bfb3;
    font-size: 0.65rem;
    letter-spacing: 0.03em;
  }
  @media (max-width: 640px) {
    .contact-actions { flex-direction: column; align-items: stretch; }
    .contact-action { width: 100%; }
    .contact-row { align-items: flex-start; flex-direction: column; gap: 0.6rem; min-height: 0; }
    .contact-row-value { text-align: left; }
    .contact-footer { flex-direction: column; }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-action, .contact-row { transition: none; }
  }
</style>
