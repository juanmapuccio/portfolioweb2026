---
import type { Lang } from '../i18n/ui';
import { contactData, CV_URL } from '../data/contact';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = contactData[lang];
const t = useTranslations(lang);
const location = lang === 'pt' ? 'Rosário, Argentina' : 'Rosario, Argentina';
const whatsapp = data.channels.find((channel) => channel.primary);
const whatsappLabel = data.ctaButtonText.toUpperCase();
const cvLabel = t('hero.btn.cv').toUpperCase();
---

<footer
  id="contacto"
  data-fx="k"
  data-zone="kimono"
  data-ch="6"
  class="kimono-contact-footer"
>
  <div class="kimono-sticky-stage">
    <!-- Revealed Contact Content in the Background -->
    <div class="kimono-revealed-plane">
      <div class="kimono-content-top">
        <span class="mono-badge">
          {lang === 'es' ? 'DISPONIBILIDAD & CONTRATACIÓN' : lang === 'en' ? 'AVAILABILITY & HIRING' : 'DISPONIBILIDADE & CONTRATAÇÃO'}
        </span>
        <h2 class="kimono-title">{data.title}</h2>
        <p class="kimono-subtitle">{data.subtitle}</p>
        <div class="kimono-actions-row">
          {whatsapp && (
            <a
              href={whatsapp.url}
              target="_blank"
              rel="noopener noreferrer"
              class="kimono-btn-primary"
            >
              {whatsappLabel}
            </a>
          )}
          <a
            href={CV_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="kimono-btn-secondary"
          >
            {cvLabel}
          </a>
        </div>
      </div>

      <!-- Contact Channels Grid -->
      <nav class="kimono-channels-grid" aria-label={lang === 'es' ? 'Canales de contacto' : lang === 'en' ? 'Contact channels' : 'Canais de contato'}>
        {data.channels.map((channel) => (
          <a
            href={channel.url}
            target={channel.id === 'email' ? undefined : '_blank'}
            rel={channel.id === 'email' ? undefined : 'noopener noreferrer'}
            class="kimono-channel-card"
          >
            <span class="ch-name">{channel.name}</span>
            <span class="ch-val">{channel.label} ↗</span>
          </a>
        ))}
      </nav>

      <div class="kimono-legal-bar">
        <span>{location} · Remoto / Híbrido / On-site</span>
        <span>Kyong-ye · © 2026 Juan Manuel Puccio</span>
      </div>
    </div>

    <!-- Dobok Kimono Left Fold -->
    <div class="dobok-fold dobok-fold-left" aria-hidden="true">
      <div class="dobok-inner dobok-inner-left"></div>
      <div class="dobok-badge-label dobok-badge-left">Dobok · 1º dan</div>
    </div>

    <!-- Dobok Kimono Right Fold -->
    <div class="dobok-fold dobok-fold-right" aria-hidden="true">
      <div class="dobok-inner dobok-inner-right"></div>
      <div class="dobok-badge-label dobok-badge-right">
        {lang === 'es' ? 'Contacto ↓' : lang === 'en' ? 'Contact ↓' : 'Contato ↓'}
      </div>
    </div>

    <!-- 3D Belt Landing Slot (Waist of Dobok) -->
    <div data-slot="1" class="kimono-belt-slot" aria-hidden="true"></div>
  </div>
</footer>

<style>
  .kimono-contact-footer {
    height: 220vh;
    position: relative;
    background: #1c1a17;
    color: #f2eee6;
    margin-top: -1px;
    box-sizing: border-box;
  }

  .kimono-sticky-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    background: #1c1a17;
  }

  /* Background Revealed Plane */
  .kimono-revealed-plane {
    position: absolute;
    inset: 0;
    padding: clamp(80px, 11vh, 100px) clamp(20px, 5vw, 72px) 28px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    max-width: 1600px;
    margin: 0 auto;
    opacity: clamp(0, calc((var(--p, 0) - 0.25) * 2.5), 1);
    transform: scale(calc(0.96 + clamp(0, var(--p, 0), 1) * 0.04));
    transition: opacity 0.05s linear, transform 0.05s linear;
  }

  .kimono-content-top {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 1100px;
  }

  .mono-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c9c3b7;
  }

  .kimono-title {
    margin: 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 300;
    font-size: clamp(38px, 5vw, 84px);
    line-height: 1;
    letter-spacing: -0.03em;
    color: #f2eee6;
    text-wrap: balance;
  }

  .kimono-subtitle {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: #c9c3b7;
    max-width: 720px;
    text-wrap: pretty;
  }

  .kimono-actions-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    padding-top: 8px;
  }

  .kimono-btn-primary {
    background: #f2eee6;
    color: #1c1a17;
    padding: 15px 26px;
    text-decoration: none;
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .kimono-btn-primary:hover {
    transform: translateY(-2px);
    background: #ffffff;
    color: #1c1a17;
  }

  .kimono-btn-secondary {
    border: 1px solid rgba(242, 238, 230, 0.4);
    color: #f2eee6;
    padding: 15px 26px;
    text-decoration: none;
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .kimono-btn-secondary:hover {
    transform: translateY(-2px);
    border-color: #f2eee6;
    color: #f2eee6;
  }

  /* Channels Grid */
  .kimono-channels-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    border-top: 1px solid rgba(242, 238, 230, 0.18);
  }

  .kimono-channel-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 16px 18px 0;
    text-decoration: none;
    border-bottom: 1px solid rgba(242, 238, 230, 0.18);
    transition: transform 0.2s ease;
  }

  .kimono-channel-card:hover {
    transform: translateX(4px);
  }

  .ch-name {
    font-family: var(--font-mono, monospace);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c9c3b7;
  }

  .ch-val {
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 400;
    font-size: clamp(17px, 1.4vw, 21px);
    line-height: 1.2;
    color: #f2eee6;
    overflow-wrap: anywhere;
  }

  .kimono-legal-bar {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #c9c3b7;
    padding-top: 8px;
  }

  /* Dobok Flaps / Folds */
  .dobok-fold {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 53%;
    background: #1c1a17;
    pointer-events: none;
    will-change: transform;
    z-index: 2;
  }

  .dobok-fold-left {
    left: 0;
    clip-path: polygon(0 0, 78% 0, 100% 44%, 100% 100%, 0 100%);
    transform: translateX(calc(clamp(0, calc(var(--p, 0) * 1.6), 1) * -104%));
    box-shadow: 0 0 0 1px #1c1a17;
  }

  .dobok-inner-left {
    position: absolute;
    inset: 0 0 7vh 0;
    background: #faf8f3;
    clip-path: polygon(0 0, 70% 0, 92% 44%, 92% 100%, 0 100%);
  }

  .dobok-badge-left {
    left: clamp(20px, 5vw, 72px);
  }

  .dobok-fold-right {
    right: 0;
    clip-path: polygon(22% 0, 100% 0, 100% 100%, 0 100%, 0 44%);
    transform: translateX(calc(clamp(0, calc(var(--p, 0) * 1.6), 1) * 104%));
  }

  .dobok-inner-right {
    position: absolute;
    inset: 0 0 7vh 0;
    background: #f2eee6;
    clip-path: polygon(30% 0, 100% 0, 100% 100%, 8% 100%, 8% 44%);
  }

  .dobok-badge-right {
    right: clamp(20px, 5vw, 72px);
  }

  .dobok-badge-label {
    position: absolute;
    top: 96px;
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4a463f;
    z-index: 3;
  }

  /* Belt Slot on the Kimono Waist */
  .kimono-belt-slot {
    position: absolute;
    left: 18vw;
    right: 18vw;
    top: 48vh;
    height: 30vh;
    pointer-events: none;
    z-index: 3;
  }

  @media (prefers-reduced-motion: reduce) {
    .dobok-fold-left,
    .dobok-fold-right {
      display: none;
    }

    .kimono-revealed-plane {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
