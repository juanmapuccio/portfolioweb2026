---
import type { Lang } from '../i18n/ui';
import { contactData, CV_URL } from '../data/contact';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = contactData[lang];
const t = useTranslations(lang);
const location = lang === 'pt' ? 'Rosário, Argentina' : 'Rosario, Argentina';
const whatsapp = data.channels.find((channel) => channel.primary);
const whatsappLabel = data.ctaButtonText.toUpperCase();
const cvLabel = t('hero.btn.cv').toUpperCase();
---

<footer
  id="contacto"
  data-fx="c"
  data-zone="curtain"
  data-ch="6"
  class="cinematic-contact-footer"
>
  <div class="contact-sticky-stage">
    <!-- Atmospheric Lighting & Background Vignette -->
    <div class="contact-ambient-halo" aria-hidden="true"></div>
    <div class="contact-gold-beam" aria-hidden="true"></div>

    <div class="contact-main-wrapper">
      <!-- Top Meta Row -->
      <div class="contact-top-meta">
        <span class="mono-badge">
          {lang === 'es' ? 'DISPONIBILIDAD & CONTRATACIÓN' : lang === 'en' ? 'AVAILABILITY & HIRING' : 'DISPONIBILIDADE & CONTRATAÇÃO'}
        </span>
        <span class="belt-dan-label">1º DAN · CINTURÓN NEGRO ITF</span>
      </div>

      <!-- Main Headline & Belt Showcase Grid -->
      <div class="contact-hero-grid">
        <div class="contact-narrative-col">
          <h2 class="contact-display-title">{data.title}</h2>
          <p class="contact-lead-desc">{data.subtitle}</p>

          <div class="contact-actions-row">
            {whatsapp && (
              <a
                href={whatsapp.url}
                target="_blank"
                rel="noopener noreferrer"
                class="contact-btn-primary"
              >
                {whatsappLabel}
              </a>
            )}
            <a
              href={CV_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="contact-btn-secondary"
            >
              {cvLabel}
            </a>
          </div>

          <p class="contact-location">
            <span class="contact-location-dot" aria-hidden="true"></span>
            {location} · Remoto / Híbrido / On-site
          </p>
        </div>

        <!-- 3D Black Belt Dedicated Landing Target -->
        <div class="contact-belt-col">
          <div data-slot="1" class="contact-belt-slot" aria-hidden="true"></div>
          <div class="belt-shadow-disk" aria-hidden="true"></div>
        </div>
      </div>

      <!-- Contact Channels Minimalist Row -->
      <nav class="contact-channels-grid" aria-label={lang === 'es' ? 'Canales de contacto' : lang === 'en' ? 'Contact channels' : 'Canais de contato'}>
        {data.channels.map((channel) => (
          <a
            href={channel.url}
            target={channel.id === 'email' ? undefined : '_blank'}
            rel={channel.id === 'email' ? undefined : 'noopener noreferrer'}
            class="contact-channel-card"
          >
            <span class="ch-head">
              <span class="ch-meta-label">{channel.name}</span>
              <span class="ch-arrow" aria-hidden="true">↗</span>
            </span>
            <span class="ch-value-link">{channel.label}</span>
          </a>
        ))}
      </nav>

      <!-- Bottom Bar -->
      <div class="contact-bottom-legal">
        <span>© 2026 Juan Manuel Puccio</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .cinematic-contact-footer {
    height: 190vh;
    position: relative;
    background: #1c1a17;
    color: #f2eee6;
    margin-top: -1px;
    box-sizing: border-box;
  }

  .contact-sticky-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1c1a17;
  }

  /* Atmospheric Lights */
  .contact-ambient-halo {
    position: absolute;
    width: min(80vw, 750px);
    height: min(80vw, 750px);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(212, 175, 55, 0.12) 0%, rgba(212, 175, 55, 0.03) 45%, transparent 70%);
    pointer-events: none;
    z-index: 1;
    transform: translate3d(0, 0, 0);
  }

  .contact-gold-beam {
    position: absolute;
    top: 0;
    left: clamp(20px, 5vw, 72px);
    right: clamp(20px, 5vw, 72px);
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, rgba(212, 175, 55, 0.4) 50%, transparent 100%);
    pointer-events: none;
  }

  .contact-main-wrapper {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1600px;
    padding: clamp(70px, 9vh, 90px) clamp(20px, 5vw, 72px) clamp(24px, 4vh, 40px);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    opacity: clamp(0, calc((var(--p, 0) - 0.15) * 3), 1);
    transform: translateY(calc(30px * (1 - clamp(0, var(--p, 0), 1))));
  }

  .contact-top-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .mono-badge {
    color: #c9c3b7;
    font-weight: 600;
  }

  .belt-dan-label {
    color: #fbbf24;
    font-weight: 600;
  }

  /* Grid Layout: Left Narrative + Right 3D Belt Showcase */
  .contact-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
    margin-block: auto;
  }

  @media (max-width: 900px) {
    .contact-hero-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .contact-belt-col {
      display: none;
    }
  }

  .contact-narrative-col {
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 2vh, 22px);
    max-width: 780px;
  }

  .contact-display-title {
    margin: 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 300;
    font-size: clamp(36px, 4.4vw, 76px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: #f2eee6;
    text-wrap: balance;
  }

  .contact-lead-desc {
    margin: 0;
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.6;
    color: #c9c3b7;
    max-width: 680px;
    text-wrap: pretty;
  }

  .contact-actions-row {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    padding-top: 8px;
  }

  .contact-btn-primary {
    background: #f2eee6;
    color: #1c1a17;
    padding: 15px 28px;
    text-decoration: none;
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .contact-btn-primary:hover {
    transform: translateY(-2px);
    background: #ffffff;
    box-shadow: 0 8px 24px -4px rgba(255, 255, 255, 0.2);
    color: #1c1a17;
  }

  .contact-btn-secondary {
    border: 1px solid rgba(242, 238, 230, 0.35);
    color: #f2eee6;
    padding: 15px 28px;
    text-decoration: none;
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .contact-btn-secondary:hover {
    transform: translateY(-2px);
    border-color: #f2eee6;
    color: #f2eee6;
  }

  /* 3D Belt Target Slot */
  .contact-belt-col {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .contact-belt-slot {
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .belt-shadow-disk {
    position: absolute;
    bottom: 12%;
    width: 60%;
    height: 14px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.6);
    filter: blur(12px);
    pointer-events: none;
  }

  /* Channels Grid */
  .contact-channels-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    border-top: 1px solid rgba(242, 238, 230, 0.16);
    gap: 1px;
    background: rgba(242, 238, 230, 0.16);
    margin-top: 16px;
  }

  .contact-channel-card {
    position: relative;
    background: #1c1a17;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px 22px 22px;
    text-decoration: none;
    transition: background-color 0.25s ease;
  }

  .contact-channel-card::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: #fbbf24;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .contact-channel-card:hover,
  .contact-channel-card:focus-visible {
    background: #25221e;
    outline: none;
  }

  .contact-channel-card:hover::after,
  .contact-channel-card:focus-visible::after {
    transform: scaleX(1);
  }

  .ch-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .ch-arrow {
    color: #8c857b;
    font-size: 14px;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .contact-channel-card:hover .ch-arrow {
    color: #fbbf24;
    transform: translate(2px, -2px);
  }

  .contact-location {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 6px 0 0;
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c9c3b7;
  }

  .contact-location-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 0 4px rgba(74, 222, 128, 0.15);
    flex: none;
  }

  .ch-meta-label {
    font-family: var(--font-mono, monospace);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c9c3b7;
  }

  .ch-value-link {
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 400;
    font-size: clamp(14px, 1.05vw, 17px);
    line-height: 1.25;
    color: #f2eee6;
    white-space: nowrap;
  }

  /* Bottom Legal Bar */
  .contact-bottom-legal {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8c857b;
    padding-top: 16px;
    justify-content: flex-end;
  }

  @media (max-width: 767px) {
    .cinematic-contact-footer {
      height: 140vh;
    }

    .contact-main-wrapper {
      padding: 72px 20px 32px;
      gap: 24px;
    }

    .contact-display-title {
      font-size: clamp(30px, 8vw, 44px);
    }

    .contact-lead-desc {
      font-size: 14.5px;
    }

    .contact-actions-row {
      flex-direction: column;
      gap: 10px;
    }

    .contact-btn-primary,
    .contact-btn-secondary {
      width: 100%;
      text-align: center;
      padding: 14px 20px;
    }

    .contact-channels-grid {
      grid-template-columns: 1fr;
    }

    .ch-value-link {
      white-space: normal;
      overflow-wrap: anywhere;
    }

    .contact-bottom-legal {
      justify-content: center;
      font-size: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-main-wrapper {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
