---
import type { Lang } from '../i18n/ui';
import { contactData } from '../data/contact';
import { MessageCircle, Mail, Linkedin, Github, Globe, Send, MapPin, Sparkles, ArrowRight } from 'lucide-astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = contactData[lang];

const channelIcons: Record<string, typeof MessageCircle> = {
  whatsapp: MessageCircle,
  email: Mail,
  linkedin: Linkedin,
  github: Github,
  nodosur: Globe,
};
---

<section id="contacto" class="contact-section">
  <div class="container">
    <div class="contact-card" data-reveal>
      <div class="contact-glow"></div>

      <div class="contact-header">
        <div class="contact-badge">
          <Sparkles size={14} class="badge-icon" />
          <span>{data.badge}</span>
        </div>
        <h2 class="contact-title">{data.title}</h2>
        <p class="contact-subtitle">{data.subtitle}</p>
      </div>

      <div class="contact-meta-bar">
        <div class="status-pill">
          <span class="status-dot"></span>
          <span>{data.statusText}</span>
        </div>
        <div class="location-pill">
          <MapPin size={14} class="location-icon" />
          <span>{data.locationText}</span>
        </div>
      </div>

      <div class="cta-action-wrapper">
        <a 
          href="https://wa.me/5493413192179" 
          target="_blank"
          rel="noopener noreferrer"
          class="btn-cta-main btn-cta-whatsapp"
          aria-label="Contactar a Juan Manuel Puccio por WhatsApp"
        >
          <MessageCircle size={20} class="whatsapp-icon" />
          <span>{data.ctaButtonText}</span>
          <ArrowRight size={16} class="arrow-icon" />
        </a>
      </div>

      <div class="channels-grid">
        {data.channels.map((ch, i) => {
          const IconComponent = channelIcons[ch.id] || Send;
          return (
            <a
              href={ch.url}
              target={ch.id === 'email' ? '_self' : '_blank'}
              rel={ch.id === 'email' ? '' : 'noopener noreferrer'}
              class:list={['channel-item', { 'primary-channel': ch.primary }]}
              aria-label={ch.name}
              data-reveal
              style={`--reveal-delay: ${i}`}
            >
              <div class="channel-icon-wrap">
                <IconComponent size={18} />
              </div>
              <div class="channel-info">
                <span class="channel-name">{ch.name}</span>
                <span class="channel-value">{ch.label}</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding: 6.5rem 0 7.5rem;
    background: color-mix(in srgb, var(--bg-surface-elevated) 30%, var(--bg-primary));
    border-top: 1px solid var(--border-subtle);
  }

  .contact-card {
    position: relative;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 3.5rem 3rem;
    text-align: center;
    overflow: hidden;
    box-shadow: 0 16px 36px -12px rgba(0, 0, 0, 0.15);
  }

  .contact-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--accent-amber);
  }

  .contact-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 0.85rem;
  }

  .badge-icon {
    color: var(--accent-emerald);
  }

  .contact-title {
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-size: clamp(2.2rem, 4.5vw, 3.8rem);
    font-weight: 300;
    color: var(--text-main);
    letter-spacing: -0.03em;
    max-width: 780px;
    margin: 0 auto 1rem;
    line-height: 1.05;
  }

  .contact-subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 650px;
    margin: 0 auto 2.5rem;
    line-height: 1.7;
  }

  .contact-meta-bar {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .status-pill, .location-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-main);
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius-sm);
  }

  .status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--accent-emerald);
    box-shadow: 0 0 8px var(--accent-emerald);
  }

  .location-icon {
    color: var(--accent-cyan);
  }

  .cta-action-wrapper {
    margin-bottom: 3.5rem;
  }

  .btn-cta-main {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 2.2rem;
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-family: var(--font-mono);
    font-size: 1rem;
    /* Flat fill in the narrow-purpose "available/production" color, not
       a gradient — this button signals status, it doesn't decorate. */
    background: var(--accent-emerald);
    color: #0a120e;
    transition: transform var(--transition);
  }

  .btn-cta-main:hover {
    transform: translateY(-2px);
  }

  .arrow-icon {
    transition: transform var(--transition);
  }

  .btn-cta-main:hover .arrow-icon {
    transform: translateX(4px);
  }

  .channels-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    max-width: 960px;
    margin: 0 auto;
    border-top: 1px solid var(--border-subtle);
    padding-top: 2.5rem;
  }

  .channel-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.9rem 1.1rem;
    text-align: left;
    transition: border-color var(--transition), transform var(--transition), background var(--transition);
  }

  .channel-item:hover {
    border-color: var(--accent-amber);
    transform: translateY(-2px);
    background: color-mix(in srgb, var(--accent-amber) 6%, var(--bg-surface-elevated));
  }

  .channel-icon-wrap {
    width: 2.2rem;
    height: 2.2rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--accent-amber) 12%, transparent);
    color: var(--accent-amber);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .channel-info {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .channel-name {
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .channel-value {
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 768px) {
    .contact-card {
      padding: 2.5rem 1.5rem;
    }
    .contact-title {
      font-size: 1.7rem;
    }
    .contact-meta-bar {
      flex-direction: column;
      align-items: center;
      gap: 0.6rem;
    }
  }
</style>
