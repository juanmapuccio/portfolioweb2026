---
import type { Lang } from '../i18n/ui';
import { contactData, CV_URL } from '../data/contact';
import { ArrowUpRight, ArrowDown } from 'lucide-astro';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = contactData[lang];
const t = useTranslations(lang);
const location = lang === 'es' ? 'Rosario, Argentina' : lang === 'en' ? 'Rosario, Argentina' : 'Rosário, Argentina';
const whatsappLabel = lang === 'es' ? 'CONVERSAR POR WHATSAPP' : lang === 'en' ? 'CHAT ON WHATSAPP' : 'CONVERSAR PELO WHATSAPP';
const cvLabel = lang === 'es' ? 'DESCARGAR CV' : lang === 'en' ? 'DOWNLOAD CV' : 'BAIXAR CV';
---

<section id="contacto" class="contact-section" aria-labelledby="contact-title">
  <div class="container contact-container">
    <div class="contact-intro">
      <p class="contact-eyebrow"><span class="status-dot" aria-hidden="true"></span>{data.badge}</p>
      <h2 id="contact-title" class="contact-title">{data.title}</h2>
      <p class="contact-subtitle">{data.subtitle}</p>
      <div class="contact-actions">
        <a href="https://wa.me/5493413192179" target="_blank" rel="noopener noreferrer" class="contact-action action-primary">
          {whatsappLabel}<ArrowUpRight size={17} aria-hidden="true" />
        </a>
        <a href={CV_URL} target="_blank" rel="noopener noreferrer" class="contact-action action-secondary">
          {cvLabel}<ArrowUpRight size={17} aria-hidden="true" />
        </a>
      </div>
    </div>

    <nav class="contact-rows" aria-label={lang === 'es' ? 'Canales de contacto' : lang === 'en' ? 'Contact channels' : 'Canais de contato'}>
      {data.channels.map((channel) => (
        <a
          class="contact-row"
          href={channel.url}
          target={channel.id === 'email' ? undefined : '_blank'}
          rel={channel.id === 'email' ? undefined : 'noopener noreferrer'}
          aria-label={`${channel.name}: ${channel.label}`}
        >
          <span class="contact-row-label">{channel.name}</span>
          <span class="contact-row-value">{channel.label}<ArrowUpRight size={20} aria-hidden="true" /></span>
        </a>
      ))}
    </nav>

    <footer class="contact-footer">
      <span>{location}</span>
      <span>© 2026 Juan Manuel Puccio</span>
    </footer>
  </div>
</section>

<!-- Mobile-only shortcut to the contact section. Hidden while the section is in view. -->
<a href="#contacto" class="contact-shortcut" data-contact-shortcut aria-hidden="true" tabindex="-1">
  {t('contact.shortcut')}<ArrowDown size={16} aria-hidden="true" />
</a>

<script>
  function initContactShortcut() {
    const shortcut = document.querySelector<HTMLAnchorElement>('[data-contact-shortcut]');
    const target = document.getElementById('contacto');
    if (!shortcut || !target || shortcut.dataset.ready === 'true') return;
    shortcut.dataset.ready = 'true';

    let pastIntro = false;
    let contactInView = false;

    const render = () => {
      const visible = pastIntro && !contactInView;
      shortcut.classList.toggle('is-visible', visible);
      shortcut.setAttribute('aria-hidden', visible ? 'false' : 'true');
      shortcut.tabIndex = visible ? 0 : -1;
    };

    // Appears once the hero (which has its own contact CTAs) has scrolled away.
    const onScroll = () => {
      const next = window.scrollY > window.innerHeight * 0.8;
      if (next !== pastIntro) {
        pastIntro = next;
        render();
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        contactInView = entries.some((entry) => entry.isIntersecting);
        render();
      },
      { threshold: 0.05 }
    );
    observer.observe(target);

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactShortcut);
  } else {
    initContactShortcut();
  }
</script>

<style>
  .contact-section {
    padding: clamp(5rem, 10vw, 10rem) 0 max(2rem, env(safe-area-inset-bottom));
    background: #1c1a17;
    color: #f2eee6;
  }
  .contact-container { max-width: 1600px; }
  .contact-intro { max-width: 57rem; }
  .contact-eyebrow, .contact-row-label, .contact-action, .contact-footer {
    font-family: var(--font-mono, monospace);
  }
  .contact-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 1.5rem;
    color: #d2cbbf;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
  }
  .status-dot { width: 0.48rem; height: 0.48rem; flex: 0 0 auto; border-radius: 50%; background: #6d9c73; }
  .contact-title {
    max-width: 16ch;
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(3rem, 7vw, 6.7rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 0.98;
    text-wrap: balance;
  }
  .contact-subtitle {
    max-width: 66ch;
    margin-top: 1.6rem;
    color: #d2cbbf;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.7;
  }
  .contact-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2.3rem; }
  .contact-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    min-height: 3.4rem;
    padding: 0.9rem 1.2rem;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease;
  }
  .action-primary { background: #f2eee6; color: #1c1a17; border: 1px solid #f2eee6; }
  .action-secondary { color: #f2eee6; border: 1px solid rgba(242, 238, 230, 0.5); }
  .action-primary:hover { background: #d9d1c3; border-color: #d9d1c3; }
  .action-secondary:hover { background: rgba(242, 238, 230, 0.1); }
  .contact-action:focus-visible, .contact-row:focus-visible { outline: 2px solid #b6d3b8; outline-offset: 5px; }

  .contact-rows { margin-top: clamp(5rem, 10vw, 10rem); border-top: 1px solid rgba(242, 238, 230, 0.32); }
  .contact-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 6.3rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid rgba(242, 238, 230, 0.25);
    transition: color 180ms ease;
  }
  .contact-row:hover { color: #c9d8c7; }
  .contact-row-label { color: #c6bfb3; font-size: 0.68rem; letter-spacing: 0.06em; }
  .contact-row-value {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(1.35rem, 3vw, 2.35rem);
    line-height: 1.2;
    overflow-wrap: anywhere;
    text-align: right;
  }
  .contact-row-value :global(svg) { flex: 0 0 auto; }
  .contact-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    color: #c6bfb3;
    font-size: 0.65rem;
    letter-spacing: 0.03em;
  }
  .contact-shortcut { display: none; }

  @media (max-width: 640px) {
    .contact-actions { flex-direction: column; align-items: stretch; }
    .contact-action { width: 100%; min-height: 3.5rem; }
    .contact-row { align-items: flex-start; flex-direction: column; gap: 0.6rem; min-height: 3.5rem; }
    .contact-row-value { text-align: left; }
    .contact-footer { flex-direction: column; }
  }
  @media (max-width: 767px) {
    .contact-section { padding-top: 4rem; }
    .contact-actions { margin-top: 1.75rem; }
    .contact-rows { margin-top: 3rem; }
    .contact-row { padding: 1rem 0; }

    .contact-shortcut {
      position: fixed;
      right: max(1rem, env(safe-area-inset-right));
      bottom: max(1rem, env(safe-area-inset-bottom));
      z-index: 40;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 44px;
      min-width: 44px;
      padding: 0 1rem;
      background: #1c1a17;
      color: #f2eee6;
      border: 1px solid rgba(242, 238, 230, 0.35);
      box-shadow: 0 6px 16px rgba(28, 26, 23, 0.28);
      font-family: var(--font-mono, monospace);
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      opacity: 0;
      transform: translateY(8px);
      visibility: hidden;
      pointer-events: none;
      transition: opacity 220ms cubic-bezier(0.16, 1, 0.3, 1), transform 220ms cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 220ms;
    }
    .contact-shortcut.is-visible {
      opacity: 1;
      transform: none;
      visibility: visible;
      pointer-events: auto;
      transition-delay: 0s;
    }
    .contact-shortcut:focus-visible { outline: 2px solid #b6d3b8; outline-offset: 3px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-action, .contact-row, .contact-shortcut { transition: none; }
    .contact-shortcut { transform: none; }
  }
</style>
