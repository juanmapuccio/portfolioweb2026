---
import type { Lang } from '../i18n/ui';
import { projectsContent, automationsContent } from '../data/projects';
import { ShieldCheck, Zap } from 'lucide-astro';
import ArchitectureDiagram from './ArchitectureDiagram.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const projects = projectsContent[lang];
const auto = automationsContent[lang];
---

<section id="proyectos" class="projects-scrolly-section">
  <!-- Encabezado editorial oscuro -->
  <div class="projects-intro" data-reveal>
    <div class="intro-badge">
      <span class="mono-badge">{lang === 'es' ? 'PRODUCCIÓN VIVA' : lang === 'en' ? 'LIVE PRODUCTION' : 'PRODUÇÃO VIVA'}</span>
    </div>
    <h2 class="intro-title">
      {lang === 'es' ? 'Sistemas en Producción & Casos Reales' : lang === 'en' ? 'Live Production Systems & Real Cases' : 'Sistemas em Produção & Casos Reais'}
    </h2>
    <p class="intro-subtitle">
      {lang === 'es' 
        ? 'Proyectos desplegados en clientes reales, resolviendo problemas de software, logística y operación.' 
        : lang === 'en' 
        ? 'Software deployed for real business clients, solving operational bottlenecks and logistics.' 
        : 'Projetos implantados em clientes reais, resolvendo problemas de software, logística e operações.'}
    </p>
  </div>

  <!-- Escenas pinned de proyectos estilo Claude Design -->
  <div class="projects-pinned-container">
    <!-- Franja negra con barras de dan: una se enciende por proyecto visto -->
    <div class="dan-band" aria-hidden="true">
      <div class="dan-bars" data-dan-bars>
        {projects.map(() => <span class="dan-bar"></span>)}
      </div>
    </div>
    {projects.map((pr, index) => {
      const num = String(index + 1).padStart(2, '0');
      const total = String(projects.length).padStart(2, '0');

      return (
        <div class="project-scene" data-project-scene id={`project-scene-${pr.id}`}>
          <div class="project-sticky-wrapper">
            <!-- Header superior del proyecto -->
            <header class="project-topbar">
              <div class="project-title-group">
                <span class="project-seq-meta">
                  {num} / {total} · {pr.badge}
                </span>
                <h3 class="project-display-title">{pr.name}</h3>
              </div>
              <div class="project-role-group">
                <span class="project-role-text">{pr.role}</span>
                <a 
                  href={pr.url} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="project-live-link"
                  aria-label={lang === 'es' ? `Ver ${pr.name} en vivo` : lang === 'en' ? `Visit ${pr.name} live` : `Ver ${pr.name} ao vivo`}
                >
                  <span>{lang === 'es' ? 'Ver en vivo' : lang === 'en' ? 'Visit live' : 'Ver ao vivo'} ↗</span>
                </a>
              </div>
            </header>

            <!-- Grid: Technical Mockup UI + Scrollytelling de Fricción / Solución / Impacto -->
            <div class="project-grid-main">
              <!-- Technical Wireframe / Blueprint Display -->
              <div class="project-visual-col">
                <details class="project-tech-detail" open>
                <summary class="project-tech-summary">
                  {lang === 'es' ? 'Ver detalle técnico' : lang === 'en' ? 'View technical detail' : 'Ver detalhe técnico'}
                </summary>
                <div class="mockup-frame technical-blueprint">
                  <div class="blueprint-window-header">
                    <div class="window-controls">
                      <span class="dot-ctrl"></span>
                      <span class="dot-ctrl"></span>
                      <span class="dot-ctrl"></span>
                    </div>
                    <div class="window-title-address">
                      <span class="address-lock">🔒</span>
                      <span class="address-text">{pr.url.replace('https://', '')}</span>
                    </div>
                    <div class="window-status-pill">
                      <span class="pulse-dot"></span>
                      <span>HTTP 200 OK</span>
                    </div>
                  </div>

                  <div class="blueprint-inner-body">
                    <div class="blueprint-sys-meta">
                      <span class="sys-id">SYSTEM_ID // {pr.id.toUpperCase()}_CORE</span>
                      <span class="sys-env">ENV: PRODUCTION</span>
                    </div>
                    
                    <div class="blueprint-metric-grid">
                      <div class="blueprint-metric-card">
                        <span class="metric-label">{lang === 'es' ? 'DISPONIBILIDAD' : lang === 'en' ? 'UPTIME' : 'DISPONIBILIDADE'}</span>
                        <span class="metric-val">99.98%</span>
                      </div>
                      <div class="blueprint-metric-card">
                        <span class="metric-label">{lang === 'es' ? 'LATENCIA CORE' : lang === 'en' ? 'CORE LATENCY' : 'LATÊNCIA CORE'}</span>
                        <span class="metric-val">&lt; 45ms</span>
                      </div>
                      <div class="blueprint-metric-card">
                        <span class="metric-label">{lang === 'es' ? 'INFRAESTRUCTURA' : lang === 'en' ? 'INFRA' : 'INFRAESTRUTURA'}</span>
                        <span class="metric-val">{pr.tech[0]}</span>
                      </div>
                    </div>

                    <div class="blueprint-terminal-box">
                      <div class="terminal-line"><span class="cmd-prompt">&gt;</span> <span class="cmd-run">target --verify</span> <span class="cmd-arg">{pr.name}</span></div>
                      <div class="terminal-line text-muted">&gt; status: active · automated checks passing</div>
                      <div class="terminal-line text-highlight">&gt; scope: {pr.category}</div>
                    </div>

                    <div class="blueprint-circuit-grid">
                      <div class="circuit-node">NODE_01: API_ROUTER [READY]</div>
                      <div class="circuit-divider"></div>
                      <div class="circuit-node">NODE_02: DB_PERSISTENCE [SYNC]</div>
                      <div class="circuit-divider"></div>
                      <div class="circuit-node">NODE_03: BUSINESS_RULES [LIVE]</div>
                    </div>
                  </div>

                  <div class="screen-tag">
                    <span class="pulse-dot"></span>
                    <span>ACTIVE · {pr.id}</span>
                  </div>
                </div>
                </details>
              </div>

              <!-- Pasos de Scrollytelling interactivo -->
              <div class="project-narrative-col">
                <!-- Barras de progreso de los 3 pasos -->
                <div class="narrative-progress-bars">
                  <div class="step-prog-item" data-step-prog="0">
                    <span class="step-label">{lang === 'es' ? '01 Fricción' : lang === 'en' ? '01 Bottleneck' : '01 Fricção'}</span>
                    <div class="prog-track"><div class="prog-bar bar-amber"></div></div>
                  </div>
                  <div class="step-prog-item" data-step-prog="1">
                    <span class="step-label">{lang === 'es' ? '02 Solución' : lang === 'en' ? '02 Solution' : '02 Solução'}</span>
                    <div class="prog-track"><div class="prog-bar bar-white"></div></div>
                  </div>
                  <div class="step-prog-item" data-step-prog="2">
                    <span class="step-label">{lang === 'es' ? '03 Impacto' : lang === 'en' ? '03 Impact' : '03 Impacto'}</span>
                    <div class="prog-track"><div class="prog-bar bar-emerald"></div></div>
                  </div>
                </div>

                <!-- Textos superpuestos con fade de transición -->
                <div class="narrative-content-slot">
                  <div class="narrative-pane pane-friction active" data-pane="0">
                    <div class="pane-meta text-amber">{lang === 'es' ? 'Fricción operativa' : lang === 'en' ? 'Operational bottleneck' : 'Fricção operacional'}</div>
                    <p class="pane-text">"{pr.problem}"</p>
                  </div>
                  <div class="narrative-pane pane-solution" data-pane="1">
                    <div class="pane-meta text-white">{lang === 'es' ? 'Solución de ingeniería' : lang === 'en' ? 'Engineering solution' : 'Solução de engenharia'}</div>
                    <p class="pane-text">"{pr.solution}"</p>
                  </div>
                  <div class="narrative-pane pane-impact" data-pane="2">
                    <div class="pane-meta text-emerald">{lang === 'es' ? 'Impacto medible' : lang === 'en' ? 'Measured impact' : 'Impacto mensurável'}</div>
                    <p class="pane-text highlight-impact">"{pr.impact}"</p>
                  </div>
                </div>

                <!-- Tags de tecnologías utilizadas -->
                <div class="narrative-tech-row">
                  {pr.tech.map((t) => (
                    <span class="tech-pill">{t}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <!-- Automatizaciones & Bots de Negocio -->
  <div class="automations-wrapper container">
    <div class="auto-header" data-reveal>
      <span class="mono-badge">
        {lang === 'es' ? 'RESOLVIENDO CUELLOS DE BOTELLA REALES' : lang === 'en' ? 'SOLVING REAL BOTTLENECKS' : 'RESOLVENDO GARGALOS REAIS'}
      </span>
      <h3 class="auto-display-title">{auto.title}</h3>
      <p class="auto-display-sub">{auto.subtitle}</p>
    </div>

    <div class="auto-cards-grid">
      <div class="auto-editorial-card" data-reveal>
        <div class="card-icon-line">
          <Zap class="text-amber" size={20} />
          <h4 class="auto-item-name">{auto.bot1Title}</h4>
        </div>
        <p class="auto-item-text">{auto.bot1Desc}</p>
        <div class="auto-metric-tag">
          <span class="metric-arrow">→</span>
          <span class="metric-body">{auto.bot1Metric}</span>
        </div>
      </div>

      <div class="auto-editorial-card" data-reveal style="--reveal-delay: 1">
        <div class="card-icon-line">
          <ShieldCheck class="text-emerald" size={20} />
          <h4 class="auto-item-name">{auto.bot2Title}</h4>
        </div>
        <p class="auto-item-text">{auto.bot2Desc}</p>
        <div class="auto-metric-tag">
          <span class="metric-arrow">→</span>
          <span class="metric-body">{auto.bot2Metric}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Pipeline de Arquitectura en Producción (Cloud & Edge) -->
  <div class="architecture-wrapper container">
    <ArchitectureDiagram lang={lang} />
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  import { initResponsiveDetails } from '../scripts/responsiveDetails';

  gsap.registerPlugin(ScrollTrigger);

  // Dan bars: each project scene entering view lights the next bar (once).
  function setupDanBars() {
    const bars = document.querySelectorAll<HTMLElement>('[data-dan-bars] .dan-bar');
    const scenes = document.querySelectorAll<HTMLElement>('.project-scene[data-project-scene]');
    if (!bars.length || !scenes.length) return;

    if (!('IntersectionObserver' in window)) {
      bars.forEach((bar) => bar.classList.add('is-lit'));
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const index = Array.from(scenes).indexOf(entry.target as HTMLElement);
          // Light every bar up to this project so skipping ahead stays coherent.
          bars.forEach((bar, i) => {
            if (i <= index) bar.classList.add('is-lit');
          });
          io.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -30% 0px', threshold: 0 }
    );
    scenes.forEach((scene) => io.observe(scene));
  }

  function setupProjectScrolly() {
    initResponsiveDetails('.project-tech-detail');
    setupDanBars();
    const scenes = document.querySelectorAll<HTMLElement>('.project-scene[data-project-scene]');
    if (!scenes.length) return;

    scenes.forEach((scene) => {
      const bars = scene.querySelectorAll<HTMLElement>('.prog-bar');
      const panes = scene.querySelectorAll<HTMLElement>('.narrative-pane');

      ScrollTrigger.create({
        trigger: scene,
        start: 'top top',
        end: 'bottom bottom',
        scrub: true,
        onUpdate: (self) => {
          const p = self.progress;

          // Bar 0: Friction (0 -> 0.33)
          const p0 = Math.min(1, Math.max(0, p * 3.1));
          // Bar 1: Solution (0.33 -> 0.66)
          const p1 = Math.min(1, Math.max(0, (p - 0.33) * 3.1));
          // Bar 2: Impact (0.66 -> 1)
          const p2 = Math.min(1, Math.max(0, (p - 0.66) * 3.1));

          if (bars[0]) bars[0].style.width = `${p0 * 100}%`;
          if (bars[1]) bars[1].style.width = `${p1 * 100}%`;
          if (bars[2]) bars[2].style.width = `${p2 * 100}%`;

          // Switch active pane based on progress thirds
          let activeIndex = 0;
          if (p >= 0.64) activeIndex = 2;
          else if (p >= 0.31) activeIndex = 1;

          panes.forEach((pane, idx) => {
            if (idx === activeIndex) {
              pane.classList.add('active');
            } else {
              pane.classList.remove('active');
            }
          });
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupProjectScrolly);
  } else {
    setupProjectScrolly();
  }
</script>

<style>
  .projects-scrolly-section {
    background: #1c1a17;
    color: #f2eee6;
    margin-top: -1px;
    padding-bottom: 8rem;
    position: relative;
    border-top: 1px solid rgba(242, 238, 230, 0.12);
  }

  .container {
    max-width: var(--max-width, 1200px);
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 48px);
  }

  /* Intro Section */
  .projects-intro {
    padding: clamp(80px, 14vh, 140px) clamp(20px, 5vw, 72px) clamp(40px, 8vh, 80px);
    max-width: 1000px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    text-align: left;
  }

  .intro-badge {
    margin-bottom: 0.25rem;
  }

  .mono-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #b3ab9d;
    display: inline-block;
  }

  .intro-title {
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 300;
    font-size: clamp(2.4rem, 5.5vw, 5.2rem);
    line-height: 0.96;
    letter-spacing: -0.04em;
    color: #f2eee6;
    margin: 0;
  }

  .intro-subtitle {
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    color: #cfc7b8;
    max-width: 640px;
    line-height: 1.6;
    margin: 0;
  }


  /* Dan band: black strip pinned under the header while browsing projects */
  .dan-band {
    position: sticky;
    top: 60px;
    z-index: 5;
    height: 14px;
    background: #1c1a17;
    display: flex;
    align-items: center;
    padding: 0 clamp(20px, 5vw, 72px);
    pointer-events: none;
  }

  .dan-bars {
    display: flex;
    gap: 6px;
  }

  .dan-bar {
    width: 28px;
    height: 4px;
    background: rgba(242, 238, 230, 0.16);
    transition: background-color 0.5s ease;
  }

  .dan-bar.is-lit {
    background: oklch(0.84 0.15 90);
  }

  @media (prefers-reduced-motion: reduce) {
    .dan-bar {
      transition: none;
    }
  }

  /* One markup: details stay open and the summary is hidden on desktop. */
  .project-tech-detail {
    width: 100%;
  }

  .project-tech-summary {
    display: none;
  }

  /* Pinned Scrollytelling Scenes */
  .projects-pinned-container {
    display: flex;
    flex-direction: column;
  }

  .project-scene {
    height: 280vh;
    position: relative;
    border-top: 1px solid rgba(242, 238, 230, 0.12);
  }

  .project-sticky-wrapper {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(70px, 11vh, 90px) clamp(20px, 5vw, 72px) clamp(30px, 5vh, 48px);
    box-sizing: border-box;
  }

  .project-topbar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .project-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .project-seq-meta {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #b3ab9d;
  }

  .project-display-title {
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 300;
    font-size: clamp(2.8rem, 6vw, 6.5rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
    color: #f2eee6;
    margin: 0;
  }

  .project-role-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    align-items: flex-start;
  }

  .project-role-text {
    font-size: 1rem;
    font-weight: 600;
    color: #f2eee6;
  }

  .project-live-link {
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    color: #b3ab9d;
    text-decoration: none;
    border-bottom: 1px solid rgba(179, 171, 157, 0.4);
    padding-bottom: 2px;
    transition: color 0.2s, border-color 0.2s;
  }

  .project-live-link:hover {
    color: #f2eee6;
    border-color: #f2eee6;
  }

  /* Grid Layout: Visual on Left, Steps on Right */
  .project-grid-main {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
  }

  .project-visual-col {
    height: 100%;
    min-height: 0;
    display: flex;
    align-items: center;
  }

  .mockup-frame {
    position: relative;
    width: 100%;
    min-height: clamp(280px, 46vh, 480px);
    background: #141210;
    border: 1px solid rgba(242, 238, 230, 0.16);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
  }

  .technical-blueprint {
    font-family: var(--font-mono, monospace);
  }

  .blueprint-window-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1rem;
    background: rgba(242, 238, 230, 0.04);
    border-bottom: 1px solid rgba(242, 238, 230, 0.1);
  }

  .window-controls {
    display: flex;
    gap: 0.35rem;
  }

  .dot-ctrl {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(242, 238, 230, 0.2);
  }

  .window-title-address {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    color: #b3ab9d;
    background: rgba(0, 0, 0, 0.3);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    border: 1px solid rgba(242, 238, 230, 0.08);
  }

  .window-status-pill {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.68rem;
    color: #34d399;
  }

  .blueprint-inner-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    flex: 1;
  }

  .blueprint-sys-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.68rem;
    color: #8c8375;
    letter-spacing: 0.05em;
    border-bottom: 1px dashed rgba(242, 238, 230, 0.1);
    padding-bottom: 0.5rem;
  }

  .blueprint-metric-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6rem;
  }

  .blueprint-metric-card {
    background: rgba(242, 238, 230, 0.02);
    border: 1px solid rgba(242, 238, 230, 0.08);
    padding: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .metric-label {
    font-size: 0.6rem;
    color: #8c8375;
    letter-spacing: 0.06em;
  }

  .metric-val {
    font-size: 0.95rem;
    font-weight: 700;
    color: #f2eee6;
  }

  .blueprint-terminal-box {
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(242, 238, 230, 0.08);
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.72rem;
  }

  .cmd-prompt {
    color: #e27d60;
  }

  .cmd-run {
    color: #f2eee6;
  }

  .cmd-arg {
    color: #34d399;
  }

  .text-muted {
    color: #8c8375;
  }

  .text-highlight {
    color: #e6b89c;
  }

  .blueprint-circuit-grid {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.65rem;
    color: #71695d;
  }

  .circuit-node {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .circuit-divider {
    height: 1px;
    background: rgba(242, 238, 230, 0.06);
    margin: 0.1rem 0;
  }

  .screen-tag {
    position: absolute;
    top: 14px;
    left: 14px;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: #f2eee6;
    background: rgba(28, 26, 23, 0.85);
    border: 1px solid rgba(242, 238, 230, 0.2);
    padding: 0.3rem 0.6rem;
    backdrop-filter: blur(4px);
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: oklch(0.58 0.12 150);
    box-shadow: 0 0 6px oklch(0.58 0.12 150);
  }

  /* Narrative Scrollytelling Column */
  .project-narrative-col {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    justify-content: center;
    padding-left: clamp(0px, 2vw, 24px);
  }

  .narrative-progress-bars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .step-prog-item {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .step-label {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #b3ab9d;
  }

  .prog-track {
    height: 2px;
    background: rgba(242, 238, 230, 0.16);
    overflow: hidden;
  }

  .prog-bar {
    height: 100%;
    width: 0%;
    transition: width 0.1s linear;
  }

  .bar-amber { background: oklch(0.84 0.15 90); }
  .bar-white { background: #f2eee6; }
