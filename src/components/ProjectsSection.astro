---
import type { Lang } from '../i18n/ui';
import { projectsContent, automationsContent } from '../data/projects';
import ArchitectureDiagram from './ArchitectureDiagram.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const projects = projectsContent[lang];
const auto = automationsContent[lang];
---

<!-- Horizontal Pinned Track: Casos Reales en Producción -->
<section
  id="proyectos"
  data-fx="h"
  data-zone="h"
  data-ch="6"
  class="projects-horizontal-section"
>
  <div class="projects-sticky-frame">
    <div data-track class="projects-track-rail">
      <!-- Lead Intro Card -->
      <div class="project-track-intro">
        <span class="mono-badge">
          {lang === 'es' ? 'SISTEMAS EN PRODUCCIÓN' : lang === 'en' ? 'LIVE PRODUCTION SYSTEMS' : 'SISTEMAS EM PRODUÇÃO'}
        </span>
        <h2 class="project-track-title">
          {lang === 'es' ? 'Casos Reales, Código Vivo' : lang === 'en' ? 'Real Cases, Living Code' : 'Casos Reais, Código Vivo'}
        </h2>
        <p class="project-track-desc">
          {lang === 'es'
            ? 'Sistemas desplegados en clientes reales, resolviendo problemas de software, logística y operación con usuarios activos.'
            : lang === 'en'
            ? 'Systems deployed for real clients, solving software, logistics, and operational problems with active users.'
            : 'Sistemas implantados em clientes reais, resolvendo problemas de software, logística e operações com usuários ativos.'}
        </p>
      </div>

      <!-- 4 Project Cards -->
      {projects.map((pr, idx) => {
        const num = String(idx + 1).padStart(2, '0');
        return (
          <article class="project-editorial-card">
            <header class="project-card-topbar">
              <span class="project-card-num-badge">
                {num} · {pr.badge}
              </span>
              <span class="project-card-status">
                <span class="status-pulse-dot"></span>
                <span>{lang === 'es' ? 'Activo · Producción' : lang === 'en' ? 'Active · Production' : 'Ativo · Produção'}</span>
              </span>
            </header>

            <div class="project-card-center">
              <h3 class="project-card-name">{pr.name}</h3>
              <div class="project-card-role-meta">
                {pr.role} · {pr.category}
              </div>
              <p class="project-card-description">{pr.description}</p>
            </div>

            <div class="project-card-footer">
              <div class="project-card-columns">
                <div class="metric-col metric-friction">
                  <span class="metric-col-label">{lang === 'es' ? '01 Fricción' : lang === 'en' ? '01 Bottleneck' : '01 Fricção'}</span>
                  <span class="metric-col-val">{pr.problem}</span>
                </div>
                <div class="metric-col metric-solution">
                  <span class="metric-col-label">{lang === 'es' ? '02 Solución' : lang === 'en' ? '02 Solution' : '02 Solução'}</span>
                  <span class="metric-col-val">{pr.solution}</span>
                </div>
                <div class="metric-col metric-impact">
                  <span class="metric-col-label">{lang === 'es' ? '03 Impacto' : lang === 'en' ? '03 Impact' : '03 Impacto'}</span>
                  <span class="metric-col-val">{pr.impact}</span>
                </div>
              </div>

              <div class="project-card-action-row">
                <div class="project-card-tech-pills">
                  {pr.tech.map((t) => (
                    <span class="tech-tag-mono">{t}</span>
                  ))}
                </div>
                <a
                  href={pr.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-live-btn"
                  aria-label={lang === 'es' ? `Ver ${pr.name} en vivo` : lang === 'en' ? `Visit ${pr.name} live` : `Ver ${pr.name} ao vivo`}
                >
                  {lang === 'es' ? 'Ver en vivo ↗' : lang === 'en' ? 'Visit live ↗' : 'Ver ao vivo ↗'}
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Scrollytelling Progress Bar -->
    <div class="projects-progress-track">
      <div class="projects-progress-bar"></div>
    </div>
  </div>
</section>

<!-- Automatizaciones & Bots de Negocio -->
<section data-zone="dark" data-ch="6" class="automations-section">
  <div class="automations-container">
    <div class="automations-header">
      <div class="automations-meta">
        <span class="mono-badge">
          {lang === 'es' ? 'RESOLVIENDO CUELLOS DE BOTELLA REALES' : lang === 'en' ? 'SOLVING REAL BOTTLENECKS' : 'RESOLVENDO GARGALOS REAIS'}
        </span>
        <h2 class="automations-title">{auto.title}</h2>
      </div>
      <p class="automations-subtitle">{auto.subtitle}</p>
    </div>

    <div class="automations-grid">
      <!-- Bot 1: Python Bank Parser -->
      <article class="auto-card">
        <span class="auto-badge badge-py">py</span>
        <h3 class="auto-card-title">{auto.bot1Title}</h3>
        <p class="auto-card-desc">{auto.bot1Desc}</p>
        <div class="auto-card-metric">
          <span class="metric-arrow">→</span>
          <strong>{auto.bot1Metric}</strong>
        </div>
      </article>

      <!-- Bot 2: ARCA Electronic Invoicing -->
      <article class="auto-card">
        <span class="auto-badge badge-arca">ARCA</span>
        <h3 class="auto-card-title">{auto.bot2Title}</h3>
        <p class="auto-card-desc">{auto.bot2Desc}</p>
        <div class="auto-card-metric">
          <span class="metric-arrow">→</span>
          <strong>{auto.bot2Metric}</strong>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- Pipeline de Arquitectura en Producción (Cloud & Edge) -->
<section data-zone="dark" data-ch="6" class="architecture-section">
  <div class="architecture-container">
    <ArchitectureDiagram lang={lang} />
  </div>
</section>

<style>
  /* Base Dark Container */
  .projects-horizontal-section {
    height: 400vh;
    position: relative;
    background: #1c1a17;
    color: #f2eee6;
    margin-top: -1px;
    box-sizing: border-box;
  }

  .projects-sticky-frame {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: center;
    background: #1c1a17;
  }

  .projects-track-rail {
    display: flex;
    gap: clamp(20px, 3vw, 44px);
    padding: 0 clamp(20px, 5vw, 72px);
    will-change: transform;
    align-items: center;
  }

  /* Intro Card in Track */
  .project-track-intro {
    flex: none;
    width: min(440px, 80vw);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
  }

  .mono-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c9c3b7;
  }

  .project-track-title {
    margin: 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 300;
    font-size: clamp(38px, 4.4vw, 74px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: #f2eee6;
  }

  .project-track-desc {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: #c9c3b7;
    max-width: 400px;
  }

  /* Editorial Project Card */
  .project-editorial-card {
    flex: none;
    width: min(980px, 68vw);
    height: min(76vh, 720px);
    background: #25221e;
    color: #f2eee6;
    border: 1px solid rgba(242, 238, 230, 0.12);
    box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.6);
    padding: clamp(20px, 2.4vw, 36px);
    box-sizing: border-box;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 18px;
    border-radius: 3px;
  }

  @media (max-width: 899px) {
    .project-editorial-card {
      width: 88vw;
      height: min(82vh, 640px);
      padding: 20px;
    }
  }

  .project-card-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #a8a29e;
  }

  .project-card-status {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #f2eee6;
  }

  .status-pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: oklch(0.58 0.12 150);
  }

  .project-card-center {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
  }

  .project-card-name {
    margin: 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 400;
    font-size: clamp(42px, 5.2vw, 92px);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: #f2eee6;
  }

  .project-card-role-meta {
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    font-weight: 600;
    color: #fbbf24;
  }

  .project-card-description {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: #c9c3b7;
    max-width: 640px;
  }

  .project-card-footer {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* 3 Metric Columns with Colored Accent Borders */
  .project-card-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 14px;
  }

  .metric-col {
    padding-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .metric-friction {
    border-top: 3px solid oklch(0.84 0.15 90);
  }

  .metric-solution {
    border-top: 3px solid #38bdf8;
  }

  .metric-impact {
    border-top: 3px solid oklch(0.58 0.12 150);
  }

  .metric-col-label {
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    font-weight: 600;
    color: #a8a29e;
  }

  .metric-col-val {
    font-size: 13.5px;
    line-height: 1.45;
    color: #e5e0d8;
  }

  .project-card-action-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    border-top: 1px solid rgba(242, 238, 230, 0.12);
    padding-top: 14px;
  }

  .project-card-tech-pills {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .tech-tag-mono {
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    color: #c9c3b7;
    background: rgba(242, 238, 230, 0.08);
    border: 1px solid rgba(242, 238, 230, 0.1);
    padding: 2px 7px;
    border-radius: 2px;
  }

  .project-live-btn {
    background: #f2eee6;
    color: #1c1a17;
    padding: 10px 18px;
    text-decoration: none;
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 2px;
    transition: background 0.2s ease, transform 0.2s ease, color 0.2s ease;
  }

  .project-live-btn:hover {
    background: #fbbf24;
    color: #1c1a17;
    transform: translateY(-1px);
  }

  /* Scrolly Progress Bar */
  .projects-progress-track {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 4px;
    width: 100%;
    background: rgba(242, 238, 230, 0.1);
  }

  .projects-progress-bar {
    height: 100%;
    width: 100%;
    background: #f2eee6;
    transform-origin: 0 50%;
    transform: scaleX(var(--p, 0));
  }

  /* Section: Automatizaciones & Bots de Negocio */
  .automations-section {
    background: #1c1a17;
    color: #f2eee6;
    padding: clamp(80px, 12vh, 130px) clamp(20px, 5vw, 72px);
    border-top: 1px solid rgba(242, 238, 230, 0.14);
    box-sizing: border-box;
  }

  .automations-container {
    max-width: 1600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .automations-header {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 24px;
    align-items: end;
  }

  .automations-meta {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .automations-title {
    margin: 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 300;
    font-size: clamp(34px, 4vw, 64px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: #f2eee6;
  }

  .automations-subtitle {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: #c9c3b7;
  }

  .automations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 1px;
    background: rgba(242, 238, 230, 0.18);
    border: 1px solid rgba(242, 238, 230, 0.18);
  }

  .auto-card {
    background: #1c1a17;
    padding: clamp(24px, 3.5vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .auto-badge {
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    font-weight: 600;
    align-self: flex-start;
    padding: 3px 8px;
  }

  .badge-py {
    color: #1c1a17;
    background: oklch(0.84 0.15 90);
  }

  .badge-arca {
    color: #1c1a17;
    background: #f2eee6;
  }

  .auto-card-title {
    margin: 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 400;
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.15;
    color: #f2eee6;
  }

  .auto-card-desc {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: #c9c3b7;
  }

  .auto-card-metric {
    margin-top: auto;
    padding-top: 10px;
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 15px;
    color: #f2eee6;
  }

  .metric-arrow {
    color: oklch(0.84 0.15 90);
    font-weight: 700;
  }

  /* Section: Architecture */
  .architecture-section {
    background: #1c1a17;
    color: #f2eee6;
    padding: 0 clamp(20px, 5vw, 72px) clamp(60px, 10vh, 100px);
    border-top: 1px solid rgba(242, 238, 230, 0.14);
  }

  .architecture-container {
    max-width: 1600px;
    margin: 0 auto;
    padding-top: 48px;
  }

  @media (max-width: 767px) {
    .projects-horizontal-section {
      height: 320vh;
    }

    .project-track-intro {
      width: 84vw;
      gap: 10px;
    }

    .project-track-title {
      font-size: clamp(30px, 8vw, 42px);
    }

    .project-track-desc {
      font-size: 14.5px;
    }

    .project-editorial-card {
      width: 90vw;
      height: min(84vh, 620px);
      padding: 18px 16px;
      gap: 12px;
      overflow-y: auto;
    }

    .project-card-name {
      font-size: clamp(28px, 7vw, 42px);
    }

    .project-card-description {
      font-size: 13.5px;
      line-height: 1.45;
    }

    .project-card-columns {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .metric-col {
      padding-top: 4px;
    }

    .metric-col-val {
      font-size: 12.5px;
      line-height: 1.35;
    }

    .project-card-action-row {
      padding-top: 10px;
      gap: 10px;
    }

    .project-live-btn {
      width: 100%;
      text-align: center;
      padding: 12px 16px;
    }

    .automations-section {
      padding: 64px 20px 80px;
    }

    .automations-container {
      gap: 32px;
    }

    .automations-title {
      font-size: clamp(28px, 7.5vw, 40px);
    }

    .automations-subtitle {
      font-size: 15px;
    }

    .architecture-section {
      padding: 0 16px 64px;
    }

    .architecture-container {
      padding-top: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .projects-track-rail {
      transform: none !important;
    }
  }
</style>
