---
import type { Lang } from '../i18n/ui';
import { projectsContent, automationsContent } from '../data/projects';
import { ExternalLink, Terminal, ShieldCheck, Zap, Server } from 'lucide-astro';
import ArchitectureDiagram from './ArchitectureDiagram.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const projects = projectsContent[lang];
const auto = automationsContent[lang];
---

<section id="proyectos" class="projects-section">
  <div class="container">
    <div class="section-header" data-reveal>
      <div class="section-badge">
        <Server class="badge-icon" size={14} />
        <span>PRODUCCIÓN VIVA</span>
      </div>
      <h2 class="section-title">
        {lang === 'es' ? 'Sistemas en Producción & Casos Reales' : lang === 'en' ? 'Live Production Systems & Real Cases' : 'Sistemas em Produção & Casos Reais'}
      </h2>
      <p class="section-subtitle">
        {lang === 'es' 
          ? 'Proyectos desplegados en clientes reales, resolviendo problemas de software, logística y operación.' 
          : lang === 'en' 
          ? 'Software deployed for real business clients, solving operational bottlenecks and logistics.' 
          : 'Projetos implantados em clientes reais, resolvendo problemas de software, logística e operações.'}
      </p>
    </div>

    <!-- Bento Grid de Proyectos -->
    <div class="bento-grid">
      {projects.map((project, i) => (
        <article
          class:list={['bento-card', { 'bento-featured': project.featured }]}
          data-reveal
          style={`--reveal-delay: ${i}`}
        >
          <div class="card-glow"></div>
          
          <div class="card-header">
            <span class="project-badge">
              <span class="pulse-dot"></span>
              {project.badge}
            </span>
            <a 
              href={project.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="link-btn" 
              aria-label={`Visitar ${project.name}`}
            >
              <span>{lang === 'es' ? 'Ver en vivo' : lang === 'en' ? 'Visit live' : 'Ver ao vivo'}</span>
              <ExternalLink size={14} />
            </a>
          </div>

          <div class="card-body">
            <h3 class="project-name">{project.name}</h3>
            <p class="project-role">{project.role} · <span class="project-cat">{project.category}</span></p>
            <p class="project-desc">{project.description}</p>

            <div class="problem-solution-box">
              <div class="row">
                <span class="label text-amber">{lang === 'es' ? 'Fricción:' : lang === 'en' ? 'Bottleneck:' : 'Fricção:'}</span>
                <span class="text">{project.problem}</span>
              </div>
              <div class="row">
                <span class="label text-cyan">{lang === 'es' ? 'Solución:' : lang === 'en' ? 'Solution:' : 'Solução:'}</span>
                <span class="text">{project.solution}</span>
              </div>
              <div class="row">
                <span class="label text-emerald">{lang === 'es' ? 'Impacto:' : lang === 'en' ? 'Impact:' : 'Impacto:'}</span>
                <span class="text highlight">{project.impact}</span>
              </div>
            </div>
          </div>

          <div class="card-footer">
            <div class="tech-tags">
              {project.tech.map((tech) => (
                <span class="tech-tag">{tech}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Módulo de Automatizaciones Críticas -->
    <div class="automations-box" data-reveal>
      <div class="auto-header">
        <div class="auto-title-group">
          <Terminal class="text-cyan" size={20} />
          <div>
            <h3 class="auto-title">{auto.title}</h3>
            <p class="auto-subtitle">{auto.subtitle}</p>
          </div>
        </div>
      </div>

      <div class="auto-grid">
        <div class="auto-card">
          <div class="auto-card-top">
            <Zap class="text-cyan" size={18} />
            <h4 class="auto-item-title">{auto.bot1Title}</h4>
          </div>
          <p class="auto-item-desc">{auto.bot1Desc}</p>
          <div class="auto-metric">
            <span class="metric-label">{lang === 'es' ? 'Resultado:' : lang === 'en' ? 'Outcome:' : 'Resultado:'}</span>
            <span class="metric-val">{auto.bot1Metric}</span>
          </div>
        </div>

        <div class="auto-card">
          <div class="auto-card-top">
            <ShieldCheck class="text-emerald" size={18} />
            <h4 class="auto-item-title">{auto.bot2Title}</h4>
          </div>
          <p class="auto-item-desc">{auto.bot2Desc}</p>
          <div class="auto-metric">
            <span class="metric-label">{lang === 'es' ? 'Resultado:' : lang === 'en' ? 'Outcome:' : 'Resultado:'}</span>
            <span class="metric-val">{auto.bot2Metric}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Diagrama de Arquitectura de Producción e Infraestructura Cloud -->
    <ArchitectureDiagram lang={lang} />
  </div>
</section>

<style>
  .projects-section {
    padding: 6.5rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .section-header {
    text-align: center;
    margin-bottom: 4.5rem;
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 0.85rem;
  }

  .section-title {
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    font-weight: 300;
    letter-spacing: -0.035em;
    line-height: 0.98;
    color: var(--text-main);
    margin-bottom: 1rem;
  }

  .section-subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
    max-width: 640px;
    margin-inline: auto;
    line-height: 1.55;
  }

  /* Bento Grid */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .bento-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 2.1rem;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);
  }

  .bento-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent-amber);
  }

  /* Structural break from the templated symmetric grid (T4): each
     featured project spans the full row width and gets a hard accent
     stripe down its left edge — read as "flagship/priority unit on
     the control panel," not a decorative card variant. */
  .bento-featured {
    grid-column: 1 / -1;
    border-left: 4px solid var(--accent-amber);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .project-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--bg-surface-elevated);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    background: var(--accent-emerald);
    border-radius: 50%;
    box-shadow: 0 0 6px var(--accent-emerald);
  }

  .link-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    font-family: var(--font-mono);
    color: var(--accent-amber);
    padding: 0.35rem 0.7rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--accent-amber) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-amber) 25%, transparent);
    transition: all var(--transition);
  }

  .link-btn:hover {
    background: var(--accent-amber);
    border-color: var(--accent-amber);
    color: #12161c;
  }

  .project-name {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 0.25rem;
  }

  .project-role {
    font-size: 0.85rem;
    color: var(--accent-blue);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .project-cat {
    color: var(--text-dim);
    font-weight: 400;
  }

  .project-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .problem-solution-box {
    background: var(--bg-primary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 1.75rem;
    font-size: 0.85rem;
  }

  .problem-solution-box .row {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .problem-solution-box .label {
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .text-amber { color: var(--accent-amber); }
  .text-cyan { color: var(--accent-cyan); }
  .text-emerald { color: var(--accent-emerald); }

  .problem-solution-box .text {
    color: var(--text-muted);
    line-height: 1.4;
  }

  .problem-solution-box .highlight {
    color: var(--text-main);
    font-weight: 500;
  }

  .card-footer {
    margin-top: auto;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tech-tag {
    font-size: 0.75rem;
    font-family: monospace;
    color: var(--text-dim);
    background: var(--bg-surface-elevated);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }

  /* Automations Module */
  .automations-box {
    margin-top: 4.5rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 2.25rem;
  }

  .auto-header {
    margin-bottom: 2rem;
  }

  .auto-title-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .auto-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .auto-subtitle {
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  .auto-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
  }

  .auto-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .auto-card-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .auto-item-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .auto-item-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.45;
    margin-bottom: 1rem;
  }

  .auto-metric {
    margin-top: auto;
    background: color-mix(in srgb, var(--accent-emerald) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-emerald) 25%, transparent);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.75rem;
    font-size: 0.8rem;
    font-family: var(--font-mono);
  }

  .metric-label {
    color: var(--accent-emerald);
    font-weight: 700;
    margin-right: 0.4rem;
  }

  .metric-val {
    color: var(--text-main);
  }

  @media (max-width: 900px) {
    .bento-grid, .auto-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
