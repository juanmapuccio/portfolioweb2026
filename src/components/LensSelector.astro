---
// Lets a reader pick the reading lens that best fits them (technical /
// operations / human). It never hides or duplicates content: it only sets
// `data-lens` on <html>, and global.css reorders/emphasizes existing
// sections via that attribute — the same mechanism the theme toggle in
// Layout.astro uses for `data-theme`. No lens selected (default, first
// paint) keeps the site's current order untouched.
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const labels: Record<Lang, { legend: string; technical: string; operations: string; human: string }> = {
  es: { legend: 'Leer como:', technical: 'Técnico', operations: 'Operaciones', human: 'Humano' },
  en: { legend: 'Read as:', technical: 'Technical', operations: 'Operations', human: 'Human' },
  pt: { legend: 'Ler como:', technical: 'Técnico', operations: 'Operações', human: 'Humano' },
};

const t = labels[lang] ?? labels.es;

const statusLabels: Record<Lang, { none: string; prefix: string }> = {
  es: { none: 'ORDEN POR DEFECTO', prefix: 'LENTE ACTIVO:' },
  en: { none: 'DEFAULT ORDER', prefix: 'ACTIVE LENS:' },
  pt: { none: 'ORDEM PADRÃO', prefix: 'LENTE ATIVA:' },
};
const s = statusLabels[lang] ?? statusLabels.es;
---

<div class="lens-selector" data-reveal>
  <span class="lens-legend">{t.legend}</span>
  <div class="lens-options" role="group" aria-label={t.legend}>
    <button type="button" class="lens-btn" data-lens-option="technical">{t.technical}</button>
    <button type="button" class="lens-btn" data-lens-option="operations">{t.operations}</button>
    <button type="button" class="lens-btn" data-lens-option="human">{t.human}</button>
  </div>
  <!-- Persistent console-style readout of the active lens — a fourth,
       always-visible signal (in addition to the button's own loud
       pressed state and the flagged items below) that a change happened
       and which lens is currently applied. -->
  <span class="lens-status" data-lens-status data-prefix={s.prefix} aria-live="polite">{s.none}</span>
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-lens-option]');
  const statusEl = document.querySelector<HTMLElement>('[data-lens-status]');
  const labelByOption: Record<string, string> = {
    technical: buttons[0]?.textContent?.trim() ?? 'technical',
    operations: buttons[1]?.textContent?.trim() ?? 'operations',
    human: buttons[2]?.textContent?.trim() ?? 'human',
  };
  const defaultStatus = statusEl?.textContent ?? '';
  const statusPrefix = statusEl?.dataset.prefix ?? '';

  function applyLens(lens: string | null) {
    if (lens) {
      document.documentElement.setAttribute('data-lens', lens);
    } else {
      document.documentElement.removeAttribute('data-lens');
    }
    buttons.forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.lensOption === lens));
    });
    if (statusEl) {
      statusEl.textContent = lens
        ? `${statusPrefix} ${(labelByOption[lens] ?? lens).toUpperCase()}`
        : defaultStatus;
    }
  }

  // Reflect whatever the inline head script already applied (or the
  // no-lens default) so button state matches on first render.
  applyLens(document.documentElement.getAttribute('data-lens'));

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-lens');
      const next = current === btn.dataset.lensOption ? null : (btn.dataset.lensOption ?? null);
      applyLens(next);
      try {
        if (next) {
          localStorage.setItem('lens', next);
        } else {
          localStorage.removeItem('lens');
        }
      } catch {
        // Storage unavailable (private mode, etc.) — lens still works for this page view.
      }
    });
  });
</script>

<style>
  .lens-selector {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    padding: 1.25rem 0 0;
  }

  .lens-legend {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-dim);
  }

  .lens-options {
    display: flex;
    gap: 0.4rem;
    background: var(--bg-surface);
    padding: 0.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .lens-btn {
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    transition: all var(--transition);
  }

  .lens-btn:hover {
    color: var(--text-main);
    background: var(--bg-surface-elevated);
  }

  /* Loud, full-strength pressed state — not just a color tint — so the
     button itself confirms the click, in addition to the flagged items
     it produces below. */
  .lens-btn[aria-pressed='true'] {
    background: var(--accent-amber);
    color: #12161c;
    border: 1px solid var(--accent-amber);
    font-family: var(--font-mono);
  }

  .lens-status {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--border-subtle);
  }
</style>
