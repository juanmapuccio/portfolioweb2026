---
// Review card for /lab: specimen id, name, Replay button and a short note.
// The Replay behaviour lives in the lab page script (it re-toggles `.is-in`).
interface Props {
  id: string;
  name: string;
  note: string;
  stage?: 'light' | 'phone' | 'bare';
  wide?: boolean;
}
const { id, name, note, stage = 'light', wide = false } = Astro.props;
---

<article class:list={['lab-card', { 'lab-card--wide': wide }]} data-lab-card>
  <header class="lab-card__head">
    <span class="lab-card__id">{id}</span>
    <h3 class="lab-card__name">{name}</h3>
    <button class="lab-card__replay" type="button" data-lab-replay>Replay</button>
  </header>
  <div class:list={['lab-card__stage', `lab-card__stage--${stage}`]} data-lab-stage>
    <slot />
  </div>
  <p class="lab-card__note">{note}</p>
</article>

<style>
  .lab-card { display: grid; grid-template-rows: auto 1fr auto; gap: 10px; min-width: 0; padding: 14px; background: var(--bg-surface); border: 1px solid var(--border-subtle); box-shadow: var(--shadow-card); }
  .lab-card--wide { grid-column: 1 / -1; }
  .lab-card__head { display: flex; align-items: center; gap: 10px; }
  .lab-card__id { padding: 3px 7px; font: 600 11px/1 var(--font-mono); background: var(--text-main); color: var(--paper); }
  .lab-card__name { flex: 1; margin: 0; font: 600 14px/1.25 var(--font-sans); color: var(--text-main); }
  .lab-card__replay { padding: 6px 12px; font: 600 11px/1 var(--font-mono); letter-spacing: var(--tracking-meta); text-transform: uppercase; background: transparent; color: var(--text-main); border: 1px solid var(--border-strong); cursor: pointer; }
  .lab-card__replay:hover { background: var(--bg-surface-elevated); }
  .lab-card__stage { display: grid; place-items: center; min-width: 0; overflow: hidden; background: var(--bg-primary); }
  .lab-card__stage--bare { display: block; }
  .lab-card__stage--phone { padding: 12px; }
  .lab-card__stage--phone > :global(*) { width: 244px; max-width: 100%; height: 420px; border: 6px solid var(--text-main); border-radius: 26px; box-sizing: border-box; overflow: hidden; }
  .lab-card__note { margin: 0; font: 400 13px/1.4 var(--font-sans); color: var(--text-muted); }
</style>
