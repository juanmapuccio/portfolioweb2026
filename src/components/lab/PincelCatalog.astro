  <g filter="url(#dryH)" fill="#1c1a17">
    <circle cx="90" cy="180" r="4.5" style="animation:amaterasuAshRise 2.8s ease-out infinite;--drift:-25px"></circle>
    <circle cx="160" cy="200" r="6" style="animation:amaterasuAshRise 3.1s ease-out .2s infinite;--drift:18px"></circle>
