<svg viewBox="0 0 420 240" style="position:absolute;inset:0;width:100%;height:100%"><g filter="url(#bleedF)"><path d="M-10 172 L430 68" stroke="#f4efe4" stroke-width="6" pathLength="1" stroke-dasharray="1" style="animation:slash6 4s linear infinite"></path></g></svg>
