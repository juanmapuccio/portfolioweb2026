    <circle cx="320" cy="210" r="7" style="animation:amaterasuAshRise 3.3s ease-out .1s infinite;--drift:30px"></circle>
    <circle cx="380" cy="180" r="3.5" style="animation:amaterasuAshRise 2.6s ease-out .7s infinite;--drift:-18px"></circle>
  </g>
</svg>

<div style="position:absolute;left:20px;bottom:16px;font:600 11px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:#f4efe4;background:#1c1a17;border:1px solid rgba(244,239,228,.25);padding:4px 8px;z-index:6">ROJO → 1º DAN · KUROHOMURA (黒炎)</div>
