<svg viewBox="0 0 420 240" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:3">
  <path d="M-20 180 L440 60" fill="none" stroke="#ffffff" stroke-width="2.5" pathLength="1" stroke-dasharray="1" style="animation:amaterasuEyeSlash 5.5s cubic-bezier(.16,1,.3,1) infinite"></path>
</svg>

<!-- 2. Núcleo de ignición central: mancha de tinta negra densa con halo carmesí que explota -->
<div style="position:absolute;left:50%;top:50%;width:130px;height:130px;border-radius:50%;background:#000000;filter:url(#bleedF);animation:amaterasuCoreIgnition 5.5s cubic-bezier(.16,1,.3,1) infinite;pointer-events:none;z-index:2"></div>

