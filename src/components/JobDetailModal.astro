---
import type { Lang } from '../i18n/ui';
import { martialExperienceData, BELTS } from '../data/martialExperience';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = martialExperienceData[lang];

// Same chapter hexes the timeline paints on card accents/ribbons, keyed by belt.
const CHAPTER_ACCENTS: Record<string, string> = {
  blanco: '#ffffff',
  amarillo: '#fbbf24',
  verde: '#10b981',
  azul: '#0284c7',
  rojo: '#ef4444',
  negro: '#1c1a17',
};

const closeLabel = lang === 'es' ? 'Cerrar' : lang === 'en' ? 'Close' : 'Fechar';

// One detail block per job, pre-rendered in the active language. The dialog
// shows exactly one of them; "qué hice" = description, "aprendizaje" =
// transferableCompetency under the existing competencyLabel (no new copy).
const entries = data.stages.flatMap((stage, stageIdx) => {
  const belt = BELTS[stage.beltKey];
  const accent = CHAPTER_ACCENTS[stage.beltKey] ?? '#1c1a17';
  const chapterMeta = `Capítulo ${String(stageIdx + 1).padStart(2, '0')} · ${stage.title}`;
  return stage.positions.map((pos, posIdx) => ({
    key: `${stage.beltKey}:${posIdx}`,
    headingId: `job-detail-heading-${stage.beltKey}-${posIdx}`,
    chapterMeta,
    beltName: belt.beltName[lang],
    gup: belt.gup,
    years: stage.years,
    accent,
    pos,
  }));
});
---

<dialog class="job-modal" data-job-modal aria-modal="true" aria-labelledby="job-detail-heading-blanco-0">
  <div class="job-modal-inner">
    <header class="job-modal-topbar">
      <span class="job-modal-kicker" data-modal-kicker></span>
      <button type="button" class="job-modal-close" data-modal-close aria-label={closeLabel}>
        <span aria-hidden="true">×</span>
      </button>
    </header>

    <div class="job-modal-body">
      {entries.map((entry) => (
        <article
          class="job-detail"
          data-job-detail={entry.key}
          data-modal-kicker-text={entry.chapterMeta}
          style={`--job-accent: ${entry.accent};`}
          hidden
        >
          <span class="job-detail-accent" style={`background: ${entry.accent};`} aria-hidden="true"></span>
          <p class="job-detail-eyebrow">
            <span>{entry.beltName}</span>
            <span aria-hidden="true">·</span>
            <span>{entry.gup}</span>
            <span aria-hidden="true">·</span>
            <span>{entry.years}</span>
          </p>
          <h2 class="job-detail-role" id={entry.headingId} data-job-heading>{entry.pos.role}</h2>
          <p class="job-detail-meta">
            <span class="job-detail-org">{entry.pos.org}</span>
            <span aria-hidden="true">·</span>
            <span class="job-detail-dates">{entry.pos.dates}</span>
          </p>
          <p class="job-detail-text">{entry.pos.description}</p>
          <div class="job-detail-learn">
            <p class="job-detail-label">{data.competencyLabel}</p>
            <p class="job-detail-text">{entry.pos.transferableCompetency}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</dialog>

<script>
  function initJobDetailModal() {
    const mounted = document.querySelector<HTMLDialogElement>('[data-job-modal]');
    if (!mounted) return;
    // Explicit non-null alias: keeps every nested handler free of null guards.
    const dialog: HTMLDialogElement = mounted;

    // Lenis is only instantiated when reduced-motion is off (Layout.astro).
    interface LenisInstance {
      stop(): void;
      start(): void;
    }
    type WindowWithLenis = Window & { __lenis?: LenisInstance };

    const root = document.documentElement;
    const details = Array.from(dialog.querySelectorAll<HTMLElement>('[data-job-detail]'));
    const kicker = dialog.querySelector<HTMLElement>('[data-modal-kicker]');
    const closeButton = dialog.querySelector<HTMLButtonElement>('[data-modal-close]');
    let invoker: HTMLElement | null = null;
    let scrollLocked = false;

    function lockScroll() {
      if (scrollLocked) return;
      scrollLocked = true;
      const lenis = (window as WindowWithLenis).__lenis;
      if (lenis) lenis.stop();
      // Fallback for sessions without Lenis (prefers-reduced-motion).
      root.style.setProperty('overflow', 'hidden');
    }

    function unlockScroll() {
      if (!scrollLocked) return;
      scrollLocked = false;
      const lenis = (window as WindowWithLenis).__lenis;
      if (lenis) lenis.start();
      root.style.removeProperty('overflow');
    }

    function openJob(jobKey: string, source: HTMLElement) {
      const target = details.find((detail) => detail.dataset.jobDetail === jobKey);
      if (!target) return;
      for (const detail of details) detail.hidden = detail !== target;
      if (kicker) kicker.textContent = target.dataset.modalKickerText ?? '';
      const heading = target.querySelector<HTMLElement>('[data-job-heading]');
      if (heading?.id) dialog.setAttribute('aria-labelledby', heading.id);
      invoker = source;
      lockScroll();
      // showModal() puts the dialog in the top layer: native focus trap,
      // Escape support, and inert background for everything else.
      if (!dialog.open) dialog.showModal();
      closeButton?.focus();
    }

    function closeJob() {
      if (dialog.open) dialog.close();
    }

    // Event delegation: the timeline re-renders nothing, but one listener covers
    // every [data-job] card across all chapters.
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const trigger = target.closest<HTMLElement>('[data-job]');
      if (!trigger) return;
      const jobKey = trigger.dataset.job;
      if (jobKey) openJob(jobKey, trigger);
    });

    // Backdrop click: clicks landing on the dialog element itself.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) closeJob();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        closeJob();
      }
    });

    closeButton?.addEventListener('click', closeJob);

    // Single cleanup path for every close route: resume scroll, return focus
    // to the invoking card so the user lands exactly where they were.
    dialog.addEventListener('close', () => {
      unlockScroll();
      invoker?.focus();
      invoker = null;
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initJobDetailModal, { once: true });
  } else {
    initJobDetailModal();
  }
</script>

<style>
  .job-modal {
    box-sizing: border-box;
    border: 1px solid rgba(28, 26, 23, 0.35);
    padding: 0;
    margin: auto;
    width: min(760px, calc(100vw - 40px));
    max-width: none;
    max-height: min(86vh, 880px);
    background: #f2eee6;
    color: #1c1a17;
    box-shadow: 0 24px 60px -20px rgba(28, 26, 23, 0.45);
    overflow: hidden;
  }

  .job-modal[open] {
    display: flex;
    flex-direction: column;
  }

  .job-modal::backdrop {
    background: rgba(28, 26, 23, 0.72);
  }

  .job-modal-inner {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .job-modal-topbar {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px clamp(20px, 4vw, 36px);
    border-bottom: 1px solid rgba(28, 26, 23, 0.18);
  }

  .job-modal-kicker {
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4a463f;
  }

  .job-modal-close {
    appearance: none;
    box-sizing: border-box;
    flex: none;
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    border: 1px solid rgba(28, 26, 23, 0.35);
    background: transparent;
    color: #1c1a17;
    font: inherit;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    transition: background-color 160ms ease-out;
  }

  .job-modal-close:hover {
    background-color: rgba(28, 26, 23, 0.06);
  }

  .job-modal-close:focus-visible {
    outline: 2px solid #1c1a17;
    outline-offset: 2px;
  }

  .job-modal-body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: clamp(24px, 4vw, 40px) clamp(20px, 4vw, 36px) clamp(28px, 5vw, 44px);
  }

  .job-detail[hidden] {
    display: none;
  }

  .job-detail-accent {
    display: block;
    height: 10px;
    margin-bottom: 22px;
    border-top: 1px solid #1c1a17;
    border-bottom: 1px solid #1c1a17;
  }

  .job-detail-eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 0 0 14px;
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4a463f;
  }

  .job-detail-role {
    margin: 0 0 12px;
    font-family: var(--font-serif, serif);
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: #1c1a17;
  }

  .job-detail-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 24px;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(28, 26, 23, 0.16);
  }

  .job-detail-org {
    font-family: var(--font-sans, sans-serif);
    font-size: 16px;
    font-weight: 700;
    color: #1c1a17;
  }

  .job-detail-dates {
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6a645a;
  }

  .job-detail-text {
    margin: 0;
    max-width: 62ch;
    font-family: var(--font-serif, serif);
    font-size: clamp(17px, 1.5vw, 20px);
    font-weight: 400;
    line-height: 1.55;
    color: #1c1a17;
  }

  .job-detail-learn {
    margin-top: 26px;
    padding: 18px 20px;
    background: rgba(28, 26, 23, 0.05);
    border-left: 3px solid var(--job-accent, #1c1a17);
  }

  .job-detail-learn .job-detail-text {
    font-family: var(--font-sans, sans-serif);
    font-size: 16px;
    line-height: 1.6;
    color: #1c1a17;
  }

  .job-detail-label {
    margin: 0 0 8px;
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4a463f;
  }

  /* Motion is opt-in: with prefers-reduced-motion the dialog appears instantly. */
  @media (prefers-reduced-motion: no-preference) {
    .job-modal[open] {
      animation: job-modal-in 200ms ease-out;
    }

    .job-modal::backdrop {
      animation: job-modal-veil-in 200ms ease-out;
    }
  }

  @keyframes job-modal-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @keyframes job-modal-veil-in {
    from {
      opacity: 0;
    }
  }

  /* Mobile (≤767px): bottom-sheet layout, full width, internal scroll. */
  @media (max-width: 767px) {
    .job-modal {
      margin: auto 0 0;
      width: 100%;
      max-height: 92svh;
      /* Rounded top corners for the sheet silhouette (overflow: hidden on
         .job-modal clips the body to the radius). */
      border-radius: 18px 18px 0 0;
      /* Home-indicator clearance: the sheet background covers the inset while
         border-box keeps the total inside 92svh. */
      padding-bottom: env(safe-area-inset-bottom, 0px);
      border-left: 0;
      border-right: 0;
      border-bottom: 0;
      border-top: 1px solid rgba(28, 26, 23, 0.35);
    }

    .job-modal-topbar {
      padding: 12px 20px;
    }

    /* Visible close affordance: 36px on desktop, 44px touch target here.
       The topbar stays flex:none above the scrolling body, so the close
       never scrolls out of reach. */
    .job-modal-close {
      width: 44px;
      height: 44px;
    }

    .job-modal-body {
      padding: 24px 20px 32px;
    }

    .job-detail-role {
      font-size: clamp(24px, 6.5vw, 32px);
    }

    .job-detail-text {
      font-size: 16.5px;
    }
  }
</style>
