---
import Layout from '../layouts/Layout.astro';
import { CV_URL } from '../data/contact';
import { useTranslations, type Lang } from '../i18n/ui';
import { Image } from 'astro:assets';
import fotoPerfil from '../assets/fotojmPerfil.png';
import ProjectsSection from './ProjectsSection.astro';
import ManifestoScrollytelling from './ManifestoScrollytelling.astro';
import MartialExperienceTimeline from './MartialExperienceTimeline.astro';
import SkillsPhilosophySection from './SkillsPhilosophySection.astro';
import ContactSection from './ContactSection.astro';
import Belt3D from './Belt3D.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Layout
  title={t('meta.title')}
  description={t('meta.description')}
  lang={lang}
>
  <Belt3D />
  <div class="portfolio-shell">
    <main class="portfolio-main-column">
  <section id="top" data-zone="hero" data-ch="0" class="hero-pinned-scene">
    <div class="hero-sticky-container">
      <div class="hero-top-status-row">
        <span class="hero-status-pill">
          <span class="status-dot"></span>
          <span>{lang === 'es' ? 'Disponible · full-time' : lang === 'en' ? 'Available · full-time' : 'Disponível · full-time'}</span>
        </span>
      </div>

      <h1 class="hero-headline-name">Juan Manuel Puccio</h1>

      <div class="hero-editorial-layout">
        <div class="hero-narrative-block">
          <span class="hero-role-headline">
            {lang === 'es' ? 'Desarrollador Full Stack · Disponibilidad full-time' : lang === 'en' ? 'Full Stack Developer · Full-time availability' : 'Desenvolvedor Full Stack · Disponibilidade full-time'}
          </span>
          <p class="hero-italic-quote">
            {lang === 'es' ? 'Audito procesos de empresas y los resuelvo con código.' : lang === 'en' ? 'I audit business processes and solve them with code.' : 'Audito processos de empresas e os resolvo com código.'}
          </p>
          <div class="hero-buttons-row">
            <a href={CV_URL} target="_blank" rel="noopener noreferrer" class="hero-btn-dark">
              {t('hero.btn.cv')}
            </a>
            <a href="#contacto" class="hero-btn-outline">
              {lang === 'es' ? 'Contacto' : lang === 'en' ? 'Contact' : 'Contato'}
            </a>
          </div>
          <div class="hero-proof-strip">
            <div class="proof-item">
              <span class="proof-num">04</span>
              <span class="proof-label">{lang === 'es' ? 'Sistemas en producción' : lang === 'en' ? 'Production systems' : 'Sistemas em produção'}</span>
            </div>
            <div class="proof-sep" aria-hidden="true">/</div>
            <div class="proof-item">
              <span class="proof-num">ITF</span>
              <span class="proof-label">10º gup → 1º dan</span>
            </div>
            <div class="proof-sep" aria-hidden="true">/</div>
            <div class="proof-item">
              <span class="proof-num">{lang === 'es' ? 'Automatizaciones' : lang === 'en' ? 'Automations' : 'Automações'}</span>
              <span class="proof-label">{lang === 'es' ? 'Python & Integraciones' : lang === 'en' ? 'Python & Integrations' : 'Python & Integrações'}</span>
            </div>
          </div>
        </div>

        <figure class="hero-portrait-col">
          <div class="portrait-slot">
            <Image
              src={fotoPerfil}
              alt="Juan Manuel Puccio"
              class="portrait-img"
              width={700}
              height={875}
              format="webp"
              quality={85}
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <figcaption class="portrait-caption-row">
            <span class="fig-label">Fig. 01 · {lang === 'pt' ? 'Rosário' : 'Rosario'}, 2026</span>
            <span class="fig-cue">10º gup → 1º dan · {lang === 'es' ? 'Desplázate' : lang === 'en' ? 'Scroll' : 'Role'} ↓</span>
          </figcaption>
        </figure>
      </div>

      <div class="hero-belt-track"></div>
      <div class="hero-scroll-cue">{lang === 'es' ? 'Desplázate' : lang === 'en' ? 'Scroll' : 'Role'} ↓</div>
    </div>
  </section>

  <!-- Scene 02: Word-by-word Manifesto Scrollytelling (Perfil) -->
  <ManifestoScrollytelling lang={lang} />

  <!-- Scene 03 & 04: Operational & technical martial experience timeline (Taekwondo ITF 10º gup -> 1º dan Cinturón Negro) -->
  <MartialExperienceTimeline lang={lang} />

  <!-- Scene 05: Production bento grid & automations (Nace del negro de la escena 04) -->
  <ProjectsSection lang={lang} />

  <!-- Scene 06 & 07: Tech stack, skills & practical philosophy -->
  <SkillsPhilosophySection lang={lang} />

  <!-- Scene 08: Contact & call to action -->
  <ContactSection lang={lang} />
    </main>
  </div>
</Layout>

<script>
  import { registerZone } from '../scripts/journey';

  // Scroll-engine consolidation (T3): the hero zone (data-zone="hero",
  // data-ch="0") is registered here — HomePage previously had no client
  // script, which left the zone undriven and silenced belt:change on initial
  // load after the timeline migrated to the registry (T2). With the hero
  // registered, journey.ts's initial pass resolves the center-crossing zone
  // (hero at scroll 0, ch 0 → "blanco") and dispatches belt:change exactly
  // like the old rAF engine did on load. Markup and styles untouched.
  const heroZone = document.querySelector<HTMLElement>('#top');
  if (heroZone) registerZone(heroZone);
</script>

<style>
  .portfolio-shell {
    width: 100%;
    margin-inline: auto;
    display: block;
  }

  .portfolio-main-column {
    width: 100%;
    min-width: 0;
  }

  .belt-console {
    position: sticky;
    top: 76px;
    box-sizing: border-box;
    width: min(100%, 680px, 78vh);
    aspect-ratio: 1;
    margin-inline: auto;
    overflow: hidden;
    background: #f8f6f0;
    border: 1px solid rgba(28, 26, 23, 0.2);
  }

  .belt-sticky-monitor {
    position: absolute;
    z-index: 2;
    top: clamp(16px, 2vw, 28px);
    left: clamp(16px, 2vw, 28px);
    right: clamp(16px, 2vw, 28px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) 76px;
    gap: 8px 12px;
    padding: 0 0 10px;
    background: #f8f6f0;
  }

  .belt-gup-row,
  .belt-caption,
  .belt-stage-link {
    font-family: var(--font-mono, monospace);
    color: #4a463f;
  }

  .belt-gup-row {
    grid-column: 1;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .belt-display-name {
    grid-column: 1;
    margin: 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-size: clamp(21px, 2vw, 30px);
    font-weight: 300;
    line-height: 1.05;
    text-wrap: balance;
  }

  .belt-strap {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    width: 76px;
    height: 18px;
    border: 1px solid rgba(28, 26, 23, 0.22);
    background-color: #f8f6f0;
    background-image: repeating-linear-gradient(0deg, transparent 0 6px, rgba(28, 26, 23, 0.08) 6px 7px);
    transition: background-color 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .belt-dots-row {
    grid-column: 1 / -1;
    display: flex;
    gap: 4px;
  }

  .belt-dot-bar {
    flex: 1;
    height: 6px;
    border: 1px solid rgba(28, 26, 23, 0.25);
    background: var(--dot-color);
    opacity: 0.2;
    transition: opacity 0.4s ease;
  }

  .belt-caption {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 10px;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .belt-console-model-stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  :global(.belt-console-fallback) {
    position: absolute;
    z-index: 1;
    width: min(42%, 220px);
    height: auto;
    pointer-events: none;
    --knot-fill: var(--active-belt-color, #f8f6f0);
    --knot-stroke: #1c1a17;
  }

  :global(.belt3d-root:not([hidden]) ~ .belt-console-fallback) {
    display: none;
  }

  .belt-stage-navigation {
    position: absolute;
    z-index: 2;
    left: clamp(16px, 2vw, 28px);
    right: clamp(16px, 2vw, 28px);
    bottom: clamp(16px, 2vw, 28px);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 4px clamp(8px, 1.2vw, 16px);
    padding-top: 8px;
    background: #f8f6f0;
  }

  .belt-stage-link {
    display: grid;
    grid-template-columns: 12px 1fr;
    align-items: center;
    column-gap: 8px;
    min-height: 38px;
    border-top: 1px solid var(--border-subtle);
    color: #4a463f;
    font-size: 10px;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .belt-stage-name {
    grid-column: 2;
    color: #6a645a;
    font-size: 9px;
    line-height: 1.2;
  }

  .belt-stage-swatch {
    grid-row: span 2;
    width: 12px;
    height: 5px;
    border: 1px solid rgba(28, 26, 23, 0.28);
    background: var(--stage-color);
  }

  .belt-stage-link:hover {
    color: #1c1a17;
  }

  .belt-stage-link.is-active,
  .belt-stage-link.is-active .belt-stage-name {
    color: #1c1a17;
  }

  .belt-stage-link.is-active {
    font-weight: 600;
  }

  .belt-stage-link:focus-visible {
    outline: 2px solid #1c1a17;
    outline-offset: 2px;
  }

  @media (max-width: 1023px) {
    .portfolio-shell {
      display: block;
      padding: 0;
    }

    .belt-console-column {
      display: none;
    }

    .hero-editorial-layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  .hero-pinned-scene {
    position: relative;
    height: 140vh;
    background: #f2eee6;
  }

  .hero-sticky-container {
    position: sticky;
    top: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(12px, 2.5vh, 24px);
    padding: clamp(72px, 11vh, 92px) clamp(20px, 5vw, 72px) clamp(32px, 6vh, 56px);
  }

  .hero-top-status-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #4a463f;
  }

  .hero-status-pill {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: oklch(0.58 0.12 150);
  }

  .hero-headline-name {
    margin: 0 0 clamp(8px, 1.5vh, 16px);
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 300;
    font-size: clamp(38px, 5.8vw, 92px);
    line-height: 0.96;
    letter-spacing: -0.035em;
    color: #1c1a17;
  }

  .hero-editorial-layout {
    display: grid;
    /* T7: equal columns — the narrative block caps itself at 620px anyway, and
       the right column needed real estate for a portrait worthy of the hero. */
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    flex: 1;
  }

  .hero-proof-strip {
    display: flex;
    align-items: center;
    gap: clamp(12px, 1.8vw, 24px);
    margin-top: clamp(10px, 1.8vh, 20px);
    padding-top: 14px;
    border-top: 1px solid rgba(28, 26, 23, 0.16);
    flex-wrap: wrap;
  }

  .proof-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .proof-num {
    font-family: var(--font-mono, monospace);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #1c1a17;
  }

  .proof-label {
    font-family: var(--font-mono, monospace);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6a645a;
  }

  .proof-sep {
    color: rgba(28, 26, 23, 0.25);
    font-family: var(--font-mono, monospace);
    font-size: 14px;
  }

  .hero-narrative-block {
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 1.4vh, 14px);
    max-width: 620px;
  }

  .hero-role-headline {
    font-family: var(--font-mono, monospace);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: #4a463f;
  }

  .hero-italic-quote {
    margin: 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(24px, min(3vw, 5.5vh), 44px);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: #1c1a17;
  }

  .hero-buttons-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .hero-btn-dark {
    font-family: var(--font-mono, monospace);
    font-size: 13px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: #1c1a17;
    color: #f2eee6;
    padding: 15px 20px;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
  }

  .hero-btn-dark:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  .hero-btn-outline {
    font-family: var(--font-mono, monospace);
    font-size: 13px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border: 1px solid #1c1a17;
    color: #1c1a17;
    padding: 14px 20px;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
  }

  .hero-btn-outline:hover {
    opacity: 0.7;
    transform: translateY(-1px);
  }

  .hero-portrait-col {
    justify-self: end;
    width: 100%;
    /* T7: was 310px max — the photo now commands the right column. */
    max-width: clamp(300px, 30vw, 470px);
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .portrait-slot {
    width: 100%;
    aspect-ratio: 4 / 5;
    border: 1px solid rgba(28, 26, 23, 0.18);
    background: #ffffff;
    overflow: hidden;
    position: relative;
    box-shadow: 0 16px 40px -12px rgba(28, 26, 23, 0.12);
  }

  .portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    filter: grayscale(1) contrast(1.06);
    mix-blend-mode: multiply;
  }

  .portrait-caption-row {
    margin-top: 4px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6a645a;
  }

  .fig-label {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .fig-cue {
    text-align: right;
  }

  .hero-belt-track {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 20px;
    width: 100%;
    background: #f8f6f0;
    border-top: 1px solid rgba(28, 26, 23, 0.25);
    border-bottom: 1px solid rgba(28, 26, 23, 0.25);
    background-image: repeating-linear-gradient(0deg, transparent 0 4px, rgba(28, 26, 23, 0.07) 4px 5px);
  }

  .hero-scroll-cue {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: 30px;
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6a645a;
  }

  .btn-secondary:hover {
    background: var(--bg-surface-elevated);
    transform: translateY(-2px);
  }

  .avatar-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    box-shadow: var(--shadow-card);
  }

  .avatar-img {
    width: 100%;
    max-width: 280px;
    height: auto;
    aspect-ratio: 1/1;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .avatar-meta {
    margin-top: 1rem;
    display: flex;
    justify-content: space-between;
    width: 100%;
    padding: 0.5rem 0.75rem;
    background: var(--bg-primary);
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
  }

  .meta-label {
    color: var(--text-dim);
  }

  .meta-value {
    color: var(--accent-amber);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-desc {
      margin-inline: auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .avatar-card {
      max-width: 300px;
      margin-inline: auto;
    }
  }

  /* Mobile (< 768px): compact hero. Long paragraph hidden, small portrait
     beside the name so photo + CTAs fit in the first viewport. */
  @media (max-width: 767px) {
    .hero-pinned-scene {
      height: auto;
    }

    .hero-sticky-container {
      position: relative;
      min-height: 0;
      justify-content: flex-start;
      gap: 18px;
      padding: 84px 20px 64px;
    }

    .hero-location-text,
    .hero-scroll-cue,
    .portrait-caption-row {
      display: none;
    }

    .hero-headline-name {
      font-size: clamp(38px, 11vw, 46px);
      padding-right: 116px;
      min-height: 84px;
    }

    .hero-portrait-col {
      position: absolute;
      top: 116px;
      right: 20px;
      width: 96px;
    }

    .hero-bottom-grid {
      gap: 0;
    }

    .hero-narrative-block {
      gap: 14px;
    }

    .hero-italic-quote {
      font-size: 26px;
    }

    .hero-buttons-row {
      flex-wrap: nowrap;
      margin-top: 8px;
    }

    .hero-btn-dark,
    .hero-btn-outline {
      flex: 1 1 0;
      text-align: center;
      padding-inline: 12px;
    }
  }
</style>
