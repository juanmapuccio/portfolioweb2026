---
import QRCode from 'qrcode';
import Layout from '../layouts/Layout.astro';
import { CV_URL } from '../data/contact';
import { useTranslations, type Lang } from '../i18n/ui';
import ProjectsSection from './ProjectsSection.astro';
import ManifestoScrollytelling from './ManifestoScrollytelling.astro';
import MartialExperienceTimeline from './MartialExperienceTimeline.astro';
import SkillsPhilosophySection from './SkillsPhilosophySection.astro';
import EducationSection from './EducationSection.astro';
import ContactSection from './ContactSection.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const localePath = lang === 'es' ? '' : `/${lang}`;
const siteHost = new URL(Astro.site ?? 'https://juanpuccio.vercel.app').host;
const qrUrl = `https://${siteHost}${localePath}`;
const qrDisplay = `${siteHost}${localePath}`;
const qrSvgRaw = await QRCode.toString(qrUrl, { type: 'svg', margin: 1 });
// Themed via dedicated QR tokens, never the surface/text tokens: those
// swap polarity in dark mode and would render an inverted (unscannable
// on many readers) code. See --qr-bg / --qr-fg in global.css.
const qrSvg = qrSvgRaw
  .replace(/fill="#ffffff"/g, 'fill="var(--qr-bg)"')
  .replace(/stroke="#000000"/g, 'stroke="var(--qr-fg)"');
---

<Layout
  title={t('meta.title')}
  description={t('meta.description')}
  lang={lang}
>
  <section id="top" class="hero-pinned-scene">
    <div class="hero-sticky-container">
      <div class="hero-top-status-row">
        <span class="hero-status-pill">
          <span class="status-dot"></span>
          <span>{lang === 'es' ? 'Disponible · full-time' : lang === 'en' ? 'Available · full-time' : 'Disponível · full-time'}</span>
        </span>
        <span class="hero-location-text">Rosario, Santa Fe, Argentina</span>
      </div>

      <h1 class="hero-headline-name">Juan Manuel<br />Puccio</h1>

      <div class="hero-bottom-grid">
        <div class="hero-narrative-block">
          <span class="hero-role-headline">
            {lang === 'es' ? 'Desarrollador Full Stack — Disponibilidad full-time' : lang === 'en' ? 'Full Stack Developer — Full-time availability' : 'Desenvolvedor Full Stack — Disponibilidade full-time'}
          </span>
          <p class="hero-italic-quote">
            {lang === 'es' ? 'Construyo sistemas que siguen funcionando sin mí.' : lang === 'en' ? 'I build systems that keep working without me.' : 'Construo sistemas que continuam funcionando sem mim.'}
          </p>
          <p class="hero-body-claim">
            {lang === 'es' 
              ? 'Diseño, despliego y estabilizo software de negocio en producción, con usuarios reales. Esa capacidad de construir sistemas confiables, que siguen funcionando una vez entregados, es la que quiero poner al servicio de un equipo, con dedicación full-time.'
              : lang === 'en'
              ? 'I design, deploy, and stabilize production business software with real active users. That capability to build resilient systems that run autonomously after delivery is what I want to bring to an engineering team full-time.'
              : 'Projeto, implanto e estabilizo software de negócios em produção, com usuários reais. Essa capacidade de construir sistemas confiáveis, que continuam funcionando após a entrega, é o que quero colocar a serviço de uma equipe, com dedicação em tempo integral.'}
          </p>
          <div class="hero-buttons-row">
            <a href={CV_URL} target="_blank" rel="noopener noreferrer" class="hero-btn-dark">
              {t('hero.btn.cv')}
            </a>
            <a href="#contacto" class="hero-btn-outline">
              {lang === 'es' ? 'Contacto' : lang === 'en' ? 'Contact' : 'Contato'}
            </a>
          </div>
        </div>

        <div class="hero-portrait-col">
          <div class="portrait-slot">
            <img
              src="/fotojmPerfil.PNG"
              alt="Juan Manuel Puccio"
              class="portrait-img"
              loading="eager"
            />
          </div>
          <div class="portrait-caption-row">
            <span>Fig. 01</span>
            <span>Rosario, 2026</span>
          </div>
        </div>
      </div>

      <div class="hero-belt-track"></div>
      <div class="hero-scroll-cue">Scroll ↓</div>
    </div>
  </section>

  <!-- Scene 02: Word-by-word Manifesto Scrollytelling (Perfil) -->
  <ManifestoScrollytelling lang={lang} />

  <!-- Scene 03 & 04: Operational & technical martial experience timeline (Taekwondo ITF 10º gup -> 1º dan Cinturón Negro) -->
  <MartialExperienceTimeline lang={lang} />

  <!-- Scene 05: Production bento grid & automations (Nace del negro de la escena 04) -->
  <ProjectsSection lang={lang} />

  <!-- Scene 06 & 07: Tech stack, skills & practical philosophy -->
  <SkillsPhilosophySection lang={lang} />

  <!-- Education, Certifications & Continuous Learning -->
  <EducationSection lang={lang} />

  <!-- Scene 08: Contact & call to action -->
  <ContactSection lang={lang} />

  <!-- Accessible native dialog for the QR code -->
  <dialog id="qr-modal" class="qr-dialog">
    <div class="modal-card">
      <div class="modal-header">
        <h3>{t('qr.modal.title')}</h3>
        <button id="close-qr-btn" class="close-btn" aria-label={t('qr.modal.close')}>✕</button>
      </div>
      <p class="modal-desc">{t('qr.modal.desc')}</p>
      <div class="qr-preview">
        <div class="qr-image" role="img" aria-label={t('qr.modal.title')} set:html={qrSvg} />
      </div>
      <div class="modal-actions">
        <a href={qrUrl} target="_blank" class="direct-link">{qrDisplay}</a>
      </div>
    </div>
  </dialog>
</Layout>

<script>
  const openBtn = document.getElementById('open-qr-btn');
  const closeBtn = document.getElementById('close-qr-btn');
  const dialog = document.getElementById('qr-modal') as HTMLDialogElement | null;

  openBtn?.addEventListener('click', () => dialog?.showModal());
  closeBtn?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>

<style>
  .hero-pinned-scene {
    position: relative;
    height: 140vh;
    background: #f2eee6;
  }

  .hero-sticky-container {
    position: sticky;
    top: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(12px, 2.5vh, 24px);
    padding: clamp(72px, 11vh, 92px) clamp(20px, 5vw, 72px) clamp(32px, 6vh, 56px);
  }

  .hero-top-status-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #4a463f;
  }

  .hero-status-pill {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: oklch(0.58 0.12 150);
  }

  .hero-headline-name {
    margin: 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 300;
    font-size: clamp(44px, min(12vw, 16vh), 224px);
    line-height: 0.86;
    letter-spacing: -0.045em;
    color: #1c1a17;
  }

  .hero-bottom-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 32px 64px;
    align-items: end;
  }

  .hero-narrative-block {
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 2vh, 18px);
    max-width: 620px;
  }

  .hero-role-headline {
    font-family: var(--font-mono, monospace);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: #4a463f;
  }

  .hero-italic-quote {
    margin: 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(24px, min(3vw, 5.5vh), 44px);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: #1c1a17;
  }

  .hero-body-claim {
    margin: 0;
    font-size: clamp(15px, 2.2vh, 16px);
    line-height: 1.5;
    max-width: 520px;
    color: #4a463f;
  }

  .hero-buttons-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .hero-btn-dark {
    font-family: var(--font-mono, monospace);
    font-size: 13px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: #1c1a17;
    color: #f2eee6;
    padding: 15px 20px;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
  }

  .hero-btn-dark:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  .hero-btn-outline {
    font-family: var(--font-mono, monospace);
    font-size: 13px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border: 1px solid #1c1a17;
    color: #1c1a17;
    padding: 14px 20px;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
  }

  .hero-btn-outline:hover {
    opacity: 0.7;
    transform: translateY(-1px);
  }

  .hero-portrait-col {
    justify-self: end;
    width: clamp(140px, min(17vw, 30vh), 250px);
  }

  .portrait-slot {
    width: 100%;
    aspect-ratio: 4 / 5;
    background: rgba(28, 26, 23, 0.08);
    overflow: hidden;
  }

  .portrait-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.06);
    mix-blend-mode: multiply;
  }

  .portrait-caption-row {
    margin-top: 10px;
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #7a746a;
  }

  .hero-belt-track {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 20px;
    width: 100%;
    background: #f8f6f0;
    border-top: 1px solid rgba(28, 26, 23, 0.25);
    border-bottom: 1px solid rgba(28, 26, 23, 0.25);
    background-image: repeating-linear-gradient(0deg, transparent 0 4px, rgba(28, 26, 23, 0.07) 4px 5px);
  }

  .hero-scroll-cue {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: 30px;
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #7a746a;
  }

  .btn-secondary:hover {
    background: var(--bg-surface-elevated);
    transform: translateY(-2px);
  }

  .avatar-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    box-shadow: var(--shadow-card);
  }

  .avatar-img {
    width: 100%;
    max-width: 280px;
    height: auto;
    aspect-ratio: 1/1;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .avatar-meta {
    margin-top: 1rem;
    display: flex;
    justify-content: space-between;
    width: 100%;
    padding: 0.5rem 0.75rem;
    background: var(--bg-primary);
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
  }

  .meta-label {
    color: var(--text-dim);
  }

  .meta-value {
    color: var(--accent-amber);
    font-weight: 600;
  }

  /* Modal Dialog */
  .qr-dialog {
    border: none;
    background: transparent;
    padding: 0;
    max-width: 90vw;
    /* Restores the centering the UA gives a modal dialog; the global
       `* { margin: 0 }` reset strips it. */
    margin: auto;
    /* The UA stylesheet sets `color: CanvasText` on dialog, an explicit
       declaration that beats inheritance from the themed ancestors. Left
       alone it tracks the OS theme instead of ours, rendering near-black
       text on the dark card. */
    color: var(--text-main);
  }

  .qr-dialog::backdrop {
    background: rgba(10, 12, 16, 0.75);
    backdrop-filter: blur(8px);
  }

  .modal-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    width: 320px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.2);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .close-btn {
    font-size: 1.2rem;
    color: var(--text-dim);
  }

  .close-btn:hover {
    color: var(--text-main);
  }

  .modal-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .qr-preview {
    display: grid;
    place-items: center;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1rem;
  }

  .qr-image {
    display: block;
    width: 220px;
    height: 220px;
    border-radius: var(--radius-sm);
    /* Light card in both themes, with padding that widens the quiet zone
       the generator only renders one module wide. */
    background: var(--qr-bg);
    padding: 0.5rem;
  }

  .qr-image :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .modal-actions {
    margin-top: 1rem;
    text-align: center;
  }

  .direct-link {
    font-size: 0.85rem;
    color: var(--accent-cyan);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-desc {
      margin-inline: auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .avatar-card {
      max-width: 300px;
      margin-inline: auto;
    }
  }
</style>
