---
import type { Lang } from '../i18n/ui';
import { educationData, type EducationCategory } from '../data/education';
import { GraduationCap, Award, BookOpen, Cloud, Terminal, CheckCircle2, Calendar } from 'lucide-astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = educationData[lang];

const categoryIcons = {
  cloud: Cloud,
  academic: GraduationCap,
  foundations: Terminal,
};
---

<section id="formacion" class="education-section">
  <div class="container">
    <div class="section-header" data-reveal>
      <div class="section-badge">
        <GraduationCap size={15} />
        <span>{data.sectionBadge}</span>
      </div>
      <h2 class="section-title">{data.title}</h2>
      <p class="section-subtitle">{data.subtitle}</p>

      <!-- Filtros interactivos por categoría -->
      <div class="filter-bar" role="tablist" aria-label="Filtrar credenciales">
        {(['all', 'cloud', 'academic', 'foundations'] as EducationCategory[]).map((catKey) => (
          <button
            type="button"
            class:list={['filter-pill', { active: catKey === 'all' }]}
            data-filter={catKey}
            role="tab"
            aria-selected={catKey === 'all' ? 'true' : 'false'}
          >
            {data.filterLabels[catKey]}
          </button>
        ))}
      </div>
    </div>

    <!-- Grid de Credenciales y Formación -->
    <div class="credentials-grid" id="education-grid">
      {data.items.map((item, index) => {
        const IconComponent = categoryIcons[item.category] || Award;
        return (
          <article
            class="credential-card"
            data-category={item.category}
            data-reveal
            style={`--reveal-delay: ${index % 4};`}
          >
            <div class="card-inner">
              <header class="card-header">
                <div class="header-main">
                  <div class="icon-bubble">
                    <IconComponent size={20} class="category-icon" />
                  </div>
                  <div>
                    <span class="issuer-name">{item.issuer}</span>
                    <h3 class="credential-title">{item.title}</h3>
                  </div>
                </div>
                <div class="meta-tags">
                  <span class="period-badge">
                    <Calendar size={12} />
                    <span>{item.period}</span>
                  </span>
                  {item.credentialBadge && (
                    <span class:list={['status-badge', { 'in-progress': item.status === 'in_progress' }]}>
                      {item.credentialBadge}
                    </span>
                  )}
                </div>
              </header>

              <p class="credential-desc">{item.description}</p>

              <div class="highlights-box">
                <span class="highlights-title">
                  {lang === 'es' ? 'Competencias clave:' : lang === 'en' ? 'Core competencies:' : 'Competências-chave:'}
                </span>
                <ul class="highlights-list">
                  {item.highlights.map((point) => (
                    <li class="highlight-item">
                      <CheckCircle2 size={13} class="check-icon" />
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<script>
  function initEducationFilters() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-pill[data-filter]');
    const cards = document.querySelectorAll<HTMLElement>('.credential-card[data-category]');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter') || 'all';

        filterButtons.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        cards.forEach((card) => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.classList.remove('is-hidden');
          } else {
            card.classList.add('is-hidden');
          }
        });
      });
    });
  }

  // Initialize on load & Astro View Transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEducationFilters);
  } else {
    initEducationFilters();
  }
  document.addEventListener('astro:page-load', initEducationFilters);
</script>

<style>
  .education-section {
    padding: 6rem 0;
    background: var(--bg-surface-elevated);
    border-top: 1px solid var(--border-subtle);
  }

  .section-header {
    text-align: center;
    max-width: 48rem;
    margin: 0 auto 3.5rem auto;
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent-primary);
    background: var(--accent-surface);
    border: 1px solid color-mix(in srgb, var(--accent-primary) 30%, transparent);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 1.25rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 3.2vw, 2.35rem);
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .section-subtitle {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  /* Barra de filtros */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .filter-pill {
    appearance: none;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.5rem 1.15rem;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .filter-pill:hover {
    color: var(--text-main);
    border-color: var(--border-strong);
    background: var(--bg-surface-hover);
  }

  .filter-pill.active {
    background: var(--text-main);
    color: var(--bg-surface);
    border-color: var(--text-main);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  /* Grid de credenciales */
  .credentials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
    align-items: stretch;
  }

  .credential-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 0.75rem;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-card);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.25s ease,
                box-shadow 0.25s ease,
                opacity 0.25s ease;
  }

  .credential-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
  }

  .credential-card.is-hidden {
    display: none !important;
  }

  .card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.15rem;
  }

  .header-main {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .icon-bubble {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.5rem;
    background: var(--accent-surface);
    color: var(--accent-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .issuer-name {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 0.2rem;
  }

  .credential-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-main);
    line-height: 1.35;
  }

  .meta-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .period-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    color: var(--text-dim);
    font-family: var(--font-mono, monospace);
    background: var(--bg-surface-elevated);
    padding: 0.2rem 0.55rem;
    border-radius: 0.25rem;
  }

  .status-badge {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--accent-emerald) 12%, transparent);
    color: var(--accent-emerald);
    border: 1px solid color-mix(in srgb, var(--accent-emerald) 25%, transparent);
  }

  .status-badge.in-progress {
    background: color-mix(in srgb, var(--accent-amber) 12%, transparent);
    color: var(--accent-amber);
    border-color: color-mix(in srgb, var(--accent-amber) 25%, transparent);
  }

  .credential-desc {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .highlights-box {
    background: var(--bg-surface-elevated);
    border-radius: 0.5rem;
    padding: 0.85rem 1rem;
    border-left: 2px solid var(--accent-primary);
  }

  .highlights-title {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-dim);
    margin-bottom: 0.5rem;
  }

  .highlights-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .highlight-item {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-size: 0.78rem;
    color: var(--text-main);
    line-height: 1.35;
  }

  .check-icon {
    color: var(--accent-emerald);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  @media (max-width: 768px) {
    .education-section {
      padding: 4.5rem 0;
    }
    .credentials-grid {
      grid-template-columns: 1fr;
    }
    .filter-bar {
      gap: 0.4rem;
    }
    .filter-pill {
      font-size: 0.75rem;
      padding: 0.4rem 0.85rem;
    }
  }
</style>
