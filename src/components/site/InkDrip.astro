---
// Specimen 7e: vertical ink drip used as the mobile section transition (hero -> belts and
// every belt change). Plays once when it enters the viewport (`data-ink` -> `.is-in`).
// Mobile / tablet only: hidden on desktop (which uses 10l / 6b) and under reduced motion.
// Only transform animates, and the columns carry no SVG filter (mobile perf budget).
interface Props {
  /** Suffix of --ink-belt-*: the colour of the ink. */
  tone?: 'white' | 'yellow' | 'green' | 'blue' | 'red' | 'black';
  class?: string;
}
const { tone = 'black', class: className } = Astro.props;
const delays = [0, 0.1, 0.04, 0.14, 0.07];
---

<div class:list={['ink-drip', className]} data-ink data-specimen="7e" aria-hidden="true" style={`--drip: var(--ink-belt-${tone})`}>
  <svg viewBox="0 0 200 420" preserveAspectRatio="none" focusable="false">
    {delays.map((delay, i) => (
      <rect class="ink-drip__col" x={i * 40 - 4} y="-20" width="48" height="480" rx="24" style={`--ink-delay: ${delay}s`}></rect>
    ))}
  </svg>
</div>

<style is:global>
  .ink-drip { position: absolute; left: 0; right: 0; top: 0; height: 70svh; z-index: 4; overflow: hidden; pointer-events: none; color: var(--drip, var(--ink-belt-black)); }
  .ink-drip svg { display: block; width: 100%; height: 100%; }
  .ink-drip__col { fill: currentColor; transform-box: fill-box; transform-origin: top; transform: scaleY(0); }

  @keyframes ink-drip {
    0% { transform: scaleY(0); }
    45% { transform: scaleY(1); }
    100% { transform: translateY(110%) scaleY(1); }
  }
  html.js .ink-drip.is-in .ink-drip__col { animation: ink-drip 1.5s cubic-bezier(0.7, 0, 0.3, 1) var(--ink-delay, 0s) 1 both; }

  @media (min-width: 1024px), (prefers-reduced-motion: reduce) {
    .ink-drip { display: none; }
  }
</style>
