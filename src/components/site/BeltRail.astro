---
// Specimen 10o: horizontal ink rail. A line fills with --p and lights one node per belt.
// Decorative (aria-hidden): the chapters carry the real text. Desktop scrub only.
// transform (scaleX) and opacity only, no filter.
export interface RailNode {
  grade: string;
  tone: string;
}
interface Props {
  nodes: RailNode[];
}
const { nodes } = Astro.props;
const last = Math.max(1, nodes.length - 1);
---

<div class="belt-rail" aria-hidden="true" data-specimen="10o">
  <span class="belt-rail__line"><span class="belt-rail__fill"></span></span>
  {nodes.map((node, i) => (
    <span class="belt-rail__node" style={`--at: ${(i / last).toFixed(4)}; --tone: var(--ink-belt-${node.tone})`}>
      <span class="belt-rail__dot"></span>
      <span class="belt-rail__grade">{node.grade}</span>
    </span>
  ))}
</div>

<style is:global>
  .belt-rail { position: relative; display: none; justify-content: space-between; align-items: flex-start; }
  .belt-rail__line { position: absolute; left: 7px; right: 7px; top: 6px; height: 3px; background: var(--border-strong); }
  .belt-rail__fill { display: block; width: 100%; height: 100%; background: var(--text-main); transform-origin: left center; transform: scaleX(var(--p, 1)); }
  .belt-rail__node { position: relative; display: grid; justify-items: center; gap: 8px; width: 14px; }
  .belt-rail__dot { position: relative; display: block; width: 14px; height: 14px; box-sizing: border-box; border: 2px solid var(--text-main); border-radius: 50%; background: var(--paper); }
  .belt-rail__dot::after { content: ''; position: absolute; inset: -2px; border-radius: 50%; background: var(--tone); border: 2px solid var(--text-main); opacity: clamp(0, calc((var(--p, 1) - var(--at) + 0.02) * 25), 1); }
  .belt-rail__grade { font: 600 10px/1 var(--font-mono); letter-spacing: var(--tracking-meta); white-space: nowrap; color: var(--text-dim); }
</style>
