---
// S7 Contacto y cierre. One responsive tree, content from src/data/contact.ts,
// src/data/projects.ts, src/data/martialExperience.ts and src/i18n/ui.ts.
// Desktop (>=1024): 10v result screen (only verifiable facts: the number of own systems in
// production, +10 years teaching ITF Taekwondo, the 1st dan seal; no invented metrics), 10w
// channel scroll, the WhatsApp CTA with the 11b aura on hover/focus, the CV download, and
// 10z end credits that roll with --p on a pinned stage and settle on "end of the chapter".
// Mobile (<1024): 7k ink curtain that rises with --p (static path, transform only) over a
// pinned stage, a 7h bottom sheet (native <dialog>, Esc closes, focus is trapped by
// showModal) with the channels, and 10y hold-to-send used ONLY to confirm the WhatsApp
// link (no backend, no form). Wiring for the sheet and the hold lives in src/scripts/ink.ts.
// Without JS: the channels are listed inline and the plain CTA shows on every width.
// Reduced motion: no curtain, no roll, no pin; everything final and stacked.
import InkIcon from '../ink/InkIcon.astro';
import ChannelList from './ChannelList.astro';
import { contactData, CV_URL } from '../../data/contact';
import { BELTS } from '../../data/martialExperience';
import { projectsContent } from '../../data/projects';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const data = contactData[lang];
const projects = projectsContent[lang];
const whatsapp = data.channels.find((channel) => channel.primary) ?? data.channels[0];
const systems = String(projects.length).padStart(2, '0');
const dan = BELTS.negro.gup;
---

<section id="contacto" class="contact" data-belt="negro" aria-labelledby="contact-title">
  <div class="contact__scene" data-ink-scene>
    <div class="contact__stage">
      <svg class="contact__curtain" viewBox="0 0 400 100" preserveAspectRatio="none" aria-hidden="true" focusable="false" data-specimen="7k">
        <path d="M0 14 C30 4 50 18 80 10 S130 2 160 12 S220 20 250 8 S320 0 360 12 L400 8 V100 H0 Z"></path>
      </svg>

      <div class="contact__content">
        <p class="contact__label">{t('contact.label')}</p>
        <p class="contact__badge">{data.badge}</p>
        <h2 class="contact__title" id="contact-title">{data.title}</h2>
        <p class="contact__sub">{data.subtitle}</p>

        <div class="result" data-ink data-specimen="10v">
          <p class="result__label">{t('contact.result.label')}</p>
          <span class="result__dan ink-stamp" style="--ink-delay: 0.9s">{dan}</span>
          <ul class="result__stats">
            <li class="result__stat">
              <span class="result__clip"><strong class="result__value ink-rise" style="--ink-delay: 0.2s">{systems}</strong></span>
              <span class="result__text">{t('contact.result.systems')}</span>
            </li>
            <li class="result__stat">
              <span class="result__clip"><strong class="result__value ink-rise" style="--ink-delay: 0.4s">{t('contact.result.yearsValue')}</strong></span>
              <span class="result__text">{t('contact.result.years')}</span>
            </li>
          </ul>
        </div>

        <div class="contact__actions">
          <div class="cta" data-specimen="11b">
            <span class="cta__aura" aria-hidden="true"></span>
            <a class="cta__link" href={whatsapp.url} target="_blank" rel="noopener noreferrer">
              <span>{data.ctaButtonText}</span>
              <InkIcon name="next" size={22} />
            </a>
          </div>
          <a class="contact__cv" href={CV_URL} target="_blank" rel="noopener noreferrer">
            <InkIcon name="download" size={22} />
            <span>{t('hero.btn.cv')}</span>
          </a>
          <button type="button" class="contact__sheet-btn" data-sheet-open="contact-sheet" aria-haspopup="dialog" aria-controls="contact-sheet">
            <span>{t('contact.channelsOpen')}</span>
            <span aria-hidden="true">▲</span>
          </button>
          <button type="button" class="hold" data-hold-to-send data-hold-href={whatsapp.url} aria-describedby="hold-hint" data-specimen="10y">
            <span class="hold__fill" aria-hidden="true"></span>
            <span class="hold__label">{t('contact.hold')}</span>
          </button>
          <p class="hold__hint" id="hold-hint">{t('contact.holdHint')}</p>
        </div>

        <div class="contact__channels">
          <h3 class="contact__channels-title">{t('contact.channels')}</h3>
          <ChannelList channels={data.channels} />
        </div>
      </div>
    </div>
  </div>

  <div class="credits" data-ink-scene>
    <div class="credits__stage">
      <div class="credits__roll" aria-hidden="true" data-specimen="10z">
        <p class="credits__kicker">{t('contact.credits')}</p>
        {projects.map((project) => (
          <p class="credits__entry"><span class="credits__role">{project.role}</span><span class="credits__work">{project.name}</span></p>
        ))}
        <p class="credits__entry"><span class="credits__work">{t('header.name')}</span></p>
      </div>
      <p class="credits__end">{t('contact.end')}</p>
    </div>
  </div>

  <footer class="contact__footer">
    <p>{t('contact.footer')}</p>
  </footer>

  <dialog class="sheet" id="contact-sheet" aria-labelledby="contact-sheet-title" data-specimen="7h">
    <div class="sheet__panel">
      <span class="sheet__grip" aria-hidden="true"></span>
      <h3 class="sheet__title" id="contact-sheet-title">{t('contact.sheetTitle')}</h3>
      <ChannelList channels={data.channels} />
      <form method="dialog">
        <button class="sheet__close" autofocus>{t('contact.close')}</button>
      </form>
    </div>
  </dialog>
</section>

<style is:global>
  /* ---- Static layout (reduced motion, no JS, and the base for both widths) ---- */
  .contact { position: relative; background: var(--panel-dark); color: var(--panel-dark-fg); }
  .contact__stage { position: relative; box-sizing: border-box; padding: calc(var(--header-h) + var(--section-pad)) var(--gutter) calc(var(--section-pad) * 2); }
  .contact__curtain { display: none; }
  .contact__content { display: grid; gap: 22px; justify-items: start; }
  .contact__label, .contact__badge { margin: 0; font: 600 var(--fs-caption) / 1.2 var(--font-mono); letter-spacing: var(--tracking-meta); text-transform: uppercase; color: color-mix(in oklab, var(--panel-dark-fg) 65%, transparent); }
  .contact__title { margin: 0; max-width: 16em; font: 700 var(--fs-h2) / 1.05 var(--font-serif); letter-spacing: var(--tracking-heading); }
  .contact__sub { margin: 0; max-width: 40em; font: 400 var(--fs-lede) / 1.35 var(--font-serif); color: color-mix(in oklab, var(--panel-dark-fg) 82%, transparent); }

  /* 10v result screen (desktop only). */
  .result { display: none; }

  .contact__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
  .contact__sheet-btn, .hold, .hold__hint { display: none; }

  /* 11b: aura swells behind the CTA on hover / focus (transform and opacity only). */
  .cta { position: relative; display: inline-block; --e: cubic-bezier(0.16, 1, 0.3, 1); }
  .cta__aura { position: absolute; inset: -34px -48px; border-radius: 50%; background: radial-gradient(closest-side, color-mix(in oklab, var(--seal-red) 85%, transparent), color-mix(in oklab, var(--seal-red) 25%, transparent) 55%, transparent 75%); opacity: 0; transform: scale(0.7); transition: opacity 0.4s var(--e), transform 0.6s var(--e); pointer-events: none; }
  .cta:hover .cta__aura, .cta:focus-within .cta__aura { opacity: 1; transform: scale(1.05); }
  .cta__link { position: relative; display: inline-flex; align-items: center; gap: 12px; min-height: 56px; padding: 0 28px; border: 2px solid var(--panel-dark-fg); background: var(--panel-dark-fg); color: var(--panel-dark); font: 700 var(--fs-body) / 1 var(--font-sans); text-decoration: none; }
  .contact__cv { display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 20px; border: 2px solid var(--panel-dark-fg); color: inherit; font: 600 var(--fs-caption) / 1 var(--font-mono); letter-spacing: var(--tracking-meta); text-transform: uppercase; text-decoration: none; }
  .cta__link:focus-visible, .contact__cv:focus-visible, .contact__sheet-btn:focus-visible, .hold:focus-visible { outline: 3px solid var(--accent-amber); outline-offset: 4px; }

  .contact__channels { width: min(100%, 560px); }
  .contact__channels-title { margin: 0 0 10px; font: 600 11px / 1 var(--font-mono); letter-spacing: var(--tracking-meta); text-transform: uppercase; color: color-mix(in oklab, var(--panel-dark-fg) 65%, transparent); }

  /* 10z credits: the roll only exists on the desktop pin; the end line is always there. */
  .credits { display: grid; place-items: center; padding: 14svh var(--gutter); border-top: 1px solid var(--panel-dark-border); }
  .credits__stage { display: grid; place-items: center; }
  .credits__roll { display: none; }
  .credits__end { margin: 0; text-align: center; font: 700 clamp(32px, 6vw, 96px) / 1.05 var(--font-serif); letter-spacing: var(--tracking-heading); }
  .contact__footer { padding: 22px var(--gutter) calc(22px + env(safe-area-inset-bottom)); border-top: 1px solid var(--panel-dark-border); font: 400 var(--fs-caption) / 1.4 var(--font-mono); color: color-mix(in oklab, var(--panel-dark-fg) 65%, transparent); }
  .contact__footer p { margin: 0; }

  /* 7h bottom sheet: a native modal dialog (Esc closes, focus is trapped, backdrop dims). */
  .sheet { position: fixed; inset: 0; width: 100%; max-width: none; height: 100%; max-height: none; margin: 0; padding: 0; border: 0; background: transparent; color: var(--text-main); }
  .sheet[open] { display: grid; align-items: end; }
  .sheet::backdrop { background: rgba(28, 26, 23, 0.62); }
  .sheet__panel { box-sizing: border-box; display: grid; gap: 14px; max-height: 88svh; overflow-y: auto; padding: 12px var(--gutter) calc(20px + env(safe-area-inset-bottom)); background: var(--paper); border-top: 4px solid var(--text-main); }
  .sheet__grip { justify-self: center; width: 44px; height: 5px; background: var(--border-strong); }
  .sheet__title { margin: 0; font: 700 var(--fs-h3) / 1.1 var(--font-serif); }
  .sheet__close { width: 100%; min-height: 48px; border: 2px solid var(--text-main); background: transparent; color: var(--text-main); font: 600 var(--fs-caption) / 1 var(--font-mono); letter-spacing: var(--tracking-meta); text-transform: uppercase; cursor: pointer; }
  .sheet__close:focus-visible { outline: 3px solid var(--accent-blue); outline-offset: 3px; }

  /* ---- Desktop: result screen beside the copy ---- */
  @media (min-width: 1024px) {
    .contact__content { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); column-gap: 6vw; align-items: start; grid-template-areas: 'label result' 'badge result' 'title result' 'sub result' 'actions result' 'channels result'; }
    .contact__label { grid-area: label; }
    .contact__badge { grid-area: badge; }
    .contact__title { grid-area: title; }
    .contact__sub { grid-area: sub; }
    .contact__actions { grid-area: actions; }
    .contact__channels { grid-area: channels; }
    .result { grid-area: result; position: relative; display: grid; gap: 22px; align-content: start; padding: 32px; border: 2px solid var(--panel-dark-fg); background: var(--paper); color: var(--text-main); box-shadow: 8px 8px 0 color-mix(in oklab, var(--panel-dark-fg) 25%, transparent); }
    .result__label { margin: 0; font: 600 11px / 1 var(--font-mono); letter-spacing: var(--tracking-meta); }
    .result__dan { position: absolute; right: 22px; top: 18px; padding: 8px 10px; border: 3px solid var(--seal-red); color: var(--seal-red); font: 700 16px / 1 var(--font-mono); text-transform: uppercase; rotate: -5deg; }
    .result__stats { display: grid; gap: 18px; margin: 0; padding: 0; list-style: none; }
    .result__stat { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); align-items: end; gap: 16px; padding-top: 14px; border-top: 2px solid var(--text-main); }
    .result__clip { display: block; overflow: hidden; padding-bottom: 0.08em; }
    .result__value { display: block; font: 700 clamp(56px, 6vw, 104px) / 1 var(--font-serif); letter-spacing: var(--tracking-heading); }
    .result__text { font: 600 var(--fs-caption) / 1.3 var(--font-mono); letter-spacing: var(--tracking-meta); text-transform: uppercase; }
  }

  /* ---- Desktop motion: 10z credits roll on a pinned stage ---- */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    html.js .credits { display: block; height: 260svh; padding: 0; }
    html.js .credits__stage { position: sticky; top: 0; height: 100svh; overflow: hidden; }
    html.js .credits__roll { display: grid; gap: 28px; position: absolute; left: 50%; top: 0; width: min(640px, 80vw); translate: -50% 0; text-align: center; transform: translateY(calc(100svh - var(--p, 0) * 235svh)); opacity: calc(1 - clamp(0, calc((var(--p, 0) - 0.72) / 0.12), 1)); will-change: transform, opacity; }
    html.js .credits__kicker { margin: 0; font: 600 var(--fs-caption) / 1 var(--font-mono); letter-spacing: var(--tracking-meta); color: color-mix(in oklab, var(--panel-dark-fg) 65%, transparent); }
    html.js .credits__entry { display: grid; gap: 6px; margin: 0; }
    html.js .credits__role { font: 400 var(--fs-caption) / 1.3 var(--font-mono); letter-spacing: var(--tracking-meta); text-transform: uppercase; color: color-mix(in oklab, var(--panel-dark-fg) 65%, transparent); }
    html.js .credits__work { font: 700 clamp(28px, 3.4vw, 52px) / 1.1 var(--font-serif); }
    html.js .credits__end { --e: clamp(0, calc((var(--p, 0) - 0.8) / 0.15), 1); opacity: var(--e); transform: translateY(calc((1 - var(--e)) * 24px)); }
  }

  /* ---- Mobile / tablet ---- */
  @media (max-width: 1023.98px) {
    .contact__sub { display: none; }
    /* With JS: hold-to-send replaces the plain CTA and the sheet replaces the inline list. */
    html.js .cta { display: none; }
    html.js .contact__sheet-btn { display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 20px; border: 2px solid var(--panel-dark-fg); background: transparent; color: inherit; font: 600 var(--fs-caption) / 1 var(--font-mono); letter-spacing: var(--tracking-meta); text-transform: uppercase; cursor: pointer; }
    html.js .hold { position: relative; display: inline-flex; align-items: center; justify-content: center; overflow: hidden; width: 100%; max-width: 360px; min-height: 56px; padding: 0 20px; border: 2px solid var(--panel-dark-fg); background: transparent; color: var(--panel-dark-fg); font: 700 var(--fs-body) / 1 var(--font-sans); touch-action: manipulation; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; cursor: pointer; }
    html.js .hold__fill { position: absolute; inset: 0; background: var(--seal-red); transform: scaleX(0); transform-origin: left center; transition: transform 0.2s ease-out; }
    html.js .hold.is-holding .hold__fill { transform: scaleX(1); transition: transform 1.2s linear; }
    html.js .hold__label { position: relative; }
    html.js .hold__hint { display: block; flex-basis: 100%; margin: 0; font: 400 12px / 1.4 var(--font-sans); color: color-mix(in oklab, var(--panel-dark-fg) 65%, transparent); }
    html.js .contact__channels { display: none; }
  }
  @media (min-width: 1024px) {
    .sheet, .contact__sheet-btn, .hold, .hold__hint { display: none !important; }
  }

  /* 7k curtain: pinned stage, the ink rises with --p (transform only), content fades in. */
  @media (max-width: 1023.98px) and (prefers-reduced-motion: no-preference) {
    html.js .contact__scene { height: 170svh; --k: clamp(0, calc(var(--p, 0) / 0.5), 1); --f: clamp(0, calc((var(--p, 0) - 0.4) / 0.25), 1); }
    html.js .contact__stage { position: sticky; top: 0; height: 100svh; padding-bottom: var(--section-pad); overflow: hidden; display: grid; align-content: center; background: var(--paper); }
    html.js .contact__curtain { display: block; position: absolute; left: 0; top: 0; width: 100%; height: 112%; z-index: 0; fill: var(--panel-dark); transform: translateY(calc(100% - var(--k) * 125%)); will-change: transform; }
    html.js .contact__content { position: relative; z-index: 1; opacity: var(--f); transform: translateY(calc((1 - var(--f)) * 24px)); }
  }

  /* 7h sheet animates in (transform / opacity) unless reduced motion is requested. */
  @keyframes sheet-up {
    from { transform: translateY(100%); }
    to { transform: translateY(0); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .sheet[open] .sheet__panel { animation: sheet-up 0.35s cubic-bezier(0.16, 1, 0.3, 1) 1 both; }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact__curtain { display: none; }
    .cta__aura { transition: none; }
  }
</style>
