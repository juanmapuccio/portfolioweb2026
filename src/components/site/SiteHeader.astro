---
// Persistent header (S0). Composes the catalog pieces: 11j brush stroke under the active
// link (desktop only; the nav is hidden on mobile), 11m language stamp, and the belt
// progress line (1g / 7b) at the bottom.
// Runtime state lives in src/scripts/ink.ts: `.is-active` + aria-current on the link of
// the section in view, `data-belt` on <html> (colours the progress line through
// --ink-belt-*), `--page-p` on this element (scaleX of the line) and the desktop
// hide-on-scroll (11k, `data-header-hidden` on <html>).
// TODO(11t): the language switch keeps the 11m puff (static filtered svg) as the smoke
// placeholder until the 11t sprite asset exists.
import InkNavStroke from '../ink/InkNavStroke.astro';
import InkLangStamp from '../ink/InkLangStamp.astro';
import { siteSections } from '../../data/sections';
import { languages, useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
  preview?: boolean;
  active?: number;
}
const { lang = 'es', preview = false, active = -1 } = Astro.props;
const t = useTranslations(lang);

const items = siteSections.map((section) => ({ label: t(section.label), href: `#${section.id}` }));
const localePaths: Record<Lang, string> = { es: '/', en: '/en/', pt: '/pt/' };
const codes = Object.keys(languages) as Lang[];
const langLinks = codes.map((code) => ({ href: localePaths[code], name: languages[code], code }));
const hookAttr = preview ? { 'data-site-header-preview': '' } : { 'data-site-header': '' };
---

<div class:list={['site-header', { 'site-header--preview': preview }]} {...hookAttr} style={preview ? '--page-p: 0.6' : undefined}>
  <InkNavStroke brand={t('header.name')} brandShort={t('header.nameShort')} items={items} active={active} navLabel={t('nav.label')}>
    <span slot="after-brand" class="site-header__avail">
      <span class="site-header__dot" aria-hidden="true"></span>
      <span class="site-header__status">{t('header.status')}</span>
    </span>
    <InkLangStamp
      slot="end"
      langs={codes.map((code) => code.toUpperCase())}
      active={codes.indexOf(lang)}
      label={t('header.lang')}
      links={langLinks}
    />
  </InkNavStroke>
  <div class="site-header__progress" aria-hidden="true"><span class="site-header__bar"></span></div>
</div>

<style is:global>
  /* Active belt colour, set by ink.ts through html[data-belt]. Default: white. */
  html { --belt-now: var(--ink-belt-white); }
  html[data-belt='blanco'] { --belt-now: var(--ink-belt-white); }
  html[data-belt='amarillo'] { --belt-now: var(--ink-belt-yellow); }
  html[data-belt='verde'] { --belt-now: var(--ink-belt-green); }
  html[data-belt='azul'] { --belt-now: var(--ink-belt-blue); }
  html[data-belt='rojo'] { --belt-now: var(--ink-belt-red); }
  html[data-belt='negro'] { --belt-now: var(--ink-belt-black); }

  .site-header { position: fixed; top: 0; left: 0; right: 0; z-index: 50; height: var(--header-h); transform: translateZ(0); will-change: transform; transition: transform 0.35s var(--reveal-easing); }
  .site-header--preview { position: relative; z-index: auto; }
  .site-header .ink-11j {
    height: var(--header-h);
    padding: 0 var(--gutter);
    gap: 12px;
    transition: background-color 0.4s var(--reveal-easing), border-color 0.4s var(--reveal-easing), color 0.4s var(--reveal-easing);
  }
  .site-header .ink-11j__brand { white-space: nowrap; }

  .site-header__avail { display: inline-flex; align-items: center; gap: 8px; }
  .site-header__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ok-green); }
  .site-header__status {
    font: 600 10px/1 var(--font-mono);
    letter-spacing: var(--tracking-meta);
    color: var(--text-dim);
    transition: color 0.4s var(--reveal-easing);
  }

  /* Chameleon mode over Hero scene: blends seamlessly with the dark manga ground */
  html[data-in-hero] .site-header .ink-11j {
    background: rgba(28, 26, 23, 0.72);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(244, 239, 228, 0.12);
    color: var(--paper);
  }
  html[data-in-hero] .site-header__status {
    color: rgba(244, 239, 228, 0.65);
  }
  html[data-in-hero] .site-header .ink-11j__link {
    color: var(--paper);
  }
  html[data-in-hero] .site-header .ink-11m__lang {
    color: var(--paper);
  }
  html[data-in-hero] .site-header .ink-11m__c {
    fill: rgba(244, 239, 228, 0.65);
  }
  html[data-in-hero] .site-header__progress {
    background: rgba(244, 239, 228, 0.08);
  }

  /* Touch targets >= 44px. Links grow in height; the stroke sits inside the taller box.
     Language options grow through ::after (28px + 16px gap = 44px step, 22px + 22px). */
  .site-header .ink-11j__link { display: inline-flex; align-items: center; min-height: 44px; padding: 0 4px; }
  .site-header .ink-11j__stroke { bottom: 8px; }
  .site-header .ink-11m__lang::after { content: ''; position: absolute; inset: -11px -8px; }
  .site-header .ink-11m { margin-left: auto; }

  /* One dry filter per viewport instead of one per link: the 11j filter attribute is
     neutralised and re-applied only to the active or hovered stroke (static element). */
  .site-header .ink-11j__stroke g { filter: none; }
  .site-header .ink-11j__link.is-active .ink-11j__stroke g,
  .site-header .ink-11j__link:hover .ink-11j__stroke g,
  .site-header .ink-11j__link:focus-visible .ink-11j__stroke g { filter: url(#dryH); }

  .site-header a:focus-visible { outline: 2px solid var(--accent-blue); outline-offset: 2px; }

  .site-header__progress { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: var(--border-subtle); pointer-events: none; }
  .site-header__bar { display: block; height: 100%; transform-origin: left center; transform: scaleX(var(--page-p, 0)); background: var(--belt-now, var(--ink-belt-white)); box-shadow: inset 0 -1px 0 var(--border-strong); transition: background-color 0.4s var(--reveal-easing); }

  .site-header .ink-11j nav { display: none; }
  .site-header__status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  @media (min-width: 768px) {
    .site-header .ink-11j nav { display: block; margin-left: auto; margin-right: 24px; }
    .site-header .ink-11m { margin-left: 0; }
    .site-header__status { position: static; width: auto; height: auto; overflow: visible; clip-path: none; }
    /* 11k: hide on scroll down, keep hidden on scroll up.
       Reveals when the user hovers over the top edge or when focusing inside. */
    html[data-header-hidden] .site-header[data-site-header]:not(:focus-within) {
      transform: translateY(calc(-100% + 3px));
    }
    html[data-header-hidden] .site-header[data-site-header]::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      height: 18px;
      pointer-events: auto;
    }
    html[data-header-hidden] .site-header[data-site-header]:hover {
      transform: translateY(0);
    }
  }
  @media (max-width: 767.98px) {
    .site-header .ink-11j__brand-full { display: none; }
    .site-header .ink-11j__brand-short { display: inline; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header { transition: none; }
    .site-header__bar { transition: none; }
  }
</style>
