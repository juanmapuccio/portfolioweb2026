---
// Specimen 2d: bamboo that grows with the belts scene `--p` (mobile / tablet scrub).
// A stalk scales up from the bottom and one ring (node) appears per belt.
// Decorative. transform / opacity only, no filter (mobile perf budget).
interface Props {
  count: number;
}
const { count } = Astro.props;
const last = Math.max(1, count - 1);
const nodes = Array.from({ length: count }, (_, i) => ({ at: i / last, y: 96 - (i / last) * 92 }));
---

<div class="bamboo" aria-hidden="true" data-specimen="2d">
  <svg class="bamboo__svg" viewBox="0 0 16 100" preserveAspectRatio="none" focusable="false">
    <rect class="bamboo__stalk" x="5" y="0" width="6" height="100" rx="3"></rect>
    {nodes.map((node) => (
      <rect class="bamboo__ring" x="2" y={node.y.toFixed(2)} width="12" height="2.2" rx="1.1" style={`--at: ${node.at.toFixed(4)}`}></rect>
    ))}
  </svg>
</div>

<style is:global>
  .bamboo { display: none; }
  .bamboo__svg { display: block; width: 100%; height: 100%; }
  .bamboo__stalk { fill: var(--ink-belt-green); opacity: 0.85; transform-box: fill-box; transform-origin: bottom; transform: scaleY(var(--p, 1)); }
  .bamboo__ring { fill: var(--text-main); opacity: clamp(0, calc((var(--p, 1) - var(--at) + 0.03) * 20), 1); }
</style>
