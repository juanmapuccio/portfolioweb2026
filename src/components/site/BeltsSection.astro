---
// S2 Cinturones. One responsive tree, six chapters from src/data/martialExperience.ts.
// Desktop (>=1024, motion allowed, JS): 700svh section, sticky stage, a horizontal track of
// six chapters scrubbed by the section's `--p` (10d chapter cards), 10o rail on top, 6b
// brush wipe at the mid-point of every segment, 6d enso before the 1o dan, then a soft ink
// bloom (no glyph, no flash) as the black belt lands.
// Mobile / tablet (<1024): 7c sticky stacked cards, 2d bamboo growing with --p, and one 7e
// drip per belt change (InkDrip).
// Reduced motion / no JS: chapters stacked in a plain column, final states, no flashes.
// Active belt: ink.ts reads [data-belt-scene] + [data-belt-chapter] and sets <html data-belt>.
// TODO(raster): flat --paper stands in for the washi texture behind the wipes.
import InkUnderlineSweep from '../ink/InkUnderlineSweep.astro';
import BeltRail from './BeltRail.astro';
import BambooGrow from './BambooGrow.astro';
import InkDrip from './InkDrip.astro';
import { BELTS, martialExperienceData, type MartialStage } from '../../data/martialExperience';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

type Tone = 'white' | 'yellow' | 'green' | 'blue' | 'red' | 'black';
const toneOf: Record<MartialStage['beltKey'], Tone> = {
  blanco: 'white',
  amarillo: 'yellow',
  verde: 'green',
  azul: 'blue',
  rojo: 'red',
  negro: 'black',
};

const stages = martialExperienceData[lang].stages;
const chapters = stages.map((stage, i) => {
  const belt = BELTS[stage.beltKey];
  const orgs = [...new Set(stage.positions.map((position) => position.org))].join(' · ');
  return {
    index: i,
    number: String(i + 1).padStart(2, '0'),
    key: stage.beltKey,
    tone: toneOf[stage.beltKey],
    grade: belt.gup,
    beltName: belt.beltName[lang],
    title: stage.title,
    years: stage.years,
    line: belt.symbolism[lang],
    orgs,
  };
});
const railNodes = chapters.map((chapter) => ({ grade: chapter.grade, tone: chapter.tone }));
---

<section id="cinturones" class="belts" data-belt="amarillo" data-belt-scene data-ink-scene style={`--count: ${chapters.length}`}>
  <div class="belts__stage">
    <div class="belts__wipes" aria-hidden="true">
      {chapters.slice(1).map((chapter) => (
        <span class="belt-wipe" style={`--i: ${chapter.index}; --tone: var(--ink-belt-${chapter.tone})`}></span>
      ))}
    </div>

    <svg class="belts__enso" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
      <circle cx="50" cy="50" r="42" pathLength="1" fill="none" stroke-width="3.2" stroke-linecap="round"></circle>
    </svg>

    <div class="belts__head">
      <h2 class="belts__label">{t('belts.label')}</h2>
      <BeltRail nodes={railNodes} />
    </div>

    <ol class="belts__track">
      {chapters.map((chapter) => (
        <li class="chapter" data-belt={chapter.key} data-belt-chapter style={`--i: ${chapter.index}; --tone: var(--ink-belt-${chapter.tone})`}>
          {chapter.index > 0 && <InkDrip class="chapter__drip" tone={chapter.tone} />}
          <article class="chapter__card" data-ink>
            <span class="chapter__band" aria-hidden="true"></span>
            <header class="chapter__head">
              <span class="chapter__no">{t('belts.chapter')} {chapter.number}</span>
              <span class="chapter__grade">{chapter.grade}</span>
              <span class="chapter__years">{chapter.years}</span>
            </header>
            <div class="chapter__title" role="heading" aria-level="3">
              <InkUnderlineSweep eyebrow={chapter.beltName} title={chapter.title} tone={chapter.tone} />
            </div>
            <p class="chapter__line">{chapter.line}</p>
            <p class="chapter__orgs">{chapter.orgs}</p>
            {chapter.key === 'negro' && <span class="chapter__seal ink-stamp" aria-hidden="true">JMP</span>}
          </article>
        </li>
      ))}
    </ol>

    <span class="belts__bloom" aria-hidden="true"></span>
  </div>
  <div class="belts__bamboo"><BambooGrow count={chapters.length} /></div>
</section>

<style is:global>
  /* ---- Static layout (reduced motion, no JS): a plain column of chapter cards ---- */
  .belts { position: relative; background: var(--paper); color: var(--text-main); }
  .belts__stage { position: relative; padding: calc(var(--header-h) + var(--section-pad)) var(--gutter) var(--section-pad); }
  .belts__head { display: grid; gap: 14px; margin-bottom: 20px; }
  .belts__label { margin: 0; font: 600 var(--fs-caption) / 1 var(--font-mono); letter-spacing: var(--tracking-meta); text-transform: uppercase; color: var(--text-dim); }
  .belts__track { display: flex; flex-direction: column; gap: 20px; margin: 0; padding: 0; list-style: none; }

  .chapter { position: relative; }
  .chapter__card { position: relative; display: grid; gap: 14px; box-sizing: border-box; padding: 28px 22px 22px 34px; border: 2px solid var(--text-main); background: var(--paper); box-shadow: 6px 6px 0 rgba(28, 26, 23, 0.16); }
  .chapter__band { position: absolute; left: 0; top: 0; bottom: 0; width: 12px; background: var(--tone); border-right: 2px solid var(--text-main); }
  .chapter__head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px; font: 600 11px/1 var(--font-mono); letter-spacing: var(--tracking-meta); text-transform: uppercase; color: var(--text-dim); }
  .chapter__no { color: var(--text-main); }
  .chapter__years { margin-left: auto; color: var(--text-main); }
  .chapter .ink-1a { max-width: none; padding: 0; }
  .chapter .ink-1a__title { font-size: clamp(34px, 9vw, 56px); line-height: 1.05; }
  .chapter__line { margin: 0; font: 400 var(--fs-lede) / 1.35 var(--font-serif); }
  .chapter__orgs { margin: 0; font: 400 var(--fs-caption) / 1.4 var(--font-mono); color: var(--text-dim); }
  .chapter__seal { position: absolute; right: 18px; bottom: 16px; display: grid; place-items: center; width: 52px; height: 52px; border: 3px solid var(--seal-red); color: var(--seal-red); font: 700 14px/1 var(--font-serif); letter-spacing: 0.06em; rotate: -5deg; }

  /* Desktop-only layers are hidden in the static layout. */
  .belts__wipes, .belts__enso, .belts__bloom, .belts__bamboo { display: none; }

  @media (min-width: 1024px) {
    .belts__track { gap: 32px; }
    .chapter__card { width: min(980px, 100%); padding: 40px 48px 36px 60px; margin: 0 auto; }
    .chapter .ink-1a__title { font-size: clamp(48px, 5.4vw, 92px); }
    .chapter__band { width: 18px; }
    .chapter__line { font-size: clamp(20px, 1.8vw, 28px); max-width: 28em; }
  }

  /* ---- Mobile / tablet scrub: 7c sticky stacked cards + 2d bamboo ---- */
  @media (max-width: 1023.98px) and (prefers-reduced-motion: no-preference) {
    html.js .belts__track { display: block; }
    html.js .chapter { position: sticky; top: calc(var(--header-h) + 16px + var(--i) * 12px); height: calc(100svh - var(--header-h) - 56px); margin-bottom: calc(var(--header-h) + 56px); z-index: calc(1 + var(--i)); }
    html.js .chapter:last-child { margin-bottom: 0; }
    html.js .chapter__card { height: 100%; align-content: start; background: var(--paper); }
    html.js .chapter__drip { top: -24px; }
    html.js .belts__bamboo { display: block; position: absolute; right: 3px; top: 0; bottom: 0; width: 14px; z-index: 40; pointer-events: none; }
    html.js .belts__bamboo .bamboo { display: block; position: sticky; top: var(--header-h); height: calc(100svh - var(--header-h) - 24px); }
  }

  /* ---- Desktop scrub: pinned horizontal track ---- */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    html.js .belts { height: 700svh; }
    html.js .belts__stage { position: sticky; top: 0; height: 100svh; padding: 0; overflow: hidden; }

    html.js .belts__wipes { display: block; position: absolute; inset: 0; z-index: 0; }
    /* 6b: belt colour wipes in, left to right, at the mid-point of each segment. */
    html.js .belt-wipe { position: absolute; inset: 0; background: var(--tone); --w: clamp(0, calc((var(--p, 0) - (var(--i) - 0.5) / 5 + 0.05) / 0.1), 1); clip-path: inset(0 calc((1 - var(--w)) * 100%) 0 0); }

    html.js .belts__head { position: absolute; left: var(--gutter); right: var(--gutter); top: calc(var(--header-h) + 18px); z-index: 4; display: flex; align-items: center; gap: 24px; margin: 0; padding: 12px 20px 22px; border: 2px solid var(--text-main); background: var(--paper); }
    html.js .belts__label { flex: none; }
    html.js .belt-rail { display: flex; flex: 1; padding: 0 14px; }

    html.js .belts__track { position: absolute; inset: 0; z-index: 2; width: calc(var(--count) * 100%); flex-direction: row; gap: 0; transform: translateX(calc(var(--p, 0) * -1 * (var(--count) - 1) / var(--count) * 100%)); will-change: transform; }
    html.js .chapter { flex: 0 0 calc(100% / var(--count)); display: grid; place-items: center; box-sizing: border-box; padding: calc(var(--header-h) + 150px) var(--gutter) 48px; height: 100%; }
    html.js .chapter__drip { display: none; }

    /* 6d enso: draws before the 1o dan, then fades. */
    html.js .belts__enso { display: block; position: absolute; left: 50%; top: 52%; z-index: 1; width: min(78vh, 62vw); height: auto; translate: -50% -50%; pointer-events: none; stroke: var(--paper); fill: none; --e: clamp(0, calc((var(--p, 0) - 0.76) / 0.12), 1); opacity: clamp(0, calc((0.96 - var(--p, 0)) / 0.03), 1); }
    html.js .belts__enso circle { stroke-dasharray: 1; stroke-dashoffset: calc(1 - var(--e)); }

    /* 6e: no glyph. After the enso closes, a soft ink bloom grows behind the last chapter (transform + opacity only). */
    html.js .belts__bloom { display: block; position: absolute; left: 50%; top: 52%; z-index: 1; width: min(120vh, 96vw); aspect-ratio: 1; translate: -50% -50%; border-radius: 50%; pointer-events: none; background: radial-gradient(circle, var(--ink-belt-black) 0%, rgba(28, 26, 23, 0.55) 38%, transparent 68%); --bloom: clamp(0, calc((var(--p, 0) - 0.9) / 0.1), 1); transform: scale(calc(0.2 + 1.2 * var(--bloom))); opacity: calc(0.4 * var(--bloom)); will-change: transform, opacity; }
    html.js .chapter__seal { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .belts__wipes, .belts__enso, .belts__bloom, .belts__bamboo { display: none; }
  }
</style>
