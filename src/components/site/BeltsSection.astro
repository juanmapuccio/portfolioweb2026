---
import type { Lang } from '../../i18n/ui';
interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
---

<section id="cinturones" class="belts" data-belt="amarillo" data-belt-scene data-ink-scene data-ink-smooth>
  <div class="belts__stage">
    <div data-belt3d-slot data-slot style="display:none;"></div>
  </div>
</section>

<style>
  .belts {
    position: relative;
    min-height: 100vh;
    background: var(--paper, #f2eee6);
  }
</style>
