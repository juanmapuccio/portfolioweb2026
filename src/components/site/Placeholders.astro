---
// Temporary empty sections so the header nav and progress line can be exercised before
// the remaining sections land. Sections that already have a real component (S1 hero in
// HeroSection, S2 belts in BeltsSection) are skipped here; remove ids from `real` as each
// sub-phase replaces its placeholder, and delete this file once the list is empty.
import { siteSections } from '../../data/sections';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const real = new Set<string>(['hero', 'cinturones']);
const pending = siteSections.filter((section) => !real.has(section.id));
---

{pending.map((section) => (
  <section id={section.id} data-belt={section.belt} class="ph-section" style={`--ph-belt: var(--ink-belt-${section.token})`}>
    <p class="ph-label">{t(section.label)}</p>
  </section>
))}

<style>
  .ph-section { min-height: 100svh; box-sizing: border-box; padding: calc(var(--header-h) + var(--section-pad)) var(--gutter) var(--section-pad); border-left: 8px solid var(--ph-belt); }
  .ph-label { margin: 0; font: 600 var(--fs-caption) / 1 var(--font-mono); letter-spacing: var(--tracking-meta); text-transform: uppercase; color: var(--text-dim); }
</style>
