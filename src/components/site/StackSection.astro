---
// S5 Stack. Five 10r tech scrolls from src/data/skills.ts (categories): each parchment drops
// down once (clip-path, enter mode) with a stagger on desktop.
// Desktop / tablet (>=640): the scrolls sit in a row (auto-fit grid, five on desktop).
// Mobile (<640): the same scrolls stacked in one column, items as chips.
// Exit 10n: a hanging scroll that unrolls with --p and teases the principles section
// (InkExit, scene driven by src/scripts/ink.ts).
// Reduced motion / no JS: scrolls visible and static, no exit.
import InkExit from './InkExit.astro';
import { skillsData } from '../../data/skills';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const categories = skillsData[lang].categories;
---

<section id="stack" class="stack" data-belt="negro" aria-labelledby="stack-title">
  <div class="stack__inner">
    <header class="stack__head">
      <p class="stack__label">{t('stack.label')}</p>
      <h2 class="stack__title" id="stack-title">{t('stack.title')}</h2>
      <p class="stack__kicker">{t('stack.kicker')}</p>
    </header>

    <ol class="stack__scrolls">
      {categories.map((category, i) => (
        <li class="tscroll" style={`--i: ${i}`} data-ink data-specimen="10r">
          <article class="tscroll__sheet">
            <span class="tscroll__rod" aria-hidden="true"></span>
            <p class="tscroll__no">{String(i + 1).padStart(2, '0')} · {category.badge}</p>
            <h3 class="tscroll__title">{category.title}</h3>
            <ul class="tscroll__items">
              {category.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <span class="tscroll__rod" aria-hidden="true"></span>
          </article>
        </li>
      ))}
    </ol>
  </div>

  <InkExit variant="scroll" mark="06" label={t('principles.label')} />
</section>

<style is:global>
  .stack { position: relative; background: var(--bg-primary); color: var(--text-main); }
  .stack__inner { box-sizing: border-box; padding: calc(var(--header-h) + var(--section-pad)) var(--gutter) calc(var(--section-pad) * 2); }
  .stack__head { display: grid; gap: 12px; margin-bottom: 36px; }
  .stack__label, .stack__kicker { margin: 0; font: 600 var(--fs-caption) / 1.2 var(--font-mono); letter-spacing: var(--tracking-meta); text-transform: uppercase; color: var(--text-dim); }
  .stack__title { margin: 0; font: 700 var(--fs-h2) / 1.05 var(--font-serif); letter-spacing: var(--tracking-heading); max-width: 16em; }

  .stack__scrolls { display: grid; grid-template-columns: 1fr; gap: 20px; margin: 0; padding: 0; list-style: none; }
  .tscroll { --d: 0s; --e: cubic-bezier(0.16, 1, 0.3, 1); }

  /* 10r scroll: parchment hanging between two rods. */
  .tscroll__sheet { position: relative; display: flex; flex-direction: column; gap: 12px; box-sizing: border-box; height: 100%; padding: 0 18px 18px; background: var(--paper); border: 2px solid var(--text-main); box-shadow: 5px 5px 0 rgba(28, 26, 23, 0.16); }
  .tscroll__rod { display: block; height: 12px; margin: 0 -20px; background: var(--text-main); }
  .tscroll__rod:last-child { margin-top: auto; margin-bottom: -18px; }
  .tscroll__no { margin: 10px 0 0; font: 600 11px / 1.3 var(--font-mono); letter-spacing: var(--tracking-meta); text-transform: uppercase; color: var(--text-dim); }
  .tscroll__title { margin: 0; font: 700 clamp(20px, 1.9vw, 26px) / 1.15 var(--font-serif); letter-spacing: var(--tracking-heading); }
  .tscroll__items { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .tscroll__items li { padding: 5px 9px; border: 1px solid var(--border-strong); font: 500 12px / 1.25 var(--font-mono); }

  @media (min-width: 640px) {
    .stack__scrolls { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 22px; }
    .tscroll { --d: calc(var(--i) * 0.12s); }
  }
  @media (min-width: 1024px) {
    .stack__scrolls { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 18px; }
    .tscroll__items { display: grid; gap: 7px; }
    .tscroll__items li { padding: 0 0 7px; border: 0; border-bottom: 1px dashed var(--border-strong); font-size: 13px; }
  }

  /* Enter: each scroll drops once (clip-path) when it reaches the viewport. */
  @keyframes tscroll-drop {
    from { clip-path: inset(0 0 100% 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  html.js .tscroll:not(.is-in) .tscroll__sheet { clip-path: inset(0 0 100% 0); }
  html.js .tscroll.is-in .tscroll__sheet { animation: tscroll-drop 0.9s var(--e) var(--d, 0s) 1 both; }

  @media (prefers-reduced-motion: reduce) {
    html.js .tscroll:not(.is-in) .tscroll__sheet,
    html.js .tscroll.is-in .tscroll__sheet { animation: none; clip-path: none; }
  }
</style>
