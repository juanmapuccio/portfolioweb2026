---
// Page loader (S0). Desktop (>= 768px) shows the 11c ensō, mobile the 11g drop. Both
// are the catalog components in `controlled` mode: progress comes from real readiness
// (fonts + window load) and is driven by src/scripts/loader.ts, which also runs the
// curtain exit (translateY(-100%), 0.75s), stops/starts Lenis and sets aria-busy.
// Hidden without JS (html:not(.js)) and under prefers-reduced-motion.
// `preview` is the /lab variant: contained in its parent, no page side effects.
import InkLoaderEnso from '../ink/InkLoaderEnso.astro';
import InkLoaderDrop from '../ink/InkLoaderDrop.astro';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
  preview?: boolean;
  variant?: 'auto' | 'desktop' | 'mobile';
}
const { lang = 'es', preview = false, variant = 'auto' } = Astro.props;
const t = useTranslations(lang);
---

<div
  class:list={['site-loader', { 'site-loader--preview': preview }]}
  data-site-loader
  data-loader-preview={preview ? '' : undefined}
  data-variant={variant}
  role="status"
>
  <span class="site-loader__sr">{t('loader.loading')}</span>
  <div class="site-loader__panel site-loader__panel--desktop" aria-hidden="true">
    <InkLoaderEnso controlled label={t('loader.name')} />
    <span class="site-loader__status">{t('loader.loading')}</span>
  </div>
  <div class="site-loader__panel site-loader__panel--mobile" aria-hidden="true">
    <InkLoaderDrop controlled eyebrow={t('loader.eyebrow')} name={t('loader.name')} />
    <span class="site-loader__pill"><span data-loader-count>00</span> · {t('loader.loading')}</span>
  </div>
</div>

<style is:global>
  .site-loader { display: none; position: fixed; inset: 0; z-index: 100; overflow: hidden; background: var(--paper); color: var(--text-main); transition: transform 0.75s cubic-bezier(0.7, 0, 0.2, 1); }
  html.js .site-loader { display: block; }
  .site-loader.is-done { transform: translateY(-100%); pointer-events: none; }
  .site-loader[hidden] { display: none !important; }
  .site-loader--preview { position: absolute; z-index: 1; }

  .site-loader__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .site-loader__panel { display: none; position: absolute; inset: 0; }
  .site-loader[data-variant='desktop'] .site-loader__panel--desktop,
  .site-loader[data-variant='mobile'] .site-loader__panel--mobile { display: block; }
  @media (min-width: 768px) {
    .site-loader[data-variant='auto'] .site-loader__panel--desktop { display: block; }
  }
  @media (max-width: 767.98px) {
    .site-loader[data-variant='auto'] .site-loader__panel--mobile { display: block; }
  }

  /* Catalog components fill the panel instead of their specimen size. */
  .site-loader .ink-11c { max-width: none; height: 100%; min-height: 0; }
  .site-loader .ink-11g { min-height: 0; }
  .site-loader [data-loader-stroke] { transition: stroke-dashoffset 0.1s linear; }

  .site-loader__status { position: absolute; right: 24px; bottom: 20px; font: 600 10px/1 var(--font-mono); letter-spacing: var(--tracking-meta); color: var(--text-dim); }
  .site-loader__pill { position: absolute; left: 20px; top: 20px; padding: 6px 10px; font: 600 10px/1 var(--font-mono); letter-spacing: var(--tracking-meta); background: var(--seal-red); color: var(--paper); }

  @media (prefers-reduced-motion: reduce) {
    .site-loader:not(.site-loader--preview) { display: none !important; }
    .site-loader { transition: none; }
    .site-loader [data-loader-stroke] { transition: none; }
  }
</style>
