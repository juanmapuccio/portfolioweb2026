---
// S1 Hero as a manga page (catalog specimen 5a). Five panels on a black gutter grid drop
// in once, in order, after the loader exits: name, tagline, portrait (screentone dots over
// the real photo), role, scroll cue. The entrance is soft: ~1.1s per panel, a small
// travel (32px + scale .98 -> 1), stagger 150ms, ease cubic-bezier(.22, 1, .36, 1). No
// bounce, no flash, no zoom.
// Entrance trigger: `html.hero-ready`, added by src/scripts/loader.ts when the loader
// leaves (or at once without loader / under reduced motion). Without JS everything shows.
// Exit (scrubbed by the scene `--p`, ink.ts): the manga page drifts up and fades while a
// soft ink wash rises over the stage and hands over to the belts. Only transform and
// opacity change.
// Desktop (>=768): asymmetric grid. Mobile (<768): stacked panels, same cascade.
// Reduced motion: final state, no entrance, no scrub.
// TODO(raster): the dot screentone is a radial-gradient; an 8i raster can replace it.
import { Image } from 'astro:assets';
import portrait from '../../assets/fotojmPerfil.png';
import InkScrollDrop from '../ink/InkScrollDrop.astro';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const nameLines = t('header.name').split(' ');
---

<section id="hero" class="hero" data-belt="blanco" data-ink-scene aria-labelledby="hero-name">
  <div class="hero__stage">
    <div class="hero__manga">
      <div class="hero__panel hero__panel--name" data-panel="name" style="--k: 0">
        <h1 class="hero__name" id="hero-name">
          {nameLines.map((word) => <span class="hero__word">{word}</span>)}
        </h1>
      </div>
      <div class="hero__panel hero__panel--tagline" data-panel="tagline" style="--k: 1">
        <p class="hero__tagline">{t('hero.tagline')}</p>
      </div>
      <figure class="hero__panel hero__panel--portrait" data-panel="portrait" style="--k: 2">
        <Image src={portrait} alt={t('hero.portraitAlt')} widths={[480, 800, 1100]} sizes="(min-width: 768px) 40vw, 100vw" format="webp" loading="eager" fetchpriority="high" />
        <span class="hero__tone" aria-hidden="true"></span>
      </figure>
      <div class="hero__panel hero__panel--role" data-panel="role" style="--k: 3">
        <span class="hero__dot" aria-hidden="true"></span>
        <p class="hero__role">{t('hero.role')}</p>
        <p class="hero__fig">{t('hero.fig')}</p>
      </div>
      <div class="hero__panel hero__panel--cue" data-panel="cue" style="--k: 4">
        <InkScrollDrop label={t('hero.scroll')} />
      </div>
    </div>
    <span class="hero__wash" aria-hidden="true"></span>
  </div>
</section>

<style is:global>
  .hero { position: relative; background: var(--paper); color: var(--text-main); }

  .hero__stage { position: relative; box-sizing: border-box; min-height: 100svh; padding: var(--header-h) 0 0; overflow: hidden; }
  .hero__manga { box-sizing: border-box; display: grid; gap: 10px; min-height: calc(100svh - var(--header-h)); padding: 10px; background: var(--ink-belt-black); }

  .hero__panel { position: relative; box-sizing: border-box; margin: 0; overflow: hidden; background: var(--paper); }

  .hero__panel--name { display: flex; align-items: flex-end; padding: 20px 18px; }
  .hero__name { display: flex; flex-direction: column; margin: 0; font: 700 clamp(52px, 17vw, 96px) / 0.98 var(--font-serif); letter-spacing: var(--tracking-heading); }
  .hero__word { display: block; }

  .hero__panel--tagline { display: flex; align-items: center; padding: 20px 18px; }
  .hero__tagline { margin: 0; max-width: 16em; font: italic 400 clamp(22px, 6.4vw, 34px) / 1.25 var(--font-serif); }

  .hero__panel--portrait { aspect-ratio: 4 / 5; background: var(--bg-surface-elevated); }
  .hero__panel--portrait img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 15%; }
  /* Screentone: ink dots over the real photo (plain gradient, no filter), fading out upward. */
  .hero__tone { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(rgba(28, 26, 23, 0.5) 1.2px, transparent 1.6px) 0 0 / 6px 6px; opacity: 0.55; -webkit-mask-image: linear-gradient(to top, #000 10%, transparent 85%); mask-image: linear-gradient(to top, #000 10%, transparent 85%); }

  .hero__panel--role { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; padding: 14px 18px; font: 600 11px / 1.3 var(--font-mono); letter-spacing: var(--tracking-meta); text-transform: uppercase; }
  .hero__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ok-green); flex: none; }
  .hero__role, .hero__fig { margin: 0; }
  .hero__fig { color: var(--text-dim); }

  .hero__panel--cue { display: flex; justify-content: center; padding: 12px; }

  /* Stacked order on mobile follows the DOM; the wash only exists with motion. */
  .hero__wash { display: none; }

  @media (min-width: 768px) {
    .hero__manga { grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.9fr) minmax(0, 1.1fr); grid-template-rows: minmax(0, 1.5fr) minmax(0, 1fr) auto; grid-template-areas: 'name name portrait' 'tagline role portrait' 'cue cue portrait'; height: calc(100svh - var(--header-h)); }
    .hero__panel--name { grid-area: name; padding: 28px 32px; }
    .hero__panel--tagline { grid-area: tagline; padding: 24px 28px; }
    .hero__panel--portrait { grid-area: portrait; aspect-ratio: auto; }
    .hero__panel--role { grid-area: role; flex-direction: column; align-items: flex-start; justify-content: flex-end; padding: 18px 22px; }
    .hero__panel--cue { grid-area: cue; justify-content: flex-start; padding: 8px 22px; }
    .hero__name { flex-direction: row; flex-wrap: wrap; gap: 0 0.28em; font-size: clamp(56px, 8.4vw, 148px); }
    .hero__tagline { font-size: clamp(20px, 2.1vw, 34px); }
  }

  /* Entrance (once, after the loader). Hidden start state only with motion and JS. */
  @keyframes hero-panel {
    from { opacity: 0; transform: translateY(32px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  @media (prefers-reduced-motion: no-preference) {
    html.js:not(.hero-ready) .hero__panel { opacity: 0; transform: translateY(32px) scale(0.98); }
    html.js.hero-ready .hero__panel { animation: hero-panel 1.1s cubic-bezier(0.22, 1, 0.36, 1) calc(0.1s + var(--k) * 0.15s) 1 both; }

    /* Exit: --exit runs over the last 45% of the scene. */
    html.js .hero { --exit: clamp(0, calc((var(--p, 0) - 0.55) / 0.45), 1); }
    html.js .hero__manga { transform: translateY(calc(var(--exit) * -6svh)); opacity: calc(1 - var(--exit)); will-change: transform, opacity; }
    html.js .hero__wash { display: block; position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; height: 120%; pointer-events: none; background: linear-gradient(to top, var(--paper) 0%, var(--paper) 55%, rgba(244, 239, 228, 0.6) 78%, transparent 100%); transform: translateY(calc((1 - var(--exit)) * 100%)); will-change: transform; }

    /* Desktop: pinned stage so the scrub has room. Mobile: extra paper below the stack. */
    html.js .hero { padding-bottom: 30svh; }
  }

  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    html.js .hero { height: 200svh; padding-bottom: 0; }
    html.js .hero__stage { position: sticky; top: 0; height: 100svh; min-height: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__panel { opacity: 1; transform: none; animation: none; }
    .hero__wash { display: none; }
  }
</style>
