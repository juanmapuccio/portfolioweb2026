---
// S1 Hero as a manga page (catalog specimen 5a), drawn the way a koma-wari page is: irregular
// panels cut with clip-path polygons (slanted gutters), black frames of different weight (--b),
// paper between them, and one figure that breaks its frame. Five panels: name (manga title),
// scroll cue, tagline (narration caption box), portrait (ink cut-out, focus lines) and a speech
// balloon ("Full Stack · Rosario · Disponible") on a spot-black panel.
// Frame trick: a panel has no background of its own; ::before is the black polygon (--clip) and
// ::after is the paper polygon on the same shape inset by --b, so the border follows the slanted
// edges. The portrait is NOT inside that clip: it is a transparent ink PNG
// (scripts/make-ink-portrait.mjs) laid over the frame, so the hair crosses the top border.
// No dot screentone on the photo (user rejected it); only line hatching and focus lines (static
// repeating gradients) live in the panel backgrounds.
// The page sits inside a black ground with margins (--page-pad, max-width 1600px, centered), and
// nothing scales it, so no panel is ever cropped by the viewport at any --p (the old 1.04 camera
// push cropped the edges and was removed).
// The panels APPEAR WITH THE SCROLL, cinematically, not on a timer: the hero is a
// [data-ink-scene][data-ink-smooth] and ink.ts writes its progress `--p` (0..1), lerped for
// smoothness. Each panel has its own window (--s start, --l length, set inline), a local progress
// --i = clamp((--p - --s) / --l) and a smoothstep --e = i*i*(3-2i). A clip-path inset wipe opens
// the frame from one side (direction differs per panel), the content eases in with opacity and a
// translateY of 20px. The portrait cut-out drifts slower than its panel (parallax).
// Windows (--p), one element at a time over a black page: at p = 0 only the black ground shows.
// name .02-.12, cue .10-.18 (overlaps the name only by .02, so the scroll hint arrives almost at
// once: nothing at p = 0 invites scrolling, so the cue is made to appear very early instead of a
// separate hint on the black), tagline .22-.34, portrait .38-.50, balloon .54-.64, hold, exit
// .70-1 (the page drifts up and fades under a soft paper wash).
// Pin: desktop 450svh, mobile 360svh (svh only), sticky 100svh stage. Only transform, opacity and
// clip-path animate. Reduced motion / no JS: all panels visible and static, no pin.
import { Picture } from 'astro:assets';
import portrait from '../../assets/fotojmPerfil-ink.png';
import InkScrollDrop from '../ink/InkScrollDrop.astro';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const nameLines = t('header.name').split(' ');
// Balloon text from i18n; the green availability dot goes right before the last segment
// ("Disponible" / "Available" / "Disponível").
const balloon = t('hero.balloon');
const cut = balloon.lastIndexOf(' · ');
const balloonLead = cut === -1 ? '' : balloon.slice(0, cut + 3);
const balloonStatus = cut === -1 ? balloon : balloon.slice(cut + 3);
---

<section id="hero" class="hero" data-belt="blanco" data-ink-scene data-ink-smooth aria-labelledby="hero-name">
  <div class="hero__stage">
    <div class="hero__manga">
      <div class="hero__panel hero__panel--name" data-panel="name" style="--s: 0.02; --l: 0.12">
        <span class="hero__lines hero__lines--name" aria-hidden="true"></span>
        <div class="hero__in">
          <div class="hero__name-stack">
            <span class="hero__name-ghost hero__name-ghost--1" aria-hidden="true">
              {nameLines.map((word) => <span class="hero__word">{word}</span>)}
            </span>
            <span class="hero__name-ghost hero__name-ghost--2" aria-hidden="true">
              {nameLines.map((word) => <span class="hero__word">{word}</span>)}
            </span>
            <h1 class="hero__name" id="hero-name">
              {nameLines.map((word) => <span class="hero__word">{word}</span>)}
            </h1>
          </div>
        </div>
      </div>
      <div class="hero__panel hero__panel--tagline" data-panel="tagline" style="--s: 0.16; --l: 0.12">
        <div class="hero__in">
          <p class="hero__caption hero__tagline">{t('hero.tagline')}</p>
        </div>
      </div>
      <figure class="hero__panel hero__panel--portrait" data-panel="portrait" style="--s: 0.30; --l: 0.14">
        <span class="hero__lines hero__lines--focus" aria-hidden="true"></span>
        <div class="hero__cutout">
          {/* Ink PNG with alpha (AVIF first, WebP fallback); 1290 is the source's native width, for retina. */}
          <Picture src={portrait} alt={t('hero.portraitAlt')} formats={['avif', 'webp']} fallbackFormat="webp" quality={82} widths={[480, 800, 1100, 1290]} sizes="(min-width: 768px) 40vw, 100vw" loading="eager" fetchpriority="high" />
        </div>
      </figure>
      <div class="hero__panel hero__panel--balloon" data-panel="balloon" style="--s: 0.46; --l: 0.12">
        <div class="hero__in">
          <div class="hero__balloon">
            <span class="hero__balloon-lead">{balloonLead}</span>
            <span class="hero__balloon-status">
              <span class="hero__dot" aria-hidden="true"></span>
              <span>{balloonStatus}</span>
            </span>
          </div>
        </div>
      </div>
      <div class="hero__panel hero__panel--cue" data-panel="cue" style="--s: 0.58; --l: 0.08">
        <div class="hero__in">
          <InkScrollDrop label={t('hero.scroll')} />
        </div>
      </div>
    </div>
    <!-- Floating scroll indicator that appears right after the site loader completes -->
    <aside class="hero__scroll-indicator" data-scroll-indicator aria-hidden="true">
      <div class="hero__scroll-mouse">
        <span class="hero__scroll-wheel"></span>
      </div>
      <span class="hero__scroll-text">{t('hero.scroll')}</span>
    </aside>
    <span class="hero__wash" aria-hidden="true"></span>
  </div>
</section>

<style is:global>
  .hero { position: relative; background: var(--ink-belt-black); color: var(--text-main); }

  .hero__stage { position: relative; box-sizing: border-box; min-height: 100svh; padding: var(--header-h) 0 0; overflow: hidden; }
  /* The page: solid black ground with margins (--page-pad), centered and capped, so the panels never touch the viewport edge. */
  .hero__manga { --page-pad: clamp(16px, 3vw, 48px); box-sizing: border-box; display: grid; gap: 16px; width: 100%; max-width: 1600px; margin: 0 auto; min-height: calc(100svh - var(--header-h)); padding: var(--page-pad); background: var(--ink-belt-black); }
  /* Panel = frame (::before black polygon, ::after paper polygon inset by --b) + content (.hero__in). */
  .hero__panel { --b: 3px; --tilt: 7px; --fill: var(--paper); --hatch: linear-gradient(transparent, transparent); position: relative; box-sizing: border-box; margin: 0; }
  .hero__panel::before, .hero__panel::after { content: ''; position: absolute; clip-path: var(--clip); pointer-events: none; }
  .hero__panel::before { inset: 0; background: var(--ink-belt-black); }
  .hero__panel::after { inset: var(--b); background: var(--hatch), var(--fill); }
  .hero__in { position: relative; z-index: 1; box-sizing: border-box; height: 100%; display: flex; }

  /* Mobile shapes: stacked, every panel slanted at top and/or bottom. */
  .hero__panel--name { --b: 3px; --clip: polygon(0 0, 100% 0, 100% calc(100% - var(--tilt)), 0 100%); }
  .hero__panel--tagline { --b: 2px; --clip: polygon(0 var(--tilt), 100% 0, 100% calc(100% - var(--tilt)), 0 100%); --hatch: repeating-linear-gradient(115deg, transparent 0 8px, rgba(28, 26, 23, 0.07) 8px 9px); }
  .hero__panel--portrait { --b: 3px; --clip: polygon(0 14%, 100% 7%, 100% calc(100% - var(--tilt)), 0 100%); aspect-ratio: 1 / 1; z-index: 2; }
  .hero__panel--balloon { --b: 3px; --clip: polygon(0 var(--tilt), 100% 0, 100% 100%, 0 100%); --fill: var(--ink-belt-black); --hatch: repeating-linear-gradient(-60deg, transparent 0 8px, rgba(244, 239, 228, 0.08) 8px 9px); }
  .hero__panel--cue { --b: 2px; --clip: polygon(0 0, 100% var(--tilt), 100% 100%, 0 100%); }

  /* Manga title: bold display type, uppercase, tight tracking, barely tilted + afterimage clone stack */
  .hero__panel--name .hero__in { align-items: flex-end; padding: 20px 20px 24px; }
  .hero__name-stack { position: relative; width: 100%; display: grid; }
  .hero__name {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    margin: 0;
    font: 800 clamp(42px, 13vw, 76px) / 0.94 var(--font-sans);
    text-transform: uppercase;
    letter-spacing: -0.045em;
    transform: rotate(-1deg);
    transform-origin: 0 100%;
    position: relative;
    z-index: 2;
  }
  .hero__name-ghost {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    margin: 0;
    font: 800 clamp(42px, 13vw, 76px) / 0.94 var(--font-sans);
    text-transform: uppercase;
    letter-spacing: -0.045em;
    transform-origin: 0 100%;
    pointer-events: none;
    user-select: none;
    z-index: 1;
    transition: transform 0.2s ease-out, opacity 0.2s ease-out;
  }
  .hero__name-ghost--1 {
    color: rgba(28, 26, 23, 0.2);
    transform: rotate(-1deg) translate(calc((1 - var(--e, 0)) * -40px), calc((1 - var(--e, 0)) * -12px));
    opacity: calc(var(--e, 0) * 0.45);
  }
  .hero__name-ghost--2 {
    color: rgba(3, 105, 161, 0.28);
    transform: rotate(-1deg) translate(calc((1 - var(--e, 0)) * -80px), calc((1 - var(--e, 0)) * -24px));
    opacity: calc(var(--e, 0) * 0.25);
  }
  .hero__word { display: block; }

  /* Speed lines on the name panel: animated repeating-conic-gradient from the right edge. */
  .hero__lines { position: absolute; z-index: 0; pointer-events: none; }
  .hero__lines--name {
    inset: var(--b);
    clip-path: var(--clip);
    background: repeating-conic-gradient(from 90deg at 100% 50%, rgba(28, 26, 23, 0.24) 0 0.35deg, transparent 0.35deg 3.4deg);
    -webkit-mask-image: linear-gradient(to right, transparent 35%, #000 100%);
    mask-image: linear-gradient(to right, transparent 35%, #000 100%);
    opacity: clamp(0.2, calc(var(--e, 0) * 1.2), 1);
    transform: scale(calc(1 + (1 - var(--e, 0)) * 0.15));
    transition: transform 0.3s ease-out;
  }
  /* Focus lines (shuchusen) around the portrait: two conic layers, clear centre. */
  .hero__lines--focus {
    inset: var(--b);
    clip-path: var(--clip);
    background: repeating-conic-gradient(from 3deg at 50% 38%, rgba(28, 26, 23, 0.36) 0 0.4deg, transparent 0.4deg 5deg), repeating-conic-gradient(from 0deg at 50% 38%, rgba(28, 26, 23, 0.22) 0 0.22deg, transparent 0.22deg 2.6deg);
    -webkit-mask-image: radial-gradient(ellipse 70% 62% at 50% 38%, transparent 0 24%, #000 62%);
    mask-image: radial-gradient(ellipse 70% 62% at 50% 38%, transparent 0 24%, #000 62%);
    transform: scale(calc(1 + (1 - var(--e, 0)) * 0.2)) rotate(calc((1 - var(--e, 0)) * 4deg));
  }

  /* Narration caption box: rectangular, black border, hard offset shadow. */
  .hero__panel--tagline .hero__in { align-items: center; padding: 14px 18px 18px; }
  .hero__caption { position: relative; box-sizing: border-box; margin: 0; max-width: 17em; padding: 12px 16px; background: var(--paper); border: 2px solid var(--ink-belt-black); box-shadow: 3px 3px 0 rgba(28, 26, 23, 0.55); font: italic 400 clamp(18px, 5vw, 26px) / 1.25 var(--font-serif); }

  /* Portrait: transparent ink cut-out laid OVER the frame; it crosses the top border and the gutter. */
  .hero__cutout { position: absolute; z-index: 2; left: -6%; right: -4%; top: -3%; bottom: 0; }
  .hero__cutout picture { display: block; width: 100%; height: 100%; }
  .hero__cutout img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 100%; }

  /* Speech balloon: comic manga speech bubble with clean editorial proportions. */
  .hero__panel--balloon .hero__in { align-items: center; justify-content: center; padding: 20px 16px; }
  .hero__balloon {
    position: relative;
    box-sizing: border-box;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin: 0;
    width: auto;
    max-width: min(100%, 340px);
    padding: 14px 22px;
    background: var(--paper);
    border: 2px solid var(--ink-belt-black);
    border-radius: 9999px;
    color: var(--ink-belt-black);
    text-align: center;
    box-shadow: 3px 3px 0 rgba(28, 26, 23, 0.4);
  }
  .hero__balloon::before {
    content: '';
    position: absolute;
    bottom: -14px;
    left: 50%;
    transform: translateX(-50%);
    width: 16px;
    height: 14px;
    background: var(--ink-belt-black);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
  }
  .hero__balloon::after {
    content: '';
    position: absolute;
    bottom: -11px;
    left: 50%;
    transform: translateX(-50%);
    width: 12px;
    height: 11px;
    background: var(--paper);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
  }
  .hero__balloon-lead {
    font: 700 clamp(11px, 2.8vw, 13px) / 1.2 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-belt-black);
  }
  .hero__balloon-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 600 clamp(10px, 2.4vw, 12px) / 1 var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(28, 26, 23, 0.85);
  }
  .hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ok-green);
    box-shadow: 0 0 0 1.5px rgba(28, 26, 23, 0.4), 0 0 8px rgba(4, 120, 87, 0.4);
    flex: none;
  }

  /* Floating post-load scroll indicator over the hero's black background */
  .hero__scroll-indicator {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%) translateY(24px);
    z-index: 20;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: rgba(28, 26, 23, 0.88);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(244, 239, 228, 0.28);
    border-radius: 9999px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5), 0 0 12px rgba(244, 239, 228, 0.08);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  html.is-ready .hero__scroll-indicator {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  /* Fades out as soon as the user starts scrolling the hero scene */
  html.js .hero[style*="--p"] .hero__scroll-indicator {
    opacity: calc(1 - clamp(0, calc(var(--p, 0) * 16), 1));
    transform: translateX(-50%) translateY(calc(clamp(0, calc(var(--p, 0) * 16), 1) * 20px));
  }
  .hero__scroll-mouse {
    width: 16px;
    height: 26px;
    border: 1.5px solid var(--paper);
    border-radius: 9px;
    position: relative;
    display: flex;
    justify-content: center;
    padding-top: 4px;
    box-sizing: border-box;
  }
  .hero__scroll-wheel {
    width: 2.5px;
    height: 6px;
    background: var(--paper);
    border-radius: 2px;
    animation: heroScrollWheel 1.5s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  @keyframes heroScrollWheel {
    0% { transform: translateY(0); opacity: 1; }
    60% { transform: translateY(8px); opacity: 0; }
    61% { transform: translateY(0); opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
  }
  .hero__scroll-text {
    font: 600 10px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--paper);
  }

  /* Stacked order on mobile follows the DOM; the wash only exists with motion. */
  .hero__wash { display: none; }

  /* Tablet portrait transition: 640px to 767px */
  @media (min-width: 640px) and (max-width: 767px) {
    .hero__manga {
      max-width: 600px;
      gap: 14px;
    }
    .hero__balloon {
      flex-direction: row;
      gap: 10px;
      padding: 12px 24px;
    }
  }

  @media (min-width: 768px) {
    .hero__manga { grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.9fr) minmax(0, 1.1fr); grid-template-rows: minmax(0, 1.5fr) minmax(0, 1fr) auto; grid-template-areas: 'name name portrait' 'tagline balloon portrait' 'cue cue portrait'; height: calc(100svh - var(--header-h)); gap: 20px; }
    .hero__panel { --tilt: 12px; }
    /* Desktop shapes: slanted right edge on name, tagline and cue, parallel to the portrait's and balloon's left edges. */
    .hero__panel--name { grid-area: name; --clip: polygon(0 0, 100% 0, calc(100% - var(--tilt)) 100%, 0 100%); }
    .hero__panel--tagline { grid-area: tagline; --clip: polygon(0 10px, 100% 0, calc(100% - var(--tilt)) 100%, 0 100%); }
    .hero__panel--portrait { grid-area: portrait; aspect-ratio: auto; --clip: polygon(var(--tilt) 22%, 100% 12%, 100% 100%, 0 100%); }
    .hero__panel--balloon { grid-area: balloon; --clip: polygon(var(--tilt) 0, 100% 0, 100% 100%, 0 calc(100% - 8px)); }
    .hero__panel--cue { grid-area: cue; --clip: polygon(0 0, 100% 0, calc(100% - var(--tilt)) 100%, 0 100%); }
    .hero__panel--name .hero__in { padding: 28px 40px 32px 32px; }
    .hero__panel--tagline .hero__in { padding: 22px 36px 26px 24px; }
    .hero__panel--balloon .hero__in { padding: 18px 28px; }
    .hero__panel--cue .hero__in { justify-content: flex-start; padding: 6px 22px 8px; }
    .hero__name, .hero__name-ghost { flex-direction: row; flex-wrap: wrap; gap: 0 0.26em; font-size: clamp(48px, 6.6vw, 116px); }
    .hero__caption { font-size: clamp(18px, 1.9vw, 30px); }
    .hero__cutout { left: -12%; right: -3%; top: -2%; }
    .hero__balloon {
      flex-direction: row;
      gap: 12px;
      padding: 14px 26px;
      border-radius: 9999px;
    }
    .hero__balloon-lead { font-size: clamp(11px, 0.9vw, 13px); }
    .hero__balloon-status { font-size: clamp(10px, 0.8vw, 12px); }
    /* Desktop: speech bubble tail points right directly toward the portrait */
    .hero__balloon::before {
      bottom: auto;
      left: auto;
      right: -13px;
      top: 50%;
      transform: translateY(-50%);
      width: 14px;
      height: 16px;
      clip-path: polygon(0 0, 100% 50%, 0 100%);
    }
    .hero__balloon::after {
      bottom: auto;
      left: auto;
      right: -10px;
      top: 50%;
      transform: translateY(-50%);
      width: 11px;
      height: 12px;
      clip-path: polygon(0 0, 100% 50%, 0 100%);
    }
  }

  /* Scroll-scrubbed assembly. Only with motion and JS; --p is 0 until ink.ts writes it. */
  @media (prefers-reduced-motion: no-preference) {
    /* Per panel: --i linear window, --e smoothstep, --w wipe inset (100% hidden -> -15% open, so the
       cut-out may overflow the clip). Each panel wipes from a different side. At --p = 0 every panel
       has --i = 0, so only the black page is visible. */
    html.js .hero__panel { --i: clamp(0, calc((var(--p, 0) - var(--s, 0)) / var(--l, 0.1)), 1); --e: calc(var(--i) * var(--i) * (3 - 2 * var(--i))); --w: calc(-15% + (1 - var(--e)) * 115%); opacity: clamp(0, calc(var(--i) * 4), 1); clip-path: inset(-15% -15% -15% -15%); will-change: opacity, clip-path; }
    html.js .hero__panel--name, html.js .hero__panel--cue { clip-path: inset(-15% -15% var(--w) -15%); }
    html.js .hero__panel--tagline { clip-path: inset(-15% var(--w) -15% -15%); }
    html.js .hero__panel--portrait { clip-path: inset(var(--w) -15% -15% -15%); }
    html.js .hero__panel--balloon { clip-path: inset(-15% -15% -15% var(--w)); }
    html.js .hero__in { transform: translateY(calc((1 - var(--e)) * 20px)); opacity: var(--e); will-change: transform, opacity; }
    html.js .hero__cutout { transform: translateY(calc((1 - var(--e)) * 24px + (1 - var(--cam)) * 3%)); opacity: var(--e); will-change: transform, opacity; }

    /* Camera: only the portrait parallax (--cam 0 -> 1 across p 0 -> .64); the page itself never scales. Then the exit. */
    html.js .hero { --cam: clamp(0, calc(var(--p, 0) / 0.64), 1); --exit: clamp(0, calc((var(--p, 0) - 0.7) / 0.3), 1); --x: calc(var(--exit) * var(--exit) * (3 - 2 * var(--exit))); }
    html.js .hero__manga { transform: translateY(calc(var(--x) * -6svh)); opacity: calc(1 - var(--x)); will-change: transform, opacity; }
    html.js .hero__wash { display: block; position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; height: 120%; pointer-events: none; background: linear-gradient(to top, var(--paper) 0%, var(--paper) 55%, rgba(244, 239, 228, 0.6) 78%, transparent 100%); transform: translateY(calc((1 - var(--x)) * 100%)); will-change: transform; }

    /* Mobile: pinned stage too (360svh). The stack is squeezed to fit one screen. */
    html.js .hero { height: 360svh; }
    html.js .hero__stage { position: sticky; top: 0; height: 100svh; min-height: 0; }
    html.js .hero__manga { height: calc(100svh - var(--header-h)); min-height: 0; grid-template-rows: auto auto minmax(0, 1fr) auto auto; gap: 11px; }
    html.js .hero__panel--portrait { aspect-ratio: auto; }
    html.js .hero__panel--name .hero__in { padding: 12px 16px 16px; }
    html.js .hero__panel--tagline .hero__in { padding: 10px 14px 14px; }
    html.js .hero__panel--balloon .hero__in { padding: 22px 14px 10px; }
    html.js .hero__panel--cue .hero__in { padding: 6px 12px 8px; }
    html.js .hero__name { flex-direction: row; flex-wrap: wrap; gap: 0 0.26em; font-size: clamp(32px, 9vw, 52px); }
    html.js .hero__caption { font-size: clamp(15px, 4.2vw, 22px); padding: 8px 12px; }
    html.js .hero__balloon { padding: 12px 26px; }
  }

  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    html.js .hero { height: 450svh; }
    html.js .hero__manga { grid-template-rows: minmax(0, 1.5fr) minmax(0, 1fr) auto; gap: 20px; }
    html.js .hero__panel--name .hero__in { padding: 28px 40px 32px 32px; }
    html.js .hero__panel--tagline .hero__in { padding: 22px 36px 26px 24px; }
    html.js .hero__panel--balloon .hero__in { padding: 18px 44px 18px 24px; }
    html.js .hero__panel--cue .hero__in { padding: 6px 22px 8px; }
    html.js .hero__name { font-size: clamp(48px, 6.6vw, 116px); }
    html.js .hero__caption { font-size: clamp(18px, 1.9vw, 30px); padding: 12px 16px; }
