---
// S1 Hero. One responsive tree.
// Desktop (>=1024, motion allowed, JS): 250svh section with a sticky stage; the section's
// `--p` (src/scripts/ink.ts, [data-ink-scene]) scrubs 10a pull-back (scale 5 -> 1), name
// and tagline lines, the portrait reveal and the 10f glyph, then 10l zoom + flash into the
// belts. Everything is a CSS function of --p (transform / opacity / clip-path only).
// Mobile and tablet (<1024): 7i enter animation (vertical brush, name lines rise, 염치
// seal, tagline lines) with one 7e drip as the exit.
// Reduced motion / no JS: final state, no pin, no scrub, no flash.
// TODO(raster): the flat --paper background stands in for the washi / aguada rasters.
import { Image } from 'astro:assets';
import portrait from '../../assets/fotojmPerfil.png';
import InkGlyphTitle from '../ink/InkGlyphTitle.astro';
import InkScrollDrop from '../ink/InkScrollDrop.astro';
import InkDrip from './InkDrip.astro';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const nameLines = t('header.name').split(' ');
const taglineLines = [t('hero.tagline.l1'), t('hero.tagline.l2'), t('hero.tagline.l3')];
---

<section id="hero" class="hero" data-belt="blanco" data-ink data-ink-scene aria-labelledby="hero-name">
  <div class="hero__stage">
    <div class="hero__zoom">
      <div class="hero__body">
        <div class="hero__text">
          <InkGlyphTitle class="hero__glyph" glyph="유" eyebrow={t('hero.role')} title={t('hero.fig')} />
          <div class="hero__namerow">
            <h1 class="hero__name" id="hero-name">
              {nameLines.map((word, i) => (
                <span class="hero__clip"><span class="hero__rise ink-rise" style={`--ink-delay: ${0.15 + i * 0.12}s; --i: ${i}`}>{word}</span></span>
              ))}
            </h1>
            <span class="hero__seal ink-stamp" style="--ink-delay: 0.7s" aria-hidden="true">염치</span>
          </div>
          <p class="hero__tagline">
            {taglineLines.map((line, i) => (
              <>
                <span class="hero__clip"><span class="hero__rise hero__rise--tag ink-rise" style={`--ink-delay: ${0.75 + i * 0.12}s; --i: ${i}`}>{line}</span></span>{' '}
              </>
            ))}
          </p>
        </div>
        <figure class="hero__portrait ink-unroll" style="--ink-delay: 0.5s; --ink-duration: 1.1s">
          <Image src={portrait} alt={t('hero.portraitAlt')} widths={[480, 800, 1100]} sizes="(min-width: 1024px) 40vw, 80vw" format="webp" loading="eager" fetchpriority="high" />
        </figure>
      </div>
      <svg class="hero__brush" viewBox="0 0 12 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path class="ink-draw" style="--ink-delay: 0.1s; --ink-duration: 1.4s" d="M6 0 L6 100" pathLength="1" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"></path>
      </svg>
      <div class="hero__cue"><InkScrollDrop label={t('hero.scroll')} /></div>
    </div>
    <svg class="hero__pull" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      <rect x="-40" y="30" width="1680" height="150" rx="75"></rect>
      <rect x="-40" y="200" width="1680" height="150" rx="75"></rect>
      <rect x="-40" y="370" width="1680" height="150" rx="75"></rect>
      <rect x="-40" y="540" width="1680" height="150" rx="75"></rect>
      <rect x="-40" y="710" width="1680" height="160" rx="80"></rect>
    </svg>
    <span class="hero__flash" aria-hidden="true"></span>
  </div>
  <InkDrip class="hero__drip" tone="black" />
</section>

<style is:global>
  .hero { position: relative; background: var(--paper); color: var(--text-main); }

  .hero__stage { position: relative; display: flex; flex-direction: column; min-height: 100svh; box-sizing: border-box; padding: calc(var(--header-h) + var(--section-pad)) var(--gutter) var(--section-pad); overflow: hidden; }
  .hero__zoom { position: relative; display: flex; flex: 1; flex-direction: column; gap: 28px; }
  .hero__body { display: flex; flex: 1; flex-direction: column; gap: 28px; }
  .hero__text { position: relative; display: flex; flex-direction: column; gap: 20px; }

  /* 10f glyph block, reusing InkGlyphTitle as a transparent backdrop instead of a card. */
  .hero .hero__glyph.ink-10f { max-width: none; height: auto; padding: 0 0 8px; overflow: visible; background: transparent; }
  .hero .hero__glyph .ink-10f__glyph { top: 10%; right: -2%; width: min(62vw, 360px); height: auto; }
  .hero .hero__glyph .ink-10f__eyebrow { color: var(--text-main); }
  .hero .hero__glyph .ink-10f__title { font: 400 var(--fs-caption) / 1.4 var(--font-mono); letter-spacing: var(--tracking-meta); color: var(--text-dim); }

  .hero__namerow { position: relative; display: flex; align-items: flex-end; gap: 16px; }
  .hero__name { margin: 0; font: 700 clamp(56px, 17vw, 112px) / 0.98 var(--font-serif); letter-spacing: var(--tracking-heading); }
  .hero__clip { display: block; overflow: hidden; padding-bottom: 0.1em; margin-bottom: -0.1em; }
  .hero__rise { display: block; }
  .hero__seal { display: inline-grid; place-items: center; width: 64px; height: 64px; margin-bottom: 10px; border: 3px solid var(--seal-red); color: var(--seal-red); font: 700 22px/1 'Noto Sans KR', var(--font-sans); rotate: -5deg; flex: none; }

  .hero__tagline { margin: 0; max-width: 16em; font: 400 clamp(26px, 7.4vw, 40px) / 1.2 var(--font-serif); color: var(--text-main); }

  .hero__portrait { position: relative; align-self: center; width: min(78%, 360px); margin: 0; border: 2px solid var(--text-main); background: var(--bg-surface-elevated); }
  .hero__portrait img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 15%; }

  /* 7i vertical brush: a plain stroke-dashoffset draw, no filter. */
  .hero__brush { position: absolute; right: -4px; top: 0; width: 12px; height: 100%; color: var(--text-main); opacity: 0.85; }
  .hero__cue { display: flex; justify-content: center; padding-top: 8px; }

  /* Mobile hero drip is the exit; it sits over the lower part of the hero. */
  .hero .hero__drip { top: auto; bottom: 0; height: 60svh; }

  /* Desktop-only layers stay out of the static (mobile / reduced / no-JS) layout. */
  .hero__pull, .hero__flash { display: none; }

  @media (min-width: 1024px) {
    .hero__stage { padding-bottom: calc(var(--section-pad) + 8px); }
    .hero__body { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); align-items: center; gap: 4vw; }
    .hero__name { font-size: clamp(72px, 9.6vw, 168px); }
    .hero__tagline { max-width: 14em; font-size: clamp(30px, 3.1vw, 54px); }
    .hero__portrait { width: 100%; max-width: 440px; justify-self: end; }
    .hero__brush { display: none; }
    .hero .hero__drip { display: none; }
  }

  /* Scrubbed pin: desktop, motion allowed, JS present. */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    html.js .hero {
      height: 250svh;
      --pull: clamp(0, calc(var(--p, 0) / 0.55), 1);
      --exit: clamp(0, calc((var(--p, 0) - 0.85) / 0.15), 1);
    }
    html.js .hero__stage { position: sticky; top: 0; height: 100svh; min-height: 0; padding-top: calc(var(--header-h) + 16px); padding-bottom: 24px; }
    html.js .hero__zoom { transform: scale(calc(1 + 1.4 * var(--exit))); transform-origin: 50% 50%; will-change: transform; }

    /* 10a: five brush bars start x5 (almost black screen), pull back and fade. */
    html.js .hero__pull { display: block; position: absolute; inset: 0; width: 100%; height: 100%; z-index: 3; pointer-events: none; fill: var(--ink-belt-black); transform-origin: 50% 85%; transform: scale(calc(5 - 4 * var(--pull))); opacity: calc(1 - 0.88 * var(--pull)); will-change: transform, opacity; }

    /* 10l: white cut at the end of the exit zoom. */
    html.js .hero__flash { display: block; position: absolute; inset: 0; z-index: 6; pointer-events: none; background: #fff; opacity: clamp(0, calc((var(--exit) - 0.4) * 1.7), 1); }

    /* Lines: the one-shot ink-rise is replaced by a scrub keyed to --p. */
    html.js .hero .hero__clip .hero__rise { --t: clamp(0, calc((var(--p, 0) - 0.3 - var(--i) * 0.06) / 0.15), 1); animation: none; transform: translateY(calc((1 - var(--t)) * 110%)); }
    html.js .hero .hero__clip .hero__rise--tag { --t: clamp(0, calc((var(--p, 0) - 0.5 - var(--i) * 0.05) / 0.12), 1); }
    html.js .hero .hero__seal.ink-stamp { --t: clamp(0, calc((var(--p, 0) - 0.5) / 0.1), 1); animation: none; opacity: var(--t); transform: scale(calc(1.6 - 0.6 * var(--t))); }
    html.js .hero .hero__portrait.ink-unroll { --r: clamp(0, calc((var(--p, 0) - 0.38) / 0.25), 1); animation: none; clip-path: inset(calc((1 - var(--r)) * 100%) 0 0 0); }
    html.js .hero .hero__glyph .ink-10f__glyph { opacity: calc(0.09 * clamp(0, calc((var(--p, 0) - 0.25) / 0.2), 1)); animation: none; transform: none; }
    html.js .hero .hero__glyph .ink-10f__clip .ink-rise { animation: none; transform: none; opacity: clamp(0, calc((var(--p, 0) - 0.25) / 0.15), 1); }

    html.js .hero__cue { position: absolute; left: 50%; bottom: 20px; z-index: 5; translate: -50% 0; color: var(--paper); opacity: clamp(0, calc(1 - var(--p, 0) * 9), 1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__pull, .hero__flash, .hero__brush, .hero .hero__drip { display: none; }
  }
</style>
