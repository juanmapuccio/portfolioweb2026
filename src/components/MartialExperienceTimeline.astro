---
import type { Lang } from '../i18n/ui';
import { martialExperienceData, BELTS } from '../data/martialExperience';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = martialExperienceData[lang];

const CHAPTER_CONFIG = [
  {
    key: 'blanco',
    num: '01',
    ko: '흰 띠',
    hex: '#ffffff',
    layout: 'split' as const,
    word: { es: 'Inocencia', en: 'Innocence', pt: 'Inocência' }[lang],
    meaning: {
      es: 'El alumno que empieza sin conocimiento previo.',
      en: 'The student who begins without prior knowledge.',
      pt: 'O aluno que começa sem conhecimento prévio.',
    }[lang],
  },
  {
    key: 'amarillo',
    num: '02',
    ko: '노란 띠',
    hex: '#fbbf24',
    layout: 'h' as const,
    word: { es: 'Tierra', en: 'Earth', pt: 'Terra' }[lang],
    meaning: {
      es: 'Donde la semilla echa raíces y se asientan las bases.',
      en: 'Where the seed takes root and the foundations are laid.',
      pt: 'Onde a semente cria raízes e se assentam as bases.',
    }[lang],
  },
  {
    key: 'verde',
    num: '03',
    ko: '초록 띠',
    hex: '#10b981',
    layout: 'split' as const,
    word: { es: 'Crecimiento', en: 'Growth', pt: 'Crescimento' }[lang],
    meaning: {
      es: 'La planta crece a medida que la técnica se desarrolla.',
      en: 'The plant grows as technique develops.',
      pt: 'A planta cresce à medida que a técnica se desenvolve.',
    }[lang],
  },
  {
    key: 'azul',
    num: '04',
    ko: '파란 띠',
    hex: '#0284c7',
    layout: 'h' as const,
    word: { es: 'Cielo', en: 'Heaven', pt: 'Céu' }[lang],
    meaning: {
      es: 'Hacia donde la planta madura y se convierte en árbol.',
      en: 'Toward which the plant matures into a tree.',
      pt: 'Para onde a planta amadurece e se torna árvore.',
    }[lang],
  },
  {
    key: 'rojo',
    num: '05',
    ko: '빨간 띠',
    hex: '#ef4444',
    layout: 'split' as const,
    word: { es: 'Control', en: 'Control', pt: 'Controle' }[lang],
    meaning: {
      es: 'Exige templanza, precisión técnica y saber cuándo frenar antes de actuar.',
      en: 'Demands composure, technical precision, and knowing when to hold back before acting.',
      pt: 'Exige equilíbrio, precisão técnica e saber quando frear antes de agir.',
    }[lang],
  },
];
---

<div class="martial-timeline-container" id="trayectoria">
  <div class="trayectoria-section-intro">
    <div class="intro-badge-row">
      <span class="intro-badge">{data.sectionBadge}</span>
    </div>
    <h2 class="intro-title">{data.title}</h2>
    <p class="intro-subtitle">{data.subtitle}</p>
  </div>

  {CHAPTER_CONFIG.map((cfg, idx) => {
    const stage = data.stages.find((s) => s.beltKey === cfg.key);
    const belt = BELTS[cfg.key];
    if (!stage || !belt) return null;
    const chIndex = idx + 1;

    return (
      <div id={cfg.key} class="chapter-block">
        <!-- Escena 1: Cortina con título gigante y banda de cinturón -->
        <section data-fx="c" data-zone="curtain" data-ch={chIndex} class="curtain-scene">
          <div class="curtain-sticky">
            <div class="curtain-meta-top">
              <span>Capítulo {cfg.num} · {cfg.ko} · {belt.beltName[lang]}</span>
              <span>{belt.gup} · {stage.years}</span>
            </div>

            <div class="curtain-title-wrap">
              <div class="curtain-title">{belt.philosophicalTitle[lang]}</div>
            </div>

            <div class="curtain-ribbon" style={`background: ${cfg.hex};`}>
              <div class="curtain-ribbon-overlay"></div>
            </div>
            
            <div data-slot="1" class="curtain-slot"></div>

            <div class="curtain-meta-center">
              <div class="curtain-meaning-badge">
                <span class="curtain-word">{cfg.word}</span>
                <span class="curtain-meaning-sep" aria-hidden="true">—</span>
                <span class="curtain-meaning">{cfg.meaning}</span>
              </div>
              <p class="curtain-stage-lede">{stage.lede}</p>
            </div>
          </div>
        </section>

        <!-- Escena 2: Contenido según Layout (Split vs Horizontal) -->
        {cfg.layout === 'split' ? (
          <section data-zone="split" data-ch={chIndex} class="split-section">
            <div class="split-side-sticky">
              <div data-slot="1" class="split-slot"></div>
              <div class="split-side-footer">
                <div class="split-stage-tag">
                  <span class="stage-tag-swatch" style={`background: ${cfg.hex};`}></span>
                  {belt.gup} · {stage.years}
                </div>
                <div class="split-stage-line">{stage.title}</div>
              </div>
            </div>

            <div class="split-roles-column">
              {stage.positions.map((pos) => (
                <article class="split-role-card">
                  <div class="role-bar" style={`background: ${cfg.hex};`}></div>
                  <div class="role-date">{pos.dates}</div>
                  <h3 class="role-title">{pos.role}</h3>
                  <div class="role-company">{pos.org}</div>
                  <p class="role-desc">{pos.description}</p>
                  {pos.transferableCompetency && (
                    <div class="role-comp">
                      <span class="comp-label">{data.competencyLabel}</span>
                      <span class="comp-text">{pos.transferableCompetency}</span>
                    </div>
                  )}
                </article>
              ))}
            </div>
          </section>
        ) : (
          <section
            data-fx="h"
            data-zone="h"
            data-ch={chIndex}
            class="h-section"
            style={`height: ${120 + stage.positions.length * 105}vh;`}
          >
            <div class="h-sticky">
              <div data-track="1" class="h-track">
                <div class="h-intro-slide">
                  <div class="h-intro-text">
                    <div class="h-intro-tag">
                      <span class="stage-tag-swatch" style={`background: ${cfg.hex};`}></span>
                      {belt.gup} · {stage.years}
                    </div>
                    <div class="h-intro-headline">{stage.title}</div>
                    <div class="h-intro-count">
                      {stage.positions.length} {lang === 'es' ? 'etapas · seguí bajando →' : lang === 'en' ? 'stages · scroll down →' : 'etapas · continue descendo →'}
                    </div>
                  </div>
                  <div data-slot="1" class="h-intro-slot"></div>
                </div>

                {stage.positions.map((pos, pIdx) => (
                  <article class="h-role-card">
                    <div class="h-card-accent" style={`background: ${cfg.hex};`}></div>
                    <div class="h-card-header">
                      <span>{String(pIdx + 1).padStart(2, '0')} / {String(stage.positions.length).padStart(2, '0')}</span>
                      <span>{pos.dates}</span>
                    </div>
                    <div class="h-card-main">
                      <h3 class="h-card-role">{pos.role}</h3>
                      <div class="h-card-company">{pos.org}</div>
                      <p class="h-card-desc">{pos.description}</p>
                    </div>
                    {pos.transferableCompetency && (
                      <div class="h-card-comp">
                        <span class="comp-label">{data.competencyLabel}</span>
                        <span class="comp-text">{pos.transferableCompetency}</span>
                      </div>
                    )}
                  </article>
                ))}
              </div>
              <div class="h-progress-bar" style={`background: ${cfg.hex};`}></div>
            </div>
          </section>
        )}
      </div>
    );
  })}

  <!-- Capítulo 06: Cinturón Negro & Transición a Modo Oscuro -->
  <div id="negro" class="chapter-black-wrapper">
    <section data-fx="c" data-zone="curtain" data-ch="6" class="black-curtain-scene">
      <div class="black-curtain-sticky">
        <div class="black-red-flash"></div>
        <div class="black-expanding-circle"></div>
        <div class="black-radial-glow"></div>

        <div class="black-pre-text">
          <div class="black-pre-gup">1º gup → 1º dan</div>
          <div class="black-pre-quote">
            {lang === 'es' ? 'Diez grados, quince años.' : lang === 'en' ? 'Ten ranks, fifteen years.' : 'Dez graus, quinze anos.'}
          </div>
        </div>

        <div class="black-meta-top">
          <span>Capítulo 06 · 검은 띠 · {BELTS.negro.beltName[lang]}</span>
          <span>1º dan · Jun 2025 — Presente</span>
        </div>

        <div class="black-title-wrap">
          <div class="black-title">{BELTS.negro.philosophicalTitle[lang]}</div>
        </div>

        <div class="black-gold-line"></div>
        <div data-slot="1" class="black-slot"></div>

        <div class="black-meta-bottom">
          <div class="black-word-box">
            <span class="black-word">{lang === 'es' ? 'Madurez' : lang === 'en' ? 'Maturity' : 'Maturidade'}</span>
            <span class="black-meaning">
              {lang === 'es'
                ? 'Lo opuesto al blanco: dominio y serenidad frente al miedo.'
                : lang === 'en'
                ? 'The opposite of white: mastery and calm in the face of fear.'
                : 'O oposto do branco: domínio e serenidade diante do medo.'}
            </span>
          </div>
          <div class="black-right-box">
            <span class="black-role-lead">Fundador &amp; Arquitecto de Software · NodoSur</span>
            <span class="black-avail-cue">
              {lang === 'es'
                ? 'Hoy cuento con disponibilidad full-time real para sumarme a un equipo.'
                : lang === 'en'
                ? 'Today I have real full-time availability to join a team.'
                : 'Hoje conto com disponibilidade full-time real para me somar a uma equipe.'}
            </span>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

<script>
  function initScrollytelling() {
    const isReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const CHAPTER_KEYS = ['blanco', 'blanco', 'amarillo', 'verde', 'azul', 'rojo', 'negro'];
    const CHAPTER_COLORS: Record<string, string> = {
      blanco: '#ffffff',
      amarillo: '#fbbf24',
      verde: '#10b981',
      azul: '#0284c7',
      rojo: '#ef4444',
      negro: '#1c1a17',
    };

    let lastCh = -1;

    function tick() {
      const H = window.innerHeight;
      const mid = H / 2;

      document.querySelectorAll<HTMLElement>('[data-fx]').forEach((el) => {
        const r = el.getBoundingClientRect();
        if (r.bottom < -H || r.top > 2 * H) return;
        let p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - H)));
        if (isReduced && el.dataset.fx !== 'h') p = 1;
        el.style.setProperty('--p', p.toFixed(4));

        if (el.dataset.fx === 'h') {
          const tr = el.querySelector<HTMLElement>('[data-track]');
          if (tr) {
            const shift = -p * Math.max(0, tr.scrollWidth - window.innerWidth);
            tr.style.transform = `translate3d(${shift.toFixed(1)}px, 0, 0)`;
          }
        }
      });

      const zones = Array.from(document.querySelectorAll<HTMLElement>('[data-zone]'));
      const activeZone = zones.find((el) => {
        const r = el.getBoundingClientRect();
        return r.top <= mid && r.bottom > mid;
      }) ?? null;

      if (activeZone) {
        const ch = parseInt(activeZone.dataset.ch || '0', 10);
        const beltKey = CHAPTER_KEYS[ch] || 'blanco';
        const color = CHAPTER_COLORS[beltKey] || '#ffffff';
        document.documentElement.dataset.activeBeltColor = color;
        if (ch !== lastCh) {
          lastCh = ch;
          window.dispatchEvent(
            new CustomEvent('belt:change', {
              detail: { beltKey, color },
            })
          );
        }
      }

      requestAnimationFrame(tick);
    }

    requestAnimationFrame(tick);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollytelling, { once: true });
  } else {
    initScrollytelling();
  }
</script>

<style>
  .martial-timeline-container {
    position: relative;
    background: #f2eee6;
  }

  .trayectoria-section-intro {
    padding: 120px clamp(20px, 5vw, 72px) 60px;
    max-width: 1600px;
    margin: 0 auto;
  }

  .intro-badge-row {
    margin-bottom: 12px;
  }

  .intro-badge {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4a463f;
  }

  .intro-title {
    margin: 0 0 12px;
    font-family: var(--font-serif);
    font-size: clamp(36px, 4.5vw, 64px);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #1c1a17;
  }

  .intro-subtitle {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: #4a463f;
    max-width: 640px;
  }

  /* ── Cortina Vertical Escénica ── */
  .curtain-scene {
    height: 340vh;
    position: relative;
  }

  .curtain-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    background: #f2eee6;
  }

  .curtain-meta-top {
    position: absolute;
    top: 84px;
    left: clamp(20px, 5vw, 72px);
    right: clamp(20px, 5vw, 72px);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4a463f;
  }

  .curtain-title-wrap {
    position: absolute;
    left: clamp(20px, 4vw, 64px);
    right: clamp(20px, 4vw, 64px);
    top: 14vh;
    height: 30vh;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
    pointer-events: none;
  }

  .curtain-title {
    font-family: var(--font-serif);
    font-size: clamp(38px, 5.2vw, 92px);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #1c1a17;
    white-space: nowrap;
    text-align: center;
    transform: translateY(calc((1 - clamp(0, calc((var(--p, 0) - 0.3) * 3), 1)) * 110%));
    transition: transform 0.1s linear;
  }

  .curtain-ribbon {
    position: absolute;
    left: 0;
    right: 0;
    top: 44vh;
    height: 38vh;
    border-top: 1px solid #1c1a17;
    border-bottom: 1px solid #1c1a17;
    transform-origin: 0 50%;
    transform: scaleX(clamp(0, calc(var(--p, 0) * 2.4), 1));
    transition: transform 0.1s linear;
  }

  .curtain-slot {
    position: absolute;
    left: 20vw;
    right: 20vw;
    top: 45vh;
    height: 26vh;
    pointer-events: none;
    z-index: 2;
  }

  .curtain-meta-center {
    position: absolute;
    left: clamp(20px, 6vw, 120px);
    right: clamp(20px, 6vw, 120px);
    bottom: 5vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    z-index: 3;
    opacity: clamp(0, calc((var(--p, 0) - 0.35) * 3.5), 1);
    transform: translateY(calc((1 - clamp(0, calc((var(--p, 0) - 0.35) * 3.5), 1)) * 24px));
    transition: opacity 0.1s linear, transform 0.1s linear;
  }

  .curtain-meaning-badge {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: rgba(28, 26, 23, 0.04);
    border: 1px solid rgba(28, 26, 23, 0.16);
    padding: 6px 20px;
    backdrop-filter: blur(4px);
    flex-wrap: wrap;
    justify-content: center;
  }

  .curtain-word {
    font-family: var(--font-serif);
    font-size: clamp(20px, 2.2vw, 28px);
    font-style: italic;
    font-weight: 500;
    line-height: 1.1;
    color: #1c1a17;
  }

  .curtain-meaning-sep {
    color: rgba(28, 26, 23, 0.4);
    font-size: 14px;
  }

  .curtain-meaning {
    font-family: var(--font-sans);
    font-size: clamp(14px, 1.2vw, 16px);
    font-weight: 500;
    color: #4a463f;
  }

  .curtain-stage-lede {
    font-family: var(--font-serif);
    font-size: clamp(18px, 1.8vw, 26px);
    line-height: 1.4;
    max-width: 840px;
    margin: 0 auto;
    color: #1c1a17;
    letter-spacing: -0.01em;
  }

  /* ── Layout Dividido (Split) ── */
  .split-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    border-top: 1px solid rgba(28, 26, 23, 0.12);
  }

  .split-side-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 96px clamp(20px, 5vw, 72px) 48px;
    box-sizing: border-box;
    gap: 24px;
  }

  .split-slot {
    flex: 1;
    min-height: 0;
  }

  .split-side-footer {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .split-stage-tag {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4a463f;
  }

  .stage-tag-swatch {
    width: 28px;
    height: 10px;
    border: 1px solid #1c1a17;
    display: inline-block;
  }

  .split-stage-line {
    font-family: var(--font-serif);
    font-size: clamp(34px, 3.6vw, 60px);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: #1c1a17;
  }

  .split-roles-column {
    display: flex;
    flex-direction: column;
    border-left: 1px solid rgba(28, 26, 23, 0.12);
  }

  .split-role-card {
    min-height: 115vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    padding: 110px clamp(20px, 4vw, 64px);
    box-sizing: border-box;
    border-bottom: 1px solid rgba(28, 26, 23, 0.12);
  }

  .role-bar {
    height: 10px;
    width: 120px;
    border: 1px solid #1c1a17;
  }

  .role-date {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6a645a;
  }

  .role-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(30px, 3vw, 48px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #1c1a17;
  }

  .role-company {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 700;
    color: #1c1a17;
  }

  .role-desc {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: #4a463f;
    max-width: 580px;
  }

  .role-comp {
    border-top: 1px solid rgba(28, 26, 23, 0.28);
    padding-top: 14px;
    max-width: 580px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .comp-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6a645a;
  }

  .comp-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 20px;
    line-height: 1.35;
    color: #1c1a17;
  }

  /* ── Layout Horizontal (h-section) ── */
  .h-section {
    position: relative;
    border-top: 1px solid rgba(28, 26, 23, 0.12);
  }

  .h-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  .h-track {
    display: flex;
    height: 100%;
    will-change: transform;
  }

  .h-intro-slide {
    flex: none;
    width: 100vw;
    height: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: 40px;
    padding: 96px clamp(20px, 5vw, 72px) 60px;
    box-sizing: border-box;
  }

  .h-intro-text {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .h-intro-tag {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4a463f;
  }

  .h-intro-headline {
    font-family: var(--font-serif);
    font-size: clamp(40px, 5vw, 84px);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
    color: #1c1a17;
  }

  .h-intro-count {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6a645a;
  }

  .h-intro-slot {
    height: 52vh;
  }

  .h-role-card {
    flex: none;
    width: min(640px, 46vw);
    height: 100%;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 96px clamp(20px, 3vw, 48px) 56px;
    box-sizing: border-box;
    border-left: 1px solid rgba(28, 26, 23, 0.12);
    gap: 20px;
    position: relative;
  }

  .h-card-accent {
    position: absolute;
    top: 64px;
    left: 0;
    right: 0;
    height: 10px;
    border-top: 1px solid #1c1a17;
    border-bottom: 1px solid #1c1a17;
  }

  .h-card-header {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6a645a;
    padding-top: 12px;
  }

  .h-card-main {
    display: flex;
    flex-direction: column;
