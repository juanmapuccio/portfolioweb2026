---
import type { Lang } from '../i18n/ui';
import { martialExperienceData, BELTS, type MartialStage } from '../data/martialExperience';
import { Shield, Sparkles, ArrowRight, CheckCircle2 } from 'lucide-astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = martialExperienceData[lang];
---

<section id="trayectoria" class="martial-timeline-section" data-screen-label="03 Trayectoria">
  <!-- Encabezado de sección editorial espacioso -->
  <div class="trayectoria-intro" data-reveal>
    <span class="trayectoria-badge">{data.sectionBadge}</span>
    <h2 class="trayectoria-headline">{data.title}</h2>
    <p class="trayectoria-lede">{data.subtitle}</p>
  </div>

  <!-- Layout dividido 5fr / 7fr: Rail Sticky a la izquierda, Etapas a la derecha -->
  <div class="trayectoria-grid">
    <!-- Rail Sticky Izquierdo (Monitor Marcial) -->
    <aside class="belt-rail-wrapper" aria-hidden="true">
      <div class="belt-sticky-monitor" id="belt-sticky-monitor">
        <span class="belt-gup-row" id="monitor-meta">
          <span id="monitor-gup">10º gup</span> · <span id="monitor-years">2011</span>
        </span>

        <h3 class="belt-display-name" id="monitor-belt-name">Cinturón blanco</h3>

        <!-- Barra de tela de 72px con textura rayada y transición de color suave -->
        <div class="belt-strap" id="monitor-strap"></div>

        <!-- Indicador de 6 segmentos lineales de progreso -->
        <div class="belt-dots-row">
          {data.stages.map((stage) => {
            const belt = BELTS[stage.beltKey];
            return (
              <span
                class="belt-dot-bar"
                data-belt-step={stage.beltKey}
                style={`--dot-color: ${belt.color};`}
                title={`${belt.beltName} (${stage.years})`}
              />
            );
          })}
        </div>

        <p class="belt-caption">
          {lang === 'es'
            ? 'Los grados del Taekwondo ITF, del blanco al negro, como mapa de cada etapa.'
            : lang === 'en'
            ? 'Taekwondo ITF belt ranks, from white to black, as a blueprint of each milestone.'
            : 'As graduações do Taekwondo ITF, da branca à preta, como mapa de cada etapa.'}
        </p>
      </div>
    </aside>

    <!-- Columna de Etapas a la derecha -->
    <div class="stages-column">
      {data.stages.filter(s => s.beltKey !== 'negro').map((stage, index) => {
        const belt = BELTS[stage.beltKey];
        return (
          <article
            class="stage-scroll-block"
            id={`stage-${stage.beltKey}`}
            data-stage-index={index}
            data-belt-key={stage.beltKey}
            data-gup={belt.gup}
            data-belt-name={belt.beltName}
            data-years={stage.years}
            data-belt-color={belt.color}
            data-belt-line={belt.line}
          >
            <div class="stage-intro-header" data-reveal>
              <div class="stage-badge-tag">
                <span class="belt-badge-swatch" style={`background-color: ${belt.color};`}></span>
                <span class="belt-badge-text">{belt.gup} · {belt.beltName} · {stage.years}</span>
              </div>
              <h3 class="stage-main-title">{stage.title}</h3>
              {stage.lede && <p class="stage-editorial-lede">"{stage.lede}"</p>}
            </div>

            <div class="stage-positions-stack">
              {stage.positions.map((pos) => (
                <div class="position-row" data-reveal>
                  <span class="position-dates-col">{pos.dates}</span>
                  <div class="position-body-col">
                    <div class="position-role-title">{pos.role}</div>
                    <div class="position-org-title">{pos.org}</div>
                    {pos.description && <p class="position-desc-text">{pos.description}</p>}
                    {pos.transferableCompetency && (
                      <div class="position-comp-badge">
                        <span class="comp-badge-label">{data.competencyLabel}</span>
                        <span class="comp-badge-val">{pos.transferableCompetency}</span>
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

  <!-- Escena Pinned de Transición a Cinturón Negro (Claude Design v2) -->
  <div class="black-belt-scene" id="black-belt-transition" data-black-belt-scene>
    <div class="black-belt-sticky-wrapper">
      <div class="black-expanding-canvas" id="black-canvas"></div>
      
      <!-- Entrada: 2º gup -> 1º dan -->
      <div class="black-pre-text" id="black-pre-text">
        <span class="black-display-label">Negro</span>
        <span class="black-mono-sub">2º gup → 1º dan</span>
      </div>

      <!-- Revelación completa: Producción / NodoSur -->
      <div class="black-reveal-content" id="black-reveal-content">
        <span class="black-badge-dan">1º dan · {lang === 'es' ? 'Cinturón negro · Jun 2025 — hoy' : lang === 'en' ? 'Black belt · Jun 2025 — present' : 'Faixa preta · Jun 2025 — presente'}</span>
        <h3 class="black-main-headline">{lang === 'es' ? 'Producción' : lang === 'en' ? 'Production' : 'Produção'}</h3>
        <div class="black-details-grid">
          <div class="black-col-left">
            <span class="black-founder-title">{lang === 'es' ? 'Fundador & Arquitecto de Software' : lang === 'en' ? 'Founder & Software Architect' : 'Fundador & Arquiteto de Software'}</span>
            <a href="https://nodosur.dev/" target="_blank" rel="noopener noreferrer" class="black-nodosur-link">
              NodoSur · nodosur.dev ↗
            </a>
          </div>
          <div class="black-col-right">
            <p class="black-editorial-p">
              {lang === 'es' 
                ? 'Marca y software factory de soluciones a medida, servidores cloud autoadministrados y flujo CI/CD con Docker y GitHub Actions.'
                : lang === 'en' 
                ? 'Boutique software factory and proprietary cloud solutions: self-managed Linux servers, containerization, and GitHub Actions CI/CD.'
                : 'Marca e software factory de soluções sob medida, servidores cloud autogerenciados e fluxo CI/CD com Docker e GitHub Actions.'}
            </p>
            <p class="black-availability-p">
              {lang === 'es' 
                ? 'Hoy cuento con disponibilidad full-time real para sumarme a un equipo.' 
                : lang === 'en' 
                ? 'Ready with immediate full-time availability to join an engineering team.' 
                : 'Hoje conto com disponibilidade full-time real para me somar a uma equipe.'}
            </p>
          </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function setupMartialTimeline() {
    const stageBlocks = document.querySelectorAll<HTMLElement>('.stage-scroll-block[data-belt-key]');
    const monitorGup = document.getElementById('monitor-gup');
    const monitorYears = document.getElementById('monitor-years');
    const monitorBeltName = document.getElementById('monitor-belt-name');
    const monitorStrap = document.getElementById('monitor-strap');
    const dotBars = document.querySelectorAll<HTMLElement>('.belt-dot-bar[data-belt-step]');
    
    // Header elements sync
    const headerBeltSwatch = document.getElementById('header-belt-indicator');
    const headerGupText = document.getElementById('header-gup-indicator');

    if (!stageBlocks.length || !monitorGup || !monitorYears || !monitorBeltName || !monitorStrap) {
      return;
    }

    // Set initial active state on first belt
    updateMonitor(
      stageBlocks[0].dataset.beltKey,
      stageBlocks[0].dataset.gup,
      stageBlocks[0].dataset.years,
      stageBlocks[0].dataset.beltName,
      stageBlocks[0].dataset.beltColor,
      stageBlocks[0].dataset.beltLine,
      0
    );

    stageBlocks.forEach((block, index) => {
      const beltKey = block.dataset.beltKey;
      const gup = block.dataset.gup;
      const years = block.dataset.years;
      const beltName = block.dataset.beltName;
      const beltColor = block.dataset.beltColor;
      const beltLine = block.dataset.beltLine;

      ScrollTrigger.create({
        trigger: block,
        start: 'top 55%',
        end: 'bottom 55%',
        onEnter: () => updateMonitor(beltKey, gup, years, beltName, beltColor, beltLine, index),
        onEnterBack: () => updateMonitor(beltKey, gup, years, beltName, beltColor, beltLine, index),
      });
    });

    function updateMonitor(
      key?: string,
      gup?: string,
      years?: string,
      name?: string,
      color?: string,
      line?: string,
      activeIndex: number = 0
    ) {
      if (!key) return;
      if (monitorGup && gup) monitorGup.textContent = gup;
      if (monitorYears && years) monitorYears.textContent = years;
      if (monitorBeltName && name) monitorBeltName.textContent = name;
      if (monitorStrap && color) {
        monitorStrap.style.backgroundColor = color;
      }

      // Sync topbar header indicator
      if (headerBeltSwatch && color) {
        headerBeltSwatch.style.backgroundColor = color;
      }
      if (headerGupText && gup) {
        headerGupText.textContent = gup;
      }

      // Sync 6 dot bars with opacity: 1 (current), 0.55 (passed), 0.2 (upcoming)
      dotBars.forEach((bar, i) => {
        if (i === activeIndex) {
          bar.style.opacity = '1';
        } else if (i < activeIndex) {
          bar.style.opacity = '0.55';
        } else {
          bar.style.opacity = '0.2';
        }
      });
    }

    // GSAP ScrollTrigger para la transición a Cinturón Negro
    const blackScene = document.querySelector<HTMLElement>('[data-black-belt-scene]');
    const blackCanvas = document.getElementById('black-canvas');
    const blackPreText = document.getElementById('black-pre-text');
    const blackReveal = document.getElementById('black-reveal-content');

    if (blackScene && blackCanvas && blackPreText && blackReveal) {
      ScrollTrigger.create({
        trigger: blackScene,
        start: 'top top',
        end: 'bottom bottom',
        scrub: true,
        onUpdate: (self) => {
          const p = self.progress;

          // Height of black canvas expanding from center: 40px -> 100vh
          const expandPercent = Math.min(1, p * 1.8);
          blackCanvas.style.height = `calc(40px + ${expandPercent} * (100vh - 40px))`;

          // Pre-text fades out early
          const preOpacity = Math.max(0, Math.min(1, 1 - p * 3.5));
          blackPreText.style.opacity = `${preOpacity}`;

          // Final content fades in after 0.55 progress
          const revealOpacity = Math.max(0, Math.min(1, (p - 0.55) * 4));
          const revealTranslate = Math.max(0, (0.75 - p) * 80);
          blackReveal.style.opacity = `${revealOpacity}`;
          blackReveal.style.transform = `translateY(${revealTranslate}px)`;

          // When passing into black belt scene, sync header to black belt
          if (p > 0.4 && headerBeltSwatch && headerGupText) {
            headerBeltSwatch.style.backgroundColor = '#1c1a17';
            headerGupText.textContent = '1º dan';
          }
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMartialTimeline);
  } else {
    setupMartialTimeline();
  }
  document.addEventListener('astro:page-load', setupMartialTimeline);
</script>

<style>
  /* Sección 03 Trayectoria: Ancho completo de borde a borde */
  .martial-timeline-section {
    position: relative;
    padding: 0 clamp(20px, 5vw, 72px);
    background: #f2eee6;
    color: #1c1a17;
  }

  .trayectoria-intro {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
    max-width: 900px;
    box-sizing: border-box;
  }

  .trayectoria-badge {
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #7a746a;
  }

  .trayectoria-headline {
    margin: 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 300;
    font-size: clamp(40px, 6vw, 96px);
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: #1c1a17;
    text-wrap: balance;
  }

  .trayectoria-lede {
    margin: 0;
    font-size: 18px;
    line-height: 1.55;
    color: #4a463f;
    max-width: 620px;
    text-wrap: pretty;
  }

  /* Grid Layout: 5fr a la izquierda (sticky belt) / 7fr a la derecha (etapas) */
  .trayectoria-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 6vw, 120px);
    align-items: start;
    position: relative;
  }

  /* Columna izquierda Sticky: Monitor Marcial */
  .belt-rail-wrapper {
    display: block;
    position: relative;
    height: 100%;
  }

  .belt-sticky-monitor {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 26px;
    padding-top: 60px;
    box-sizing: border-box;
  }

  .belt-gup-row {
    font-family: var(--font-mono, monospace);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4a463f;
  }

  .belt-display-name {
    margin: 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 300;
    font-size: clamp(40px, 4.6vw, 76px);
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: #1c1a17;
  }

  .belt-strap {
    height: 72px;
    border: 1px solid rgba(28, 26, 23, 0.22);
    background-color: #f8f6f0;
    background-image: repeating-linear-gradient(
      0deg,
      transparent 0px,
      transparent 6px,
      rgba(28, 26, 23, 0.08) 6px,
      rgba(28, 26, 23, 0.08) 7px
    );
    transition: background-color 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .belt-dots-row {
    display: flex;
    gap: 6px;
  }

  .belt-dot-bar {
    flex: 1;
    height: 10px;
    border: 1px solid rgba(28, 26, 23, 0.25);
    background: var(--dot-color);
    opacity: 0.2;
    transition: opacity 0.4s ease;
  }

  .belt-caption {
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    color: #7a746a;
    max-width: 340px;
    line-height: 1.5;
    margin: 0;
  }

  /* Columna derecha: Flujo de etapas */
  .stages-column {
    display: flex;
    flex-direction: column;
  }

  .stage-scroll-block {
    padding: 14vh 0 10vh;
    min-height: 90vh;
    display: flex;
    flex-direction: column;
    gap: 28px;
    box-sizing: border-box;
  }

  .stage-intro-header {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .stage-badge-tag {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4a463f;
  }

  .belt-badge-swatch {
    width: 56px;
    height: 14px;
    border: 1px solid rgba(28, 26, 23, 0.25);
  }

  .stage-main-title {
    margin: 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 300;
    font-size: clamp(48px, 6.4vw, 104px);
    line-height: 0.92;
    letter-spacing: -0.04em;
    color: #1c1a17;
  }

  .stage-editorial-lede {
    margin: 0;
    max-width: 640px;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(20px, 1.8vw, 26px);
    line-height: 1.35;
    color: #4a463f;
    text-wrap: pretty;
  }

  .stage-positions-stack {
    display: flex;
    flex-direction: column;
  }

  .position-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 32px;
    padding: 26px 0;
    border-top: 1px solid rgba(28, 26, 23, 0.14);
  }

  .position-dates-col {
    flex: 0 0 170px;
    font-family: var(--font-mono, monospace);
    font-size: 13px;
    color: #7a746a;
    padding-top: 4px;
  }

  .position-body-col {
    flex: 1 1 320px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 640px;
  }

  .position-role-title {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: #1c1a17;
  }

  .position-org-title {
    font-family: var(--font-mono, monospace);
    font-size: 13px;
    color: #4a463f;
  }

  .position-desc-text {
    margin: 4px 0 0;
    font-size: 16px;
    line-height: 1.5;
    color: #4a463f;
    text-wrap: pretty;
  }

  .position-comp-badge {
    margin-top: 6px;
    font-size: 14px;
    color: #1c1a17;
    display: flex;
    gap: 10px;
    align-items: baseline;
  }

  .comp-badge-label {
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #7a746a;
    flex: none;
  }

  .comp-badge-val {
    color: #1c1a17;
  }

  @media (max-width: 900px) {
    .trayectoria-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .belt-rail-wrapper {
      display: none;
    }
    .position-row {
      flex-direction: column;
      gap: 8px;
    }
    .position-dates-col {
      flex: none;
    }
  }

  /* Escena Pinned de Cinturón Negro (Claude Design v2) */
  .black-belt-scene {
    height: 280vh;
    position: relative;
    margin-top: 5rem;
  }

  .black-belt-sticky-wrapper {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  .black-expanding-canvas {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    height: 40px;
    background: repeating-linear-gradient(0deg, transparent 0px, transparent 6px, rgba(242, 238, 230, 0.035) 6px, rgba(242, 238, 230, 0.035) 7px) #1c1a17;
    will-change: height;
  }

  .black-pre-text {
    position: absolute;
    left: clamp(20px, 5vw, 72px);
    right: clamp(20px, 5vw, 72px);
    top: calc(50% - 140px);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    pointer-events: none;
  }

  .black-display-label {
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 300;
    font-size: clamp(48px, 7vw, 112px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--text-main);
  }

  .black-mono-sub {
    font-family: var(--font-mono, monospace);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    padding-bottom: 12px;
  }

  .black-reveal-content {
    position: absolute;
    inset: 0;
    padding: 100px clamp(20px, 5vw, 72px) 48px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 24px;
    color: #f2eee6;
    opacity: 0;
    pointer-events: auto;
  }

  .black-badge-dan {
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #b3ab9d;
  }

  .black-main-headline {
    margin: 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 300;
    font-size: clamp(56px, 10vw, 150px);
    line-height: 0.88;
    letter-spacing: -0.045em;
    color: #f2eee6;
  }

  .black-details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 24px 64px;
    max-width: 1100px;
  }

  .black-col-left {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .black-founder-title {
    font-size: 20px;
    font-weight: 600;
    color: #ffffff;
  }

  .black-nodosur-link {
    font-family: var(--font-mono, monospace);
    font-size: 13px;
    color: #b3ab9d;
    text-decoration: none;
    transition: color 0.2s;
  }

  .black-nodosur-link:hover {
    color: #ffffff;
  }

  .black-col-right {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .black-editorial-p {
    margin: 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 300;
    font-size: clamp(20px, 1.8vw, 26px);
    line-height: 1.35;
    color: #f2eee6;
  }

  .black-availability-p {
    margin: 0;
    font-size: 16px;
    color: #cfc7b8;
  }
</style>
