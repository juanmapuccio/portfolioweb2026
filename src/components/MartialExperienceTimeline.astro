---
import type { Lang } from '../i18n/ui';
import { martialExperienceData, BELTS } from '../data/martialExperience';
import JobDetailModal from './JobDetailModal.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = martialExperienceData[lang];

const CHAPTER_CONFIG = [
  {
    key: 'blanco',
    num: '01',
    ko: '흰 띠',
    hex: '#ffffff',
    word: { es: 'Inocencia', en: 'Innocence', pt: 'Inocência' }[lang],
    meaning: {
      es: 'El alumno que empieza sin conocimiento previo.',
      en: 'The student who begins without prior knowledge.',
      pt: 'O aluno que começa sem conhecimento prévio.',
    }[lang],
  },
  {
    key: 'amarillo',
    num: '02',
    ko: '노란 띠',
    hex: '#fbbf24',
    word: { es: 'Tierra', en: 'Earth', pt: 'Terra' }[lang],
    meaning: {
      es: 'Donde la semilla echa raíces y se asientan las bases.',
      en: 'Where the seed takes root and the foundations are laid.',
      pt: 'Onde a semente cria raízes e se assentam as bases.',
    }[lang],
  },
  {
    key: 'verde',
    num: '03',
    ko: '초록 띠',
    hex: '#10b981',
    word: { es: 'Crecimiento', en: 'Growth', pt: 'Crescimento' }[lang],
    meaning: {
      es: 'La planta crece a medida que la técnica se desarrolla.',
      en: 'The plant grows as technique develops.',
      pt: 'A planta cresce à medida que a técnica se desenvolve.',
    }[lang],
  },
  {
    key: 'azul',
    num: '04',
    ko: '파란 띠',
    hex: '#0284c7',
    word: { es: 'Cielo', en: 'Heaven', pt: 'Céu' }[lang],
    meaning: {
      es: 'Hacia donde la planta madura y se convierte en árbol.',
      en: 'Toward which the plant matures into a tree.',
      pt: 'Para onde a planta amadurece e se torna árvore.',
    }[lang],
  },
  {
    key: 'rojo',
    num: '05',
    ko: '빨간 띠',
    hex: '#ef4444',
    word: { es: 'Control', en: 'Control', pt: 'Controle' }[lang],
    meaning: {
      es: 'Exige templanza, precisión técnica y saber cuándo frenar antes de actuar.',
      en: 'Demands composure, technical precision, and knowing when to hold back before acting.',
      pt: 'Exige equilíbrio, precisão técnica e saber quando frear antes de agir.',
    }[lang],
  },
];
---

<div class="martial-timeline-container" id="trayectoria">
  <div class="trayectoria-section-intro">
    <div class="intro-badge-row">
      <span class="intro-badge">{data.sectionBadge}</span>
    </div>
    <h2 class="intro-title">{data.title}</h2>
    <p class="intro-subtitle">{data.subtitle}</p>
  </div>

  {CHAPTER_CONFIG.map((cfg, idx) => {
    const stage = data.stages.find((s) => s.beltKey === cfg.key);
    const belt = BELTS[cfg.key];
    if (!stage || !belt) return null;
    const chIndex = idx + 1;

    return (
      <div id={cfg.key} class="chapter-block">
        <!-- Beat 1 — Aparece: cortina con título gigante y banda de cinturón. data-nav-target (contrato T3): fracción 0..1 del rango de scroll de la cortina (altura de la sección − viewport) en la que el reveal queda COMPLETO: título p≈0.33, cinta p≈0.42 y lede editorial p≈0.64 → se fija 0.7 con margen; T3 aterriza en curtainTop + f × (altura − innerHeight). -->
        <section data-fx="c" data-zone="curtain" data-ch={chIndex} data-nav-target="0.7" class="curtain-scene">
          <div class="curtain-sticky">
            <div class="curtain-meta-top">
              <span>Capítulo {cfg.num} · {cfg.ko} · {belt.beltName[lang]}</span>
              <span>{belt.gup} · {stage.years}</span>
            </div>

            <div class="curtain-title-wrap">
              <div class="curtain-title">{belt.philosophicalTitle[lang]}</div>
            </div>

            <div class="curtain-ribbon" style={`background: ${cfg.hex};`}></div>
            <div data-slot="1" class="curtain-slot"></div>

            <div class="curtain-editorial-block">
              <div class="curtain-meta-row">
                <span class="curtain-word-title">{cfg.word}</span>
                <span class="curtain-sep" aria-hidden="true">·</span>
                <span class="curtain-meaning-text">{cfg.meaning}</span>
              </div>
              <p class="curtain-stage-lede">{stage.lede}</p>
            </div>
          </div>
        </section>

        <!-- Beat 2 — Juega: track sticky+horizontal con los trabajos de la etapa (mismo mecanismo en los 5 capítulos; el detalle largo queda en data para el modal T2). -->
        <section
          data-fx="h"
          data-zone="h"
          data-ch={chIndex}
          class="h-section"
          style={`--h-section-h: ${120 + stage.positions.length * 105}vh;`}
        >
          <div class="h-sticky">
            <div data-track="1" class="h-track">
              <div class="h-intro-slide">
                <div class="h-intro-text">
                  <div class="h-intro-tag">
                    <span class="stage-tag-swatch" style={`background: ${cfg.hex};`}></span>
                    {belt.gup} · {stage.years}
                  </div>
                  <div class="h-intro-headline">{stage.title}</div>
                  <div class="h-intro-count">
                    {stage.positions.length} {lang === 'es' ? 'etapas · seguí bajando →' : lang === 'en' ? 'stages · scroll down →' : 'etapas · continue descendo →'}
                  </div>
                </div>
                <div data-slot="1" class="h-intro-slot"></div>
              </div>

              {stage.positions.map((pos, pIdx) => (
                <button
                  type="button"
                  class="h-role-card"
                  data-job={`${cfg.key}:${pIdx}`}
                  aria-label={`${pos.role} · ${pos.org} · ${pos.dates}`}
                >
                  <span class="h-card-accent" style={`background: ${cfg.hex};`}></span>
                  <span class="h-card-header">
                    <span>{String(pIdx + 1).padStart(2, '0')} / {String(stage.positions.length).padStart(2, '0')}</span>
                    <span>{pos.dates}</span>
                  </span>
                  <span class="h-card-main">
                    <span class="h-card-role">{pos.role}</span>
                    <span class="h-card-company">{pos.org}</span>
                    <span class="h-card-teaser">{pos.teaser}</span>
                  </span>
                </button>
              ))}
            </div>
            <div class="h-progress-bar" style={`background: ${cfg.hex};`}></div>
          </div>
        </section>
      </div>
    );
  })}

  <!-- Capítulo 06: Cinturón Negro & Transición a Modo Oscuro -->
  <div id="negro" class="chapter-black-wrapper">
    <!-- data-nav-target (contrato T3): 0.97 = p en la que el último bloque (.black-meta-bottom, opacidad (p−0.72)×4) queda visible con las fórmulas actuales de esta cortina; si T6 re-tima los tiempos, reajustar este valor. -->
    <section data-fx="c" data-zone="curtain" data-ch="6" data-nav-target="0.97" class="black-curtain-scene">
      <div class="black-curtain-sticky">
        <div class="black-red-flash"></div>
        <div class="black-expanding-circle"></div>
        <div class="black-radial-glow"></div>

        <div class="black-pre-text">
          <div class="black-pre-gup">1º gup → 1º dan</div>
          <div class="black-pre-quote">
            {lang === 'es' ? 'Diez grados, quince años.' : lang === 'en' ? 'Ten ranks, fifteen years.' : 'Dez graus, quinze anos.'}
          </div>
        </div>

        <div class="black-meta-top">
          <span>Capítulo 06 · 검은 띠 · {BELTS.negro.beltName[lang]}</span>
          <span>1º dan · Jun 2025 — Presente</span>
        </div>

        <div class="black-title-wrap">
          <div class="black-title">{BELTS.negro.philosophicalTitle[lang]}</div>
        </div>

        <div class="black-gold-line"></div>
        <div data-slot="1" class="black-slot"></div>

        <div class="black-meta-bottom">
          <div class="black-word-box">
            <span class="black-word">{lang === 'es' ? 'Madurez' : lang === 'en' ? 'Maturity' : 'Maturidade'}</span>
            <span class="black-meaning">
              {lang === 'es'
                ? 'Lo opuesto al blanco: dominio y serenidad frente al miedo.'
                : lang === 'en'
                ? 'The opposite of white: mastery and calm in the face of fear.'
                : 'O oposto do branco: domínio e serenidade diante do medo.'}
            </span>
          </div>
          <div class="black-right-box">
            <span class="black-role-lead">Fundador &amp; Arquitecto de Software · NodoSur</span>
            <span class="black-avail-cue">
              {lang === 'es'
                ? 'Hoy cuento con disponibilidad full-time real para sumarme a un equipo.'
                : lang === 'en'
                ? 'Today I have real full-time availability to join a team.'
                : 'Hoje conto com disponibilidade full-time real para me somar a uma equipe.'}
            </span>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Beat 3 — Profundiza: modal de detalle de cada trabajo (T2). Se monta UNA
       sola vez para todos los capítulos; abre por delegación en [data-job]. -->
  <JobDetailModal lang={lang} />
</div>

<script>
  function initScrollytelling() {
    const isReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const CHAPTER_KEYS = ['blanco', 'blanco', 'amarillo', 'verde', 'azul', 'rojo', 'negro'];
    const CHAPTER_COLORS: Record<string, string> = {
      blanco: '#ffffff',
      amarillo: '#fbbf24',
      verde: '#10b981',
      azul: '#0284c7',
      rojo: '#ef4444',
      negro: '#1c1a17',
    };

    // Static nodes: query once. Each fx element keeps its optional horizontal track.
    const fxItems = Array.from(document.querySelectorAll<HTMLElement>('[data-fx]')).map((el) => ({
      el,
      isH: el.dataset.fx === 'h',
      track: el.querySelector<HTMLElement>('[data-track]'),
      trackWidth: 0,
      lastP: '',
      lastTransform: '',
    }));
    const zones = Array.from(document.querySelectorAll<HTMLElement>('[data-zone]'));

    let lastBeltKey = '';
    let queued = false;
    let measureWidths = true;

    // Maps the active zone to a belt key. The black curtain stays "rojo" until its
    // expanding circle (see .black-expanding-circle: 10px * 400 at full scale) covers
    // the viewport corners, so the header never turns dark over a cream background.
    const BLACK_CIRCLE_MAX_RADIUS = 2000;
    function resolveBeltKey(zone: HTMLElement, rect: DOMRect, H: number, W: number): string {
      const ch = parseInt(zone.dataset.ch || '0', 10);
      if (zone.classList.contains('black-curtain-scene') && !isReduced) {
        const p = Math.min(1, Math.max(0, -rect.top / Math.max(1, rect.height - H)));
        const radius = Math.min(1, Math.max(0, (p - 0.14) * 4)) * BLACK_CIRCLE_MAX_RADIUS;
        if (radius < Math.hypot(W / 2, H / 2)) return CHAPTER_KEYS[5];
      }
      return CHAPTER_KEYS[ch] || 'blanco';
    }

    function frame() {
      queued = false;

      // READ phase: every layout read happens before any write.
      const H = window.innerHeight;
      const W = window.innerWidth;
      const mid = H / 2;

      if (measureWidths) {
        measureWidths = false;
        for (const item of fxItems) {
          if (item.track) item.trackWidth = item.track.scrollWidth;
        }
      }

      const fxRects = fxItems.map((item) => item.el.getBoundingClientRect());
      const zoneRects = zones.map((z) => z.getBoundingClientRect());

      // WRITE phase.
      fxItems.forEach((item, i) => {
        const r = fxRects[i];
        if (r.bottom < -H || r.top > 2 * H) return;
        let p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - H)));
        if (isReduced && !item.isH) p = 1;

        const pStr = p.toFixed(4);
        if (pStr !== item.lastP) {
          item.lastP = pStr;
          item.el.style.setProperty('--p', pStr);
        }

        if (item.isH && item.track) {
          const shift = -p * Math.max(0, item.trackWidth - W);
          const transform = `translate3d(${shift.toFixed(1)}px, 0, 0)`;
          if (transform !== item.lastTransform) {
            item.lastTransform = transform;
            item.track.style.transform = transform;
          }
        }
      });

      const activeIdx = zoneRects.findIndex((r) => r.top <= mid && r.bottom > mid);
      if (activeIdx !== -1) {
        const zone = zones[activeIdx];
        const beltKey = resolveBeltKey(zone, zoneRects[activeIdx], H, W);
        const color = CHAPTER_COLORS[beltKey] || '#ffffff';
        document.documentElement.dataset.activeBeltColor = color;
        if (beltKey !== lastBeltKey) {
          lastBeltKey = beltKey;
          window.dispatchEvent(
            new CustomEvent('belt:change', {
              detail: { beltKey, color },
            })
          );
        }

        // T6: while the black curtain is the active zone, scrub the 3D tint with
        // the same circle the scene paints. mix = radius / corner distance means
        // the belt turns black exactly as the circle swallows the viewport.
        // Dispatching every frame inside the zone (no change-throttle) is a
        // deliberate conflict guard: belt:change and this signal can fire on the
        // same frame when the header flips (scroll up/down across the flip
        // point), and Belt3D registers belt:change before belt:black-progress —
        // so the scrub always has the last word and the two never fight. At the
        // flip itself mix = 1, i.e. the hard switch to black is identical to the
        // scrub result. Leaving the zone needs no reset dispatch: the belt:change
        // path already restores the chapter color when the curtain deactivates.
        if (zone.classList.contains('black-curtain-scene')) {
          const rect = zoneRects[activeIdx];
          // Same p formula as the fx write phase (reduced motion renders the
          // final frame: --p is forced to 1 there, so mirror it here).
          const p = isReduced ? 1 : Math.min(1, Math.max(0, -rect.top / Math.max(1, rect.height - H)));
          const radius = Math.min(1, Math.max(0, (p - 0.14) * 4)) * BLACK_CIRCLE_MAX_RADIUS;
          const corner = Math.hypot(W / 2, H / 2);
          // Degenerate viewport (0×0 during teardown): treat as fully covered
          // instead of dividing by zero.
          const mix = corner > 0 ? Math.min(1, radius / corner) : 1;
          window.dispatchEvent(new CustomEvent('belt:black-progress', { detail: { progress: p, mix, from: CHAPTER_COLORS.rojo, to: CHAPTER_COLORS.negro } }));
        }
      }
    }

    // On-demand scheduler: at most one frame per rAF, only when something changed.
    function requestUpdate() {
      if (queued) return;
      queued = true;
      requestAnimationFrame(frame);
    }

    function onResizeOrLoad() {
      measureWidths = true;
      requestUpdate();
    }

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', onResizeOrLoad);
    window.addEventListener('load', onResizeOrLoad);
    requestUpdate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollytelling, { once: true });
  } else {
    initScrollytelling();
  }
</script>

<style>
  .martial-timeline-container {
    position: relative;
    background: #f2eee6;
  }

  .trayectoria-section-intro {
    padding: 120px clamp(20px, 5vw, 72px) 60px;
    max-width: 1600px;
    margin: 0 auto;
  }

  .intro-badge-row {
    margin-bottom: 12px;
  }

  .intro-badge {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4a463f;
  }

  .intro-title {
    margin: 0 0 12px;
    font-family: var(--font-serif);
    font-size: clamp(36px, 4.5vw, 64px);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #1c1a17;
  }

  .intro-subtitle {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: #4a463f;
    max-width: 640px;
  }

  /* ── Cortina Vertical Escénica ── */
  .curtain-scene {
    height: 240vh;
    position: relative;
  }

  .curtain-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: #f2eee6;
  }

  .curtain-meta-top {
    position: absolute;
    top: 84px;
    left: clamp(20px, 5vw, 72px);
    right: clamp(20px, 5vw, 72px);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4a463f;
  }

  .curtain-title-wrap {
    position: absolute;
    left: clamp(20px, 4vw, 64px);
    right: clamp(20px, 4vw, 64px);
    top: 9vh;
    height: 24vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
    pointer-events: none;
    z-index: 5;
  }

  .curtain-title {
    font-family: var(--font-serif);
    font-size: clamp(34px, 4.8vw, 84px);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #1c1a17;
    white-space: nowrap;
    text-align: center;
    opacity: clamp(0, calc(var(--p, 0) * 3.5), 1);
    transform: translateY(calc((1 - clamp(0, calc(var(--p, 0) * 3), 1)) * 24px));
  }

  .curtain-ribbon {
    position: absolute;
    left: 0;
    right: 0;
    top: 36vh;
    height: 30vh;
    border-top: 1px solid #1c1a17;
    border-bottom: 1px solid #1c1a17;
    transform-origin: 0 50%;
    transform: scaleX(clamp(0, calc(var(--p, 0) * 2.4), 1));
  }

  .curtain-slot {
    position: absolute;
    left: 20vw;
    right: 20vw;
    top: 37vh;
    height: 28vh;
    pointer-events: none;
    z-index: 2;
  }

  .curtain-editorial-block {
    position: absolute;
    left: clamp(20px, 6vw, 120px);
    right: clamp(20px, 6vw, 120px);
    bottom: 5vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    z-index: 3;
    opacity: clamp(0, calc((var(--p, 0) - 0.35) * 3.5), 1);
    transform: translateY(calc((1 - clamp(0, calc((var(--p, 0) - 0.35) * 3.5), 1)) * 18px));
  }

  .curtain-meta-row {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #4a463f;
    border-bottom: 1px solid rgba(28, 26, 23, 0.2);
    padding-bottom: 6px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .curtain-word-title {
    font-family: var(--font-serif);
    font-size: clamp(20px, 2.2vw, 28px);
    font-style: italic;
    font-weight: 500;
    color: #1c1a17;
    text-transform: none;
    letter-spacing: 0;
  }

  .curtain-sep {
    color: #6a645a;
    font-size: 14px;
  }

  .curtain-meaning-text {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #4a463f;
  }

  .curtain-stage-lede {
    font-family: var(--font-serif);
    font-size: clamp(18px, 1.8vw, 25px);
    font-weight: 400;
    line-height: 1.45;
    max-width: 780px;
    margin: 4px auto 0;
    color: #1c1a17;
    letter-spacing: -0.01em;
  }

  .stage-tag-swatch {
    width: 28px;
    height: 10px;
    border: 1px solid #1c1a17;
    display: inline-block;
  }

  /* ── Layout Horizontal (h-section) ── */
  .h-section {
    position: relative;
    /* Altura desktop: fórmula inline en --h-section-h (120 + n*105 vh).
       El override mobile vive en el media query de 767px, que escala la
       custom property (un style inline no puede ser sobreescrito por media query). */
    height: var(--h-section-h);
    border-top: 1px solid rgba(28, 26, 23, 0.12);
  }

  .h-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }

  .h-track {
    display: flex;
    height: 100%;
    will-change: transform;
  }

  .h-intro-slide {
    flex: none;
    width: 100vw;
    height: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: 40px;
    padding: 96px clamp(20px, 5vw, 72px) 60px;
    box-sizing: border-box;
  }

  .h-intro-text {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .h-intro-tag {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4a463f;
  }

  .h-intro-headline {
    font-family: var(--font-serif);
    font-size: clamp(40px, 5vw, 84px);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
    color: #1c1a17;
  }

  .h-intro-count {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6a645a;
  }

  .h-intro-slot {
    height: 52vh;
  }

  /* La card del track es un <button>: reset de controles nativos + feedback
     de interacción. El contenido usa <span> (phrasing content) para respetar
     el content model de <button>. */
  .h-role-card {
    flex: none;
    width: min(640px, 46vw);
    height: 100%;
    display: grid;
    grid-template-rows: auto 1fr;
    padding: 96px clamp(20px, 3vw, 48px) 56px;
    box-sizing: border-box;
    appearance: none;
    margin: 0;
    border: 0;
    border-left: 1px solid rgba(28, 26, 23, 0.12);
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    gap: 20px;
    position: relative;
    transition: background-color 160ms ease-out;
  }

  .h-role-card:hover {
    background-color: rgba(28, 26, 23, 0.04);
  }

  .h-role-card:focus-visible {
    outline: 2px solid #1c1a17;
    outline-offset: -2px;
    background-color: rgba(28, 26, 23, 0.04);
  }

  .h-card-accent {
    position: absolute;
    top: 64px;
