---
import type { Lang } from '../i18n/ui';
import { martialExperienceData, BELTS, type MartialStage } from '../data/martialExperience';
import { Shield, Sparkles, ArrowRight, CheckCircle2 } from 'lucide-astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = martialExperienceData[lang];
---

<section id="trayectoria" class="martial-timeline-section">
  <div class="container">
    <div class="section-header" data-reveal>
      <div class="section-badge">
        <Shield size={14} />
        <span>{data.sectionBadge}</span>
      </div>
      <h2 class="section-title">{data.title}</h2>
      <p class="section-subtitle">{data.subtitle}</p>
    </div>

    <!-- Layout dividido: Rail Sticky de Cinturones a la izquierda, Contenido a la derecha -->
    <div class="timeline-layout">
      <!-- Rail Sticky Izquierdo (Monitor Marcial) -->
      <aside class="belt-rail-container" aria-hidden="true">
        <div class="belt-sticky-monitor" id="belt-sticky-monitor">
          <div class="belt-meta-row">
            <span class="belt-gup-label" id="monitor-gup">10º gup</span>
            <span class="belt-years-label" id="monitor-years">2011</span>
          </div>

          <div class="belt-name-display" id="monitor-belt-name">Cinturón blanco</div>

          <!-- Barra simuladora de tela de cinturón con gradiente y textura -->
          <div class="belt-strap" id="monitor-strap">
            <div class="belt-texture"></div>
          </div>

          <!-- Indicador de progreso de los 6 cinturones -->
          <div class="belt-steps-indicator">
            {data.stages.map((stage) => {
              const belt = BELTS[stage.beltKey];
              return (
                <div
                  class="step-segment"
                  data-belt-step={stage.beltKey}
                  style={`--step-color: ${belt.color};`}
                  title={`${belt.beltName} (${stage.years})`}
                ></div>
              );
            })}
          </div>

          <p class="belt-philosophy-caption">
            {lang === 'es'
              ? 'Los grados del Taekwondo ITF, del blanco al negro, como mapa de constancia, rigor y maduración profesional.'
              : lang === 'en'
              ? 'Taekwondo ITF belt ranks, from white to black, as a blueprint of discipline, operational rigor, and mastery.'
              : 'As graduações do Taekwondo ITF, da branca à preta, como mapa de disciplina, rigor e maturidade profissional.'}
          </p>
        </div>
      </aside>

      <!-- Flujo de Etapas a la derecha -->
      <div class="stages-content-flow">
        {data.stages.filter(s => s.beltKey !== 'negro').map((stage, sIdx) => {
          const belt = BELTS[stage.beltKey];
          return (
            <article
              class="stage-block"
              id={`stage-${stage.beltKey}`}
              data-belt-key={stage.beltKey}
              data-gup={belt.gup}
              data-belt-name={belt.beltName}
              data-years={stage.years}
              data-belt-color={belt.color}
              data-belt-badge={belt.badgeColor}
            >
              <div class="stage-header">
                <div class="stage-tag" style={`--belt-color: ${belt.color}; --belt-badge: ${belt.badgeColor}`}>
                  <span class="belt-swatch"></span>
                  <span class="belt-tag-text">{belt.gup} · {belt.beltName} · {stage.years}</span>
                </div>
                <h3 class="stage-title">{stage.title}</h3>
                {stage.lede && <p class="stage-lede">"{stage.lede}"</p>}
              </div>

              <div class="positions-list">
                {stage.positions.map((pos) => (
                  <div class="position-item">
                    <div class="position-date-col">
                      <span class="position-date">{pos.dates}</span>
                    </div>
                    <div class="position-main-col">
                      <h4 class="position-role">{pos.role}</h4>
                      <div class="position-org">{pos.org}</div>
                      <p class="position-desc">{pos.description}</p>
                      {pos.transferableCompetency && (
                        <div class="competency-badge">
                          <span class="competency-label">{data.competencyLabel}</span>
                          <span class="competency-val">{pos.transferableCompetency}</span>
                        </div>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </div>

  <!-- Escena Pinned de Transición a Cinturón Negro (Claude Design v2) -->
  <div class="black-belt-scene" id="black-belt-transition" data-black-belt-scene>
    <div class="black-belt-sticky-wrapper">
      <div class="black-expanding-canvas" id="black-canvas"></div>
      
      <!-- Entrada: 2º gup -> 1º dan -->
      <div class="black-pre-text" id="black-pre-text">
        <span class="black-display-label">Negro</span>
        <span class="black-mono-sub">2º gup → 1º dan</span>
      </div>

      <!-- Revelación completa: Producción / NodoSur -->
      <div class="black-reveal-content" id="black-reveal-content">
        <span class="black-badge-dan">1º dan · {lang === 'es' ? 'Cinturón negro · Jun 2025 — hoy' : lang === 'en' ? 'Black belt · Jun 2025 — present' : 'Faixa preta · Jun 2025 — presente'}</span>
        <h3 class="black-main-headline">{lang === 'es' ? 'Producción' : lang === 'en' ? 'Production' : 'Produção'}</h3>
        <div class="black-details-grid">
          <div class="black-col-left">
            <span class="black-founder-title">{lang === 'es' ? 'Fundador & Arquitecto de Software' : lang === 'en' ? 'Founder & Software Architect' : 'Fundador & Arquiteto de Software'}</span>
            <a href="https://nodosur.dev/" target="_blank" rel="noopener noreferrer" class="black-nodosur-link">
              NodoSur · nodosur.dev ↗
            </a>
          </div>
          <div class="black-col-right">
            <p class="black-editorial-p">
              {lang === 'es' 
                ? 'Marca y software factory de soluciones a medida, servidores cloud autoadministrados y flujo CI/CD con Docker y GitHub Actions.'
                : lang === 'en' 
                ? 'Boutique software factory and proprietary cloud solutions: self-managed Linux servers, containerization, and GitHub Actions CI/CD.'
                : 'Marca e software factory de soluções sob medida, servidores cloud autogerenciados e fluxo CI/CD com Docker e GitHub Actions.'}
            </p>
            <p class="black-availability-p">
              {lang === 'es' 
                ? 'Hoy cuento con disponibilidad full-time real para sumarme a un equipo.' 
                : lang === 'en' 
                ? 'Ready with immediate full-time availability to join an engineering team.' 
                : 'Hoje conto com disponibilidade full-time real para me somar a uma equipe.'}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function setupMartialTimeline() {
    const stageBlocks = document.querySelectorAll<HTMLElement>('.stage-block[data-belt-key]');
    const monitorGup = document.getElementById('monitor-gup');
    const monitorYears = document.getElementById('monitor-years');
    const monitorBeltName = document.getElementById('monitor-belt-name');
    const monitorStrap = document.getElementById('monitor-strap');
    const stepSegments = document.querySelectorAll<HTMLElement>('.step-segment[data-belt-step]');

    if (!stageBlocks.length || !monitorGup || !monitorYears || !monitorBeltName || !monitorStrap) {
      return;
    }

    stageBlocks.forEach((block) => {
      const beltKey = block.dataset.beltKey;
      const gup = block.dataset.gup;
      const years = block.dataset.years;
      const beltName = block.dataset.beltName;
      const beltColor = block.dataset.beltColor;

      ScrollTrigger.create({
        trigger: block,
        start: 'top center',
        end: 'bottom center',
        onEnter: () => updateMonitor(beltKey, gup, years, beltName, beltColor),
        onEnterBack: () => updateMonitor(beltKey, gup, years, beltName, beltColor),
      });
    });

    function updateMonitor(key?: string, gup?: string, years?: string, name?: string, color?: string) {
      if (!key) return;
      if (monitorGup && gup) monitorGup.textContent = gup;
      if (monitorYears && years) monitorYears.textContent = years;
      if (monitorBeltName && name) monitorBeltName.textContent = name;
      if (monitorStrap && color) {
        monitorStrap.style.backgroundColor = color;
      }

      stepSegments.forEach((seg) => {
        const targetKey = seg.dataset.beltStep;
        if (targetKey === key) {
          seg.classList.add('is-active');
        } else {
          seg.classList.remove('is-active');
        }
      });
    }

    // GSAP ScrollTrigger para la transición a Cinturón Negro
    const blackScene = document.querySelector<HTMLElement>('[data-black-belt-scene]');
    const blackCanvas = document.getElementById('black-canvas');
    const blackPreText = document.getElementById('black-pre-text');
    const blackReveal = document.getElementById('black-reveal-content');

    if (blackScene && blackCanvas && blackPreText && blackReveal) {
      ScrollTrigger.create({
        trigger: blackScene,
        start: 'top top',
        end: 'bottom bottom',
        scrub: true,
        onUpdate: (self) => {
          const p = self.progress;

          // Height of black canvas expanding from center: 40px -> 100vh
          const expandPercent = Math.min(1, p * 1.8);
          blackCanvas.style.height = `calc(40px + ${expandPercent} * (100vh - 40px))`;

          // Pre-text fades out early
          const preOpacity = Math.max(0, Math.min(1, 1 - p * 3.5));
          blackPreText.style.opacity = `${preOpacity}`;

          // Final content fades in after 0.55 progress
          const revealOpacity = Math.max(0, Math.min(1, (p - 0.55) * 4));
          const revealTranslate = Math.max(0, (0.75 - p) * 80);
          blackReveal.style.opacity = `${revealOpacity}`;
          blackReveal.style.transform = `translateY(${revealTranslate}px)`;
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMartialTimeline);
  } else {
    setupMartialTimeline();
  }
  document.addEventListener('astro:page-load', setupMartialTimeline);
</script>

<style>
  .martial-timeline-section {
    padding: 6.5rem 0;
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-primary);
  }

  .section-header {
    margin-bottom: 4rem;
    max-width: 52rem;
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent-cyan);
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    padding: 0.35rem 0.85rem;
    margin-bottom: 1.25rem;
    font-family: var(--font-mono, monospace);
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-main);
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .section-subtitle {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* Layout con Rail Sticky */
  .timeline-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 4.5rem;
    align-items: start;
    position: relative;
  }

  .belt-rail-container {
    position: relative;
    height: 100%;
  }

  .belt-sticky-monitor {
    position: sticky;
    top: 6rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 2rem 1.75rem;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .belt-meta-row {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .belt-name-display {
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.02em;
    line-height: 1.2;
    min-height: 2.2rem;
  }

  .belt-strap {
    height: 52px;
    background-color: #f8f6f0;
    border: 1px solid var(--border-strong);
    position: relative;
    overflow: hidden;
    transition: background-color 0.4s ease-out;
  }

  .belt-texture {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      0deg,
      transparent 0,
      transparent 5px,
      rgba(0, 0, 0, 0.08) 5px,
      rgba(0, 0, 0, 0.08) 6px
    );
  }

  .belt-steps-indicator {
    display: flex;
    gap: 0.4rem;
  }

  .step-segment {
    flex: 1;
    height: 8px;
    background-color: var(--step-color);
    opacity: 0.25;
    border: 1px solid var(--border-subtle);
    transition: opacity 0.3s ease, transform 0.2s ease;
  }

  .step-segment.is-active {
    opacity: 1;
    transform: scaleY(1.35);
  }

  .belt-philosophy-caption {
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--text-dim);
    margin: 0;
  }

  /* Etapas a la derecha */
  .stages-content-flow {
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
  }

  .stage-block {
    padding-top: 1rem;
    border-top: 2px solid var(--border-subtle);
  }

  .stage-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .stage-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-main);
  }

  .belt-swatch {
    width: 38px;
    height: 12px;
    background-color: var(--belt-color);
    border: 1px solid var(--border-strong);
  }

  .stage-title {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin: 0;
  }

  .stage-lede {
    font-size: 1.05rem;
    font-style: italic;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
    max-width: 46rem;
  }

  .positions-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .position-item {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .position-date {
    font-family: var(--font-mono, monospace);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-dim);
    letter-spacing: 0.04em;
    display: block;
    margin-top: 0.25rem;
  }

  .position-main-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .position-role {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
    margin: 0;
    line-height: 1.3;
  }

  .position-org {
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
    color: var(--accent-cyan);
    font-weight: 600;
  }

  .position-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  .competency-badge {
    margin-top: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.6rem;
    background: var(--bg-surface-elevated);
    padding: 0.65rem 0.9rem;
    border-left: 2px solid var(--accent-cyan);
    border-radius: var(--radius-sm);
  }

  .competency-label {
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .competency-val {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--text-main);
  }

  @media (max-width: 900px) {
    .timeline-layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .belt-rail-container {
      display: none;
    }
    .position-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }

  /* Escena Pinned de Cinturón Negro (Claude Design v2) */
  .black-belt-scene {
    height: 280vh;
    position: relative;
    margin-top: 5rem;
  }

  .black-belt-sticky-wrapper {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  .black-expanding-canvas {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    height: 40px;
    background: repeating-linear-gradient(0deg, transparent 0px, transparent 6px, rgba(242, 238, 230, 0.035) 6px, rgba(242, 238, 230, 0.035) 7px) #1c1a17;
    will-change: height;
  }

  .black-pre-text {
    position: absolute;
    left: clamp(20px, 5vw, 72px);
    right: clamp(20px, 5vw, 72px);
    top: calc(50% - 140px);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    pointer-events: none;
  }

  .black-display-label {
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 300;
    font-size: clamp(48px, 7vw, 112px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--text-main);
  }

  .black-mono-sub {
    font-family: var(--font-mono, monospace);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    padding-bottom: 12px;
  }

  .black-reveal-content {
    position: absolute;
    inset: 0;
    padding: 100px clamp(20px, 5vw, 72px) 48px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 24px;
    color: #f2eee6;
    opacity: 0;
    pointer-events: auto;
  }

  .black-badge-dan {
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #b3ab9d;
  }

  .black-main-headline {
    margin: 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 300;
    font-size: clamp(56px, 10vw, 150px);
    line-height: 0.88;
    letter-spacing: -0.045em;
    color: #f2eee6;
  }

  .black-details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 24px 64px;
    max-width: 1100px;
  }

  .black-col-left {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .black-founder-title {
    font-size: 20px;
    font-weight: 600;
    color: #ffffff;
  }

  .black-nodosur-link {
    font-family: var(--font-mono, monospace);
    font-size: 13px;
    color: #b3ab9d;
    text-decoration: none;
    transition: color 0.2s;
  }

  .black-nodosur-link:hover {
    color: #ffffff;
  }

  .black-col-right {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .black-editorial-p {
    margin: 0;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-weight: 300;
    font-size: clamp(20px, 1.8vw, 26px);
    line-height: 1.35;
    color: #f2eee6;
  }

  .black-availability-p {
    margin: 0;
    font-size: 16px;
    color: #cfc7b8;
  }
</style>
