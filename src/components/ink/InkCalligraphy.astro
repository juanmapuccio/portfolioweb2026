---
// Specimen 2i: vertical calligraphy column, two glyphs bleed in and a seal lands (catalog cat-C).
// Each glyph and the seal are separate svg layers; the bleed filter stays on static text.
interface Props {
  glyphs: [string, string];
  label: string;
  class?: string;
}
const { glyphs, label, class: className } = Astro.props;
---

<div class:list={['ink-2i', className]} data-ink data-specimen="2i" role="img" aria-label={label}>
  <svg class="ink-2i__glyph ink-2i__glyph--a" viewBox="0 0 220 400" aria-hidden="true" focusable="false">
    <g filter="url(#bleedF)"><text x="110" y="170" text-anchor="middle" font-family="serif" font-weight="900" font-size="120" fill="currentColor">{glyphs[0]}</text></g>
  </svg>
  <svg class="ink-2i__glyph ink-2i__glyph--b" viewBox="0 0 220 400" aria-hidden="true" focusable="false">
    <g filter="url(#bleedF)"><text x="110" y="320" text-anchor="middle" font-family="serif" font-weight="900" font-size="120" fill="currentColor">{glyphs[1]}</text></g>
  </svg>
  <svg class="ink-2i__seal ink-stamp" style="--ink-delay: 0.9s" viewBox="0 0 220 400" aria-hidden="true" focusable="false">
    <rect x="150" y="350" width="26" height="26"></rect>
  </svg>
</div>

<style is:global>
  .ink-2i { position: relative; display: block; width: 100%; max-width: 220px; aspect-ratio: 220 / 400; background: var(--paper); color: var(--text-main); overflow: hidden; --e: cubic-bezier(0.16, 1, 0.3, 1); }
  .ink-2i svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ink-2i__seal { transform-origin: 74.1% 90.75%; }
  .ink-2i__seal rect { fill: var(--belt-red); }

  @keyframes ink-2i-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }
  html.js .ink-2i:not(.is-in) .ink-2i__glyph { opacity: 0; transform: translateY(10px); }
  html.js .ink-2i.is-in .ink-2i__glyph--a { animation: ink-2i-in 1.4s ease-out 0s 1 both; }
  html.js .ink-2i.is-in .ink-2i__glyph--b { animation: ink-2i-in 1.4s ease-out 0.7s 1 both; }

  @media (prefers-reduced-motion: reduce) {
    html.js .ink-2i:not(.is-in) .ink-2i__glyph,
    html.js .ink-2i.is-in .ink-2i__glyph { animation: none; opacity: 1; transform: none; }
  }
</style>
