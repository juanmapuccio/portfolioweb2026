---
// Specimen 1a: title underline, single brush sweep (catalog cat-C).
// The dry-brush filter sits on a static <g>; the wrapper svg is revealed with
// clip-path, so the filter never re-renders during the animation.
type Tone = 'white' | 'yellow' | 'green' | 'blue' | 'red' | 'black';
interface Props {
  eyebrow: string;
  title: string;
  tone?: Tone;
  class?: string;
}
const { eyebrow, title, tone = 'yellow', class: className } = Astro.props;
---

<div class:list={['ink-1a', className]} data-ink data-specimen="1a" style={`--tone: var(--ink-belt-${tone})`}>
  <span class="ink-1a__eyebrow">{eyebrow}</span>
  <span class="ink-1a__line">
    <svg class="ink-1a__stroke" viewBox="0 0 300 40" aria-hidden="true" focusable="false">
      <g filter="url(#dryH)"><path d="M6 24 C80 16 200 30 294 18" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round"></path></g>
    </svg>
    <span class="ink-1a__title">{title}</span>
  </span>
</div>

<style is:global>
  .ink-1a { display: block; max-width: 420px; padding: 36px 32px; --e: cubic-bezier(0.16, 1, 0.3, 1); }
  .ink-1a__eyebrow { display: block; font: 600 11px/1 var(--font-mono); letter-spacing: var(--tracking-meta); color: var(--text-dim); }
  .ink-1a__line { position: relative; display: inline-block; margin-top: 10px; }
  .ink-1a__stroke { position: absolute; left: -8px; bottom: -6px; width: calc(100% + 16px); height: 32px; overflow: visible; color: var(--tone); }
  .ink-1a__title { position: relative; font: 600 40px/1.1 var(--font-serif); color: var(--text-main); }

  @keyframes ink-1a-wipe {
    from { clip-path: inset(-50% 100% -50% -10%); }
    to { clip-path: inset(-50% -10% -50% -10%); }
  }
  html.js .ink-1a:not(.is-in) .ink-1a__stroke { clip-path: inset(-50% 100% -50% -10%); }
  html.js .ink-1a.is-in .ink-1a__stroke { animation: ink-1a-wipe 0.8s var(--e) 0.1s 1 both; }

  @media (prefers-reduced-motion: reduce) {
    html.js .ink-1a:not(.is-in) .ink-1a__stroke,
    html.js .ink-1a.is-in .ink-1a__stroke { animation: none; clip-path: none; }
  }
</style>
