---
// Specimen 10g: manga-style typographic SFX for milestones (catalog cat-C).
// Speed lines and the SFX glyph are separate svg layers (static filter inside),
// animated through transform and opacity only.
interface Props {
  sfx: string;
  title: string;
  caption: string;
  class?: string;
}
const { sfx, title, caption, class: className } = Astro.props;
---

<div class:list={['ink-10g', className]} data-ink data-specimen="10g">
  <svg class="ink-10g__lines" viewBox="0 0 420 220" aria-hidden="true" focusable="false">
    <g filter="url(#dryH)" stroke="currentColor" stroke-linecap="round">
      <path d="M300 100 L460 20" stroke-width="6"></path>
      <path d="M300 100 L470 110" stroke-width="9"></path>
      <path d="M300 100 L450 220" stroke-width="5"></path>
      <path d="M300 100 L360 -20" stroke-width="7"></path>
      <path d="M300 100 L250 -20" stroke-width="4"></path>
      <path d="M300 100 L330 240" stroke-width="8"></path>
    </g>
  </svg>
  <svg class="ink-10g__sfx" viewBox="0 0 420 220" aria-hidden="true" focusable="false">
    <text class="ink-10g__glyph" x="300" y="140" text-anchor="middle" font-family="serif" font-weight="900" font-size="120" stroke-width="6">{sfx}</text>
  </svg>
  <span class="ink-10g__title ink-fade" style="--ink-delay: 0.9s">{title}</span>
  <span class="ink-10g__caption ink-fade" style="--ink-delay: 1.1s">{caption}</span>
</div>

<style is:global>
  .ink-10g { position: relative; display: block; width: 100%; max-width: 420px; aspect-ratio: 420 / 220; overflow: hidden; background: var(--paper); color: var(--text-main); --e: cubic-bezier(0.16, 1, 0.3, 1); }
  .ink-10g svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ink-10g__lines, .ink-10g__sfx { transform-origin: 71.43% 45.45%; }
  .ink-10g__glyph { fill: var(--text-main); stroke: var(--paper); paint-order: stroke; }
  .ink-10g__title { position: absolute; left: 6.7%; bottom: 22%; font: 600 36px/1 var(--font-serif); }
  .ink-10g__caption { position: absolute; left: 7.1%; bottom: 11%; font: 600 10px/1 var(--font-mono); letter-spacing: 0.15em; color: var(--text-dim); }

  @keyframes ink-10g-lines {
    from { opacity: 0; transform: scale(1.4); }
    to { opacity: 1; transform: scale(1) rotate(4deg); }
  }
  @keyframes ink-10g-hit {
    from { transform: scale(0); }
    60% { transform: scale(1.3); }
    to { transform: scale(1); }
  }
  html.js .ink-10g:not(.is-in) .ink-10g__lines { opacity: 0; transform: scale(1.4); }
  html.js .ink-10g:not(.is-in) .ink-10g__sfx { transform: scale(0); }
  html.js .ink-10g.is-in .ink-10g__lines { animation: ink-10g-lines 0.7s var(--e) 0s 1 both; }
  html.js .ink-10g.is-in .ink-10g__sfx { animation: ink-10g-hit 0.6s var(--e) 0.05s 1 both; }

  @media (prefers-reduced-motion: reduce) {
    html.js .ink-10g:not(.is-in) .ink-10g__lines,
    html.js .ink-10g.is-in .ink-10g__lines { animation: none; opacity: 1; transform: rotate(4deg); }
    html.js .ink-10g:not(.is-in) .ink-10g__sfx,
    html.js .ink-10g.is-in .ink-10g__sfx { animation: none; transform: none; }
  }
</style>
