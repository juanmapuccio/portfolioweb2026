---
// Specimen 10h: letters fall in a cascade, the last one drips (catalog cat-C).
// One pass: the drip grows and stays hanging (the catalog dripped away in a loop).
interface Props {
  text: string;
  class?: string;
}
const { text, class: className } = Astro.props;
const letters = [...text];
const last = letters.length - 1;
---

<div class:list={['ink-10h', className]} data-ink data-specimen="10h">
  <span class="ink-10h__sr">{text}</span>
  <span class="ink-10h__word" aria-hidden="true">
    {letters.map((ch, i) => (
      <span class="ink-10h__letter" style={`--i: ${i}`}>
        {ch}
        {i === last && <span class="ink-10h__drip" style={`--i: ${i}`}></span>}
      </span>
    ))}
  </span>
</div>

<style is:global>
  .ink-10h { display: grid; place-items: center; width: 100%; max-width: 420px; height: 200px; background: var(--paper); color: var(--text-main); --e: cubic-bezier(0.16, 1, 0.3, 1); }
  .ink-10h__word { display: flex; font: 600 46px/1.1 var(--font-serif); }
  .ink-10h__letter { position: relative; display: inline-block; white-space: pre; }
  .ink-10h__drip { position: absolute; left: 40%; top: 88%; width: 5px; height: 38px; border-radius: 0 0 3px 3px; background: var(--text-main); transform-origin: top; }
  .ink-10h__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  @keyframes ink-10h-drop { from { opacity: 0; transform: translateY(-40px); } to { opacity: 1; transform: none; } }
  @keyframes ink-10h-drip { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  html.js .ink-10h:not(.is-in) .ink-10h__letter { opacity: 0; transform: translateY(-40px); }
  html.js .ink-10h:not(.is-in) .ink-10h__drip { transform: scaleY(0); }
  html.js .ink-10h.is-in .ink-10h__letter { animation: ink-10h-drop 0.7s var(--e) calc(var(--i) * 80ms) 1 both; }
  html.js .ink-10h.is-in .ink-10h__drip { animation: ink-10h-drip 1.1s ease-in calc(var(--i) * 80ms + 0.5s) 1 both; }

  @media (prefers-reduced-motion: reduce) {
    html.js .ink-10h:not(.is-in) .ink-10h__letter,
    html.js .ink-10h.is-in .ink-10h__letter { animation: none; opacity: 1; transform: none; }
    html.js .ink-10h:not(.is-in) .ink-10h__drip,
    html.js .ink-10h.is-in .ink-10h__drip { animation: none; transform: none; }
  }
</style>
