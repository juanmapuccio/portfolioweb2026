---
// Specimen 9c: icon button states: rest, hover with speed lines, active stamped as a hanko (catalog cat-M).
// Hover is a transition on transform/opacity only; the active seal lands once (ink-stamp).
import InkIcon from './InkIcon.astro';
import type { InkIconName } from './inkIcons';

interface Props {
  name: InkIconName;
  label: string;
  active?: boolean;
  class?: string;
}
const { name, label, active = false, class: className } = Astro.props;
---

<button type="button" class:list={['ink-9c', { 'is-active': active }, className]} data-ink data-specimen="9c" aria-label={label} aria-pressed={active}>
  {active && (
    <svg class="ink-9c__seal ink-stamp" viewBox="0 0 72 72" aria-hidden="true" focusable="false">
      <g filter="url(#bleedF)"><rect x="6" y="6" width="60" height="60" fill="none" stroke-width="2.5" transform="rotate(-4 36 36)"></rect></g>
    </svg>
  )}
  <svg class="ink-9c__speed" viewBox="0 0 72 72" aria-hidden="true" focusable="false">
    <path d="M6 26h22" stroke-width="1.2"></path>
    <path d="M2 36h20" stroke-width="2"></path>
    <path d="M8 46h16" stroke-width="1.2"></path>
  </svg>
  <span class="ink-9c__icon"><InkIcon name={name} size={40} /></span>
</button>

<style is:global>
  .ink-9c { position: relative; display: grid; place-items: center; width: 72px; height: 72px; padding: 0; border: 0; background: transparent; color: var(--text-main); cursor: pointer; }
  .ink-9c__icon { display: grid; transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
  .ink-9c__speed { position: absolute; inset: 0; width: 100%; height: 100%; stroke: currentColor; stroke-linecap: round; opacity: 0; transform: translateX(10px); transition: opacity 0.3s, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1); pointer-events: none; }
  .ink-9c:hover .ink-9c__icon, .ink-9c:focus-visible .ink-9c__icon { transform: translateX(4px); }
  .ink-9c:hover .ink-9c__speed, .ink-9c:focus-visible .ink-9c__speed { opacity: 1; transform: translateX(-6px); }
  .ink-9c.is-active { color: var(--seal-red); }
  .ink-9c__seal { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ink-9c__seal rect { stroke: var(--seal-red); }

  @media (prefers-reduced-motion: reduce) {
    .ink-9c__icon, .ink-9c__speed { transition: none; }
    .ink-9c:hover .ink-9c__icon, .ink-9c:focus-visible .ink-9c__icon { transform: none; }
    .ink-9c:hover .ink-9c__speed, .ink-9c:focus-visible .ink-9c__speed { transform: none; }
  }
</style>
