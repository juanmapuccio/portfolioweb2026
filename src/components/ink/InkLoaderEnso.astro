---
// Specimen 11c: desktop loader, ensō + mono counter, exits as a curtain (catalog cat-J).
// The slot is the content revealed when the curtain rises. The ensō stroke is NOT
// filtered because it animates stroke-dashoffset; swap in a static filtered ring if
// the dry-brush look is required. The curtain has no pointer events and is hidden
// without JS and under reduced motion.
// `controlled` hands the progress to src/scripts/loader.ts: no data-ink (no one-shot
// timeline), the stroke gets data-loader-stroke (dashoffset set from real readiness)
// and the tick column becomes a single data-loader-count number.
interface Props {
  label: string;
  controlled?: boolean;
  class?: string;
}
const { label, controlled = false, class: className } = Astro.props;
---

<div class:list={['ink-11c', className]} data-ink={controlled ? undefined : ''} data-specimen="11c">
  <div class="ink-11c__content"><slot /></div>
  <div class="ink-11c__curtain" aria-hidden="true">
    <svg class="ink-11c__enso" viewBox="0 0 200 200" width="170" height="170" focusable="false">
      <path class="ink-draw" data-loader-stroke={controlled ? '' : undefined} style="--ink-duration: 3s; --ink-ease: cubic-bezier(0.4, 0, 0.6, 1)" d="M112 34 C70 26 34 62 38 108 C42 152 86 174 124 160 C160 146 172 100 150 66" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" pathLength="1"></path>
    </svg>
    <div class="ink-11c__count">
      {controlled ? <span data-loader-count>00</span> : <div class="ink-11c__ticks"><div>00</div><div>25</div><div>50</div><div>75</div><div>100</div></div>}
    </div>
    <span class="ink-11c__label">{label}</span>
  </div>
</div>

<style is:global>
  .ink-11c { position: relative; width: 100%; max-width: 460px; min-height: 280px; overflow: hidden; background: var(--panel-dark); color: var(--panel-dark-fg); }
  .ink-11c__content { position: absolute; inset: 0; display: grid; place-items: center; font: 600 30px/1 var(--font-serif); }
  .ink-11c__curtain { position: absolute; inset: 0; display: grid; place-items: center; background: var(--paper); color: var(--text-main); pointer-events: none; transform: translateY(-100%); }
  .ink-11c__enso, .ink-11c__count { grid-area: 1 / 1; }
  .ink-11c__count { height: 24px; overflow: hidden; font: 600 18px/24px var(--font-mono); text-align: center; }
  .ink-11c__label { position: absolute; left: 24px; bottom: 20px; font: 600 10px/1 var(--font-mono); letter-spacing: var(--tracking-meta); color: var(--text-dim); }

  @keyframes ink-11c-tick {
    from { transform: translateY(0); }
    20% { transform: translateY(-24px); }
    40% { transform: translateY(-48px); }
    60% { transform: translateY(-72px); }
    80%, to { transform: translateY(-96px); }
  }
  @keyframes ink-11c-out { from { transform: none; } to { transform: translateY(-100%); } }
  html.js .ink-11c:not(.is-in) .ink-11c__curtain { transform: none; }
  html.js .ink-11c.is-in .ink-11c__curtain { animation: ink-11c-out 0.9s cubic-bezier(0.7, 0, 0.2, 1) 3.4s 1 both; }
  html.js .ink-11c.is-in .ink-11c__ticks { animation: ink-11c-tick 3s steps(1, end) 0s 1 both; }

  @media (prefers-reduced-motion: reduce) {
    html.js .ink-11c:not(.is-in) .ink-11c__curtain,
    html.js .ink-11c.is-in .ink-11c__curtain { animation: none; transform: translateY(-100%); }
    html.js .ink-11c:not(.is-in) .ink-11c__ticks,
    html.js .ink-11c.is-in .ink-11c__ticks { animation: none; transform: none; }
  }
</style>
