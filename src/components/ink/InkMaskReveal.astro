---
// Specimen 1f: three alternating brush wipes uncover a quote on a dark panel (catalog cat-C).
// The original SVG mask depended on a looping animation, so it is rebuilt as three
// statically clipped bands whose inner panels wipe in with clip-path.
interface Props {
  lines: string[];
  class?: string;
}
const { lines, class: className } = Astro.props;
const bands = [
  { top: '0%', bottom: '66.67%', from: 'left' },
  { top: '33.33%', bottom: '33.33%', from: 'right' },
  { top: '66.67%', bottom: '0%', from: 'left' },
];
---

<div class:list={['ink-1f', className]} data-ink data-specimen="1f">
  {bands.map((band, i) => (
    <div class="ink-1f__band" style={`--top: ${band.top}; --bottom: ${band.bottom}`} aria-hidden={i === 0 ? undefined : 'true'}>
      <div class:list={['ink-1f__panel', `ink-1f__panel--${band.from}`]} style={`--d: ${i * 0.35}s`}>
        {lines.map((line) => <span class="ink-1f__line">{line}</span>)}
      </div>
    </div>
  ))}
</div>

<style is:global>
  .ink-1f { position: relative; display: block; width: 100%; max-width: 420px; aspect-ratio: 2 / 1; background: var(--bg-primary); --e: cubic-bezier(0.16, 1, 0.3, 1); }
  .ink-1f__band { position: absolute; inset: 0; clip-path: inset(var(--top) 0 var(--bottom) 0); }
  .ink-1f__panel { position: absolute; inset: 0; display: grid; align-content: center; justify-items: center; gap: 8px; background: var(--panel-dark); color: var(--panel-dark-fg); }
  .ink-1f__line { font: italic 400 clamp(18px, 6vw, 28px)/1.2 var(--font-serif); text-align: center; }

  @keyframes ink-1f-from-left { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0); } }
  @keyframes ink-1f-from-right { from { clip-path: inset(0 0 0 100%); } to { clip-path: inset(0); } }
  html.js .ink-1f:not(.is-in) .ink-1f__panel--left { clip-path: inset(0 100% 0 0); }
  html.js .ink-1f:not(.is-in) .ink-1f__panel--right { clip-path: inset(0 0 0 100%); }
  html.js .ink-1f.is-in .ink-1f__panel--left { animation: ink-1f-from-left 0.9s var(--e) var(--d) 1 both; }
  html.js .ink-1f.is-in .ink-1f__panel--right { animation: ink-1f-from-right 0.9s var(--e) var(--d) 1 both; }

  @media (prefers-reduced-motion: reduce) {
    html.js .ink-1f:not(.is-in) .ink-1f__panel,
    html.js .ink-1f.is-in .ink-1f__panel { animation: none; clip-path: none; }
  }
</style>
