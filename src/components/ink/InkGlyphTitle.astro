---
// Specimen 10f: giant glyph bleeds in behind, the title rises on top (catalog cat-C).
// The glyph is a static filtered svg text on its own layer; only the layer fades/scales.
// Rising text sits inside overflow clip wrappers (ink-rise primitive).
interface Props {
  glyph: string;
  eyebrow: string;
  title: string;
  class?: string;
}
const { glyph, eyebrow, title, class: className } = Astro.props;
---

<div class:list={['ink-10f', className]} data-ink data-specimen="10f">
  <svg class="ink-10f__glyph" viewBox="0 0 260 260" aria-hidden="true" focusable="false">
    <g filter="url(#bleedF)"><text x="130" y="210" text-anchor="middle" font-family="serif" font-weight="900" font-size="260" fill="currentColor">{glyph}</text></g>
  </svg>
  <span class="ink-10f__clip"><span class="ink-10f__eyebrow ink-rise" style="--ink-delay: 0.3s">{eyebrow}</span></span>
  <span class="ink-10f__clip"><span class="ink-10f__title ink-rise" style="--ink-delay: 0.42s">{title}</span></span>
</div>

<style is:global>
  .ink-10f { position: relative; display: flex; flex-direction: column; justify-content: flex-end; gap: 8px; width: 100%; max-width: 420px; height: 220px; padding: 28px; box-sizing: border-box; overflow: hidden; background: var(--paper); color: var(--text-main); }
  .ink-10f__glyph { position: absolute; right: -10px; top: -40px; width: 260px; height: 260px; opacity: 0.09; }
  .ink-10f__clip { position: relative; display: block; overflow: hidden; }
  .ink-10f__eyebrow { display: block; font: 600 11px/1.4 var(--font-mono); letter-spacing: var(--tracking-meta); color: var(--text-dim); }
  .ink-10f__title { display: block; font: 600 40px/1.15 var(--font-serif); }

  @keyframes ink-10f-glyph {
    from { opacity: 0; transform: scale(1.3); }
    to { opacity: 0.09; transform: none; }
  }
  html.js .ink-10f:not(.is-in) .ink-10f__glyph { opacity: 0; transform: scale(1.3); }
  html.js .ink-10f.is-in .ink-10f__glyph { animation: ink-10f-glyph 1.5s ease-out 0s 1 both; }

  @media (prefers-reduced-motion: reduce) {
    html.js .ink-10f:not(.is-in) .ink-10f__glyph,
    html.js .ink-10f.is-in .ink-10f__glyph { animation: none; opacity: 0.09; transform: none; }
  }
</style>
