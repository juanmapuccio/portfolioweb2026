---
// Specimen 9g: contact channels as parchment seals on a dark panel (catalog cat-M).
// Channels rise in one after another once. The primary channel is inverted.
// Brand logos are intentionally avoided: each glyph is a function icon.
import InkIcon from './InkIcon.astro';
import type { InkIconName } from './inkIcons';

interface Channel {
  icon: InkIconName;
  label: string;
  href?: string;
  primary?: boolean;
}
interface Props {
  channels: Channel[];
  class?: string;
}
const { channels, class: className } = Astro.props;
---

<ul class:list={['ink-9g', className]} data-ink data-specimen="9g">
  {channels.map((channel, i) => {
    const Tag = channel.href ? 'a' : 'span';
    return (
      <li class="ink-9g__item" style={`--i: ${i}`}>
        <Tag class:list={['ink-9g__seal', { 'is-primary': channel.primary }]} href={channel.href}>
          <InkIcon name={channel.icon} size={32} />
          <span class="ink-9g__label">{channel.label}</span>
        </Tag>
      </li>
    );
  })}
</ul>

<style is:global>
  .ink-9g { display: grid; grid-template-columns: repeat(auto-fit, minmax(56px, 1fr)); gap: 10px; margin: 0; padding: 22px; list-style: none; background: var(--panel-dark); color: var(--panel-dark-fg); --e: cubic-bezier(0.16, 1, 0.3, 1); }
  .ink-9g__item { display: grid; }
  .ink-9g__seal { display: grid; justify-items: center; gap: 8px; color: inherit; text-decoration: none; }
  .ink-9g__seal > svg { box-sizing: content-box; padding: 12px; border: 1px solid color-mix(in oklab, var(--panel-dark-fg) 40%, transparent); }
  .ink-9g__seal.is-primary > svg { background: var(--panel-dark-fg); color: var(--panel-dark); }
  .ink-9g__label { font: 600 7px/1 var(--font-mono); letter-spacing: var(--tracking-meta); text-transform: uppercase; }

  @keyframes ink-9g-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  html.js .ink-9g:not(.is-in) .ink-9g__item { opacity: 0; transform: translateY(10px); }
  html.js .ink-9g.is-in .ink-9g__item { animation: ink-9g-in 0.7s var(--e) calc(var(--i) * 0.12s) 1 both; }

  @media (prefers-reduced-motion: reduce) {
    html.js .ink-9g:not(.is-in) .ink-9g__item,
    html.js .ink-9g.is-in .ink-9g__item { animation: none; opacity: 1; transform: none; }
  }
</style>
