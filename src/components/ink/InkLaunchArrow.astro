---
// Specimen 9e: "view live" arrow launches with a trail and pins a seal (catalog cat-M).
// Trail uses stroke-dashoffset (unfiltered); arrow and seal animate transform only.
// Positions use container units (cqw/cqh) so it scales with the card.
import InkIcon from './InkIcon.astro';

interface Props {
  label: string;
  class?: string;
}
const { label, class: className } = Astro.props;
---

<div class:list={['ink-9e', className]} data-ink data-specimen="9e">
  <svg class="ink-9e__trail" viewBox="0 0 300 200" aria-hidden="true" focusable="false">
    <path d="M30 170 L250 40" fill="none" stroke-width="2" stroke-linecap="round" pathLength="1" opacity="0.5"></path>
  </svg>
  <div class="ink-9e__arrow"><InkIcon name="external" size={56} /></div>
  <span class="ink-9e__seal" aria-hidden="true"></span>
  <span class="ink-9e__label">{label}</span>
</div>

<style is:global>
  .ink-9e { position: relative; width: 100%; max-width: 300px; aspect-ratio: 3 / 2; overflow: hidden; container-type: size; background: var(--panel-dark); color: var(--panel-dark-fg); --e: cubic-bezier(0.16, 1, 0.3, 1); }
  .ink-9e__trail { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ink-9e__trail path { stroke: currentColor; stroke-dasharray: 1; }
  .ink-9e__arrow { position: absolute; left: 0; top: 0; transform: translate(73.3cqw, 7cqh); }
  .ink-9e__seal { position: absolute; right: 20px; top: 24px; width: 44px; height: 44px; border: 2px solid var(--seal-red); transform: rotate(-6deg); }
  .ink-9e__label { position: absolute; left: 20px; bottom: 16px; font: 600 10px/1 var(--font-mono); letter-spacing: var(--tracking-meta); }

  @keyframes ink-9e-trail { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes ink-9e-throw { from { transform: translate(3.3cqw, 65cqh); } to { transform: translate(73.3cqw, 7cqh); } }
  @keyframes ink-9e-hit { from { transform: scale(0) rotate(-12deg); } 60% { transform: scale(1.4) rotate(-6deg); } to { transform: scale(1) rotate(-6deg); } }
  html.js .ink-9e:not(.is-in) .ink-9e__trail path { stroke-dashoffset: 1; }
  html.js .ink-9e:not(.is-in) .ink-9e__arrow { transform: translate(3.3cqw, 65cqh); }
  html.js .ink-9e:not(.is-in) .ink-9e__seal { transform: scale(0) rotate(-12deg); }
  html.js .ink-9e.is-in .ink-9e__trail path { animation: ink-9e-trail 0.9s var(--e) 0s 1 both; }
  html.js .ink-9e.is-in .ink-9e__arrow { animation: ink-9e-throw 0.9s var(--e) 0s 1 both; }
  html.js .ink-9e.is-in .ink-9e__seal { animation: ink-9e-hit 0.5s var(--e) 0.7s 1 both; }

  @media (prefers-reduced-motion: reduce) {
    html.js .ink-9e:not(.is-in) .ink-9e__trail path,
    html.js .ink-9e.is-in .ink-9e__trail path { animation: none; stroke-dashoffset: 0; }
    html.js .ink-9e:not(.is-in) .ink-9e__arrow,
    html.js .ink-9e.is-in .ink-9e__arrow { animation: none; transform: translate(73.3cqw, 7cqh); }
    html.js .ink-9e:not(.is-in) .ink-9e__seal,
    html.js .ink-9e.is-in .ink-9e__seal { animation: none; transform: rotate(-6deg); }
  }
</style>
