---
// Specimen 11m: language selector, a red seal hops to the chosen option and leaves a puff (catalog cat-J).
// The seal starts on the first option and lands on `active`. Step is 44px (28px option + 16px gap).
// The puff is a static filtered svg layer that swells and dissipates once at the landing spot.
// `links` turns each option into a real link (href, language name, lang code); without it
// the options are plain spans, as in the catalog.
interface LangLink {
  href: string;
  name: string;
  code: string;
}
interface Props {
  langs: string[];
  active: number;
  label: string;
  links?: LangLink[];
  class?: string;
}
const { langs, active, label, links, class: className } = Astro.props;
---

<div class:list={['ink-11m', className]} data-ink data-specimen="11m" role="group" aria-label={label} style={`--i: ${active}`}>
  <span class="ink-11m__stamp" aria-hidden="true"></span>
  {langs.map((lang, i) => links
    ? <a class:list={['ink-11m__lang', { 'is-active': i === active }]} href={links[i].href} lang={links[i].code} aria-label={links[i].name} aria-current={i === active ? 'true' : undefined}>{lang}</a>
    : <span class:list={['ink-11m__lang', { 'is-active': i === active }]} aria-current={i === active ? 'true' : undefined}>{lang}</span>)}
  <svg class="ink-11m__puff" viewBox="0 0 140 60" aria-hidden="true" focusable="false">
    <g filter="url(#bleedF)" fill-opacity="0.5">
      <circle class="ink-11m__c" cx="16" cy="11" r="11"></circle>
      <circle class="ink-11m__c" cx="6" cy="7" r="7"></circle>
      <circle class="ink-11m__c" cx="27" cy="9" r="8"></circle>
      <circle class="ink-11m__c" cx="12" cy="19" r="5"></circle>
      <circle class="ink-11m__c" cx="22" cy="19" r="5"></circle>
    </g>
  </svg>
</div>

<style is:global>
  .ink-11m { position: relative; display: inline-flex; gap: 16px; color: var(--text-main); }
  .ink-11m__lang { text-decoration: none; color: inherit; }
  .ink-11m__lang { position: relative; display: grid; place-items: center; width: 28px; height: 22px; font: 600 11px/1 var(--font-mono); letter-spacing: var(--tracking-meta); }
  .ink-11m__lang.is-active { color: var(--paper); }
  .ink-11m__stamp { position: absolute; left: -4px; top: -4px; width: 36px; height: 30px; background: var(--seal-red); transform: translateX(calc(var(--i) * 44px)); }
  .ink-11m__puff { position: absolute; left: calc(-30px + var(--i) * 44px); top: -18px; width: 140px; height: 60px; overflow: visible; pointer-events: none; opacity: 0; }
  .ink-11m__c { fill: var(--text-dim); }
  .ink-11m__lang { z-index: 1; }

  @keyframes ink-11m-hop { from { transform: translateX(0); } to { transform: translateX(calc(var(--i) * 44px)); } }
  @keyframes ink-11m-puff {
    from { opacity: 0; transform: scale(0); }
    35% { opacity: 1; transform: scale(1.1); }
    to { opacity: 0; transform: scale(1.4); }
  }
  html.js .ink-11m:not(.is-in) .ink-11m__stamp { transform: translateX(0); }
  html.js .ink-11m.is-in .ink-11m__stamp { animation: ink-11m-hop 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s 1 both; }
  html.js .ink-11m.is-in .ink-11m__puff { animation: ink-11m-puff 1.2s ease-out 0.85s 1 both; }

  @media (prefers-reduced-motion: reduce) {
    html.js .ink-11m:not(.is-in) .ink-11m__stamp,
    html.js .ink-11m.is-in .ink-11m__stamp { animation: none; transform: translateX(calc(var(--i) * 44px)); }
    html.js .ink-11m.is-in .ink-11m__puff { animation: none; opacity: 0; }
  }
</style>
