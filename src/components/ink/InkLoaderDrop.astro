---
// Specimen 11g: mobile loader, a drop falls and floods the screen with ink (catalog cat-J).
// Fills its container (give it a height); sizes are container-relative (cqh).
// Total run is about 2.4s. Ends on the dark panel with the name; no fade-out.
interface Props {
  eyebrow: string;
  name: string;
  class?: string;
}
const { eyebrow, name, class: className } = Astro.props;
---

<div class:list={['ink-11g', className]} data-ink data-specimen="11g">
  <span class="ink-11g__drop" aria-hidden="true"></span>
  <span class="ink-11g__ripple" aria-hidden="true"></span>
  <span class="ink-11g__flood" aria-hidden="true"></span>
  <div class="ink-11g__text">
    <span class="ink-11g__clip"><span class="ink-11g__eyebrow ink-rise" style="--ink-delay: 1.5s">{eyebrow}</span></span>
    <span class="ink-11g__clip"><span class="ink-11g__name ink-rise" style="--ink-delay: 1.62s">{name}</span></span>
  </div>
</div>

<style is:global>
  .ink-11g { position: relative; width: 100%; height: 100%; min-height: 360px; overflow: hidden; container-type: size; background: var(--paper); }
  .ink-11g__drop { position: absolute; left: 50%; top: 0; width: 14px; height: 20px; margin-left: -7px; border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%; background: var(--text-main); opacity: 0; }
  .ink-11g__ripple { position: absolute; left: 50%; top: 50cqh; width: 200px; height: 60px; margin: -30px 0 0 -100px; border: 3px solid var(--text-main); border-radius: 50%; box-sizing: border-box; opacity: 0; }
  .ink-11g__flood { position: absolute; inset: 0; background: var(--panel-dark); transform-origin: bottom; }
  .ink-11g__text { position: absolute; left: 20px; right: 20px; bottom: 40px; display: grid; gap: 6px; }
  .ink-11g__clip { display: block; overflow: hidden; }
  .ink-11g__eyebrow { display: block; font: 600 9px/1.4 var(--font-mono); letter-spacing: var(--tracking-meta); color: var(--bg-surface-elevated); }
  .ink-11g__name { display: block; font: 700 26px/1.1 var(--font-serif); color: var(--panel-dark-fg); }

  @keyframes ink-11g-drop {
    from { transform: translateY(-40px); opacity: 0; }
    10% { opacity: 1; }
    to { transform: translateY(50cqh); opacity: 1; }
  }
  @keyframes ink-11g-ripple { from { transform: scale(0); opacity: 1; } to { transform: scale(1); opacity: 0; } }
  @keyframes ink-11g-flood { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  html.js .ink-11g:not(.is-in) .ink-11g__flood { transform: scaleY(0); }
  html.js .ink-11g.is-in .ink-11g__drop { animation: ink-11g-drop 0.65s cubic-bezier(0.5, 0, 1, 0.5) 0s 1 both; }
  html.js .ink-11g.is-in .ink-11g__ripple { animation: ink-11g-ripple 0.8s ease-out 0.65s 1 both; }
  html.js .ink-11g.is-in .ink-11g__flood { animation: ink-11g-flood 0.85s cubic-bezier(0.7, 0, 0.3, 1) 0.8s 1 both; }

  @media (prefers-reduced-motion: reduce) {
    html.js .ink-11g:not(.is-in) .ink-11g__flood,
    html.js .ink-11g.is-in .ink-11g__flood { animation: none; transform: none; }
    html.js .ink-11g:not(.is-in) .ink-11g__drop,
    html.js .ink-11g.is-in .ink-11g__drop,
    html.js .ink-11g:not(.is-in) .ink-11g__ripple,
    html.js .ink-11g.is-in .ink-11g__ripple { animation: none; opacity: 0; }
  }
</style>
