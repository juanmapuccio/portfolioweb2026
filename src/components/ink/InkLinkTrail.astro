---
// Specimen 11l: header link hover with ghost trail and shift (catalog cat-J).
// Two ghost copies trail the text once on entry and settle into the hover offset
// via transitions on transform/opacity. Animation fill is `backwards` so the
// hover transitions are not overridden once the entry pass ends.
interface Props {
  label: string;
  href: string;
  class?: string;
}
const { label, href, class: className } = Astro.props;
---

<a class:list={['ink-11l', className]} href={href} data-ink data-specimen="11l">
  <span class="ink-11l__stack">
    <span class="ink-11l__ghost ink-11l__ghost--a" aria-hidden="true">{label}</span>
    <span class="ink-11l__ghost ink-11l__ghost--b" aria-hidden="true">{label}</span>
    <span class="ink-11l__main">{label}</span>
  </span>
</a>

<style is:global>
  .ink-11l { display: inline-block; font: 600 11px/1 var(--font-mono); letter-spacing: var(--tracking-meta); color: var(--text-main); text-decoration: none; text-transform: uppercase; --e: cubic-bezier(0.16, 1, 0.3, 1); }
  .ink-11l__stack { position: relative; display: grid; }
  .ink-11l__stack > span { grid-area: 1 / 1; }
  .ink-11l__main { transition: color 0.18s var(--e), transform 0.18s var(--e); }
  .ink-11l__ghost { opacity: 0; transition: transform 0.18s var(--e), opacity 0.18s var(--e); }
  .ink-11l:hover .ink-11l__main, .ink-11l:focus-visible .ink-11l__main { color: var(--accent-cyan); transform: translateX(2px); }
  .ink-11l:hover .ink-11l__ghost--a, .ink-11l:focus-visible .ink-11l__ghost--a { opacity: 0.15; transform: translateX(-10px); }
  .ink-11l:hover .ink-11l__ghost--b, .ink-11l:focus-visible .ink-11l__ghost--b { opacity: 0.35; transform: translateX(-5px); }

  @keyframes ink-11l-trail-a { from { opacity: 0; transform: translateX(-24px); } 40% { opacity: 0.15; transform: translateX(-10px); } to { opacity: 0; transform: none; } }
  @keyframes ink-11l-trail-b { from { opacity: 0; transform: translateX(-24px); } 40% { opacity: 0.35; transform: translateX(-5px); } to { opacity: 0; transform: none; } }
  html.js .ink-11l.is-in .ink-11l__ghost--a { animation: ink-11l-trail-a 0.9s var(--e) 0.2s 1 backwards; }
  html.js .ink-11l.is-in .ink-11l__ghost--b { animation: ink-11l-trail-b 0.9s var(--e) 0.24s 1 backwards; }

  @media (prefers-reduced-motion: reduce) {
    .ink-11l__main, .ink-11l__ghost { transition: none; }
    html.js .ink-11l.is-in .ink-11l__ghost { animation: none; }
    .ink-11l:hover .ink-11l__main, .ink-11l:focus-visible .ink-11l__main { transform: none; }
    .ink-11l:hover .ink-11l__ghost, .ink-11l:focus-visible .ink-11l__ghost { transform: none; }
  }
</style>
