---
import { useTranslations, type Lang } from '../../i18n/ui';

/**
 * "CV en 30 s": the last line of the hero on mobile, a static link to the flat one-page CV.
 * It never overlays content and needs no JS. The header carries the persistent CV link.
 */
interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const localePaths: Record<Lang, string> = { es: '/', en: '/en/', pt: '/pt/' };
---

<a class="cv30" href={localePaths[lang] + 'cv/'}>
  <span>{t('tul.cv.short')}</span>
  <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
    <path d="M3 10H16M11 5L16 10L11 15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path>
  </svg>
</a>

<style>
  .cv30 {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    align-self: flex-start;
    gap: var(--space-xs);
    min-height: 2.75rem;
    padding: 0 var(--space-s);
    border: var(--line-strong) solid var(--ink);
    background-color: var(--ink);
    color: var(--field);
    font-size: var(--step--1);
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .cv30:hover {
    background-color: var(--field);
    color: var(--ink);
  }

  .cv30:active {
    background-color: var(--ink-soft);
    border-color: var(--ink-soft);
    color: var(--field);
  }

  .cv30 svg {
    flex: none;
  }

  /* Mobile only: desktop has the header link. */
  @media (min-width: 62rem) {
    .cv30 {
      display: none;
    }
  }
</style>
