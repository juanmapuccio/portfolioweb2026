---
import FloorDiagram from './FloorDiagram.astro';
import InkDrops from './InkDrops.astro';
import { languages, useTranslations, type Lang } from '../../i18n/ui';
import { closeChannels, contactData } from '../../data/contact';
import { RETURN_FORM } from '../../data/tuls';

/**
 * The close. In ITF a tul ends where it started and Kyong-ye is the bow: one closing line is drawn
 * back to the Joon-bi footprints of the hero. One screen (100svh) holds the pitch, the CTA, the floor,
 * the ink rule, the channels and the colophon; the page ends with it. Nothing is pinned: the line
 * draws while the section scrolls in (data-scene-span="enter"), and the content is always in the DOM
 * and fully visible, the line and the ink are only the gesture.
 */
interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const content = contactData[lang];
const primary = content.channels.find((c) => c.id === 'email') ?? content.channels[0];
const whatsapp = content.channels.find((c) => c.id === 'whatsapp');
const studio = content.channels.find((c) => c.id === 'nodosur');
const localePaths: Record<Lang, string> = { es: '/', en: '/en/', pt: '/pt/' };

// One stroke weight for all channel icons (24 grid, square caps).
const ICONS: Record<string, string> = {
  whatsapp: 'M4 20L5.3 15.6A8.2 8.2 0 1 1 8.5 18.7Z M9 9.5C9 13 11 15 14.5 15',
  email: 'M3 6H21V18H3Z M3 6L12 13L21 6',
  linkedin: 'M3 3H21V21H3Z M8 10.5V17 M8 7V7.5 M12 17V10.5 M12 13.5A3 3 0 0 1 18 13.5V17',
  github: 'M5 3H9V7H5Z M5 17H9V21H5Z M15 9H19V13H15Z M7 7V17 M7 11H15',
  cv: 'M5 3H15L19 7V21H5Z M15 3V7H19 M8 11H16 M8 14.5H16 M8 18H13'
};
const isExternal = (url: string) => url.startsWith('https:');

// Four items, a 2x2 grid on phones: the email has its CTA and NodoSur sits in the colophon.
const items = [
  ...closeChannels(lang).map((c) => ({ id: c.id, name: c.name, label: c.label, url: c.url, external: isExternal(c.url) })),
  { id: 'cv', name: t('tul.cv.nav'), label: t('tul.close.cv'), url: localePaths[lang] + 'cv/', external: false }
];
---

<section
  id="contacto"
  class="ky"
  data-belt="negro"
  data-form-label={t('tul.close.label')}
  aria-labelledby="contacto-title"
>
  <div class="ky__scene" data-tul-scene data-scene-span="enter">
    <div class="ky__stage">
      <div class="ky__copy">
        <h2 id="contacto-title" class="ky__title grade-type">{content.title}</h2>
        <p class="ky__pitch">{content.subtitle}</p>
        <p class="ky__avail">{t('tul.hero.availability')}</p>
        <div class="ky__actions">
          <a class="ky__cta" href={primary.url}>
            <span>{t('tul.close.cta')}</span>
            <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
              <path d="M3 10H16M11 5L16 10L11 15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path>
            </svg>
            <span class="ky__goo ky__goo--drip" aria-hidden="true"></span>
          </a>
          {whatsapp && (
            <a class="ky__cta ky__cta--wa" href={whatsapp.url} target="_blank" rel="noopener noreferrer">
              <span>{t('tul.close.whatsapp')}<span class="visually-hidden"> {t('tul.cv.newTab')}</span></span>
            </a>
          )}
        </div>
      </div>

      <figure class="ky__map">
        <div class="ky__fig">
          <FloorDiagram form={RETURN_FORM} progress tatami readyLabel={t('tul.close.ready')} />
        </div>
        <figcaption class="ky__cap">
          <span class="ky__capname">{t('tul.close.label')} · {t('tul.close.ready')}</span>
          <span class="ky__capnote">{t('tul.close.note')}</span>
        </figcaption>
      </figure>

      <InkDrops />

      <nav class="ky__nav" aria-label={t('tul.close.channels')}>
        <ul class="ky__channels">
          {items.map((c) => (
            <li>
              <a
                class="ky__chan"
                href={c.url}
                target={c.external ? '_blank' : undefined}
                rel={c.external ? 'noopener noreferrer' : undefined}
                data-channel={c.id}
              >
                <svg class="ky__icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
                  <path d={ICONS[c.id] ?? ICONS.email}></path>
                </svg>
                <span class="ky__chan-name">{c.name}<span class="visually-hidden"> · </span></span>
                <span class="ky__chan-value num">{c.label}{c.external && <span class="visually-hidden"> {t('tul.cv.newTab')}</span>}</span>
                <span class="ky__goo" aria-hidden="true"><span class="ky__run"></span></span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <footer class="ky__colophon">
        <p class="ky__credit">{t('contact.footer')}</p>
        <ul class="ky__langs" aria-label={t('tul.lang.label')}>
          {(Object.keys(languages) as Lang[]).map((code) => (
            <li>
              <a href={localePaths[code]} hreflang={code} lang={code} aria-current={code === lang ? 'page' : undefined}>
                {code.toUpperCase()}
              </a>
            </li>
          ))}
        </ul>
        {studio && (
          <a class="ky__studio" href={studio.url} target="_blank" rel="noopener noreferrer">{studio.name}<span class="visually-hidden"> {t('tul.cv.newTab')}</span></a>
        )}
        <a class="ky__top" href="#main">{t('tul.close.back')}</a>
      </footer>
    </div>
  </div>
</section>

<style>
  /* The section keeps the layout's min-height and padding off: the stage is the one screen. */
  .ky {
    min-height: 0;
    padding: 0;
  }

  .ky__scene {
    position: relative;
  }

  /* One screen on every device: copy, floor, ink rule, channels, colophon. The floor takes what is left. */
  .ky__stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(min(7.5rem, 14svh), 1fr) auto auto auto;
    grid-template-areas:
      'copy'
      'map'
      'ink'
      'chan'
      'foot';
    row-gap: var(--space-xs);
    width: 100%;
    max-width: 80rem;
    min-height: 100svh;
    margin-inline: auto;
    padding: calc(3rem + var(--space-xs)) var(--gutter) var(--space-2xs);
  }

  .ky__copy {
    grid-area: copy;
    display: grid;
    gap: var(--space-2xs);
    align-content: center;
    justify-items: start;
    min-width: 0;
  }

  .ky__title {
    --grade: 0.9;
    max-width: 22ch;
    font-size: min(var(--step-3), 5.5svh);
    line-height: 1.02;
    /* Local: the display token is tighter than a two-line pitch at this size can carry. */
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .ky__pitch {
    max-width: 60ch;
    font-size: var(--step--1);
    line-height: 1.45;
  }

  .ky__avail {
    color: var(--ink-soft);
    font-size: var(--step--1);
    font-weight: 600;
  }

  /* Phones: the email and WhatsApp CTAs side by side; from 48rem one CTA. */
  .ky__actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2xs);
    justify-self: stretch;
    margin-top: var(--space-3xs);
  }

  /* The solid ink block of the hero CTA. A bead of ink hangs at its lower edge; on hover it drips. */
  .ky__cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    min-height: 3rem;
    padding: 0 var(--space-m);
    border: var(--line-strong) solid var(--ink);
    background-color: var(--ink);
    color: var(--field);
    font-size: var(--step-0);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .ky__cta:hover,
  .ky__cta:focus-visible {
    background-color: var(--field);
    color: var(--ink);
  }

  .ky__cta:hover svg,
  .ky__cta:focus-visible svg {
    transform: translateX(4px);
  }

  .ky__cta:active {
    transform: translateY(1px);
  }

  .ky__cta svg {
    flex: none;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  /* Phones: a compact pair; the arrow travels only on hover, so it waits for the wider screens. */
  .ky__actions .ky__cta {
    justify-content: center;
    gap: var(--space-2xs);
    padding-inline: var(--space-xs);
    font-size: var(--step--1);
    text-align: center;
    text-wrap: balance;
  }

  .ky__actions .ky__cta svg {
    display: none;
  }

  /* WhatsApp, the second way in: an outlined block of the same family beside the email CTA. */
  .ky__cta--wa {
    background-color: transparent;
    color: var(--ink);
  }

  .ky__cta--wa:hover,
  .ky__cta--wa:focus-visible {
    background-color: var(--ink);
    color: var(--field);
  }

  /* Gooey hover layers: decorative, hidden, never over text. They share the filter of InkDrops. */
  .ky__goo {
    position: absolute;
    pointer-events: none;
    filter: url(#ky-goo);
  }

  .ky__goo::before,
  .ky__goo::after,
  .ky__run::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    background-color: var(--ink);
  }

  /* CTA: a lip of ink straddling the lower edge under the arrow, and the drop it lets go on hover. */
  .ky__goo--drip {
    top: calc(100% - 0.45rem);
    right: 0.85rem;
    width: 2.25rem;
    height: 2.25rem;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .ky__cta:hover .ky__goo--drip,
  .ky__cta:focus-visible .ky__goo--drip {
    opacity: 1;
  }

  .ky__goo--drip::before {
    top: 0.1rem;
    left: 0.25rem;
    width: 1.75rem;
    height: 0.7rem;
  }

  .ky__goo--drip::after {
    top: 0.15rem;
    left: 0.75rem;
    width: 0.75rem;
    height: 0.75rem;
    transform: translateY(0) scale(0.6);
    transition: transform 200ms var(--ease-out);
  }

  .ky__cta:hover .ky__goo--drip::after,
  .ky__cta:focus-visible .ky__goo--drip::after {
    transform: translateY(1.05rem) scale(1, 1.15);
    transition-duration: 560ms;
  }

  .ky__map {
    /* The footprints are the destination: they stay solid while the line closes the loop. */
    --ready-o: 1;
    grid-area: map;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-s);
    min-height: 0;
    margin: 0;
  }

  /* The floor fills the height the screen leaves it; the box follows the isometric floor (189 x 122). */
  .ky__fig {
    --ky-h: 100cqh;
    container-type: size;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .ky__fig :global(.fd) {
    width: min(100%, calc(var(--ky-h) * 1.55));
  }

  .ky__cap {
    display: grid;
    gap: var(--space-3xs);
    max-width: 44ch;
    font-size: var(--step--1);
  }

  .ky__capname {
    font-weight: 700;
  }

  .ky__capnote {
    color: var(--ink-soft);
  }

  .ky__nav {
    grid-area: chan;
  }

  /* Phone: four items in a 2x2 grid. */
  .ky__channels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-xs);
  }

  /* Phones: the icon sits by the name and the value takes the full width of the cell below. */
  .ky__chan {
    position: relative;
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    grid-template-areas:
      'icon name'
      'value value';
    column-gap: var(--space-2xs);
    align-items: center;
    min-height: 2.75rem;
    padding-block: var(--space-3xs);
    border-bottom: var(--line) solid var(--ink-soft);
    text-decoration: none;
  }

  .ky__icon {
    grid-area: icon;
    width: 1.25rem;
    height: 1.25rem;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .ky__chan:hover .ky__icon,
  .ky__chan:focus-visible .ky__icon {
    transform: translateX(2px);
  }

  .ky__chan-name {
    grid-area: name;
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-variation-settings: 'wght' 700, 'wdth' 90;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .ky__chan-value {
    grid-area: value;
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: 0.875rem;
    line-height: 1.3;
    opacity: 0.85;
  }

  /* Channel: on hover a bead of ink runs along the item's line and the line fills behind it. */
  .ky__goo:not(.ky__goo--drip) {
    left: 0;
    right: 0;
    bottom: -0.5rem;
    height: 1rem;
  }

  .ky__goo:not(.ky__goo--drip)::before {
    top: 0.3rem;
    left: 0;
    width: 100%;
    height: 0.4rem;
    border-radius: 0;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 200ms var(--ease-out);
  }

  .ky__run {
    position: absolute;
    inset: 0;
    transition: transform 200ms var(--ease-out);
  }

  .ky__run::after {
    top: 0.1rem;
    left: 0;
    width: 0.8rem;
    height: 0.8rem;
    transform: scale(0);
    transition: transform 200ms var(--ease-out);
  }

  .ky__chan:hover .ky__goo::before,
  .ky__chan:focus-visible .ky__goo::before {
    transform: scaleX(1);
    transition-duration: 480ms;
  }

  .ky__chan:hover .ky__run,
  .ky__chan:focus-visible .ky__run {
    transform: translateX(calc(100% - 0.8rem));
    transition-duration: 480ms;
  }

  .ky__chan:hover .ky__run::after,
  .ky__chan:focus-visible .ky__run::after {
    transform: scale(1);
    transition-duration: 240ms;
  }

  .ky__colophon {
    grid-area: foot;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--space-m);
    font-size: var(--step--1);
  }

  .ky__credit {
    flex: 1 1 100%;
    line-height: 1.4;
  }

  .ky__langs {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
  }

  .ky__langs a,
  .ky__top {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-2xs);
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  /* 44px targets for the three language codes. */
  .ky__langs a {
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
  }

  .ky__top:hover,
  .ky__langs a:hover,
  .ky__studio:hover {
    opacity: 0.7;
  }

  .ky__studio {
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .ky__langs a[aria-current='page'] {
    font-weight: 700;
    text-decoration-thickness: var(--line-strong);
  }

  /* Reduced motion: the hover states land at once, nothing travels. */
  @media (prefers-reduced-motion: reduce) {
    .ky__goo,
    .ky__goo::before,
    .ky__goo::after,
    .ky__run,
    .ky__run::after {
      transition: none;
    }
  }

  /* Short phones (375 x 667): tighter rows keep the close on one screen. */
  @media (max-width: 47.99rem) and (max-height: 44rem) {
    .ky__stage {
      row-gap: var(--space-2xs);
    }
  }

  @media (min-width: 48rem) {
    .ky__stage {
      row-gap: var(--space-s);
      padding-bottom: var(--space-xs);
    }

    .ky__title {
      font-size: min(var(--step-3), 6svh);
    }

    .ky__pitch {
      font-size: var(--step-0);
    }

    .ky__actions {
      display: flex;
      justify-self: start;
    }

    .ky__actions .ky__cta {
      justify-content: space-between;
      gap: var(--space-s);
      padding-inline: var(--space-m);
      font-size: var(--step-0);
    }

    .ky__actions .ky__cta svg {
      display: block;
    }

    .ky__cta--wa {
      display: none;
    }

    .ky__channels {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .ky__chan {
      grid-template-areas:
        'icon name'
        'icon value';
      min-height: 3.75rem;
      padding-block: var(--space-2xs);
    }

    .ky__chan-value {
      font-size: var(--step--1);
    }

    .ky__credit {
      flex: 1 1 20rem;
    }
  }

  @media (min-width: 62rem) {
    .ky__stage {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.75fr);
      grid-template-rows: minmax(0, 1fr) auto auto auto;
      grid-template-areas:
        'copy map'
        'ink ink'
        'chan chan'
        'foot foot';
      column-gap: var(--space-xl);
      padding-top: calc(3rem + var(--space-m));
    }

    .ky__copy {
      gap: var(--space-xs);
    }

    .ky__title {
      font-size: min(var(--step-4), 7svh);
    }

    .ky__actions .ky__cta {
      min-height: 3.5rem;
      padding-inline: var(--space-l);
    }

    .ky__map {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .ky__fig {
      flex: 1 1 0;
    }

    .ky__cap {
      justify-items: center;
      text-align: center;
    }

    .ky__chan-name {
      font-size: var(--step-1);
    }
  }
</style>
