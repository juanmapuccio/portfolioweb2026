---
import { Picture } from 'astro:assets';
import FloorDiagram from './FloorDiagram.astro';
import CvShortcut from './CvShortcut.astro';
import ExternalDocIcon from './ExternalDocIcon.astro';
import portrait from '../../assets/fotojmPerfil.png';
import { useTranslations, type Lang } from '../../i18n/ui';
import { BELTS, martialExperienceData } from '../../data/martialExperience';
import { TUL_CHAPTERS } from '../../data/tuls';
import { CV_PDF_HREF } from '../../data/cvSheet';

/**
 * First viewport, on the white field: name, hook, availability, both CTAs and
 * the Joon-bi ready point of the white chapter's floor diagram. The scene is
 * pinned and traces the first quarter of the first tul; the white
 * chapter in T4 continues from `data-draw-end`.
 */
interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const form = TUL_CHAPTERS.blanco.forms[0];
const stage = martialExperienceData[lang].stages.find((s) => s.beltKey === 'blanco');
const readyLabel = `${BELTS.blanco.gup} · ${stage?.years ?? ''}`;

/** Share of the white form's path drawn while the hero plays. */
const DRAW_END = 0.25;
/** Scene progress at which the portrait has become the path and the line starts tracing. */
const Q_END = 0.3;
// Name lines are split here, at the word groups, so the entrance needs no runtime text splitting.
const nameWords = t('header.name').split(' ');
const nameLines = [nameWords.slice(0, -1).join(' '), nameWords[nameWords.length - 1]];

const CV_HREF = CV_PDF_HREF;

// Tooltip text of the hero floor's stops in the 3D tatami.
const stopLabels = Object.fromEntries(
  (stage?.positions ?? []).map((position) => [position.id, `${position.role} · ${position.org}`])
);
---

<section
  class="hero"
  data-belt="blanco"
  data-tul-scene
  data-belt-beat="land"
  data-p-from="0"
  data-p-to={DRAW_END}
  data-q-end={Q_END}
  data-draw-start={Q_END}
  data-draw-end={DRAW_END}
  aria-labelledby="hero-title"
>
  <div class="hero__stage" data-belt-stage>
    <div class="hero__copy">
      <div class="hero__id">
        <h1 id="hero-title" class="hero__name grade-type">{nameLines.map((line, i) => (
            <span class="hero__line" style={`--i:${i}`}>{line}</span>
          ))}</h1>
        <p class="hero__role">{t('header.role')}</p>
      </div>
      <p class="hero__hook">{t('hero.tagline')}</p>

      <div class="hero__actions">
        <a class="cta cta--primary" href="#contacto">
          <span>{t('tul.hero.cta.contact')}</span>
          <svg class="cta__icon cta__icon--next" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
            <path d="M3 10H16M11 5L16 10L11 15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path>
          </svg>
        </a>
        <a class="cta cta--secondary" href={CV_HREF} target="_blank" rel="noopener noreferrer">
          <span>{t('hero.btn.cv')}<span class="visually-hidden"> {t('tul.cv.newTab')}</span></span>
          <ExternalDocIcon />
        </a>
      </div>

      <div class="hero__foot">
        <p class="hero__avail">{t('tul.hero.availability')}</p>
        <p class="hero__cue">{t('tul.hero.cue')}</p>
      </div>
      <CvShortcut lang={lang} />
    </div>

    <figure class="hero__figure">
      <FloorDiagram form={form} labelled progress readyLabel={t('tul.hero.readyShort')} stopLabels={stopLabels}>
        <div slot="portrait" class="hero__plate">
          <div class="hero__media">
            <Picture
              src={portrait}
              alt={t('hero.portraitAlt')}
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              widths={[360, 560, 800, 1120]}
              sizes="(min-width: 62rem) 560px, 72vw"
              width={1120}
              height={1120}
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        </div>
        <div slot="overlay" class="hero__belt" data-belt-anchor="hero" aria-hidden="true"></div>
      </FloorDiagram>
      <figcaption class="hero__label">
        <span class="num">{readyLabel}</span>
        <span class="visually-hidden">{t('tul.hero.ready')}. {t('tul.hero.diagramNote')}</span>
      </figcaption>
      <button
        type="button"
        class="hero__3d"
        data-belt3d-toggle
        data-on={t('tul.hero.view3d')}
        data-off={t('tul.hero.view2d')}
        aria-pressed="false"
      >
        <svg class="hero__3d-icon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
          <path d="M10 2L17 6V14L10 18L3 14V6Z M3 6L10 10L17 6 M10 10V18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="miter"></path>
        </svg>
        <span data-belt3d-label>{t('tul.hero.view3d')}</span>
      </button>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding: 0;
    /* Static state: portrait shown, ghost route hidden, solid line undrawn. The engine
       writes --q (portrait to path) and --draw (line) only when motion is allowed. */
    --draw: 0;
    /* Ghost route stays hidden while the portrait is legible, so no line crosses the face. */
    --ghost-o: clamp(0, calc((var(--q, 0) - 0.3) * 1.4), 0.85);
    --ready-o: clamp(0, calc((var(--q, 0) - 0.45) * 4), 1);
  }

  .hero__line {
    display: block;
  }

  /* The plate holds the portrait; scroll turns it into the path (scale to the ready point, fade). */
  .hero__plate {
    width: 100%;
    height: 100%;
    transform: scale(calc(1 - 0.65 * var(--q, 0)));
    opacity: clamp(0, calc(1 - (var(--q, 0) - 0.3) * 1.6), 1);
    transform-origin: 50% 50%;
  }

  .hero__media {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: #f0f3fd;
  }

  /* Oversize by 3% each side so the transparent corners of the source stay cropped out. */
  .hero__media :global(img) {
    display: block;
    width: 106%;
    height: 106%;
    margin: -3%;
    max-width: none;
    object-fit: cover;
  }

  .hero__stage {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    height: 100svh;
    padding: calc(3rem + var(--space-m)) var(--gutter) var(--space-m);
  }

  .hero__copy {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-s);
  }

  .hero__name {
    font-size: var(--step-display);
    letter-spacing: var(--track-display);
    line-height: 0.98;
    text-wrap: wrap;
    overflow-wrap: break-word;
    max-width: 100%;
  }

  .hero__id {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .hero__role {
    color: var(--ink-soft);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-variation-settings: 'wght' 500, 'wdth' 88;
    letter-spacing: 0.01em;
  }

  .hero__hook {
    max-width: 24ch;
    font-size: var(--step-2);
    line-height: 1.2;
    font-weight: 500;
  }

  .hero__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xs);
    width: 100%;
    margin-top: var(--space-2xs);
  }

  .hero__foot {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    width: 100%;
    max-width: 38ch;
    padding-top: var(--space-xs);
    border-top: var(--line) solid var(--ink-soft);
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .hero__figure {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    gap: var(--space-2xs);
    min-height: 7rem;
    margin: 0;
  }

  .hero__figure :global(.fd) {
    flex: 1 1 0;
    min-height: 0;
    width: auto;
    max-width: 100%;
    align-self: center;
  }

  .hero__label {
    font-size: var(--step-0);
    font-weight: 600;
  }

  /* 3D belt (desktop only, see src/scripts/belt3d). This box holds no canvas: the one fixed canvas of the
     page draws the belt over it. It is the floor box the belt lands in: absolutely placed inside the
     diagram, centred on the ready point (the diagram centre), so it never moves the layout. tul.ts measures
     it and publishes its centre and side as --belt-hero-x/y/s. It is also the drag zone of the belt: it takes
     pointer events only once the canvas has drawn (the canvas itself never does). */
  .hero__belt {
    display: none;
  }

  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero__belt {
      position: absolute;
      left: 50%;
      top: 47.5%;
      z-index: 2;
      display: block;
      width: 70cqw;
      aspect-ratio: 1;
      transform: translate(-50%, -52%);
      pointer-events: none;
    }

    :global(html[data-belt3d='ready']) .hero__belt {
      pointer-events: auto;
      touch-action: pan-y;
      cursor: grab;
    }
  }

  /* On-demand 3D on a phone (T12d). The button shows below 1024 px with JS (boot.ts binds it). While it is on,
     html[data-belt3d-tap='on']: the floor box becomes the anchor the scene measures (same box as on desktop,
     but it never takes touches, so the page keeps scrolling), the portrait steps aside and the tatami takes the
     figure. "Ver en 2D" removes the attribute and everything returns. */
  .hero__3d {
    display: none;
  }

  :global(html.js) .hero__3d:not([hidden]) {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: var(--space-2xs);
    min-height: 2.75rem;
    padding: 0 var(--space-xs);
    border: var(--line) solid var(--ink-soft);
    background-color: transparent;
    color: var(--ink);
    font: inherit;
    font-size: var(--step--1);
    font-weight: 700;
    cursor: pointer;
  }

  .hero__3d[aria-pressed='true'] {
    border-color: var(--ink);
  }

  :global(html[data-belt3d-tap='on']) .hero__belt {
    position: absolute;
    left: 50%;
    top: 47.5%;
    z-index: 2;
    display: block;
    width: 70cqw;
    aspect-ratio: 1;
    transform: translate(-50%, -52%);
    pointer-events: none;
  }

  :global(html[data-belt3d-tap='on']) .hero__plate {
    visibility: hidden;
  }

  @media (min-width: 64rem) {
    :global(html.js) .hero__3d:not([hidden]) {
      display: none;
    }
  }

  /* Rule-and-label controls */

  .cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    min-height: 3.25rem;
    padding: 0 var(--space-xs);
    border: var(--line-strong) solid var(--ink);
    color: var(--ink);
    font-size: var(--step-0);
    font-weight: 700;
    line-height: 1.1;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .cta__icon {
    flex: none;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .cta--primary {
    background-color: var(--ink);
    color: var(--field);
  }

  .cta--primary:hover {
    background-color: var(--field);
    color: var(--ink);
  }

  .cta--primary:hover .cta__icon--next {
    transform: translateX(4px);
  }

  .cta--primary:active {
    background-color: var(--ink-soft);
    color: var(--field);
    transform: translateY(1px);
  }

  /* The secondary is a label over a rule; the rule thickens on interaction. */
  .cta--secondary {
    border-color: transparent;
    background-color: transparent;
  }

  .cta--secondary::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: var(--line-strong);
    background-color: var(--ink);
    transform-origin: bottom;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .cta--secondary:hover::after {
    transform: scaleY(3);
  }

  .cta--secondary:active {
    transform: translateY(1px);
  }

  .cta:focus-visible {
    outline: var(--line-strong) solid var(--ink);
    outline-offset: 3px;
  }

  /* One entrance moment (~1.6s), only while the layout script has set html.tul-intro.
     Every keyframe ends visible and the engine removes the class, so nothing can stay hidden. */
  :global(html.tul-intro) .hero__media {
    animation: plate-open 1.1s var(--ease-out) both;
  }

  :global(html.tul-intro) .hero__line {
    animation: rise 0.8s var(--ease-out) both;
    animation-delay: calc(150ms + 80ms * var(--i, 0));
  }

  :global(html.tul-intro) .hero__role {
    animation: rise 0.7s var(--ease-out) 0.42s both;
  }

  :global(html.tul-intro) .hero__hook {
    animation: rise 0.7s var(--ease-out) 0.52s both;
  }

  :global(html.tul-intro) .cta--primary {
    animation: rise 0.7s var(--ease-out) 0.64s both;
  }

  :global(html.tul-intro) .cta--secondary {
    animation: rise 0.7s var(--ease-out) 0.72s both;
  }

  :global(html.tul-intro) .hero__foot {
    animation: rise 0.7s var(--ease-out) 0.84s both;
  }

  :global(html.tul-intro) .hero__label {
    animation: fade 0.6s var(--ease-out) 1s both;
  }

  @keyframes plate-open {
    from {
      clip-path: inset(0 50% 0 50%);
      transform: scale(1.08);
      filter: blur(8px);
    }
    to {
      clip-path: inset(0);
      transform: scale(1);
      filter: blur(0);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.5em);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Pinned scene: only when JS runs and motion is allowed. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero {
      height: 220svh;
    }

    :global(html.js) .hero__stage {
      position: sticky;
      top: 0;
    }
  }

  @media (min-width: 30rem) {
    .hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-m);
    }

    .cta {
      padding: 0 var(--space-m);
    }

    .cta--primary {
      min-width: 13rem;
    }

    .cta--secondary {
      padding: 0 var(--space-2xs);
    }
  }

  /* Desktop: copy top-left; availability and cue anchored to the diagram's baseline. */
  @media (min-width: 62rem) {
    .hero__stage {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: var(--space-xl);
      align-items: stretch;
      padding-block: calc(3rem + var(--space-m)) var(--space-m);
    }

    .hero__copy {
      gap: var(--space-m);
    }

    .hero__hook {
      max-width: 22ch;
    }

    .hero__foot {
      margin-top: auto;
    }

    .hero__figure {
      justify-content: flex-end;
      align-items: flex-end;
      min-height: 0;
    }

    .hero__figure :global(.fd) {
      flex: none;
      align-self: flex-end;
      width: min(100%, calc(100svh - 8.5rem));
    }

    .hero__label {
      width: min(100%, calc(100svh - 8.5rem));
    }
  }
</style>
