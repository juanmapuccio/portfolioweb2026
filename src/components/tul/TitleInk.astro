---
/**
 * Dry-brush underline of a chapter title. Decorative (aria-hidden): the real h2 carries the meaning.
 * One shape for every belt: a horizontal stroke of variable width with four bristle streaks, drawn left to
 * right once when the title enters (src/scripts/titleInk.ts).
 *
 * The only thing that changes between chapters is the colour. The mark paints with `currentColor`, which
 * is `--belt-line` of the chapter it sits in (a stroke colour that holds 3:1 on its field; the black
 * chapter resolves it to the light line on the dark field, see tokens.css). It is authored paths, not a
 * filter, so DrawSVG can draw it (`data-ink-stroke`). Without JS or with reduced motion the markup below is
 * the finished mark.
 */
const STREAKS: { d: string; w: number }[] = [
  { d: 'M6 10 C120 6 300 12 470 8 S580 9 594 11', w: 8 },
  { d: 'M18 21 C140 18 280 23 430 19', w: 6 },
  { d: 'M62 31 C190 29 330 33 520 29', w: 4 },
  { d: 'M120 40 C220 39 300 41 380 39', w: 2.5 }
];
---

<svg class="ti" data-ink="dry" viewBox="0 0 600 48" aria-hidden="true" focusable="false">
  {STREAKS.map((s) => (
    <path class="ti__s" data-ink-stroke d={s.d} stroke-width={s.w}></path>
  ))}
</svg>

<style>
  /* Hangs under the title, on the left, never wider than a comfortable measure. */
  .ti {
    position: absolute;
    left: 0;
    bottom: -0.4rem;
    display: block;
    width: min(100%, 28rem);
    height: auto;
    aspect-ratio: 600 / 48;
    overflow: visible;
    color: var(--belt-line);
    pointer-events: none;
  }

  .ti__s {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
  }
</style>
