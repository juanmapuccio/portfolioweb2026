---
import type { BeltKey } from '../../data/tuls';

/**
 * The spacer between two belt chapters. In flow, decorative, aria-hidden, no text.
 *
 * It no longer paints anything across the screen: the sumi-e ink lives only under the chapter titles
 * (TitleInk.astro). The spacer is a quiet gap, ~50svh on desktop and 40svh on mobile, that later layers
 * stand on (the black flood at 1st dan, the belt drawing).
 *
 * The engine (tul.ts, [data-tul-passage]) writes `--p` (0..1) on the passage while it crosses the
 * viewport (top at the bottom edge to bottom at the top edge). With reduced motion or without JS the
 * passage stays a static 8rem gap and `--p` is never written.
 */
interface Props {
  from: BeltKey;
  to: BeltKey;
}

const { from, to } = Astro.props;
---

<div class="ink" data-tul-passage data-belt={to} data-from={from} aria-hidden="true"></div>

<style>
  .ink {
    --ink-h: 8rem;
    position: relative;
    height: var(--ink-h);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .ink {
      --ink-h: 50svh;
    }
  }

  @media (max-width: 47.99rem) and (prefers-reduced-motion: no-preference) {
    :global(html.js) .ink {
      --ink-h: 40svh;
    }
  }
</style>
