---
import type { BeltKey } from '../../data/tuls';
import BeltDrawing from './BeltDrawing.astro';
import { KNOT_AT } from './beltDrawing';
import { FLOOD_FULL, FLOOD_START, seepPolygon } from '../../scripts/belt3d/passage';

/**
 * The spacer between two belt chapters. In flow, decorative, aria-hidden, no text.
 *
 * It paints nothing across the screen, except at one place: the passage that arrives at 1st dan
 * (`to === 'negro'`) carries the black flood. There is no ink under the chapter titles. The spacer is ~50svh on desktop and 40svh on mobile. It holds the detailed belt
 * drawing (BeltDrawing.astro), centred, which unties and ties again as the passage scrolls by:
 *   - mobile (< 1024px): always there, it is the thread of the journey (no 3D on mobile);
 *   - desktop: the poster of the 3D belt. It shows until the 3D scene reports html[data-belt3d="ready"],
 *     and always when 3D never loads (no WebGL, reduced motion, save-data). Once ready, the one fixed canvas
 *     (src/scripts/belt3d) rides this spacer: the belt unties, changes colour and ties again inside it
 *     (data-belt-beat="passage", data-from / data-belt = the two colours). The spacer is the only place
 *     the belt leaves its side column, which is why it is empty.
 * The drawing's knot is at the centre of the box, which is why `--knot-fx` / `--knot-fy` below are
 * KNOT_AT (beltDrawing.ts): the flood starts from it.
 *
 * The engine (tul.ts, [data-tul-passage]) writes `--p` (0..1) on the passage while it crosses the
 * viewport (top at the bottom edge to bottom at the top edge). With reduced motion or without JS the
 * passage stays a static 12rem gap, `--p` is never written and there is no flood: the black chapter and
 * what follows are black by CSS (base.css). The flood passage then ends in a static ink edge (`.ink__edge`): the same
 * seep polygon as the flood, frozen at one progress (`--edge`), so the black field bleeds up into the gap with a
 * ragged front instead of a ruler-straight cut. Nothing about it moves.
 *
 * The flood passage (red to black, `.ink--flood`, html.js with motion) is the one authored moment of the page. Its
 * timeline is src/scripts/belt3d/passage.ts:
 *   - It is as tall as `--pass-h` and pulled up by it, so it overlaps the tail of the sprint track: the sprint stage
 *     stays pinned on the red belt the whole time, and the passage starts the moment the sprint ends (no stage
 *     scrolling away between them). Its `--p` runs from its top at the viewport bottom to its bottom there.
 *   - The belt turns black on the light field first (the 3D belt, or the drawn mark and band of the sprint stage),
 *     from the knot. Its own drawing steps aside: the stage holds the belt.
 *   - `.ink__flood` is a viewport layer above the chapters and below the 3D canvas and the header (z-index 10).
 *     Its fill grows from FLOOD_START (`--flood-a`) and covers the view at FLOOD_FULL (`--flood-z`); tul.ts flips
 *     html[data-field="dark"] under it there and the layer is hidden; scrolling back reverses it.
 *   - The fill is clipped by a seep polygon (passage.ts): an irregular ink front with fibres that run ahead, grown by
 *     `--g` (the square of the flood progress, so it spreads slowly from the knot and then takes the view).
 *   - The centre is the knot: the 3D knot when the scene publishes it (`--knot-x` / `--knot-y`), else the drawn
 *     knot of the sprint stage (`--ink-ox` / `--ink-oy`, measured by tul.ts), else the middle of the view.
 *   - Only clip-path and opacity change with scroll. On desktop the edge also passes a static feTurbulence +
 *     feDisplacementMap filter (parameters never animate). No mix-blend-mode.
 */
interface Props {
  from: BeltKey;
  to: BeltKey;
}

const { from, to } = Astro.props;
const floods = to === 'negro';
const floodClip = seepPolygon({ v: '--g', cx: 'var(--cx) + 3rem', cy: 'var(--cy) + 3rem', rx: 150, ry: 150, unit: 'vmax', seed: 11, points: 72, lead: 0.22 });
// The clip is declared on the fill itself: a custom property resolves its var()s where it is declared, and --cx,
// --cy and --g live on the flood layer above it.
// The static edge: a front centred well below the gap, wide and flat, so only its ragged top shows across the width.
const edgeClip = seepPolygon({ v: '--edge', cx: '50%', cy: '204%', rx: 138, ry: 229, unit: '%', seed: 11, points: 160, lead: 1.2 });
const vars = [`--knot-fx:${KNOT_AT.fx};--knot-fy:${KNOT_AT.fy}`, floods && `--flood-a:${FLOOD_START};--flood-z:${FLOOD_FULL}`];
---

<div
  class:list={['ink', { 'ink--flood': floods }]}
  data-tul-passage
  data-belt-beat="passage"
  data-belt={to}
  data-from={from}
  style={vars.filter(Boolean).join(';')}
  aria-hidden="true"
>
  <div class="ink__drawing" data-ink-drawing>
    <BeltDrawing from={from} to={to} />
  </div>
  {floods && <div class="ink__edge" style={`--edge-clip:${edgeClip}`}></div>}
  {floods && (
    <div class="ink__flood" data-ink-flood>
      <div class="ink__fill" style={`--flood-clip:${floodClip}`}></div>
    </div>
  )}
</div>
{floods && (
  <svg class="ink__defs" width="0" height="0" aria-hidden="true" focusable="false">
    <filter id="ink-edge" x="-5%" y="-5%" width="110%" height="110%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.011 0.014" numOctaves="3" seed="4" result="noise"></feTurbulence>
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="46" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
    </filter>
  </svg>
)}

<style>
  .ink {
    --ink-h: 12rem;
    /* Where the drawn belt knot sits inside the spacer (fractions of its width and height); the inline
       style of the element sets them from KNOT_AT, these are the safe defaults. */
    --knot-fx: 0.5;
    --knot-fy: 0.5;
    position: relative;
    height: var(--ink-h);
    pointer-events: none;
  }

  .ink__drawing {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  /* Desktop: the 3D belt takes over once it is ready. Until then (or if it never loads) this is the poster. */
  @media (min-width: 64rem) {
    :global(html[data-belt3d='ready']) .ink__drawing {
      display: none;
    }
  }

  .ink__defs {
    position: absolute;
  }

  .ink__flood {
    display: none;
  }

  /* Reduced motion and no JS: the black field below bleeds up into the gap through a static ink front. */
  .ink__edge {
    --edge: 0.7;
    position: absolute;
    inset: auto 0 -1px;
    height: 5rem;
    background-color: var(--field-dark);
    clip-path: var(--edge-clip);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .ink {
      --ink-h: 50svh;
    }

    /* The flood passage overlaps the tail of the sprint track (the stage stays pinned through it). */
    :global(html.js) .ink--flood {
      --ink-h: var(--pass-h);
      margin-top: calc(-1 * var(--ink-h));
    }

    /* The flood draws the real front; the static edge is only for the still page. */
    :global(html.js) .ink__edge {
      display: none;
    }

    /* Its belt is the one on the pinned stage; a drawing here would scroll across it. */
    :global(html.js) .ink--flood .ink__drawing {
      display: none;
    }

    :global(html.js) .ink__flood {
      /* 0 until --flood-a, 1 at --flood-z (FLOOD_START, FLOOD_FULL), squared for the growth. */
      --f: clamp(0, calc((var(--p, 0) - var(--flood-a)) / (var(--flood-z) - var(--flood-a))), 1);
      --g: calc(var(--f) * var(--f));
      /* Flood centre in viewport coordinates: the 3D knot, else the drawn knot of the stage, else the spacer. */
      --cx: var(--knot-x, var(--ink-ox, calc(100vw * var(--knot-fx))));
      --cy: var(--knot-y, var(--ink-oy, 50svh));
      position: fixed;
      /* Bleed past the viewport so the displaced ink edge never shows the layer's own border. */
      inset: -3rem;
      z-index: 10;
      display: block;
      /* Fully there up to --flood-z, gone right after: the dark field takes over underneath. */
      opacity: clamp(0, calc((var(--flood-z) - var(--p, 0)) * 1000 + 1), 1);
    }

    :global(html.js) .ink__fill {
      position: absolute;
      inset: 0;
      background-color: var(--field-dark);
      clip-path: var(--flood-clip);
    }
  }

  @media (max-width: 47.99rem) and (prefers-reduced-motion: no-preference) {
    :global(html.js) .ink {
      --ink-h: 40svh;
    }

    :global(html.js) .ink--flood {
      --ink-h: var(--pass-h);
    }
  }

  /* Ink edge: desktop only. The filter is static; the front grows under it. */
  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    :global(html.js) .ink__flood {
      filter: url('#ink-edge');
    }
  }
</style>
