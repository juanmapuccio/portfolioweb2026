---
import QRCode from 'qrcode';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
  path?: string;
}

const { lang = 'es', path = '' } = Astro.props;
const t = useTranslations(lang);

const siteUrl = (Astro.site ?? new URL('https://juanpuccio.vercel.app')).toString().replace(/\/$/, '');
const localePaths: Record<Lang, string> = { es: '/', en: '/en/', pt: '/pt/' };
const targetUrl = `${siteUrl}${localePaths[lang]}${path}`;

// Generate clean, deterministic SVG string at build-time (100% static, zero client runtime)
const qrSvg = await QRCode.toString(targetUrl, {
  type: 'svg',
  margin: 1,
  color: {
    dark: '#0a0d11',
    light: '#ffffff'
  },
  errorCorrectionLevel: 'M'
});
---

<div id="tul-qr-modal" class="qr-modal" popover="auto" aria-labelledby="qr-modal-title">
  <div class="qr-modal__card">
    <div class="qr-modal__header">
      <div class="qr-modal__title-group">
        <span class="qr-modal__tag num">MOBILE_BRIDGE</span>
        <h2 id="qr-modal-title" class="qr-modal__title grade-type">{t('tul.qr.title')}</h2>
      </div>
      <button
        class="qr-modal__close"
        type="button"
        popovertarget="tul-qr-modal"
        popovertargetaction="hide"
        aria-label={t('tul.qr.close')}
      >
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square">
          <path d="M3 3L13 13M13 3L3 13"></path>
        </svg>
      </button>
    </div>

    <div class="qr-modal__body">
      <div class="qr-modal__preview">
        <!-- Built-time static QR SVG -->
        <div class="qr-modal__svg-wrapper" set:html={qrSvg} />
        <!-- Corner brackets design detail -->
        <div class="qr-modal__brackets" aria-hidden="true"></div>
      </div>

      <div class="qr-modal__info">
        <p class="qr-modal__desc">{t('tul.qr.desc')}</p>
        <div class="qr-modal__url-box">
          <span class="qr-modal__url-label num">TARGET_URL:</span>
          <code class="qr-modal__url-code">{targetUrl}</code>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .qr-modal {
    position: fixed;
    inset: 0;
    margin: auto;
    width: min(calc(100vw - 2rem), 28rem);
    border: none;
    background: transparent;
    padding: 0;
    overflow: visible;
  }

  .qr-modal::backdrop {
    background: rgba(10, 13, 17, 0.78);
    backdrop-filter: blur(6px);
  }

  .qr-modal__card {
    display: grid;
    gap: var(--space-s);
    padding: var(--space-m);
    background-color: var(--field);
    color: var(--ink);
    border: var(--line-strong) solid var(--dan-gold);
    box-shadow: 0 20px 48px -12px rgba(0, 0, 0, 0.5);
  }

  /* When field is dark (e.g. 1st dan or popover in dark context) */
  :global([data-field="dark"]) .qr-modal__card,
  :global([data-active-belt="negro"]) .qr-modal__card {
    background-color: #0d1117;
    color: #f1eee8;
  }

  .qr-modal__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-s);
    padding-bottom: var(--space-2xs);
    border-bottom: var(--line) solid color-mix(in srgb, var(--ink-soft) 25%, transparent);
  }

  .qr-modal__title-group {
    display: grid;
    gap: 0.2rem;
  }

  .qr-modal__tag {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--dan-gold);
  }

  .qr-modal__title {
    font-size: var(--step-1);
    line-height: 1.1;
    margin: 0;
  }

  .qr-modal__close {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: var(--line) solid color-mix(in srgb, var(--ink-soft) 40%, transparent);
    background: transparent;
    color: currentColor;
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .qr-modal__close:hover,
  .qr-modal__close:focus-visible {
    background-color: var(--ink);
    color: var(--field);
  }

  .qr-modal__body {
    display: grid;
    gap: var(--space-m);
    justify-items: center;
    text-align: center;
  }

  .qr-modal__preview {
    position: relative;
    padding: 0.75rem;
    background-color: #ffffff;
    border-radius: 4px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
  }

  .qr-modal__svg-wrapper {
    display: block;
    width: 13rem;
    height: 13rem;
  }

  .qr-modal__svg-wrapper :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .qr-modal__brackets {
    position: absolute;
    inset: -4px;
    pointer-events: none;
    border: 2px solid transparent;
  }

  .qr-modal__brackets::before,
  .qr-modal__brackets::after {
    content: '';
    position: absolute;
    width: 12px;
    height: 12px;
    border-color: var(--dan-gold);
    border-style: solid;
  }

  .qr-modal__brackets::before {
    top: 0;
    left: 0;
    border-width: 2px 0 0 2px;
  }

  .qr-modal__brackets::after {
    bottom: 0;
    right: 0;
    border-width: 0 2px 2px 0;
  }

  .qr-modal__info {
    display: grid;
    gap: var(--space-xs);
    width: 100%;
  }

  .qr-modal__desc {
    font-size: var(--step--1);
    color: var(--ink-soft);
    line-height: 1.4;
    margin: 0;
  }

  .qr-modal__url-box {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.5rem 0.75rem;
    background-color: color-mix(in srgb, var(--ink) 4%, transparent);
    border: var(--line) solid color-mix(in srgb, var(--ink-soft) 20%, transparent);
    text-align: left;
  }

  .qr-modal__url-label {
    font-size: 0.625rem;
    color: var(--dan-gold);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .qr-modal__url-code {
    font-size: 0.75rem;
    overflow-wrap: anywhere;
    font-family: monospace;
    color: var(--ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .qr-modal {
      transition: opacity 200ms var(--ease-out), transform 200ms var(--ease-out);
    }

    .qr-modal:not(:popover-open) {
      opacity: 0;
      transform: scale(0.96);
    }

    .qr-modal:popover-open {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
