---
import BeltMark from './BeltMark.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import { BELTS } from '../../data/martialExperience';
import { PROGRESS_BELTS, SPRINT_BELTS, sprintSteps } from './beltSprint';

/**
 * The belt sprint: the five coloured belts in one pass, from the white belt of the hero to the red one, one line
 * each. The black belt is where it lands (InkPassage red to black, then BlackBeltWork).
 *
 * The content is an ordered list, always in the DOM and readable without JS: one item per belt with its mark, grade,
 * years and one line (the `line` of the stage in martialExperience.ts).
 *
 * Hooks for the engine (tul.ts) and the 3D scene (belt3d):
 *   [data-belt-sprint]           the section; the engine scrubs its track.
 *   [data-sprint-step]           one belt; carries its belt as data-belt so the tokens colour its details.
 *   [data-belt-beat="shift"]     an empty marker per change of belt (data-from, data-belt, data-step of data-steps):
 *                                the 3D belt changes colour in its column while the sprint plays.
 *   .bs__rail                    decorative progress of the six belts (aria-hidden).
 */
interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const steps = sprintSteps(lang);
const shifts = SPRINT_BELTS.slice(1).map((to, i) => ({ from: SPRINT_BELTS[i], to }));
---

<section class="bs" data-belt-sprint style={`--n:${steps.length}`} aria-labelledby="bs-title">
  <div class="bs__track">
    <div class="bs__stage">
      <h2 id="bs-title" class="bs__title">{t('tul.sprint.title')}</h2>

      <ol class="bs__list">
        {steps.map((step, i) => (
          <li class="bs__step" data-sprint-step data-belt={step.key} style={`--i:${i}`}>
            <span class="bs__band" aria-hidden="true"></span>
            <span class="bs__mark" aria-hidden="true"><BeltMark beltKey={step.key} /></span>
            <h3 class="bs__name grade-type">{step.name}</h3>
            <p class="bs__meta num">
              <span>{step.gup}</span>
              <span>{step.years}</span>
            </p>
            <p class="bs__line">{step.line}</p>
          </li>
        ))}
      </ol>

      <div class="bs__rail" aria-hidden="true">
        <span class="bs__fill"></span>
        <ol class="bs__ticks">
          {PROGRESS_BELTS.map((key, i) => (
            <li class="bs__tick" data-belt={key} style={`--i:${i}`}>
              <span class="bs__swatch"></span>
              <span class="bs__gup num">{BELTS[key].gup}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>

  {shifts.map((s, j) => (
    <div class="bs__beat" data-belt-beat="shift" data-from={s.from} data-belt={s.to} data-step={j} data-steps={shifts.length} aria-hidden="true"></div>
  ))}
</section>

<style>
  /* Static state (no JS, reduced motion): a plain list of the five belts. */
  .bs {
    position: relative;
    padding: var(--space-2xl) var(--gutter) var(--space-xl);
  }

  .bs__stage {
    display: grid;
    gap: var(--space-l);
    max-width: 72rem;
    margin-inline: auto;
  }

  .bs__title {
    max-width: 18ch;
    font-size: var(--step-3);
    letter-spacing: var(--track-display);
  }

  .bs__list {
    display: grid;
    gap: var(--space-l);
  }

  .bs__step {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--space-m);
    row-gap: var(--space-3xs);
    align-items: start;
  }

  .bs__mark {
    grid-row: 1 / span 3;
    width: clamp(4.5rem, 3.5rem + 4vw, 7.5rem);
  }

  .bs__mark :global(svg) {
    width: 100%;
    height: auto;
  }

  .bs__name,
  .bs__meta,
  .bs__line {
    grid-column: 2;
  }

  .bs__name {
    font-size: var(--step-2);
    line-height: 1.05;
  }

  .bs__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-s);
    color: var(--ink-soft);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .bs__line {
    max-width: 52ch;
  }

  /* Motion-only parts: hidden in the static list. */
  .bs__band,
  .bs__rail,
  .bs__beat {
    display: none;
  }

  /*
   * The sprint (JS and motion only). The section becomes a tall track (one viewport for the stage plus ~150svh of
   * scroll for the four changes) with a sticky full-viewport stage. The engine (tul.ts, initSprint) writes on each
   * step `--o` (opacity) and `--d` (-1..1, the slide) and on the section `--fill` (0..1 over the six belts of the
   * rail). The steps stack in one cell and crossfade through a light blur; the band of the belt settles open. Before the engine
   * runs, the first belt is the one shown. Only opacity, filter and transform change with scroll.
   */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .bs {
      padding: 0;
    }

    :global(html.js) .bs__track {
      height: calc(100svh + (var(--n) - 1) * 37.5svh);
    }

    :global(html.js) .bs__stage {
      position: sticky;
      top: 0;
      grid-template-rows: auto minmax(0, 1fr) auto;
      gap: var(--space-m);
      max-width: none;
      height: 100svh;
      padding: calc(3rem + var(--space-l)) max(var(--gutter), calc((100vw - 72rem) / 2)) var(--space-l);
      overflow: hidden;
    }

    :global(html.js) .bs__list {
      /* One shared row, centred; every belt starts at its top so the crossfade lines up. */
      display: grid;
      align-content: center;
      align-items: start;
    }

    /*
     * The veil: each change is a soft crossfade. `--o` (from the engine) goes through a smoothstep so every belt starts
     * and lands gently; the one leaving blurs out and the one arriving comes into focus, with no movement. The band
     * settles open from its centre. Before the engine runs the opacity fallback shows the first belt only.
     */
    :global(html.js) .bs__step {
      --oo: var(--o, calc(1 - min(var(--i), 1)));
      --sm: calc(var(--oo) * var(--oo) * (3 - 2 * var(--oo)));
      grid-area: 1 / 1;
      row-gap: var(--space-2xs);
      opacity: var(--sm);
      filter: blur(calc((1 - var(--oo)) * 10px));
      will-change: opacity, filter;
    }

    :global(html.js) .bs__band {
      display: block;
      grid-column: 1 / -1;
      height: 0.75rem;
      margin-bottom: var(--space-s);
      border-block: 1.5px solid var(--ink);
      background-color: var(--belt-fill);
      transform: scaleX(calc(0.9 + 0.1 * var(--sm)));
    }

    :global(html.js) .bs__mark {
      grid-row: 2 / span 3;
      width: clamp(6.5rem, 4rem + 10vw, 11rem);
    }

    :global(html.js) .bs__name {
      font-size: var(--step-4);
    }

    :global(html.js) .bs__line {
      font-size: var(--step-1);
      line-height: 1.4;
    }

    /* The rail: the six belts, lit up to the one on screen; a thin ink line runs under them. */
    :global(html.js) .bs__rail {
      position: relative;
      display: block;
      padding-bottom: var(--space-2xs);
    }

    :global(html.js) .bs__fill {
      position: absolute;
      inset: auto 0 0;
      height: var(--line-strong);
      background-color: var(--ink);
      transform: scaleX(calc((var(--fill, 0) * 5 + 1) / 6));
      transform-origin: left center;
    }

    :global(html.js) .bs__ticks {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: var(--space-2xs);
    }

    :global(html.js) .bs__tick {
      /* 1 once the fill has reached this belt, 0 a quarter belt before. */
      --lit: clamp(0, calc((var(--fill, 0) * 5 - var(--i)) * 4 + 1), 1);
      display: grid;
      gap: var(--space-3xs);
      color: var(--ink-soft);
      font-size: var(--step--1);
      font-weight: 600;
    }

    :global(html.js) .bs__swatch {
      height: 0.5rem;
      border: 1.5px solid var(--ink);
      background-color: var(--belt-fill);
      opacity: calc(0.25 + 0.75 * var(--lit));
    }

    :global(html.js) .bs__gup {
      opacity: calc(0.45 + 0.55 * var(--lit));
    }
  }

  /* Phone: one column, the mark above the name. */
  @media (max-width: 47.99rem) and (prefers-reduced-motion: no-preference) {
    :global(html.js) .bs__step {
      grid-template-columns: minmax(0, 1fr);
    }

    :global(html.js) .bs__mark {
      grid-row: auto;
      width: 7.5rem;
    }

    :global(html.js) .bs__name,
    :global(html.js) .bs__meta,
    :global(html.js) .bs__line {
      grid-column: 1;
    }

    :global(html.js) .bs__name {
      font-size: var(--step-3);
    }

    :global(html.js) .bs__line {
      font-size: var(--step-0);
    }
  }

  @media (max-width: 29.99rem) and (prefers-reduced-motion: no-preference) {
    :global(html.js) .bs__gup {
      display: none;
    }
  }

  /* Desktop: the 3D belt changes colour in the reserved column, so the stage keeps it free and the drawn marks step
     aside once the scene is ready. Without 3D (no WebGL, save-data) the marks stay. */
  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    :global(html.js) .bs__stage {
      padding-inline-end: max(calc(var(--gutter) + var(--belt-col)), calc((100vw - 72rem) / 2));
    }

    :global(html[data-belt3d='ready']) .bs__mark {
      display: none;
    }

    :global(html[data-belt3d='ready']) .bs__step {
      column-gap: 0;
    }
  }
</style>
