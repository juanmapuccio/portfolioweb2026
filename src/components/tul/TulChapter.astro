---
import FloorDiagram from './FloorDiagram.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import { BELTS, martialExperienceData } from '../../data/martialExperience';
import { automationsContent, projectsContent } from '../../data/projects';
import { getTulChapter, type BeltKey } from '../../data/tuls';

/**
 * One belt chapter, told as the floor diagram of its tul.
 *
 * Each scene is tall (100svh plus 45svh per stop) and holds one pinned stage: chapter head,
 * the compact milestone list and the diagram, all visible together. Scrolling only advances
 * `--p` / `--draw` (written by the engine on the scene); each row lights up (CSS only) once
 * the drawn line passes the row's `--t`. Without JS or with reduced motion nothing is pinned,
 * `--draw` is unset or 1, so everything is visible, in natural flow, fully drawn.
 *
 * Red belt: a second pinned stage after the milestones, "friction to code".
 * Black belt: an opening NodoSur frame, then one pinned sub-scene per tul/product.
 */
interface Props {
  lang?: Lang;
  beltKey: BeltKey;
}

const { lang = 'es', beltKey } = Astro.props;
const t = useTranslations(lang);

/** The hero already draws this share of the first tul; the white chapter continues from it. */
const HERO_DRAW_END = 0.25;

const content = martialExperienceData[lang];
const stage = content.stages.find((s) => s.beltKey === beltKey);
const chapter = getTulChapter(beltKey);
if (!stage || !chapter) throw new Error(`TulChapter: unknown belt "${beltKey}"`);

const belt = BELTS[beltKey];
const isBlack = beltKey === 'negro';
const mainForm = chapter.forms[0];
const projects = projectsContent[lang];

const positionById = new Map(stage.positions.map((p) => [p.id, p]));

interface Row {
  id: string;
  t: number;
  move?: number;
  position: (typeof stage.positions)[number];
}

// Milestone rows come from the tul stops. The black belt's only row is the NodoSur frame.
const rows: Row[] = [];
if (isBlack) {
  if (chapter.frame?.kind === 'position') {
    const position = positionById.get(chapter.frame.id);
    if (position) rows.push({ id: position.id, t: 0, position });
  }
} else {
  for (const stop of mainForm.stops) {
    if (stop.ref.kind !== 'position') continue;
    const position = positionById.get(stop.ref.id);
    if (position) rows.push({ id: position.id, t: stop.t, move: stop.move, position });
  }
}

const frameProject = isBlack ? projects.find((p) => p.id === 'nodosur') : undefined;

const passages = isBlack
  ? chapter.forms.flatMap((form) => {
      const ref = form.stops[0]?.ref;
      const project = ref ? projects.find((p) => p.id === ref.id) : undefined;
      return ref && project ? [{ form, id: ref.id, project }] : [];
    })
  : [];

const automation = beltKey === 'rojo' ? automationsContent[lang] : undefined;
// The black belt's opening frame is plain flow; every other main scene is scrubbed and pinned.
const mainScene: Record<string, string | number> = isBlack
  ? {}
  : {
      'data-tul-scene': '',
      'data-p-from': beltKey === 'blanco' ? HERO_DRAW_END : 0,
      'data-p-to': 1
    };
const stepsCount = Math.max(rows.length, 2);

const autoSteps = [
  t('tul.auto.in'),
  t('tul.auto.step1'),
  t('tul.auto.step2'),
  t('tul.auto.step3'),
  t('tul.auto.out')
];
const AUTO_T = autoSteps.map((_, i) => Number(((i + 1) / (autoSteps.length + 1)).toFixed(3)));

const tulLabel = (grade: string) => t('tul.chapter.tulLabel').replace('{grade}', grade);
// Black belt passages are all 1st dan: "Tul 1º dan" plus the position in the series.
const passageLabel = (i: number) =>
  `${tulLabel(belt.gup)} · ${t('tul.chapter.passageOf').replace('{n}', String(i + 1)).replace('{total}', String(passages.length))}`;
const caption = (label: string, movements: number) =>
  `${label} · ${t('tul.chapter.diagram')} · ${movements} ${t('tul.chapter.movements')}`;
---

<section
  id={beltKey}
  class:list={['tc', { 'tc--black': isBlack }]}
  data-belt={beltKey}
  aria-labelledby={`${beltKey}-title`}
>
  <div class:list={['tc__scene', { 'tc__scene--pin': !isBlack }]} style={`--n:${stepsCount}`} {...mainScene}>
    <div class="tc__stage">
      <div class:list={['tc__side', { 'tc__side--map': !isBlack }]}>
        {!isBlack ? (
          <figure class="tc__map">
            <div class="tc__fig tc__fig--full">
              <FloorDiagram form={mainForm} labelled progress />
            </div>
            <div class="tc__fig tc__fig--mini">
              <FloorDiagram form={mainForm} compact progress />
            </div>
            <figcaption class="tc__cap">{caption(tulLabel(belt.gup), mainForm.movements)}</figcaption>
          </figure>
        ) : (
          <nav class="tc__passages" aria-label={t('tul.chapter.passages')}>
            <ul>
              {passages.map((p, i) => (
                <li>
                  <a href={`#${p.id}`}>
                    <span class="tc__passage-form">{passageLabel(i)}</span>
                    <span class="tc__passage-name">{p.project.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </div>

      <div class="tc__copy">
        <header class="tc__head">
          <div class="tc__titlewrap" data-split-title>
            <h2 id={`${beltKey}-title`} class="tc__title grade-type">{stage.title}</h2>
            <div class="tc__split" aria-hidden="true">
              <span class="tc__half tc__half--t tc__title grade-type">{stage.title}</span>
              <span class="tc__half tc__half--b tc__title grade-type">{stage.title}</span>
            </div>
            <svg class="tc__slash" aria-hidden="true" focusable="false">
              <line x1="0" y1="1" x2="100%" y2="1" pathLength="1"></line>
            </svg>
          </div>
          <p class="tc__meta">
            <span class="num">{belt.gup}</span> · {belt.beltName[lang]} · <span class="num">{stage.years}</span>
          </p>
          <p class="tc__line">{stage.line}</p>
        </header>

        <ol class="tc__list" aria-labelledby={`${beltKey}-title`}>
          {rows.map((row, i) => (
            <li class="ms" id={row.id} data-stop={row.id} style={`--t:${row.t};--tn:${rows[i + 1]?.t ?? 9}`}>
              <span class:list={['ms__mark', { 'ms__mark--none': !row.move }]} aria-hidden="true">{row.move ?? ''}</span>
              <span class="ms__date num">{row.position.dates}</span>
              <span class="ms__role" data-text={row.position.role}><span class="ms__role-text">{row.position.role}</span></span>
              <span class="ms__org">{row.position.org}</span>
              <div class="ms__extra">
                <p class="ms__teaser">{row.position.teaser}</p>
                <details class="ms__more">
                  <summary>{t('tul.chapter.more')}</summary>
                  <p>{row.position.description}</p>
                  {row.position.transferableCompetency && (
                    <p class="ms__comp">
                      <strong>{content.competencyLabel}</strong> {row.position.transferableCompetency}
                    </p>
                  )}
                </details>
              </div>
            </li>
          ))}
        </ol>

        {frameProject && (
          <div class="tc__frame">
            <ul class="tc__tech" aria-label={t('tul.project.stack')}>
              {frameProject.tech.map((item) => <li>{item}</li>)}
            </ul>
            <a class="tc__visit" href={frameProject.url} target="_blank" rel="noopener">{frameProject.name} · {t('tul.project.visit')}</a>
          </div>
        )}
      </div>
    </div>
  </div>

  {automation && (
    <aside
      class="tc__scene tc__scene--pin"
      style="--n:3"
      data-tul-scene
      data-p-from="0"
      data-p-to="1"
      aria-labelledby="auto-title"
    >
      <div class="tc__stage auto">
        <div class="auto__copy">
          <h3 id="auto-title" class="auto__title">{t('tul.auto.title')}</h3>
          <p class="auto__name">{automation.bot1Title}</p>
          <p class="auto__desc">{automation.bot1Desc}</p>
          <p class="auto__metric">{automation.bot1Metric}</p>
        </div>
        <ul class="auto__flow">
          {autoSteps.map((label, i) => (
            <li class="auto__step" style={`--t:${AUTO_T[i]}`}>
              <span class="auto__num num" aria-hidden="true">{i + 1}</span>
              <span>{label}</span>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  )}

  {passages.map((p, i) => (
    <article
      id={p.id}
      class="tc__scene tc__scene--pin tc__sub"
      style="--n:3"
      data-tul-scene
      data-form-label={p.project.name}
      data-form={p.form.id}
      aria-labelledby={`${p.id}-title`}
    >
      <div class="tc__stage">
        <div class="tc__side tc__side--map">
          <figure class="tc__map">
            <div class="tc__fig tc__fig--full">
              <FloorDiagram form={p.form} labelled progress />
            </div>
            <div class="tc__fig tc__fig--mini">
              <FloorDiagram form={p.form} compact progress />
            </div>
            <figcaption class="tc__cap">{caption(tulLabel(belt.gup), p.form.movements)}</figcaption>
          </figure>
        </div>

        <div class="tc__copy tc__beats">
          <div class="tc__beat" style="--t:0.05">
            <h3 id={`${p.id}-title`} class="tc__project grade-type">{p.project.name}</h3>
            <p class="tc__meta">{passageLabel(i)} · {p.project.role}</p>
            <p class="tc__text">{p.project.description}</p>
          </div>
          <div class="tc__beat" style="--t:0.35">
            <dl class="tc__facts">
              <dt>{t('tul.project.problem')}</dt>
              <dd>{p.project.problem}</dd>
              <dt>{t('tul.project.solution')}</dt>
              <dd>{p.project.solution}</dd>
              <dt>{t('tul.project.impact')}</dt>
              <dd>{p.project.impact}</dd>
            </dl>
          </div>
          <div class="tc__beat" style="--t:0.65">
            <ul class="tc__tech" aria-label={t('tul.project.stack')}>
              {p.project.tech.map((item) => <li>{item}</li>)}
            </ul>
            {p.project.url && (
              <a class="tc__visit" href={p.project.url} target="_blank" rel="noopener">{p.project.name} · {t('tul.project.visit')}</a>
            )}
          </div>
        </div>
      </div>
    </article>
  ))}

  {isBlack && stage.closing && (
    <div
      class="tc__scene tc__scene--pin tc__outro"
      style="--n:1"
      data-tul-scene
    >
      <div class="tc__stage tc__stage--closing">
        <p class="tc__closing grade-type">{stage.closing}</p>
      </div>
    </div>
  )}
</section>

<style>
  .tc {
    position: relative;
    padding: 0;
  }

  .tc__scene {
    position: relative;
  }

  /* Stage: head, list and diagram together. Static flow by default (no JS, reduced motion). */
  .tc__stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding: 3rem var(--gutter) var(--space-l);
  }

  .tc__side {
    grid-row: 1;
    align-self: start;
    background-color: var(--field);
    padding-block: var(--space-xs);
  }

  .tc__side--map {
    border-bottom: var(--line) solid var(--ink-soft);
  }

  .tc__copy {
    grid-row: 2;
    min-width: 0;
  }

  .tc__map {
    --ready-o: clamp(0, calc((0.12 - var(--draw, 1)) * 24), 1);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3xs);
    margin: 0;
  }

  .tc__fig--full {
    display: none;
  }

  .tc__fig--mini {
    display: flex;
    justify-content: center;
    height: calc(26svh - 1.6rem);
    min-height: 7rem;
  }

  .tc__fig--mini :global(.fd) {
    width: auto;
    height: 100%;
  }

  .tc__cap {
    color: var(--ink-soft);
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
  }

  /* Head */

  .tc__head {
    display: grid;
    gap: var(--space-2xs);
    padding-block: var(--space-s) var(--space-xs);
  }

  .tc__title {
    font-size: var(--step-3);
    letter-spacing: var(--track-display);
    line-height: 0.98;
    overflow-wrap: break-word;
  }

  /* Horizontal cut: the title enters as two clipped halves (aria-hidden copies laid over the real
     h2) and a belt-ink rule draws under it. Default and reduced motion: the plain visible h2 and a
     static rule; the halves do not exist. */
  .tc__titlewrap {
    position: relative;
    padding-bottom: 0.3em;
  }

  .tc__split {
    display: none;
  }

  .tc__half {
    position: absolute;
    inset: 0;
    display: block;
    text-wrap: balance;
    user-select: none;
    pointer-events: none;
  }

  .tc__half--t {
    clip-path: inset(0 0 50% 0);
  }

  .tc__half--b {
    clip-path: inset(50% 0 0 0);
  }

  .tc__slash {
    position: absolute;
    inset: auto 0 0 0;
    width: 100%;
    height: var(--line-strong);
    overflow: visible;
  }

  .tc__slash line {
    stroke: var(--belt-line);
    stroke-width: 2;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  @keyframes tc-half-t {
    from {
      opacity: 0;
      transform: translateX(-2.5rem);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes tc-half-b {
    from {
      opacity: 0;
      transform: translateX(2.5rem);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes tc-slash {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .tc__meta {
    color: var(--ink-soft);
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-variation-settings: 'wght' 560, 'wdth' 90;
  }

  .tc__line {
    max-width: 34ch;
    font-size: var(--step-0);
    line-height: 1.25;
    font-weight: 500;
  }

  /* Milestone rows: fixed columns, the same in every chapter. */

  .ms {
    --on: clamp(0, calc((var(--draw, 1) - var(--t, 0)) * 24), 1);
    --cur: 1;
    display: grid;
    grid-template-columns: 1.75rem 5.5rem minmax(0, 1fr);
    grid-template-areas:
      'mark date role'
      'mark date org'
      '. extra extra';
    align-items: start;
    column-gap: var(--space-xs);
    row-gap: var(--space-3xs);
    padding-block: var(--space-xs);
    border-bottom: var(--line) solid var(--ink-soft);
    color: color-mix(in srgb, var(--ink) calc(var(--on) * 100%), var(--ink-soft));
  }

  .ms__mark {
    grid-area: mark;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: var(--line-strong) solid currentColor;
    border-radius: 50%;
    border-color: color-mix(in srgb, var(--belt-line) calc(var(--on) * 100%), var(--ink-soft));
    background-color: color-mix(in srgb, var(--belt-line) calc(var(--on) * 100%), transparent);
    color: color-mix(in srgb, #ffffff calc(var(--on) * 100%), var(--ink-soft));
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums lining-nums;
    line-height: 1;
  }

  .ms__mark--none {
    visibility: hidden;
  }

  .ms__date {
    grid-area: date;
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.3;
  }

  .ms__role {
    grid-area: role;
    display: grid;
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: calc(600 + 200 * var(--on));
    line-height: 1.2;
  }

  .ms__role-text {
    grid-area: 1 / 1;
  }

  /* Hidden bold twin: the role cell always has its heaviest width, so activation never reflows. */
  .ms__role::after {
    content: attr(data-text);
    grid-area: 1 / 1;
    visibility: hidden;
    font-weight: 800;
  }

  .ms__org {
    grid-area: org;
    font-size: var(--step--1);
    line-height: 1.3;
  }

  .ms__extra {
    grid-area: extra;
    min-width: 0;
  }

  .ms__teaser {
    max-width: 52ch;
    margin-top: var(--space-3xs);
    font-size: var(--step--1);
  }

  .ms__more {
    max-width: 60ch;
    font-size: var(--step--1);
  }

  .ms__more summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 1.75rem;
    font-weight: 700;
    text-decoration-line: underline;
    text-decoration-thickness: var(--line);
    text-underline-offset: 0.22em;
    cursor: pointer;
    list-style: none;
  }

  .ms__more summary::-webkit-details-marker {
    display: none;
  }

  .ms__more summary::after {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-right: var(--line-strong) solid currentColor;
    border-bottom: var(--line-strong) solid currentColor;
    transform: translateY(-0.12rem) rotate(45deg);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .ms__more[open] summary::after {
    transform: translateY(0.1rem) rotate(-135deg);
  }

  .ms__more p {
    margin-top: var(--space-2xs);
  }

  .ms__comp strong {
    font-weight: 700;
  }

  /* Black belt frame and project parts */

  .tc--black .ms {
    padding-block: var(--space-s);
  }

  .tc__frame {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
    padding-top: var(--space-m);
  }

  .tc__tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-xs);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .tc__tech li {
    padding: var(--space-3xs) var(--space-2xs);
    border: var(--line) solid var(--ink-soft);
  }

  .tc__visit {
    font-weight: 700;
  }

  .tc__passages ul {
    display: grid;
  }

  .tc__passages a {
    display: grid;
    grid-template-columns: minmax(0, 7.5rem) minmax(0, 1fr);
    gap: var(--space-xs);
    padding-block: var(--space-xs);
    border-bottom: var(--line) solid var(--ink-soft);
    text-decoration: none;
  }

  .tc__passage-form {
    color: var(--ink-soft);
    font-family: var(--font-display);
    font-weight: 600;
  }

  .tc__passage-name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 800;
  }

  .tc__sub {
    border-top: var(--line) solid var(--ink-soft);
  }

  /* Beats of a passage: each lights up as the line reaches it. */
  .tc__beat {
    --on: clamp(0, calc((var(--draw, 1) - var(--t, 0)) * 24), 1);
    display: grid;
    gap: var(--space-2xs);
    padding-block: var(--space-xs);
    color: color-mix(in srgb, var(--ink) calc(var(--on) * 100%), var(--ink-soft));
  }

  .tc__project {
    font-size: var(--step-3);
    letter-spacing: var(--track-display);
    line-height: 1;
  }

  .tc__text {
    max-width: 56ch;
    font-size: var(--step--1);
  }

  .tc__facts {
    display: grid;
    grid-template-columns: 4.75rem minmax(0, 1fr);
    gap: var(--space-2xs) var(--space-xs);
    margin: 0;
    max-width: 60ch;
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .tc__facts dt {
    font-family: var(--font-display);
    font-weight: 700;
  }

  .tc__facts dd {
    margin: 0;
  }

  .tc__stage--closing {
    align-content: center;
  }

  .tc__stage--closing .tc__closing {
    padding-block: var(--space-2xl);
  }

  .tc__closing {
    max-width: 22ch;
    padding: var(--space-2xl) var(--gutter) var(--space-3xl);
    font-size: var(--step-3);
    letter-spacing: var(--track-display);
    line-height: 1.08;
  }

  /* Friction to code: the process of one real automation as a notation line. */

  .auto {
    gap: var(--space-m);
    align-content: start;
  }

  .auto__copy {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
    max-width: 44rem;
    padding-top: var(--space-m);
  }

  .auto__title {
    font-size: var(--step-3);
    font-variation-settings: 'wght' 700, 'wdth' 85;
  }

  .auto__name {
    font-weight: 700;
  }

  .auto__desc {
    max-width: 56ch;
    font-size: var(--step--1);
  }

  .auto__metric {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-variation-settings: 'wght' 700, 'wdth' 85;
  }

  .auto__flow {
    position: relative;
    display: grid;
    gap: var(--space-s);
    align-content: start;
    align-self: start;
    margin-block: var(--space-xs);
  }

  /* The line of movement: one rule through the numbered stops. */
  .auto__flow::before {
    content: '';
    position: absolute;
    inset: 0.9rem auto 0.9rem 0.875rem;
    width: var(--line-strong);
    background-color: var(--belt-line);
  }

  .auto__step {
    --on: clamp(0, calc((var(--draw, 1) - var(--t, 0)) * 24), 1);
    position: relative;
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    align-items: center;
    gap: var(--space-xs);
    font-weight: 600;
    color: color-mix(in srgb, var(--ink) calc(var(--on) * 100%), var(--ink-soft));
  }

  .auto__num {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: var(--line-strong) solid currentColor;
    border-radius: 50%;
    border-color: color-mix(in srgb, var(--belt-line) calc(var(--on) * 100%), var(--ink-soft));
    background-color: color-mix(in srgb, var(--belt-line) calc(var(--on) * 100%), var(--field));
    color: color-mix(in srgb, #ffffff calc(var(--on) * 100%), var(--ink-soft));
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
  }

