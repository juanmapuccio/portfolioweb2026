---
import { useTranslations, type Lang } from '../../i18n/ui';
import { BELTS, martialExperienceData } from '../../data/martialExperience';
import { projectsContent } from '../../data/projects';
import { skillsData } from '../../data/skills';
import { FLOOD_FULL } from '../../scripts/belt3d/passage';
import LeadCaseFlow from './LeadCaseFlow.astro';

/**
 * The black belt: where the sprint lands, on the black field (the red to black InkPassage floods the page and flips
 * html[data-field="dark"]; without JS or with reduced motion base.css paints this section black). It holds the real
 * work and a condensed stack. The work is one lead case and an index: NodoFit (picked by id, the data flags stay as
 * they are) told in three beats, problem, system (LeadCaseFlow, drawn with the scroll) and result, with one link to
 * the live system; the other three are a compact list of rows, not cards. The source order of PROJECT_IDS stays.
 *
 * `.bw__beat` is the travel beat of the 3D belt on black (data-belt-beat="travel", rim light, fades out before the
 * close). It is an empty, aria-hidden box over the section and half a viewport past it, so the belt rests on black
 * while the work is read and is gone once the section scrolls away.
 *
 * With JS and motion the section is pulled up over the tail of the passage (`--tail`, the part after FLOOD_FULL, from
 * passage.ts) and 20svh more: its header is already in the lower part of the view when the field flips, so there is no
 * empty black stretch.
 * The header waits invisible under the flood and rises once html[data-field="dark"] is set (and steps back if the
 * reader scrolls back above the flip).
 */
interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const PROJECT_IDS = ['nodosur', 'nodofit', 'satori', 'donpizza'];
const projects = PROJECT_IDS.flatMap((id) => projectsContent[lang].filter((p) => p.id === id));
const LEAD_ID = 'nodofit';
const lead = projects.find((p) => p.id === LEAD_ID);
const others = projects.filter((p) => p.id !== LEAD_ID);
const stage = martialExperienceData[lang].stages.find((s) => s.beltKey === 'negro');
const STACK_IDS = ['frontend', 'backend', 'devops'];
/** Condensed stack: the first five items of each technical category. */
const stack = STACK_IDS.flatMap((id) => skillsData[lang].categories.filter((c) => c.id === id)).map((c) => ({
  title: c.title,
  items: c.items.slice(0, 5).join(' · ')
}));
---

<section id="primer-dan" class="bw" data-belt="negro" style={`--tail:${Math.round((1 - FLOOD_FULL) * 1000) / 1000}`} aria-labelledby="bw-title">
  <div class="bw__beat" data-belt-beat="travel" data-belt="negro" aria-hidden="true"></div>
  <div class="bw__inner">
    <header class="bw__head">
      <h2 id="bw-title" class="bw__title grade-type">{t('tul.black.title')}</h2>
      <p class="bw__meta num">
        <span>{BELTS.negro.gup}</span>
        <span>{stage?.years}</span>
      </p>
      <p class="bw__lede">{stage?.line}</p>
    </header>

    {lead && (
      <article class="bw__lead" aria-labelledby="bw-lead" data-rise>
        <div class="bw__lead-head">
          <h3 id="bw-lead" class="bw__lead-name">{lead.name}</h3>
          <p class="bw__lead-meta">
            <span>{lead.badge}</span>
            <span>{lead.role}</span>
          </p>
        </div>
        <dl class="bw__case">
          <div class="bw__part bw__part--problem">
            <dt>{t('tul.black.problem')}</dt>
            <dd>{lead.problem}</dd>
          </div>
          <div class="bw__part bw__part--system">
            <dt>{t('tul.black.system')}</dt>
            <dd>
              <LeadCaseFlow lang={lang} name={lead.name} />
              <p class="bw__caption">{lead.solution}</p>
            </dd>
          </div>
          <div class="bw__part bw__part--result">
            <dt>{t('tul.black.result')}</dt>
            <dd>
              <p>{lead.impact}</p>
              <a class="bw__cta" href={lead.url} target="_blank" rel="noopener noreferrer">
                <span>{t('tul.project.visit')}<span class="visually-hidden">: {lead.name} {t('tul.cv.newTab')}</span></span>
                <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
                  <path d="M6 14L14 6M7 6H14V13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path>
                </svg>
              </a>
            </dd>
          </div>
        </dl>
      </article>
    )}

    <ul class="bw__index" role="list">
      {others.map((p) => (
        <li class="bw__row" data-rise>
          <h3 class="bw__row-name">
            <a href={p.url} target="_blank" rel="noopener noreferrer">
              <span>{p.name}<span class="visually-hidden"> {t('tul.cv.newTab')}</span></span>
              <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" focusable="false">
                <path d="M6 14L14 6M7 6H14V13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path>
              </svg>
            </a>
          </h3>
          <p class="bw__row-badge">{p.badge}</p>
          <p class="bw__row-impact">{p.impact}</p>
        </li>
      ))}
    </ul>

    <div class="bw__stack">
      <h3 class="bw__stack-title">{t('tul.black.stack')}</h3>
      <dl class="bw__stack-list">
        {stack.map((row) => (
          <div class="bw__stack-row">
            <dt>{row.title}</dt>
            <dd>{row.items}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  /* The layout's section scaffold (base.css) gives the padding; the content sets the height. */
  .bw {
    position: relative;
    min-height: 0;
  }

  .bw__beat {
    position: absolute;
    inset: 0 0 auto;
    height: calc(100% + 50svh);
    pointer-events: none;
    visibility: hidden;
  }

  .bw__inner {
    display: grid;
    /* A tighter rhythm on a phone keeps the chapter short before the close. */
    gap: var(--space-l);
    max-width: 72rem;
    margin-inline: auto;
  }

  .bw__head {
    display: grid;
    gap: var(--space-s);
  }

  .bw__title {
    max-width: 16ch;
    color: var(--belt-line);
    font-size: var(--step-4);
    /* The 1st dan grade type is already condensed: no negative tracking on top of it. */
    letter-spacing: 0;
  }

  .bw__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-s);
    color: var(--ink-soft);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .bw__lede {
    max-width: 52ch;
    font-size: var(--step-1);
    line-height: 1.4;
  }

  /* The lead case: a heavier rule than the index rows, and the three beats as a definition list. */
  .bw__lead {
    display: grid;
    gap: var(--space-m);
    padding-top: var(--space-s);
    border-top: var(--line-strong) solid var(--belt-line);
  }

  .bw__lead-head {
    display: grid;
    gap: var(--space-2xs);
  }

  .bw__lead-name {
    font-size: var(--step-3);
    line-height: 1;
  }

  .bw__lead-meta,
  .bw__row-badge {
    color: var(--ink-soft);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .bw__lead-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-s);
  }

  .bw__case {
    display: grid;
    gap: var(--space-m);
    margin: 0;
  }

  .bw__part {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
  }

  .bw__part dt {
    color: var(--belt-line);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .bw__part dd {
    display: grid;
    gap: var(--space-s);
    max-width: 52ch;
    margin: 0;
  }

  /* The result is the verdict a recruiter keeps: heavier than the problem (and a step up on desktop). */
  .bw__part--result dd > p {
    font-weight: 600;
    line-height: 1.4;
  }

  .bw__caption {
    max-width: 46ch;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  /* The one primary action of the block: the live system, in a solid light bar on black. */
  .bw__cta {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: var(--space-xs);
    min-height: 3rem;
    padding-inline: var(--space-m);
    background-color: var(--ink);
    color: var(--field);
    font-weight: 700;
    text-decoration: none;
  }

  .bw__cta svg,
  .bw__row-name svg {
    flex: none;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .bw__cta:hover svg,
  .bw__row:hover .bw__row-name svg {
    transform: translate(2px, -2px);
  }

  /* The index: the other three systems as rows of one list (never tiles). */
  .bw__index {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Phone: name and badge share a line when they fit, the impact runs below. The whole row is the link's target. */
  .bw__row {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3xs) var(--space-s);
    padding-block: var(--space-s);
    border-top: var(--line) solid var(--belt-line);
  }

  .bw__row-name {
    font-size: var(--step-1);
  }

  .bw__row-name a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .bw__row-name a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .bw__row-impact {
    flex-basis: 100%;
    max-width: 60ch;
    font-size: var(--step--1);
  }

  .bw__stack {
    display: grid;
    gap: var(--space-s);
    padding-top: var(--space-m);
    border-top: var(--line) solid var(--belt-line);
  }

  .bw__stack-title {
    font-size: var(--step-1);
  }

  .bw__stack-list {
    display: grid;
    gap: var(--space-s);
    margin: 0;
  }

  .bw__stack-row {
    display: grid;
    gap: var(--space-3xs);
  }

  .bw__stack-row dt {
    color: var(--ink-soft);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .bw__stack-row dd {
    margin: 0;
  }

  @media (min-width: 48rem) {
    /* A row reads across: name and badge in the stack's 16rem label column, the impact beside them. */
    .bw__inner {
      gap: var(--space-xl);
    }

    .bw__row {
      display: grid;
      grid-template-columns: 16rem minmax(0, 1fr);
      align-items: center;
    }

    .bw__row-impact {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    .bw__stack-row {
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: var(--space-m);
    }
  }

  /* Desktop: text on one side, the system flow on the other; the index runs full width below. */
  @media (min-width: 56rem) {
    .bw__case {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        'problem system'
        'result system';
      gap: var(--space-l) var(--space-xl);
    }

    .bw__part--result dd > p {
      font-size: var(--step-1);
      line-height: 1.35;
    }

    .bw__part--problem {
      grid-area: problem;
    }

    .bw__part--system {
      grid-area: system;
    }

    .bw__part--result {
      grid-area: result;
    }
  }

  /* Entrance: the lead case and the index rows rise in once (tul.ts adds .is-in), only with JS and motion. */
  @media (prefers-reduced-motion: no-preference) {
    /*
     * Pulled up over the passage tail and a fifth of a viewport more: when the field flips the header already sits in
     * the lower part of the view (still invisible, see below), so it rises in place instead of scrolling up from the
     * edge. The fixed header (3rem) is far above when the top enters, so less padding.
     */
    :global(html.js) .bw {
      margin-top: calc(-1 * var(--tail) * var(--pass-h) - 20svh);
      padding-top: var(--space-l);
    }

    /* The header is revealed by the field flip, not by the scroll: it waits under the flood and rises with it. */
    :global(html.js) .bw__head {
      transition:
        opacity 700ms var(--ease-out),
        transform 700ms var(--ease-out);
    }

    :global(html.js:not([data-field='dark'])) .bw__head {
      opacity: 0;
      transform: translateY(1.5rem);
    }

    :global(html.js) .bw [data-rise] {
      opacity: 0;
      transform: translateY(1rem);
      transition:
        opacity 700ms var(--ease-out),
        transform 700ms var(--ease-out);
    }

    :global(html.js) .bw [data-rise].is-in {
      opacity: 1;
      transform: none;
    }
  }

  /* Desktop: the 3D belt rests on black in the reserved column, so the work keeps clear of it. */
  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    :global(html.js) .bw__inner {
      padding-inline-end: var(--belt-col);
    }
  }
</style>
