---
import { useTranslations, type Lang } from '../../i18n/ui';
import { BELTS, martialExperienceData } from '../../data/martialExperience';
import { projectsContent } from '../../data/projects';
import { skillsData } from '../../data/skills';
import { FLOOD_FULL } from '../../scripts/belt3d/passage';
import LeadCaseFlow from './LeadCaseFlow.astro';
import ProjectMiniFlow from './ProjectMiniFlow.astro';

/**
 * The black belt: where the sprint lands, on the black field (the red to black InkPassage floods the page and flips
 * html[data-field="dark"]; without JS or with reduced motion base.css paints this section black). It holds the real
 * work and a condensed stack. The work is one lead case and an index: NodoFit (picked by id, the data flags stay as
 * they are) told in three beats, problem, system (LeadCaseFlow, drawn with the scroll) and result, with one link to
 * the live system; the other three are a compact list of rows, not cards. The source order of PROJECT_IDS stays.
 *
 * `.bw__beat` is the travel beat of the 3D belt on black (data-belt-beat="travel", rim light, fades out before the
 * close). It is an empty, aria-hidden box over the section and half a viewport past it, so the belt rests on black
 * while the work is read and is gone once the section scrolls away.
 *
 * With JS and motion the section is pulled up over the tail of the passage (`--tail`, the part after FLOOD_FULL, from
 * passage.ts) and 20svh more: its header is already in the lower part of the view when the field flips, so there is no
 * empty black stretch.
 * The header waits invisible under the flood and rises once html[data-field="dark"] is set (and steps back if the
 * reader scrolls back above the flip).
 */
interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const PROJECT_IDS = ['nodosur', 'nodofit', 'satori', 'donpizza'];
const projects = PROJECT_IDS.flatMap((id) => projectsContent[lang].filter((p) => p.id === id));
const LEAD_ID = 'nodofit';
const lead = projects.find((p) => p.id === LEAD_ID);
const others = projects.filter((p) => p.id !== LEAD_ID);
const stage = martialExperienceData[lang].stages.find((s) => s.beltKey === 'negro');
const STACK_IDS = ['frontend', 'backend', 'devops'];
/** Condensed stack: the first five items of each technical category. */
const stack = STACK_IDS.flatMap((id) => skillsData[lang].categories.filter((c) => c.id === id)).map((c) => ({
  title: c.title,
  items: c.items.slice(0, 5).join(' · ')
}));
---

<section id="primer-dan" class="bw" data-belt="negro" style={`--tail:${Math.round((1 - FLOOD_FULL) * 1000) / 1000}`} aria-labelledby="bw-title">
  <div class="bw__beat" data-belt-beat="travel" data-belt="negro" aria-hidden="true"></div>
  <div class="bw__inner">
    <header class="bw__head">
      <h2 id="bw-title" class="bw__title grade-type">{t('tul.black.title')}</h2>
      <p class="bw__meta num">
        <span>{BELTS.negro.gup}</span>
        <span>{stage?.years}</span>
      </p>
      <p class="bw__lede">{stage?.line}</p>
    </header>

    {lead && (
      <article class="bw__lead" aria-labelledby="bw-lead" data-rise>
        <div class="bw__lead-head">
          <div class="bw__lead-title-row">
            <h3 id="bw-lead" class="bw__lead-name">{lead.name}</h3>
            <span class="bw__badge-live" aria-label="Sistema activo en producción">
              <span class="bw__badge-dot" aria-hidden="true"></span>
              {lead.badge}
            </span>
          </div>
          <p class="bw__lead-meta">
            <span class="bw__lead-role">{lead.role}</span>
            {lead.tech && (
              <span class="bw__lead-tech" aria-label="Tecnologías principales">
                {lead.tech.join(' · ')}
              </span>
            )}
          </p>
        </div>

        <dl class="bw__case">
          <div class="bw__part bw__part--problem">
            <dt>
              <span class="bw__part-num" aria-hidden="true">01</span>
              <span>{t('tul.black.problem')}</span>
            </dt>
            <dd>{lead.problem}</dd>
          </div>
          <div class="bw__part bw__part--system">
            <dt>
              <span class="bw__part-num" aria-hidden="true">02</span>
              <span>{t('tul.black.system')}</span>
            </dt>
            <dd>
              <div class="bw__diagram-frame">
                <div class="bw__diagram-header" aria-hidden="true">
                  <span class="bw__diagram-tag">DATA_FLOW_MAP</span>
                  <span class="bw__diagram-status">REALTIME_PIPELINE</span>
                </div>
                <LeadCaseFlow lang={lang} name={lead.name} />
              </div>
              <p class="bw__caption">{lead.solution}</p>
            </dd>
          </div>
          <div class="bw__part bw__part--result">
            <dt>
              <span class="bw__part-num" aria-hidden="true">03</span>
              <span>{t('tul.black.result')}</span>
            </dt>
            <dd>
              <p class="bw__result-text">{lead.impact}</p>
              <a class="bw__cta" href={lead.url} target="_blank" rel="noopener noreferrer">
                <span>{t('tul.project.visit')}<span class="visually-hidden">: {lead.name} {t('tul.cv.newTab')}</span></span>
                <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
                  <path d="M6 14L14 6M7 6H14V13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path>
                </svg>
              </a>
            </dd>
          </div>
        </dl>
      </article>
    )}

    <ul class="bw__index" role="list">
      {others.map((p, idx) => (
        <li class="bw__row" data-rise>
          <div class="bw__row-col-head">
            <div class="bw__row-title-row">
              <span class="bw__row-index num" aria-hidden="true">0{idx + 2}</span>
              <h3 class="bw__row-name">
                <a href={p.url} target="_blank" rel="noopener noreferrer">
                  <span>{p.name}<span class="visually-hidden"> {t('tul.cv.newTab')}</span></span>
                  <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" focusable="false">
                    <path d="M6 14L14 6M7 6H14V13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path>
                  </svg>
                </a>
              </h3>
            </div>
            <p class="bw__row-badge">{p.badge}</p>
          </div>
          <div class="bw__row-col-body">
            <p class="bw__row-impact">{p.impact}</p>
            {p.tech && (
              <p class="bw__row-tech num">{p.tech.join(' · ')}</p>
            )}
            <ProjectMiniFlow projectId={p.id} name={p.name} />
          </div>
        </li>
      ))}
    </ul>

    <div class="bw__stack">
      <div class="bw__stack-header">
        <span class="bw__stack-index num" aria-hidden="true">05</span>
        <h3 class="bw__stack-title">{t('tul.black.stack')}</h3>
      </div>
      <dl class="bw__stack-list">
        {stack.map((row) => (
          <div class="bw__stack-row">
            <dt>{row.title}</dt>
            <dd>{row.items}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  /* The layout's section scaffold (base.css) gives the padding; the content sets the height. */
  .bw {
    position: relative;
    min-height: 0;
  }

  .bw__beat {
    position: absolute;
    inset: 0 0 auto;
    height: calc(100% + 50svh);
    pointer-events: none;
    visibility: hidden;
  }

  .bw__inner {
    display: grid;
    /* A tighter rhythm on a phone keeps the chapter short before the close. */
    gap: var(--space-l);
    max-width: 72rem;
    margin-inline: auto;
  }

  .bw__head {
    display: grid;
    gap: var(--space-s);
  }

  .bw__title {
    max-width: 16ch;
    color: var(--belt-line);
    font-size: var(--step-4);
    /* The 1st dan grade type is already condensed: no negative tracking on top of it. */
    letter-spacing: 0;
  }

  .bw__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-s);
    color: var(--ink-soft);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .bw__lede {
    max-width: 52ch;
    font-size: var(--step-1);
    line-height: 1.4;
  }

  /* The lead case: a heavier rule than the index rows, and the three beats as a definition list. */
  .bw__lead {
    display: grid;
    gap: var(--space-m);
    padding-top: var(--space-m);
    border-top: var(--line-strong) solid var(--dan-gold);
  }

  .bw__lead-head {
    display: grid;
    gap: var(--space-xs);
  }

  .bw__lead-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-s);
  }

  .bw__lead-name {
    font-size: var(--step-3);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .bw__badge-live {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.55rem;
    border: var(--line) solid color-mix(in srgb, var(--dan-gold) 60%, transparent);
    background: color-mix(in srgb, var(--dan-gold) 8%, transparent);
    color: var(--dan-gold);
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .bw__badge-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background-color: var(--dan-gold);
    box-shadow: 0 0 8px var(--dan-gold);
  }

  .bw__lead-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-s);
    color: var(--ink-soft);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .bw__lead-role {
    color: var(--ink);
  }

  .bw__lead-tech {
    font-family: var(--font-display);
    color: var(--ink-soft);
    letter-spacing: 0.02em;
  }

  .bw__case {
    display: grid;
    gap: var(--space-l);
    margin: 0;
  }

  .bw__part {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
  }

  .bw__part dt {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    color: var(--dan-gold);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .bw__part-num {
    font-family: var(--font-display);
    font-size: 0.75rem;
    color: var(--ink-soft);
    opacity: 0.75;
  }

  .bw__part dd {
    display: grid;
    gap: var(--space-s);
    max-width: 52ch;
    margin: 0;
    text-wrap: pretty;
  }

  /* Architectural frame for the system diagram */
  .bw__diagram-frame {
    display: grid;
    gap: var(--space-2xs);
    padding: var(--space-xs);
    border: var(--line) solid color-mix(in srgb, var(--ink-soft) 25%, transparent);
    background: color-mix(in srgb, var(--field-dark) 50%, #000000 50%);
  }

  .bw__diagram-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: var(--space-3xs);
    border-bottom: var(--line) solid color-mix(in srgb, var(--ink-soft) 18%, transparent);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }

  .bw__diagram-status {
    color: var(--dan-gold);
    font-size: 0.625rem;
  }

  /* The result is the verdict a recruiter keeps: heavier than the problem (and a step up on desktop). */
  .bw__result-text {
    font-weight: 600;
    line-height: 1.45;
    color: var(--ink);
  }

  /* Body size on every viewport: a recruiter on a phone reads it at arm's length (P4). */
  .bw__caption {
    max-width: 48ch;
    color: var(--ink-soft);
    font-size: var(--step-0);
    line-height: 1.4;
  }

  /*
   * The one primary action of the block: the live system, in a solid light bar on black. Same family as the close
   * CTA (KyongYe): an ink block that inverts to an outline on hover and focus, and presses on click.
   */
  .bw__cta {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: var(--space-xs);
    min-height: 2.75rem;
    padding-inline: var(--space-m);
    border: var(--line-strong) solid var(--dan-gold);
    background-color: var(--dan-gold);
    color: var(--field-dark);
    font-weight: 700;
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .bw__cta:hover,
  .bw__cta:focus-visible {
    background-color: transparent;
    color: var(--dan-gold);
  }

  .bw__cta:active {
    transform: translateY(1px);
  }

  .bw__cta svg,
  .bw__row-name svg {
    flex: none;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .bw__cta:hover svg,
  .bw__cta:focus-visible svg,
  .bw__row:hover .bw__row-name svg,
  .bw__row:focus-within .bw__row-name svg {
    transform: translate(2px, -2px);
  }

  /* The index: the other three systems as rows of one list (never tiles). */
  .bw__index {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Phone: name and badge share a line when they fit, the impact runs below. The whole row is the link's target. */
  .bw__row {
    position: relative;
    display: grid;
    gap: var(--space-xs);
    padding-block: var(--space-m);
    border-top: var(--line) solid color-mix(in srgb, var(--ink-soft) 30%, transparent);
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .bw__row:hover {
    background-color: color-mix(in srgb, var(--ink-soft) 4%, transparent);
  }

  .bw__row-col-head {
    display: grid;
    gap: var(--space-3xs);
  }

  .bw__row-title-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
  }

  .bw__row-index {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--dan-gold);
    opacity: 0.85;
  }

  .bw__row-name {
    font-size: var(--step-1);
    font-weight: 700;
  }

  .bw__row-name a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--ink);
    text-decoration: none;
  }

  /* The stretched target: the whole row (well over 44px) opens the system. */
  .bw__row-name a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* Hover anywhere on the row reads as hovering its name. */
  .bw__row:hover .bw__row-name a {
    color: var(--dan-gold);
  }

  /* Keyboard focus rings the whole row (the target), not just the name. */
  .bw__row-name a:focus-visible {
    outline: none;
  }

  .bw__row-name a:focus-visible::after {
    outline: var(--line-strong) solid var(--dan-gold);
    outline-offset: 2px;
  }

  .bw__row-badge {
    color: var(--dan-gold);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .bw__row-col-body {
    display: grid;
    gap: var(--space-2xs);
  }

  .bw__row-impact {
    max-width: 62ch;
    font-size: var(--step-0);
    line-height: 1.4;
    color: var(--ink);
  }

  .bw__row-tech {
    font-size: var(--step--1);
    color: var(--ink-soft);
    letter-spacing: 0.03em;
  }

  .bw__stack {
    display: grid;
    gap: var(--space-s);
    padding-top: var(--space-m);
    border-top: var(--line-strong) solid var(--belt-line);
  }

  .bw__stack-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
  }

  .bw__stack-index {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--dan-gold);
    opacity: 0.85;
  }

  .bw__stack-title {
    font-size: var(--step-1);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .bw__stack-list {
    display: grid;
    gap: var(--space-s);
    margin: 0;
  }

  .bw__stack-row {
    display: grid;
    gap: var(--space-3xs);
  }

  .bw__stack-row dt {
    color: var(--ink-soft);
    font-size: var(--step--1);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .bw__stack-row dd {
    margin: 0;
    color: var(--ink);
    font-size: var(--step-0);
  }

  @media (min-width: 48rem) {
    .bw__inner {
      gap: var(--space-xl);
    }

    .bw__row {
      grid-template-columns: 16rem minmax(0, 1fr);
      align-items: start;
      column-gap: var(--space-m);
    }

    .bw__row-impact {
      grid-column: 2;
    }

    .bw__row-tech {
      grid-column: 2;
    }

    .bw__stack-row {
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: var(--space-m);
    }
  }

  /* Desktop: text on one side, the system flow on the other; the index runs full width below. */
  @media (min-width: 56rem) {
    .bw__case {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        'problem system'
        'result system';
      gap: var(--space-l) var(--space-xl);
    }

    .bw__part--result dd > p {
      font-size: var(--step-1);
      line-height: 1.35;
    }

    .bw__part--problem {
      grid-area: problem;
    }

    .bw__part--system {
      grid-area: system;
    }

    .bw__part--result {
      grid-area: result;
    }
  }

  /* Entrance: the lead case and the index rows rise in once (tul.ts adds .is-in), only with JS and motion. */
  @media (prefers-reduced-motion: no-preference) {
    /*
     * Pulled up over the passage tail and a fifth of a viewport more: when the field flips the header already sits in
     * the lower part of the view (still invisible, see below), so it rises in place instead of scrolling up from the
     * edge. The fixed header (3rem) is far above when the top enters, so less padding.
     */
    :global(html.js) .bw {
      margin-top: calc(-1 * var(--tail) * var(--pass-h) - 20svh);
      padding-top: var(--space-l);
    }

    /* The header is revealed by the field flip, not by the scroll: it waits under the flood and rises with it. */
    :global(html.js) .bw__head {
      transition:
        opacity 700ms var(--ease-out),
        transform 700ms var(--ease-out);
    }

    :global(html.js:not([data-field='dark'])) .bw__head {
      opacity: 0;
      transform: translateY(1.5rem);
    }

    :global(html.js) .bw [data-rise] {
      opacity: 0;
      transform: translateY(1rem);
      transition:
        opacity 700ms var(--ease-out),
        transform 700ms var(--ease-out);
    }

    :global(html.js) .bw [data-rise].is-in {
      opacity: 1;
      transform: none;
    }
  }

  /* Desktop: the 3D belt rests on black in the reserved column, so the work keeps clear of it. */
  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    :global(html.js) .bw__inner {
      padding-inline-end: var(--belt-col);
    }
  }
</style>
