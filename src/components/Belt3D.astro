---
// Desktop-only 3D belt rendered inside the page-level sticky viewer.
// three.js and GLTFLoader are imported dynamically after desktop + WebGL + motion checks pass.
---

<div id="belt3d-root" class="belt3d-root" aria-hidden="true" hidden>
  <canvas id="belt3d-canvas" class="belt3d-canvas" width="900" height="600"></canvas>
</div>

<style>
  .belt3d-root {
    position: fixed;
    left: 0;
    top: 0;
    width: 900px;
    height: 600px;
    z-index: 40;
    pointer-events: none;
    transform-origin: 0 0;
    opacity: 0;
    filter: drop-shadow(0 0 20px rgba(0, 0, 0, 0.35)) drop-shadow(0 0 4px rgba(255, 255, 255, 0.2));
  }
  .belt3d-root[hidden] {
    display: none;
  }
  .belt3d-canvas {
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: auto;
    cursor: grab;
    touch-action: pan-y;
  }
  .belt3d-canvas:active {
    cursor: grabbing;
  }
  @media (max-width: 1023px), (prefers-reduced-motion: reduce) {
    .belt3d-root {
      display: none !important;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const W0 = 900;
  const H0 = 600;
  const FIT = 2.35;
  const MODEL_ROT: [number, number, number] = [0, 0, 0];

  const root = document.getElementById('belt3d-root') as HTMLElement | null;
  const canvas = document.getElementById('belt3d-canvas') as HTMLCanvasElement | null;
  const desktopMq = window.matchMedia('(min-width: 1024px)');
  const reducedMq = window.matchMedia('(prefers-reduced-motion: reduce)');

  let dispose: (() => void) | null = null;
  let starting = false;

  function hasWebGL(): boolean {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  }

  function eligible(): boolean {
    return desktopMq.matches && !reducedMq.matches && hasWebGL();
  }

  const swatch = document.createElement('canvas');
  swatch.width = swatch.height = 1;
  const swatchCtx = swatch.getContext('2d', { willReadFrequently: true });
  function cssToRgb(css: string): [number, number, number] {
    if (!swatchCtx) return [0.9, 0.9, 0.9];
    swatchCtx.clearRect(0, 0, 1, 1);
    swatchCtx.fillStyle = '#000';
    swatchCtx.fillStyle = css;
    swatchCtx.fillRect(0, 0, 1, 1);
    const d = swatchCtx.getImageData(0, 0, 1, 1).data;
    return [d[0] / 255, d[1] / 255, d[2] / 255];
  }

  async function start() {
    if (dispose || starting || !root || !canvas || !eligible()) return;
    starting = true;
    const [THREE, { RoomEnvironment }, { GLTFLoader }] = await Promise.all([
      import('three'),
      import('three/examples/jsm/environments/RoomEnvironment.js'),
      import('three/examples/jsm/loaders/GLTFLoader.js'),
    ]);
    starting = false;
    if (dispose || !eligible()) return;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: 'low-power' });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5));
    renderer.setSize(W0, H0, false);
    renderer.setClearColor(0x000000, 0);
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 0.95;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(30, W0 / H0, 0.1, 50);
    camera.position.set(0, 0, 5.2);
    camera.lookAt(0, 0, 0);

    // Dynamic key, ambient, and rim lighting
    scene.add(new THREE.HemisphereLight(0xffffff, 0x8a8478, 0.4));
    const key = new THREE.DirectionalLight(0xffffff, 1.0);
    key.position.set(2.5, 3.5, 4.5);
    scene.add(key);
    const rim = new THREE.DirectionalLight(0xdfe8ff, 0.5);
    rim.position.set(-3, 2, -3);
    scene.add(rim);

    const belt = new THREE.Group();
    belt.position.set(0, -0.04, 0);
    scene.add(belt);

    // Realistic reflections and fabric sheen
    const pmrem = new THREE.PMREMGenerator(renderer);
    const envRT = pmrem.fromScene(new RoomEnvironment(), 0.04);
    scene.environment = envRT.texture;
    scene.environmentIntensity = 0.45;

    const CHAPTER_KEYS = ['blanco', 'blanco', 'amarillo', 'verde', 'azul', 'rojo', 'negro'];
    const CHAPTER_COLORS: Record<string, string> = {
      blanco: '#ffffff',
      amarillo: '#fbbf24',
      verde: '#10b981',
      azul: '#0284c7',
      rojo: '#ef4444',
      negro: '#1c1a17',
    };

    function getInitialColor(): string {
      const mid = window.innerHeight / 2;
      const zones = Array.from(document.querySelectorAll<HTMLElement>('[data-zone]'));
      const activeZone = zones.find((el) => {
        const r = el.getBoundingClientRect();
        return r.top <= mid && r.bottom > mid;
      });
      if (activeZone) {
        const ch = parseInt(activeZone.dataset.ch || '0', 10);
        const k = CHAPTER_KEYS[ch] || 'blanco';
        return CHAPTER_COLORS[k] || '#ffffff';
      }
      return document.documentElement.dataset.activeBeltColor || '#ffffff';
    }

    let activeColor = getInitialColor();
    const cur = new THREE.Color(activeColor);

    const cloth: Array<InstanceType<typeof THREE.MeshStandardMaterial>> = [];
    const applyTint = () => {
      for (const m of cloth) {
        m.color.copy(cur);
        const sheen = (m as unknown as { sheenColor?: InstanceType<typeof THREE.Color> }).sheenColor;
        if (sheen) sheen.copy(cur);
      }
    };

    let alive = true;
    let loaded: InstanceType<typeof THREE.Group> | null = null;

    new GLTFLoader().load(
      '/models/cinturon-itfv2.glb',
      (gltf) => {
        if (!alive) {
          disposeTree(gltf.scene);
          return;
        }
        const model = gltf.scene;
        model.traverse((o) => {
          const mesh = o as InstanceType<typeof THREE.Mesh>;
          if (!mesh.isMesh) return;
          const mats = Array.isArray(mesh.material) ? mesh.material : [mesh.material];
          for (const m of mats) {
            if ((m.name === 'belt_cloth' || m.name === 'belt_stitch') && !cloth.includes(m as never)) {
              cloth.push(m as never);
            }
          }
        });

        // Center and fit to camera framing
        const box = new THREE.Box3().setFromObject(model);
        const size = box.getSize(new THREE.Vector3());
        const center = box.getCenter(new THREE.Vector3());
        model.position.sub(center);

        const wrap = new THREE.Group();
        wrap.add(model);
        wrap.scale.setScalar(Math.min(FIT / size.x, FIT / size.y));
        wrap.rotation.set(MODEL_ROT[0], MODEL_ROT[1], MODEL_ROT[2]);
        belt.add(wrap);
        loaded = wrap;

        // Ensure current active color is applied on load (handles F5 reload)
        activeColor = getInitialColor();
        setTarget(activeColor);
        applyTint();
        root.hidden = false;
      },
      undefined,
      (err) => {
        console.warn('Failed to load cinturon-itfv2.glb', err);
        if (root) root.hidden = true;
      }
    );

    function disposeTree(obj: InstanceType<typeof THREE.Object3D>) {
      const seen = new Set<unknown>();
      obj.traverse((o) => {
        const mesh = o as InstanceType<typeof THREE.Mesh>;
        if (!mesh.isMesh) return;
        mesh.geometry?.dispose();
        const mats = Array.isArray(mesh.material) ? mesh.material : [mesh.material];
        for (const m of mats) {
          if (!m || seen.has(m)) continue;
          seen.add(m);
          for (const v of Object.values(m as unknown as Record<string, unknown>)) {
            if (v && (v as { isTexture?: boolean }).isTexture) (v as { dispose(): void }).dispose();
          }
          m.dispose();
        }
      });
    }

    // State driven by GSAP (drag only).
    const state = { drag: 0 };
    const to = new THREE.Color(0xffffff);
    const setTarget = (css: string) => {
      const [r, g, b] = cssToRgb(css);
      to.setRGB(r, g, b, THREE.SRGBColorSpace);
      cur.copy(to);
      applyTint();
    };

    setTarget(activeColor);
    const onBelt = (e: Event) => {
      const c = (e as CustomEvent<{ color?: string }>).detail?.color;
      if (!c || c === activeColor) return;
      activeColor = c;
      setTarget(c);
    };
    window.addEventListener('belt:change', onBelt);

    const scrubFrom = new THREE.Color();
    const scrubTo = new THREE.Color();
    const onBlackProgress = (e: Event) => {
      const d = (e as CustomEvent<{ progress: number; mix: number; from?: string; to?: string }>).detail;
      if (!d || !d.from || !d.to) return;
      const [fr, fg, fb] = cssToRgb(d.from);
      const [tr, tg, tb] = cssToRgb(d.to);
      scrubFrom.setRGB(fr, fg, fb, THREE.SRGBColorSpace);
      scrubTo.setRGB(tr, tg, tb, THREE.SRGBColorSpace);
      cur.copy(scrubFrom).lerp(scrubTo, d.mix);
      applyTint();
    };
    window.addEventListener('belt:black-progress', onBlackProgress);

    // Drag: rotate Y only, eases back on release.
    let dragging = false;
    let lastX = 0;
    const onDown = (e: PointerEvent) => {
      dragging = true;
      lastX = e.clientX;
      gsap.killTweensOf(state, 'drag');
      canvas!.setPointerCapture(e.pointerId);
    };
    const onMove = (e: PointerEvent) => {
      if (!dragging) return;
      state.drag += (e.clientX - lastX) * 0.012;
      lastX = e.clientX;
    };
    const onUp = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      if (canvas!.hasPointerCapture(e.pointerId)) canvas!.releasePointerCapture(e.pointerId);
      const turns = Math.round(state.drag / (Math.PI * 2));
      state.drag -= turns * Math.PI * 2;
      gsap.to(state, { drag: 0, duration: 0.9, ease: 'elastic.out(1, 0.6)' });
    };
    canvas!.addEventListener('pointerdown', onDown);
    canvas!.addEventListener('pointermove', onMove);
    canvas!.addEventListener('pointerup', onUp);
    canvas!.addEventListener('pointercancel', onUp);

    // Render loop and slot tracking
    let raf = 0;
    let t0 = performance.now();
    let lastT = 0;
    let curSlot: { x: number; y: number; w: number; h: number; o: number } | null = null;

    // T5: smoothing must be refresh-rate independent. A per-frame constant
    // (e.g. k = 0.08) converges ~4x faster at 240Hz than at 60Hz, which made
    // the belt race across the screen on high-refresh machines. Rate-based
    // easing covers the same fraction of the gap per second at any framerate.
    // 4.5/s ≈ 220ms time constant — matches the original 60Hz intent, calmer above it.
    const SMOOTH_RATE = 4.5;

    function updateBeltPosition(dt: number) {
      const H = window.innerHeight;
      const mid = H / 2;
      const zones = Array.from(document.querySelectorAll<HTMLElement>('[data-zone]'));
      const activeZone = zones.find((el) => {
        const r = el.getBoundingClientRect();
        return r.top <= mid && r.bottom > mid;
      }) ?? null;

      if (activeZone) {
        const ch = parseInt(activeZone.dataset.ch || '0', 10);
        const k = CHAPTER_KEYS[ch] || 'blanco';
        const expectedColor = CHAPTER_COLORS[k];
        if (expectedColor && expectedColor !== activeColor && activeZone.dataset.zone !== 'dark' && ch < 6) {
          activeColor = expectedColor;
          setTarget(expectedColor);
        }
      }

      let tgt: DOMRect | null = null;
      let op = 0;
      const slot = activeZone ? activeZone.querySelector<HTMLElement>('[data-slot]') : null;
      if (slot) {
        const r = slot.getBoundingClientRect();
        const vis = r.width > 20 && r.height > 20 && r.right > 0 && r.left < window.innerWidth && r.bottom > 0 && r.top < H;
        if (vis) {
          tgt = r;
          const zn = activeZone?.dataset.zone;
          const p = parseFloat(activeZone?.style.getPropertyValue('--p') || '0');
          op = zn === 'curtain' ? Math.min(1, Math.max(0, (p - (activeZone?.dataset.ch === '6' ? 0.6 : 0.32)) * 3)) : 1;
        }
      }

      if (!curSlot && tgt) curSlot = { x: tgt.left, y: tgt.top, w: tgt.width, h: tgt.height, o: 0 };
      if (!curSlot) return;
      const k = 1 - Math.exp(-SMOOTH_RATE * dt);
      if (tgt) {
        curSlot.x += (tgt.left - curSlot.x) * k;
        curSlot.y += (tgt.top - curSlot.y) * k;
        curSlot.w += (tgt.width - curSlot.w) * k;
        curSlot.h += (tgt.height - curSlot.h) * k;
      }
      curSlot.o += (op - curSlot.o) * k;
      const s = Math.min(curSlot.w / W0, curSlot.h / H0) * 0.92;
      const x = curSlot.x + (curSlot.w - W0 * s) / 2;
      const y = curSlot.y + (curSlot.h - H0 * s) / 2;
      if (root) {
        root.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0) scale(${s.toFixed(4)})`;
        root.style.opacity = curSlot.o.toFixed(3);
      }
    }

    const frame = () => {
      raf = requestAnimationFrame(frame);
      const t = (performance.now() - t0) / 1000;
      // Clamp dt so a backgrounded tab does not teleport the belt on resume.
      const dt = Math.min(0.05, Math.max(0, t - lastT));
      lastT = t;
      // T5: idle sway halved (±10° → ±5°) and slowed (0.6 → 0.35 rad/s);
      // breathing amplitude halved as well. Motion should whisper, not wave.
      const auto = dragging ? 0 : Math.sin(t * 0.35) * THREE.MathUtils.degToRad(5);
      belt.rotation.y = state.drag + auto;
      belt.scale.setScalar(1.005 + 0.005 * Math.sin(t * 0.6));
      updateBeltPosition(dt);
      renderer.render(scene, camera);
    };

    const onVis = () => {
      cancelAnimationFrame(raf);
      if (!document.hidden) {
        t0 = performance.now() - lastT * 1000;
        raf = requestAnimationFrame(frame);
      }
    };
    document.addEventListener('visibilitychange', onVis);
    raf = requestAnimationFrame(frame);

    dispose = () => {
      cancelAnimationFrame(raf);
      document.removeEventListener('visibilitychange', onVis);
      window.removeEventListener('belt:change', onBelt);
      window.removeEventListener('belt:black-progress', onBlackProgress);
      canvas!.removeEventListener('pointerdown', onDown);
      canvas!.removeEventListener('pointermove', onMove);
      canvas!.removeEventListener('pointerup', onUp);
      canvas!.removeEventListener('pointercancel', onUp);
      gsap.killTweensOf(state);
      alive = false;
      if (loaded) disposeTree(loaded);
      envRT.dispose();
      pmrem.dispose();
      scene.environment = null;
      renderer.dispose();
      renderer.forceContextLoss();
      if (root) root.hidden = true;
      dispose = null;
    };
  }

  function sync() {
    if (eligible()) {
      if (!dispose && !starting) start();
    } else if (dispose) {
      dispose();
    }
  }

  if (root && canvas) {
    const boot = () => {
      const ric = (window as unknown as { requestIdleCallback?: (cb: () => void, o?: { timeout: number }) => void }).requestIdleCallback;
      if (ric) ric(sync, { timeout: 3000 });
      else setTimeout(sync, 1500);
    };
    if (document.readyState === 'complete') boot();
    else window.addEventListener('load', boot, { once: true });
    desktopMq.addEventListener('change', sync);
    reducedMq.addEventListener('change', sync);
  }
</script>
