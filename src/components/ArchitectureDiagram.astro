---
import type { Lang } from '../i18n/ui';
import { ArrowRight } from 'lucide-astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const content = {
  es: {
    badge: 'CÓMO FUNCIONA EN PRODUCCIÓN',
    title: 'El camino de una solución: del código a la realidad',
    subtitle: 'Una arquitectura pensada para ser confiable, predecible y sin intermediarios costosos: cada mejora se prueba de forma automática, vive en servidores propios y cuida los datos críticos con supervisión humana.',
    stages: [
      {
        tag: '01 · ORIGEN',
        title: 'Código Seguro y Tipado',
        items: ['Reglas estrictas que previenen errores', 'Historial transparente de cada versión (Git)'],
        badge: 'Calidad en Origen'
      },
      {
        tag: '02 · CONTROL',
        title: 'Verificación Automática',
        items: ['Pruebas continuas antes de publicar', 'Validación de estructura y seguridad'],
        badge: 'CI / CD Limpio'
      },
      {
        tag: '03 · EL MOTOR',
        title: 'Servidores Propios (Linux)',
        items: ['Sistemas aislados y estables (Docker)', 'Conexiones cifradas de punta a punta (SSL)'],
        badge: 'Autonomía Total'
      },
      {
        tag: '04 · CARA AL USUARIO',
        title: 'Carga Inmediata en la Web',
        items: ['Apertura instantánea en móviles y PC', 'Red global de distribución (Edge)'],
        badge: 'Experiencia Fluida'
      },
      {
        tag: '05 · LO CRÍTICO',
        title: 'Datos Reales y Facturación',
        items: ['Emisión fiscal oficial con ARCA (ex AFIP)', 'Validación humana antes de confirmar'],
        badge: 'Criterio en el Loop'
      }
    ]
  },
  en: {
    badge: 'HOW IT RUNS IN PRODUCTION',
    title: 'The path of a solution: from code to reality',
    subtitle: 'An architecture designed to be reliable, predictable, and free of costly black boxes: every enhancement is automatically verified, hosted on dedicated servers, and guards critical data with human oversight.',
    stages: [
      {
        tag: '01 · SOURCE',
        title: 'Typed & Resilient Code',
        items: ['Strict typing that prevents edge bugs', 'Transparent version history with Git'],
        badge: 'Quality by Design'
      },
      {
        tag: '02 · GATES',
        title: 'Automated Verification',
        items: ['Continuous test runs before release', 'Build validation & security sanity checks'],
        badge: 'Clean CI / CD'
      },
      {
        tag: '03 · ENGINE',
        title: 'Dedicated Linux Cloud',
        items: ['Isolated, predictable services (Docker)', 'End-to-end encrypted traffic (SSL/Nginx)'],
        badge: 'Full Autonomy'
      },
      {
        tag: '04 · FRONT-FACING',
        title: 'Instant Web Delivery',
        items: ['Sub-second loads on mobile and desktop', 'Global edge network delivery (Vercel)'],
        badge: 'Seamless UX'
      },
      {
        tag: '05 · CRITICAL',
        title: 'Live Data & Fiscal Integrity',
        items: ['Official fiscal sync with ARCA (tax authority)', 'Human confirmation on irreversible ops'],
        badge: 'Human-in-the-Loop'
      }
    ]
  },
  pt: {
    badge: 'COMO OPERA EM PRODUÇÃO',
    title: 'O caminho de uma solução: do código à realidade',
    subtitle: 'Uma arquitetura projetada para ser confiável, previsível e sem intermediários onerosos: cada melhoria é testada automaticamente, roda em servidores próprios e protege dados críticos com supervisão humana.',
    stages: [
      {
        tag: '01 · ORIGEM',
        title: 'Código Seguro e Tipado',
        items: ['Regras estritas que evitam erros em produção', 'Histórico transparente de versões com Git'],
        badge: 'Qualidade na Fonte'
      },
      {
        tag: '02 · CONTROLE',
        title: 'Verificação Automática',
        items: ['Testes contínuos antes de publicar', 'Validação de build e integridade estrutural'],
        badge: 'CI / CD Limpo'
      },
      {
        tag: '03 · O MOTOR',
        title: 'Servidores Próprios (Linux)',
        items: ['Sistemas isolados e confiáveis (Docker)', 'Conexões criptografadas ponta a ponta (SSL)'],
        badge: 'Autonomia Real'
      },
      {
        tag: '04 · AO PÚBLICO',
        title: 'Carregamento Imediato na Web',
        items: ['Abertura instantânea em qualquer celular ou PC', 'Distribuição global em rede Edge'],
        badge: 'Experiência Fluida'
      },
      {
        tag: '05 · O CRÍTICO',
        title: 'Dados e Faturamento Real',
        items: ['Integração fiscal oficial com ARCA (ex AFIP)', 'Validação humana antes de confirmar'],
        badge: 'Critério Humano'
      }
    ]
  }
}[lang];
---

<div class="architecture-diagram-container" data-reveal>
  <div class="arch-header">
    <span class="arch-badge">{content.badge}</span>
    <h3 class="arch-title">{content.title}</h3>
    <p class="arch-subtitle">{content.subtitle}</p>
  </div>

  <!-- Pipeline Horizontal con Nodos -->
  <div class="pipeline-track" data-nested-scroll>
    {content.stages.map((stage, idx) => (
      <div class="pipeline-node-wrapper">
        <div class="pipeline-card">
          <div class="card-tag-row">
            <span class="node-tag">{stage.tag}</span>
            <span class="node-badge">{stage.badge}</span>
          </div>
          <h4 class="node-title">{stage.title}</h4>
          <ul class="node-items">
            {stage.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        {idx < content.stages.length - 1 && (
          <div class="pipeline-connector" aria-hidden="true">
            <ArrowRight size={18} class="connector-arrow" />
          </div>
        )}
      </div>
    ))}
  </div>
</div>

<style>
  .architecture-diagram-container {
    margin-top: 5rem;
    padding: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 3.5vw, 3rem);
    background: #141210;
    border: 1px solid rgba(242, 238, 230, 0.12);
    border-radius: 4px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
  }

  .arch-header {
    margin-bottom: 2.75rem;
  }

  .arch-badge {
    display: inline-block;
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #fbbf24;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }

  .arch-title {
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 300;
    color: #f2eee6;
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem 0;
    line-height: 1.15;
  }

  .arch-subtitle {
    font-size: 1rem;
    color: #c9c3b7;
    max-width: 52rem;
    line-height: 1.6;
    margin: 0;
  }

  .pipeline-track {
    display: flex;
    align-items: stretch;
    gap: 0.75rem;
    overflow-x: auto;
    padding-bottom: 1rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(242, 238, 230, 0.25) rgba(255, 255, 255, 0.03);
  }

  .pipeline-node-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 1 1 0;
    min-width: 220px;
  }

  .pipeline-card {
    flex: 1;
    height: 100%;
    background: #1e1c19;
    border: 1px solid rgba(242, 238, 230, 0.1);
    border-radius: 4px;
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .pipeline-card:hover {
    transform: translateY(-2px);
    border-color: rgba(251, 191, 36, 0.4);
    background: #23201c;
  }

  .card-tag-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .node-tag {
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #a39c90;
    text-transform: uppercase;
  }

  .node-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    color: #fbbf24;
    background: rgba(251, 191, 36, 0.08);
    padding: 0.2rem 0.5rem;
    border: 1px solid rgba(251, 191, 36, 0.25);
    border-radius: 2px;
  }

  .node-title {
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-size: 1.15rem;
    font-weight: 400;
    color: #f2eee6;
    line-height: 1.25;
    margin: 0;
  }

  .node-items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.82rem;
    color: #c9c3b7;
    line-height: 1.45;
  }

  .node-items li::before {
    content: '→ ';
    color: #fbbf24;
    font-family: var(--font-mono, monospace);
  }

  .pipeline-connector {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6a645a;
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .architecture-diagram-container {
      padding: 2rem 1.5rem;
    }
    .pipeline-track {
      flex-direction: column;
      gap: 1rem;
    }
    .pipeline-node-wrapper {
      flex-direction: column;
      min-width: 100%;
    }
    .pipeline-connector {
      transform: rotate(90deg);
      margin: 0.25rem 0;
    }
  }
</style>
