---
import type { Lang } from '../i18n/ui';
import { ArrowRight } from 'lucide-astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const content = {
  es: {
    badge: 'CLOUD, INFRAESTRUCTURA & DEVOPS',
    title: 'Arquitectura de Producción de NodoSur',
    subtitle: 'Despliegues autónomos en entornos cloud propios sin depender de cajas negras costosas ni arquitecturas infladas.',
    stages: [
      {
        tag: '01 · CÓDIGO & REPO',
        title: 'Repositorio GitHub',
        items: ['TypeScript Estricto', 'Python para Scripts'],
        badge: 'Git Versionado'
      },
      {
        tag: '02 · CI / CD',
        title: 'GitHub Actions',
        items: ['Pipelines automatizados', 'Linter & Build Validation'],
        badge: 'Automatización'
      },
      {
        tag: '03 · SERVIDOR PROPIO',
        title: 'Linux (Ubuntu Server)',
        items: ['Nginx Reverse Proxy & SSL', 'Docker & Docker Compose', 'NodoFit (SaaS en producción)'],
        badge: 'Infraestructura Cloud'
      },
      {
        tag: '04 · EDGE & WEB',
        title: 'Vercel Edge Network',
        items: ['Satori Dojo (Web & App)', 'Don Pizza (App Delivery)'],
        badge: 'Distribución Global'
      },
      {
        tag: '05 · FISCAL & DATOS',
        title: 'ARCA (ex AFIP) + PostgreSQL',
        items: ['Webservices de Facturación Electrónica', 'Validación humana en el loop', 'Base de datos relacional'],
        badge: 'Cumplimiento Legal'
      }
    ]
  },
  en: {
    badge: 'CLOUD, INFRASTRUCTURE & DEVOPS',
    title: 'NodoSur Production Architecture',
    subtitle: 'Autonomous deployments on self-managed cloud instances without expensive black-box lock-in.',
    stages: [
      {
        tag: '01 · CODE & REPO',
        title: 'GitHub Repository',
        items: ['Strict TypeScript', 'Python for Scripts'],
        badge: 'Git Versioning'
      },
      {
        tag: '02 · CI / CD',
        title: 'GitHub Actions',
        items: ['Automated Pipelines', 'Linter & Build Validation'],
        badge: 'Automation'
      },
      {
        tag: '03 · SELF-HOSTED CLOUD',
        title: 'Linux (Ubuntu Server)',
        items: ['Nginx Reverse Proxy & SSL', 'Docker & Docker Compose', 'NodoFit (Live SaaS)'],
        badge: 'Cloud Infrastructure'
      },
      {
        tag: '04 · EDGE & WEB',
        title: 'Vercel Edge Network',
        items: ['Satori Dojo (Web & Portal)', 'Don Pizza (Delivery App)'],
        badge: 'Global Distribution'
      },
      {
        tag: '05 · FISCAL & DATA',
        title: 'ARCA (ex AFIP) + PostgreSQL',
        items: ['Fiscal Electronic Invoicing APIs', 'Human-in-the-loop verification', 'Relational PostgreSQL Database'],
        badge: 'Statutory Compliance'
      }
    ]
  },
  pt: {
    badge: 'CLOUD, INFRAESTRUTURA & DEVOPS',
    title: 'Arquitetura de Produção da NodoSur',
    subtitle: 'Implantações autônomas em servidores cloud próprios sem dependência de plataformas caras.',
    stages: [
      {
        tag: '01 · CÓDIGO & REPO',
        title: 'Repositório GitHub',
        items: ['TypeScript Estrito', 'Python para Scripts'],
        badge: 'Versionamento Git'
      },
      {
        tag: '02 · CI / CD',
        title: 'GitHub Actions',
        items: ['Pipelines automatizados', 'Linter & Build Validation'],
        badge: 'Automação'
      },
      {
        tag: '03 · SERVIDOR PRÓPRIO',
        title: 'Linux (Ubuntu Server)',
        items: ['Nginx Reverse Proxy & SSL', 'Docker & Docker Compose', 'NodoFit (SaaS em produção)'],
        badge: 'Infraestrutura Cloud'
      },
      {
        tag: '04 · EDGE & WEB',
        title: 'Vercel Edge Network',
        items: ['Satori Dojo (Web & App)', 'Don Pizza (App Delivery)'],
        badge: 'Distribuição Global'
      },
      {
        tag: '05 · FISCAL & DADOS',
        title: 'ARCA (ex AFIP) + PostgreSQL',
        items: ['Webservices de Nota Fiscal Eletrônica', 'Validação humana no loop', 'Banco de dados relacional'],
        badge: 'Conformidade Legal'
      }
    ]
  }
}[lang];
---

<div class="architecture-diagram-container" data-reveal>
  <div class="arch-header">
    <span class="arch-badge">{content.badge}</span>
    <h3 class="arch-title">{content.title}</h3>
    <p class="arch-subtitle">{content.subtitle}</p>
  </div>

  <!-- Pipeline Horizontal con Nodos -->
  <div class="pipeline-track">
    {content.stages.map((stage, idx) => (
      <div class="pipeline-node-wrapper">
        <div class="pipeline-card">
          <div class="card-tag-row">
            <span class="node-tag">{stage.tag}</span>
            <span class="node-badge">{stage.badge}</span>
          </div>
          <h4 class="node-title">{stage.title}</h4>
          <ul class="node-items">
            {stage.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        {idx < content.stages.length - 1 && (
          <div class="pipeline-connector" aria-hidden="true">
            <ArrowRight size={18} class="connector-arrow" />
          </div>
        )}
      </div>
    ))}
  </div>
</div>

<style>
  .architecture-diagram-container {
    margin-top: 5rem;
    padding: 3rem 2.5rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }

  .arch-header {
    margin-bottom: 2.75rem;
  }

  .arch-badge {
    display: inline-block;
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent-cyan);
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .arch-title {
    font-size: clamp(1.6rem, 2.5vw, 2.1rem);
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem 0;
  }

  .arch-subtitle {
    font-size: 0.98rem;
    color: var(--text-muted);
    max-width: 48rem;
    line-height: 1.55;
    margin: 0;
  }

  .pipeline-track {
    display: flex;
    align-items: stretch;
    gap: 0.75rem;
    overflow-x: auto;
    padding-bottom: 1rem;
    scrollbar-width: thin;
  }

  .pipeline-node-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 1 1 0;
    min-width: 220px;
  }

  .pipeline-card {
    flex: 1;
    height: 100%;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 1.4rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .pipeline-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
  }

  .card-tag-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .node-tag {
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-dim);
    text-transform: uppercase;
  }

  .node-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    color: var(--accent-cyan);
    background: var(--bg-surface);
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--border-subtle);
    border-radius: 2px;
  }

  .node-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-main);
    line-height: 1.3;
    margin: 0;
  }

  .node-items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .node-items li::before {
    content: '→ ';
    color: var(--accent-cyan);
  }

  .pipeline-connector {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-dim);
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .architecture-diagram-container {
      padding: 2rem 1.5rem;
    }
    .pipeline-track {
      flex-direction: column;
      gap: 1rem;
    }
    .pipeline-node-wrapper {
      flex-direction: column;
      min-width: 100%;
    }
    .pipeline-connector {
      transform: rotate(90deg);
      margin: 0.25rem 0;
    }
  }
</style>
