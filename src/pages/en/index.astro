---
import Layout from '../../layouts/Layout.astro';
import HeroSection from '../../components/site/HeroSection.astro';
import BeltsSection from '../../components/site/BeltsSection.astro';
import Placeholders from '../../components/site/Placeholders.astro';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('en');
---

<Layout lang="en" title={t('meta.title')} description={t('meta.description')}>
  <main>
    <HeroSection lang="en" />
    <BeltsSection lang="en" />
    <Placeholders lang="en" />
  </main>
</Layout>
