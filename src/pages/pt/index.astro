---
import HeroJoonbi from '../../components/tul/HeroJoonbi.astro';
import BeltSprint from '../../components/tul/BeltSprint.astro';
import InkPassage from '../../components/tul/InkPassage.astro';
import BlackBeltWork from '../../components/tul/BlackBeltWork.astro';
import KyongYe from '../../components/tul/KyongYe.astro';
import TulLayout from '../../layouts/TulLayout.astro';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('pt');
---

<TulLayout lang="pt" title={t('meta.title')} description={t('meta.description')}>
  <main id="main">
    <HeroJoonbi lang="pt" />
    <BeltSprint lang="pt" />
    <InkPassage from="rojo" to="negro" />
    <BlackBeltWork lang="pt" />
    <KyongYe lang="pt" />
  </main>
</TulLayout>
