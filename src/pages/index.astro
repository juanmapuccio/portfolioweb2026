---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/site/HeroSection.astro';
import BeltsSection from '../components/site/BeltsSection.astro';
import FrictionSection from '../components/site/FrictionSection.astro';
import ProjectsSection from '../components/site/ProjectsSection.astro';
import StackSection from '../components/site/StackSection.astro';
import PrinciplesSection from '../components/site/PrinciplesSection.astro';
import ContactSection from '../components/site/ContactSection.astro';
import { useTranslations } from '../i18n/ui';

const t = useTranslations('es');
---

<Layout lang="es" title={t('meta.title')} description={t('meta.description')}>
  <main>
    <HeroSection lang="es" />
    <BeltsSection lang="es" />
    <FrictionSection lang="es" />
    <ProjectsSection lang="es" />
    <StackSection lang="es" />
    <PrinciplesSection lang="es" />
    <ContactSection lang="es" />
  </main>
</Layout>
