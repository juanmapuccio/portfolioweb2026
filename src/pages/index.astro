---
import TulChapter from '../components/tul/TulChapter.astro';
import HeroJoonbi from '../components/tul/HeroJoonbi.astro';
import TulLayout from '../layouts/TulLayout.astro';
import { useTranslations } from '../i18n/ui';

const t = useTranslations('es');
---

<TulLayout lang="es" title={t('meta.title')} description={t('meta.description')}>
  <main id="main">
    <HeroJoonbi lang="es" />
    <TulChapter lang="es" beltKey="blanco" />
    <TulChapter lang="es" beltKey="amarillo" />
    <TulChapter lang="es" beltKey="verde" />
    <TulChapter lang="es" beltKey="azul" />
    <TulChapter lang="es" beltKey="rojo" />
    <TulChapter lang="es" beltKey="negro" />
  </main>
</TulLayout>
