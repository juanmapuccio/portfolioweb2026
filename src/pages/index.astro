---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/site/HeroSection.astro';
import BeltsSection from '../components/site/BeltsSection.astro';
import Placeholders from '../components/site/Placeholders.astro';
import { useTranslations } from '../i18n/ui';

const t = useTranslations('es');
---

<Layout lang="es" title={t('meta.title')} description={t('meta.description')}>
  <main>
    <HeroSection lang="es" />
    <BeltsSection lang="es" />
    <Placeholders lang="es" />
  </main>
</Layout>
