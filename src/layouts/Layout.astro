---
import QRCode from 'qrcode';
import '../styles/global.css';
import '@fontsource/source-serif-4/300.css';
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/source-serif-4/700.css';
import '@fontsource/hanken-grotesk/300.css';
import '@fontsource/hanken-grotesk/400.css';
import '@fontsource/hanken-grotesk/600.css';
import '@fontsource/hanken-grotesk/700.css';
import '@fontsource/hanken-grotesk/800.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/noto-sans-kr/400.css';
import '@fontsource/noto-sans-kr/700.css';
import 'lenis/dist/lenis.css';
import type { Lang } from '../i18n/ui';
import { languages, useTranslations } from '../i18n/ui';
import { CV_URL } from '../data/contact';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
}

const { title, description, lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const siteUrl = (Astro.site ?? new URL('https://juanpuccio.vercel.app')).toString().replace(/\/$/, '');
const localePaths: Record<Lang, string> = { es: '/', en: '/en/', pt: '/pt/' };
const ogLocales: Record<Lang, string> = { es: 'es_AR', en: 'en_US', pt: 'pt_BR' };
const canonicalUrl = siteUrl + localePaths[lang];
const qrSvg = await QRCode.toString(canonicalUrl, {
  type: 'svg',
  margin: 2,
  errorCorrectionLevel: 'M',
  color: { dark: '#1c1a17', light: '#ffffff' },
});
const qrDownloadHref = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(qrSvg);
const qrText = {
  es: { btn: 'Mostrar código QR', title: 'Escaneá para abrir el portfolio', download: 'Descargar QR', close: 'Cerrar' },
  en: { btn: 'Show QR code', title: 'Scan to open the portfolio', download: 'Download QR', close: 'Close' },
  pt: { btn: 'Mostrar código QR', title: 'Escaneie para abrir o portfólio', download: 'Baixar QR', close: 'Fechar' },
}[lang];
const ogImageUrl = siteUrl + '/og/og-juan-puccio.png';
const ogImageAlt = 'JMP Portfolio, Juan Manuel Puccio';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocales[lang]} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <link rel="canonical" href={canonicalUrl} />
    {Object.keys(localePaths).map((code) => (
      <link rel="alternate" hreflang={code} href={siteUrl + localePaths[code as Lang]} />
    ))}
    <link rel="alternate" hreflang="x-default" href={siteUrl + localePaths.es} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Reveal-on-scroll gate: added early so [data-reveal] only starts
         hidden once JS is confirmed running, preventing any no-JS flash. -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('js-reveal');
      }
    </script>

  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href={lang === 'es' ? '#top' : `/${lang}#top`} class="brand-title" aria-label="Juan Manuel Puccio">
          <span class="brand-name">Juan Manuel Puccio</span>
          <span class="brand-initials" aria-hidden="true">JMP</span>
          <span class="brand-role" aria-hidden="true">{t('header.role')}</span>
        </a>

        <!-- 6 Nav Ticks correspondientes a los 6 capítulos marciales (Claude Design) -->
        <nav class="header-ticks" id="header-ticks" aria-label="Capítulos del portfolio">
          <a href="#blanco" title="Blanco · 10º gup" class="tick-link is-active" data-belt="blanco" style="--tick-color: #ffffff;"></a>
          <a href="#amarillo" title="Amarillo · 9º — 8º gup" class="tick-link" data-belt="amarillo" style="--tick-color: #fbbf24;"></a>
          <a href="#verde" title="Verde · 7º — 6º gup" class="tick-link" data-belt="verde" style="--tick-color: #10b981;"></a>
          <a href="#azul" title="Azul · 5º — 4º gup" class="tick-link" data-belt="azul" style="--tick-color: #0284c7;"></a>
          <a href="#rojo" title="Rojo · 3º — 1º gup" class="tick-link" data-belt="rojo" style="--tick-color: #ef4444;"></a>
          <a href="#negro" title="Negro · 1º dan" class="tick-link" data-belt="negro" style="--tick-color: #1c1a17;"></a>
        </nav>

        <div class="header-right-group">
          <!-- Indicador dinámico del capítulo activo -->
          <div class="header-active-ch" id="header-active-ch" aria-live="polite">
            10º GUP · INICIO
          </div>

          <!-- Typographic language switch -->
          <div class="lang-switch-minimal" role="group" aria-label={t('header.lang')}>
            {Object.entries(languages).map(([code]) => {
              const targetPath = code === 'es' ? '/' : `/${code}`;
              const isActive = code === lang;
              return (
                <a
                  href={targetPath}
                  hreflang={code}
                  lang={code}
                  aria-current={isActive ? 'page' : undefined}
                  class:list={['lang-min-link', { active: isActive }]}
                >
                  {code.toUpperCase()}
                </a>
              );
            })}
          </div>

          <!-- Contactar enlace rápido -->
          <a href="#contacto" class="header-contact-link">
            {lang === 'es' ? 'Contactar' : lang === 'en' ? 'Contact' : 'Contato'}
          </a>

          <!-- Código QR -->
          <button type="button" class="header-qr-btn" id="qr-open" aria-label={qrText.btn} title={qrText.btn}>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" />
              <path d="M14 14h3v3h-3zM20 14v3M14 20h3M20 20h1" />
            </svg>
            <span class="qr-label">QR</span>
          </button>

          <!-- Descargar CV -->
          <a href={CV_URL} target="_blank" rel="noopener noreferrer" class="header-cv-btn">
            <span class="cv-long">{t('hero.btn.cv')}</span>
            <span class="cv-short" aria-hidden="true">CV</span>
          </a>
        </div>
      </div>
      <!-- Barra de progreso global del scroll -->
      <div class="header-scroll-progress" id="header-scroll-progress"></div>
    </header>

    <dialog class="qr-dialog" id="qr-dialog" aria-labelledby="qr-title">
      <p class="qr-title" id="qr-title">{qrText.title}</p>
      <div class="qr-box" set:html={qrSvg} />
      <p class="qr-url">{canonicalUrl}</p>
      <div class="qr-actions">
        <a class="qr-download" href={qrDownloadHref} download="qr-juan-puccio.svg">{qrText.download}</a>
        <button type="button" class="qr-close" id="qr-close">{qrText.close}</button>
      </div>
    </dialog>

    <main>
      <slot />
    </main>

    <script>
      const qrDialog = document.getElementById('qr-dialog') as HTMLDialogElement | null;
      document.getElementById('qr-open')?.addEventListener('click', () => qrDialog?.showModal());
      document.getElementById('qr-close')?.addEventListener('click', () => qrDialog?.close());
      qrDialog?.addEventListener('click', (e) => { if (e.target === qrDialog) qrDialog.close(); });
    </script>

    <script>
      // Keep the current #hash when switching language.
      document.querySelectorAll<HTMLAnchorElement>('.lang-min-link').forEach((link) => {
        link.addEventListener('click', () => {
          if (location.hash) {
            const base = link.getAttribute('href')?.split('#')[0] ?? '';
            link.setAttribute('href', base + location.hash);
          }
        });
      });
    </script>

    <!-- Reveal-on-scroll: adds .is-revealed once per element, then stops
         observing. No-op when js-reveal was never enabled (see head script). -->
    <script>
      if (document.documentElement.classList.contains('js-reveal')) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        document
          .querySelectorAll('[data-reveal]:not([data-reveal="load"])')
          .forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<script>
  import Lenis from 'lenis';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Header progress bar: scaleX on a full-width bar (compositor-friendly).
  const progressBar = document.getElementById('header-scroll-progress');
  let progressQueued = false;

  function updateHeaderProgress() {
    progressQueued = false;
    if (!progressBar) return;
    const doc = document.documentElement;
    const total = Math.max(1, doc.scrollHeight - window.innerHeight);
    const progress = Math.min(1, Math.max(0, window.scrollY / total));
    progressBar.style.transform = `scaleX(${progress.toFixed(4)})`;
  }

  // Coalesce scroll/resize bursts into at most one update per frame.
  function scheduleHeaderProgress() {
    if (progressQueued) return;
    progressQueued = true;
    requestAnimationFrame(updateHeaderProgress);
  }

  const siteHeader = document.querySelector<HTMLElement>('.site-header');
  const activeChLabel = document.getElementById('header-active-ch');
  const tickLinks = document.querySelectorAll<HTMLAnchorElement>('.tick-link');

  const BELT_ORDER = ['blanco', 'amarillo', 'verde', 'azul', 'rojo', 'negro'];
  const BELT_LABELS: Record<string, string> = {
    blanco: '10º GUP · CIMIENTOS',
    amarillo: '9º — 8º GUP · TRINCHERA COMERCIAL',
    verde: '7º — 6º GUP · EL ESTADO',
    azul: '5º — 4º GUP · RECONVERSIÓN',
    rojo: '3º — 1º GUP · LA FRICCIÓN',
    negro: '1º DAN · PRODUCCIÓN',
  };

  function updateActiveBelt(beltKey: string) {
    if (!beltKey) return;
    const key = beltKey.toLowerCase();
    const idx = BELT_ORDER.indexOf(key);

    tickLinks.forEach((tick, i) => {
      if (i === idx) {
        tick.classList.add('is-active');
        tick.classList.remove('is-passed');
      } else if (i < idx) {
        tick.classList.remove('is-active');
        tick.classList.add('is-passed');
      } else {
        tick.classList.remove('is-active', 'is-passed');
      }
    });

    if (activeChLabel && BELT_LABELS[key]) {
      activeChLabel.textContent = BELT_LABELS[key];
    }

    if (key === 'negro') {
      siteHeader?.classList.add('is-dark');
    } else {
      siteHeader?.classList.remove('is-dark');
    }
  }

  function syncHeaderBeltColor(event: Event) {
    const detail = (event as CustomEvent<{ color?: string; stageKey?: string; beltKey?: string }>).detail;
    if (detail?.beltKey) {
      updateActiveBelt(detail.beltKey);
    } else if (detail?.color) {
      const colorMap: Record<string, string> = {
        '#ffffff': 'blanco',
        '#ece8df': 'blanco',
        '#fbbf24': 'amarillo',
        '#10b981': 'verde',
        '#0284c7': 'azul',
        '#ef4444': 'rojo',
        '#1c1a17': 'negro',
      };
      const found = colorMap[detail.color.toLowerCase()];
      if (found) updateActiveBelt(found);
    }
  }

  // ---------------------------------------------------------------------------
  // Header quick-selector (T3): a same-document link whose target reveals through
  // a scroll-driven curtain must land on the REVEALED frame, not on the raw hash
  // position (which sits at --p ≈ 0 behind an un-animated curtain).
  //
  // Contract (MartialExperienceTimeline): the driver computes
  //   p = (scrollY - curtainTopDoc) / (curtain.offsetHeight - window.innerHeight)
  // so the scroll position where the reveal reads complete is
  //   curtainTopDoc + fraction * (curtain.offsetHeight - window.innerHeight).
  // ---------------------------------------------------------------------------
  type LenisWindow = Window & { __lenis?: Lenis };

  interface NavTarget {
    node: HTMLElement;
    fraction: number;
  }

  // Elements without a data-nav-target curtain declare their own reveal point.
  // #contacto: ContactSection fades in with opacity = clamp((p - 0.15) * 3),
  // fully open at p ≈ 0.48, so aim slightly past it.
  const REVEAL_FRACTIONS: Record<string, number> = { contacto: 0.55 };

  function readLenis(): Lenis | undefined {
    return (window as LenisWindow).__lenis;
  }

  // Mobile (<=767px) swaps the desktop tree for the immersive scenes
  // (MobileImmersive.astro), which carry their own `m-*` ids. Same breakpoint as
  // the CSS swap in HomePage.astro; desktop resolution below is untouched.
  const mobileNav = window.matchMedia('(max-width: 767px)');
  const MOBILE_NAV_IDS: Record<string, string> = {
    top: 'm-top',
    proyectos: 'm-proyectos',
    trayectoria: 'm-trayectoria',
    contacto: 'm-contacto',
  };
  // Landing point of each mobile scene as a fraction of its pinned span: first
  // card / first scene frame, and the contact title fully risen.
  const MOBILE_REVEAL_FRACTIONS: Record<string, number> = { top: 0, proyectos: 0, trayectoria: 0, contacto: 0.5 };

  /** Mobile resolution: the header belt ticks (#blanco...#negro) land on the
   *  belts scene row they represent; the other owned anchors land on their scene. */
  function resolveMobileNavTarget(id: string): NavTarget | null {
    const beltIndex = BELT_ORDER.indexOf(id);
    const sceneId = beltIndex >= 0 ? 'trayectoria' : id;
    const mobileId = MOBILE_NAV_IDS[sceneId];
    const node = mobileId ? document.getElementById(mobileId) : null;
    if (!node) return null;
    if (beltIndex < 0) return { node, fraction: MOBILE_REVEAL_FRACTIONS[sceneId] ?? 0 };
    // Scene progress p maps to scroll as top + p * (height - 2vh); the shared
    // formula uses (height - 1vh), so rescale. Row i is fully drawn at p = (i + 1) / 6.5.
    const ih = window.innerHeight;
    const pinned = node.offsetHeight - ih;
    const p = Math.min(1, (beltIndex + 0.95) / 6.5);
    return { node, fraction: pinned > 0 ? (p * (node.offsetHeight - ih * 2)) / pinned : 0 };
  }

  /** Resolves a `#hash` to the reveal-driven element plus the fraction of its
   *  scroll range where the content is fully revealed. Returns null for anchors
   *  we do not own, so those keep Lenis's default anchor behavior. */
  function resolveNavTarget(hash: string): NavTarget | null {
    if (!hash.startsWith('#') || hash.length < 2) return null;
    if (mobileNav.matches) {
      const mobileTarget = resolveMobileNavTarget(hash.slice(1));
      if (mobileTarget) return mobileTarget;
    }
    const section = document.getElementById(hash.slice(1));
    if (!section) return null;
    const curtain = section.matches('[data-nav-target]')
      ? section
      : section.querySelector<HTMLElement>('[data-nav-target]');
    if (curtain) {
      const fraction = Number.parseFloat(curtain.dataset.navTarget ?? '');
      if (Number.isFinite(fraction)) return { node: curtain, fraction };
    }
    const fallback = REVEAL_FRACTIONS[section.id];
    if (fallback !== undefined) return { node: section, fraction: fallback };
    return null;
  }

  /** Document-space scroll position where `target`'s reveal is complete. */
  function navTargetScrollY(target: NavTarget): number {
    const top = target.node.getBoundingClientRect().top + window.scrollY;
    const range = Math.max(0, target.node.offsetHeight - window.innerHeight);
    return top + target.fraction * range;
  }

  /** Scrolls to `target`: Lenis when present (smooth), instant native fallback
   *  when it is absent (prefers-reduced-motion never creates Lenis). */
  function scrollToNavTarget(target: NavTarget): void {
    const y = navTargetScrollY(target);
    const lenis = readLenis();
    if (lenis) lenis.scrollTo(y, { immediate: false, duration: 1 });
    else window.scrollTo({ top: y, behavior: 'auto' });
  }

  // Own the reveal-gated links at the document level: Lenis listens for clicks on
  // window (bubble phase) and ignores defaultPrevented, so propagation has to stop
  // here or it would re-scroll to the raw hash and stack scroll-padding-top with
  // anchors.offset. Anchors outside this set (e.g. #top) keep Lenis's defaults.
  document.addEventListener('click', (event) => {
    if (
      event.defaultPrevented ||
      event.button !== 0 ||
      event.metaKey ||
      event.ctrlKey ||
      event.shiftKey ||
      event.altKey
    ) {
      return;
    }
    const anchor =
      event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href^="#"]') : null;
    const href = anchor?.getAttribute('href');
    const target = href ? resolveNavTarget(href) : null;
    if (!href || !target) return;
    event.preventDefault();
    event.stopPropagation();
    // Keep the deep link shareable; the language switch carries it over too.
    history.replaceState(null, '', `${location.pathname}${location.search}${href}`);
    scrollToNavTarget(target);
  });

  // Deep-link parity: on load the browser jumps natively to the raw hash (minus
  // scroll-padding-top), so a chapter opens at --p ≈ 0. Re-align once the page has
  // settled; reduced motion resolves to an instant jump inside scrollToNavTarget.
  function alignHashToReveal(): void {
    const target = resolveNavTarget(location.hash);
    if (target) scrollToNavTarget(target);
  }

  if (document.readyState === 'complete') {
    requestAnimationFrame(alignHashToReveal);
  } else {
    window.addEventListener('load', () => requestAnimationFrame(alignHashToReveal), { once: true });
  }

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // Lenis is driven by the GSAP ticker so smooth scroll and ScrollTrigger share one rAF.
    const lenis = new Lenis({
      // T4 feel tuning — validate in-browser, ranges are the agreed knobs:
      //   wheelMultiplier: travel produced by one wheel notch (Lenis default 1).
      //                    1.2–2.0; higher = less "kicking the wheel" per chapter.
      //   duration:        how fast the page settles onto the wheel target.
      //                    0.7–1.0; lower = snappier, higher = floatier.
      // lerp is deliberately absent: Lenis's Animate picks duration+easing over
      // lerp whenever both are set, so a lerp here would be dead config.
      duration: 0.9,
      wheelMultiplier: 1.5,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true,
      autoRaf: false,
      // Lenis subtracts scroll-padding-top (global.css: 5rem) AND this offset when
      // it resolves an anchor, so a negative offset stacked a second 80px on top of
      // the native one. 0 keeps anchors aligned with a plain fragment jump: 80px
      // below the viewport top, clear of the 60px fixed header.
      anchors: { offset: 0 },
      // Nested scrollers ([data-nested-scroll]) only get the gesture when their
      // overflow matches the gesture AXIS: vertical wheel over a horizontal-only
      // container (e.g. the architecture pipeline at desktop widths) stays on the
      // smoothed page, touchpad/shift horizontal over it goes native, and a mobile
      // project card still scrolls its own vertical overflow. Replaces prevent,
      // which was axis-blind and turned the whole dark tail into unsmoothed scroll.
      virtualScroll: ({ deltaX, deltaY, event }) => {
        const target = event.target;
        const el = target instanceof Element ? target.closest<HTMLElement>('[data-nested-scroll]') : null;
        if (!el) return true;
        const isVertical = Math.abs(deltaY) >= Math.abs(deltaX);
        if (isVertical) return el.scrollHeight <= el.clientHeight + 1;
        return el.scrollWidth <= el.clientWidth + 1;
      },
    });

    (window as LenisWindow).__lenis = lenis;

    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((time) => lenis.raf(time * 1000));
    gsap.ticker.lagSmoothing(0);
  }

  window.addEventListener('belt:change', syncHeaderBeltColor);
  window.addEventListener('scroll', scheduleHeaderProgress, { passive: true });
  window.addEventListener('resize', scheduleHeaderProgress);
  updateHeaderProgress();
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: 60px;
    background: #f2eee6;
    border-bottom: 1px solid rgba(28, 26, 23, 0.18);
    padding: 0 clamp(20px, 5vw, 72px);
    transition: background 0.5s, color 0.5s, border-color 0.5s;
  }

  .site-header.is-dark {
    background: rgba(28, 26, 23, 0.88);
    border-bottom: 1px solid rgba(242, 238, 230, 0.14);
    backdrop-filter: blur(10px);
  }

  .site-header.is-dark .brand-name,
  .site-header.is-dark .brand-initials,
  .site-header.is-dark .header-contact-link,
  .site-header.is-dark .lang-min-link {
    color: #f2eee6;
  }

  .site-header.is-dark .header-active-ch,
  .site-header.is-dark .brand-role {
    color: #c9c3b7;
  }

  .site-header.is-dark .tick-link {
    border-color: #f2eee6;
  }

  .site-header.is-dark .header-cv-btn {
    background: #f2eee6;
    color: #1c1a17;
  }

  .header-ticks {
    display: flex;
    gap: 5px;
    align-items: center;
  }

  .tick-link {
    display: block;
    height: 8px;
    width: 14px;
    background: var(--tick-color);
    border: 1px solid #1c1a17;
    opacity: 0.35;
    transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s, border-color 0.4s;
  }

  .tick-link.is-active {
    width: 34px;
    opacity: 1;
  }

  .tick-link.is-passed {
    opacity: 1;
  }

  .header-active-ch {
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4a463f;
    transition: color 0.4s;
  }

  .header-contact-link {
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1c1a17;
    text-decoration: none;
    transition: color 0.4s;
  }

  .header-qr-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 8px;
    background: none;
    border: 1px solid rgba(28, 26, 23, 0.25);
    color: #1c1a17;
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: color 0.3s, border-color 0.3s;
  }

  .header-qr-btn:hover {
    color: #0369a1;
    border-color: #0369a1;
  }

  @media (max-width: 640px) {
    .qr-label { display: none; }
  }

