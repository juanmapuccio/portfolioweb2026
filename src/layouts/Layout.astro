---
import '../styles/global.css';
import type { Lang } from '../i18n/ui';
import { languages } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
}

const { title, description, lang = 'es' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google Fonts: Plus Jakarta Sans (Display) & Inter (Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet" />

    <!-- Script inline: Claro por defecto absoluto a menos que el usuario haya elegido 'dark' explícitamente -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      } else {
        document.documentElement.removeAttribute('data-theme');
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href={lang === 'es' ? '/' : `/${lang}`} class="brand" aria-label="Inicio">
          <span class="brand-avatar">JP</span>
          <div class="brand-text">
            <span class="brand-name">Juan Manuel Puccio</span>
            <span class="brand-sub">Full Stack & Consultor IT</span>
          </div>
        </a>

        <!-- Navegación con Smooth Scroll hacia anclas de la página -->
        <nav class="main-nav">
          <a href="#proyectos" class="nav-item">
            {lang === 'es' ? 'Proyectos' : lang === 'en' ? 'Projects' : 'Projetos'}
          </a>
          <a href="#trayectoria" class="nav-item">
            {lang === 'es' ? 'Trayectoria' : lang === 'en' ? 'Experience' : 'Trajetória'}
          </a>
          <a href="#stack-filosofia" class="nav-item">
            {lang === 'es' ? 'Stack & Filosofía' : lang === 'en' ? 'Stack & Mindset' : 'Stack & Filosofia'}
          </a>
          <a href="#contacto" class="nav-item">
            {lang === 'es' ? 'Contacto' : lang === 'en' ? 'Contact' : 'Contato'}
          </a>
          <a href="/CV-Juan-Manuel-Puccio-2026-1.pdf" target="_blank" class="nav-item nav-cv">
            CV 📄
          </a>
        </nav>

        <div class="header-controls">
          <!-- Toggle EyeCare (Claro Orgánico / Oscuro Suave) -->
          <button id="theme-toggle" class="theme-toggle-btn" aria-label="Alternar modo claro / oscuro">
            <span class="theme-icon light-icon" title="Modo Claro">☀️</span>
            <span class="theme-icon dark-icon" title="Modo Oscuro EyeCare">🌙</span>
          </button>

          <!-- Selector de idioma -->
          <div class="lang-switch">
            {Object.entries(languages).map(([code, label]) => {
              const targetPath = code === 'es' ? '/' : `/${code}`;
              const isActive = code === lang;
              return (
                <a 
                  href={targetPath} 
                  class:list={['lang-link', { active: isActive }]}
                  aria-label={`Cambiar a ${label}`}
                >
                  {code.toUpperCase()}
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>© 2026 Juan Manuel Puccio · Desarrollador Full Stack & Fundador de NodoSur</p>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        if (isDark) {
          document.documentElement.removeAttribute('data-theme');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.setAttribute('data-theme', 'dark');
          localStorage.setItem('theme', 'dark');
        }
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(14px);
    background-color: color-mix(in srgb, var(--bg-primary) 85%, transparent);
    border-bottom: 1px solid var(--border-subtle);
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 4rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .brand-avatar {
    width: 2.2rem;
    height: 2.2rem;
    border-radius: var(--radius-sm);
    background: linear-gradient(135deg, var(--accent-cyan), var(--accent-blue));
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 0.85rem;
    font-weight: 800;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--accent-cyan) 30%, transparent);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-name {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.01em;
  }

  .brand-sub {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--text-dim);
  }

  /* Nav Links con Smooth Scroll */
  .main-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-item {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    padding: 0.3rem 0.5rem;
    border-radius: var(--radius-sm);
    transition: all var(--transition);
  }

  .nav-item:hover {
    color: var(--accent-cyan);
    background: var(--bg-surface-elevated);
  }

  .nav-cv {
    color: var(--accent-cyan);
    background: color-mix(in srgb, var(--accent-cyan) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-cyan) 20%, transparent);
    padding: 0.25rem 0.65rem;
  }

  .nav-cv:hover {
    background: color-mix(in srgb, var(--accent-cyan) 20%, transparent);
    color: var(--text-main);
  }

  .header-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .theme-toggle-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-main);
    font-size: 1rem;
    transition: all var(--transition);
  }

  .theme-toggle-btn:hover {
    background: var(--bg-surface-elevated);
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }

  /* Control de iconos sol/luna según data-theme */
  :global(html:not([data-theme='dark'])) .dark-icon {
    display: none;
  }
  :global(html[data-theme='dark']) .light-icon {
    display: none;
  }

  .lang-switch {
    display: flex;
    gap: 0.2rem;
    background: var(--bg-surface);
    padding: 0.2rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .lang-link {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
  }

  .lang-link:hover {
    color: var(--text-main);
  }

  .lang-link.active {
    background: var(--bg-surface-elevated);
    color: var(--accent-cyan);
    border: 1px solid var(--border-subtle);
  }

  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--border-subtle);
    padding: 2.5rem 0;
    text-align: center;
    font-size: 0.875rem;
    color: var(--text-dim);
  }

  @media (max-width: 768px) {
    .main-nav {
      display: none;
    }
    .brand-sub {
      display: none;
    }
  }
</style>
