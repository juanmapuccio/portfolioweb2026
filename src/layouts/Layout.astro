---
import '../styles/global.css';
import type { Lang } from '../i18n/ui';
import { languages } from '../i18n/ui';
import { CV_URL } from '../data/contact';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
}

const { title, description, lang = 'es' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google Fonts: Source Serif 4, Hanken Grotesk, IBM Plex Mono (Claude Design Aesthetic) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,300..700;1,300..700&family=IBM+Plex+Mono:ital,wght@0,400;0,600;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,300..700;1,8..60,300..700&display=swap" rel="stylesheet" />

    <!-- Script inline: Claro por defecto absoluto a menos que el usuario haya elegido 'dark' explícitamente -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      } else {
        document.documentElement.removeAttribute('data-theme');
      }
    </script>

    <!-- Reveal-on-scroll gate: added early so [data-reveal] only starts
         hidden once JS is confirmed running, preventing any no-JS flash. -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('js-reveal');
      }
    </script>

  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href={lang === 'es' ? '#top' : `/${lang}#top`} class="brand-title">
          Juan Manuel Puccio
        </a>

        <div class="header-right-group">
          <!-- Indicador dinámico de grado marcial actual -->
          <div class="header-grade-pill">
            <span class="header-belt-swatch" id="header-belt-indicator"></span>
            <span class="header-gup-text" id="header-gup-indicator">10º gup</span>
          </div>

          <!-- Selector de idioma compacto -->
          <div class="lang-switch-minimal">
            {Object.entries(languages).map(([code]) => {
              const targetPath = code === 'es' ? '/' : `/${code}`;
              const isActive = code === lang;
              return (
                <a 
                  href={targetPath} 
                  class:list={['lang-min-link', { active: isActive }]}
                >
                  {code.toUpperCase()}
                </a>
              );
            })}
          </div>

          <!-- Descargar CV -->
          <a href={CV_URL} target="_blank" rel="noopener noreferrer" class="header-cv-btn">
            {lang === 'es' ? 'Descargar CV' : lang === 'en' ? 'Download CV' : 'Baixar CV'}
          </a>
        </div>
      </div>
      <!-- Barra de progreso global del scroll -->
      <div class="header-scroll-progress" id="header-scroll-progress"></div>
    </header>

    <main>
      <slot />
    </main>

    <script>
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        if (isDark) {
          document.documentElement.removeAttribute('data-theme');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.setAttribute('data-theme', 'dark');
          localStorage.setItem('theme', 'dark');
        }
      });
    </script>

    <!-- Reveal-on-scroll: adds .is-revealed once per element, then stops
         observing. No-op when js-reveal was never enabled (see head script). -->
    <script>
      if (document.documentElement.classList.contains('js-reveal')) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        document
          .querySelectorAll('[data-reveal]:not([data-reveal="load"])')
          .forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<script>
  // Actualización dinámica de la barra de progreso del header y color de cinturón
  function updateHeaderProgress() {
    const progressBar = document.getElementById('header-scroll-progress');
    if (!progressBar) return;
    const doc = document.documentElement;
    const total = Math.max(1, doc.scrollHeight - window.innerHeight);
    const progress = Math.min(1, Math.max(0, window.scrollY / total));
    progressBar.style.width = `${progress * 100}%`;
  }

  window.addEventListener('scroll', updateHeaderProgress, { passive: true });
  window.addEventListener('resize', updateHeaderProgress);
  updateHeaderProgress();
</script>

<style>

  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: 60px;
    background: rgba(242, 238, 230, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(28, 26, 23, 0.12);
    padding: 0 clamp(20px, 5vw, 72px);
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 100%;
    width: 100%;
    max-width: 100%;
  }

  .brand-title {
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-size: 19px;
    letter-spacing: -0.01em;
    color: #1c1a17;
    text-decoration: none;
    font-weight: 400;
    transition: opacity 0.2s;
  }

  .brand-title:hover {
    opacity: 0.7;
  }

  .header-right-group {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2.5vw, 24px);
  }

  .header-grade-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #4a463f;
  }

  .header-belt-swatch {
    width: 18px;
    height: 8px;
    border: 1px solid rgba(28, 26, 23, 0.35);
    background: #f8f6f0;
    transition: background 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .lang-switch-minimal {
    display: flex;
    gap: 8px;
  }

  .lang-min-link {
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: #7a746a;
    text-decoration: none;
    padding: 2px 4px;
    transition: color 0.2s;
  }

  .lang-min-link.active {
    color: #1c1a17;
    font-weight: 700;
    border-bottom: 1px solid #1c1a17;
  }

  .header-cv-btn {
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: #1c1a17;
    color: #f2eee6;
    padding: 10px 14px;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
  }

  .header-cv-btn:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  .header-scroll-progress {
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 3px;
    width: 0%;
    background: #bdb4a4;
    transition: background 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .theme-toggle-btn:hover {
    background: var(--bg-surface-elevated);
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }

  /* Control de iconos sol/luna según data-theme */
  :global(html:not([data-theme='dark'])) .dark-icon {
    display: none;
  }
  :global(html[data-theme='dark']) .light-icon {
    display: none;
  }

  .lang-switch {
    display: flex;
    gap: 0.2rem;
    background: var(--bg-surface);
    padding: 0.2rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .lang-link {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
  }

  .lang-link:hover {
    color: var(--text-main);
  }

  .lang-link.active {
    background: var(--accent-amber);
    color: #12161c;
    border: 1px solid var(--accent-amber);
    font-family: var(--font-mono);
  }

  @media (max-width: 768px) {
    .main-nav {
      display: none;
    }
    .brand-sub {
      display: none;
    }
  }
</style>
