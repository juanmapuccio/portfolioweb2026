---
import '../styles/global.css';
import type { Lang } from '../i18n/ui';
import { languages, useTranslations } from '../i18n/ui';
import { CV_URL } from '../data/contact';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
}

const { title, description, lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const siteUrl = (Astro.site ?? new URL('https://juanpuccio.vercel.app')).toString().replace(/\/$/, '');
const localePaths: Record<Lang, string> = { es: '/', en: '/en/', pt: '/pt/' };
const ogLocales: Record<Lang, string> = { es: 'es_AR', en: 'en_US', pt: 'pt_BR' };
const canonicalUrl = siteUrl + localePaths[lang];
const ogImageUrl = siteUrl + '/og/og-juan-puccio.png';
const ogImageAlt = 'JMP Portfolio, Juan Manuel Puccio';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocales[lang]} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <link rel="canonical" href={canonicalUrl} />
    {Object.keys(localePaths).map((code) => (
      <link rel="alternate" hreflang={code} href={siteUrl + localePaths[code as Lang]} />
    ))}
    <link rel="alternate" hreflang="x-default" href={siteUrl + localePaths.es} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Google Fonts: Source Serif 4, Hanken Grotesk, IBM Plex Mono, Noto Sans KR for hangul (Claude Design Aesthetic) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,300..700;1,300..700&family=IBM+Plex+Mono:ital,wght@0,400;0,600;1,400&family=Noto+Sans+KR:wght@400;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,300..700;1,8..60,300..700&display=swap" rel="stylesheet" />

    <!-- Reveal-on-scroll gate: added early so [data-reveal] only starts
         hidden once JS is confirmed running, preventing any no-JS flash. -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('js-reveal');
      }
    </script>

  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href={lang === 'es' ? '#top' : `/${lang}#top`} class="brand-title" aria-label="Juan Manuel Puccio">
          <span class="brand-name">Juan Manuel Puccio</span>
          <span class="brand-initials" aria-hidden="true">JMP</span>
          <span class="brand-role" aria-hidden="true">{t('header.role')}</span>
        </a>

        <div class="header-right-group">
          <!-- Current martial grade, updated by the trajectory timeline script -->
          <div class="header-grade-pill">
            <span class="header-grade-label">{t('header.grade')}</span>
            <span class="header-belt-swatch" id="header-belt-indicator"></span>
            <span class="header-gup-text" id="header-gup-indicator">10º<span class="header-gup-word"> gup</span></span>
          </div>

          <!-- Typographic language switch -->
          <div class="lang-switch-minimal" role="group" aria-label={t('header.lang')}>
            {Object.entries(languages).map(([code]) => {
              const targetPath = code === 'es' ? '/' : `/${code}`;
              const isActive = code === lang;
              return (
                <a
                  href={targetPath}
                  hreflang={code}
                  lang={code}
                  aria-current={isActive ? 'page' : undefined}
                  class:list={['lang-min-link', { active: isActive }]}
                >
                  {code.toUpperCase()}
                </a>
              );
            })}
          </div>

          <!-- Descargar CV -->
          <a href={CV_URL} target="_blank" rel="noopener noreferrer" class="header-cv-btn">
            <span class="cv-long">{t('hero.btn.cv')}</span>
            <span class="cv-short" aria-hidden="true">CV</span>
          </a>
        </div>
      </div>
      <!-- Barra de progreso global del scroll -->
      <div class="header-scroll-progress" id="header-scroll-progress"></div>
    </header>

    <main>
      <slot />
    </main>

    <script>
      // Keep the current #hash when switching language.
      document.querySelectorAll<HTMLAnchorElement>('.lang-min-link').forEach((link) => {
        link.addEventListener('click', () => {
          if (location.hash) {
            const base = link.getAttribute('href')?.split('#')[0] ?? '';
            link.setAttribute('href', base + location.hash);
          }
        });
      });
    </script>

    <!-- Reveal-on-scroll: adds .is-revealed once per element, then stops
         observing. No-op when js-reveal was never enabled (see head script). -->
    <script>
      if (document.documentElement.classList.contains('js-reveal')) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        document
          .querySelectorAll('[data-reveal]:not([data-reveal="load"])')
          .forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<script>
  // Actualización dinámica de la barra de progreso del header y color de cinturón
  function updateHeaderProgress() {
    const progressBar = document.getElementById('header-scroll-progress');
    if (!progressBar) return;
    const doc = document.documentElement;
    const total = Math.max(1, doc.scrollHeight - window.innerHeight);
    const progress = Math.min(1, Math.max(0, window.scrollY / total));
    progressBar.style.width = `${progress * 100}%`;
  }

  window.addEventListener('scroll', updateHeaderProgress, { passive: true });
  window.addEventListener('resize', updateHeaderProgress);
  updateHeaderProgress();
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: 60px;
    background: #f2eee6;
    border-bottom: 1px solid rgba(28, 26, 23, 0.22);
    padding: 0 clamp(20px, 5vw, 72px);
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 100%;
    width: 100%;
  }

  /* Wordmark: serif name over a quiet mono descriptor. */
  .brand-title {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 3px;
    color: #1c1a17;
    text-decoration: none;
    min-height: 44px;
  }

  .brand-name {
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-size: 19px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: 0.01em;
    font-variant-caps: small-caps;
    font-feature-settings: 'smcp' 1, 'c2sc' 0;
  }

  .brand-role {
    font-family: var(--font-mono, monospace);
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #6a645a;
  }

  .brand-initials {
    display: none;
    font-family: var(--font-serif, 'Source Serif 4', serif);
    font-size: 19px;
    font-weight: 500;
    letter-spacing: 0.14em;
  }

  .brand-title:hover .brand-name,
  .brand-title:hover .brand-initials {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  .brand-title:focus-visible,
  .lang-min-link:focus-visible,
  .header-cv-btn:focus-visible {
    outline: 2px solid #1c1a17;
    outline-offset: 3px;
  }

  .header-right-group {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.5vw, 28px);
  }

  /* Grade: mono label, slim belt-colour tick, grade number. */
  .header-grade-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #4a463f;
  }

  .header-grade-label {
    color: #6a645a;
  }

  .header-belt-swatch {
    width: 18px;
    height: 5px;
    border: 1px solid rgba(28, 26, 23, 0.4);
    background: #f8f6f0;
    transition: background 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .header-gup-text {
    white-space: nowrap;
    color: #1c1a17;
  }

  /* Language: "ES · EN · PT", active one underlined. */
  .lang-switch-minimal {
    display: flex;
    align-items: center;
  }

  .lang-min-link {
    position: relative;
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: #6a645a;
    text-decoration: none;
    padding: 2px 7px;
    transition: color 0.2s;
  }

  .lang-min-link + .lang-min-link::before {
    content: '·' / '';
    position: absolute;
    left: -2px;
    color: #6a645a;
  }

  .lang-min-link:hover {
    color: #1c1a17;
  }

  .lang-min-link.active {
    color: #1c1a17;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  /* CV: outlined rectangle, inverts on hover. */
  .header-cv-btn {
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #1c1a17;
    background: transparent;
    border: 1px solid #1c1a17;
    padding: 9px 14px;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }

  .header-cv-btn:hover {
    background: #1c1a17;
    color: #f2eee6;
  }

  .cv-short {
    display: none;
  }

  .header-scroll-progress {
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 3px;
    width: 0%;
    background: #bdb4a4;
    transition: background 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @media (max-width: 1023px) {
    .header-grade-label {
      display: none;
    }
  }

  /* Mobile: initials wordmark, grade number + tick, ES EN PT, short CV. */
  @media (max-width: 767px) {
    .site-header {
      padding: 0 16px;
    }
    .header-right-group {
      gap: 8px;
    }
    .header-grade-pill {
      gap: 6px;
    }
    .header-gup-text :global(.header-gup-word) {
      display: none;
    }
    .lang-min-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 32px;
      min-height: 44px;
      padding: 0 4px;
    }
    .lang-min-link + .lang-min-link::before {
      left: -3px;
    }
    .header-cv-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 44px;
      min-height: 44px;
      padding: 0 10px;
    }
    .cv-long {
      display: none;
    }
    .cv-short {
      display: inline;
    }
  }

  @media (max-width: 640px) {
    .brand-name,
    .brand-role {
      display: none;
    }
    .brand-initials {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-scroll-progress,
    .header-belt-swatch,
    .lang-min-link,
    .header-cv-btn {
      transition: none;
    }
  }
</style>
