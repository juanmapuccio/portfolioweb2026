---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/atkinson-hyperlegible-next/wght.css';
import '../styles/tul/tokens.css';
import '../styles/tul/base.css';
import TulHeader from '../components/tul/TulHeader.astro';
import archivoLatin from '../../node_modules/@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import atkinsonLatin from '../../node_modules/@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-wght-normal.woff2?url';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  noindex?: boolean;
  /** Path below the locale root: '' for the home, 'cv/' for the quick CV. */
  path?: string;
}

const { title, description, lang = 'es', noindex = false, path = '' } = Astro.props;
const t = useTranslations(lang);

const siteUrl = (Astro.site ?? new URL('https://juanpuccio.vercel.app')).toString().replace(/\/$/, '');
const localePaths: Record<Lang, string> = { es: '/', en: '/en/', pt: '/pt/' };
const ogLocales: Record<Lang, string> = { es: 'es_AR', en: 'en_US', pt: 'pt_BR' };
const pageUrl = (code: Lang) => siteUrl + localePaths[code] + path;
const canonicalUrl = pageUrl(lang);
const ogImageUrl = siteUrl + '/og/og-juan-puccio.png';
const ogImageAlt = 'JMP Portfolio, Juan Manuel Puccio';
---

<!doctype html>
<html lang={lang} data-belt="blanco">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // `js` marks a working script. `tul-intro` arms the one entrance moment, only when motion is
      // allowed; tul.ts removes it when the intro ends. Without this script everything stays visible.
      (function () {
        var c = document.documentElement.classList;
        c.add('js');
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) c.add('tul-intro');
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={atkinsonLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocales[lang]} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <link rel="canonical" href={canonicalUrl} />
    {Object.keys(localePaths).map((code) => (
      <link rel="alternate" hreflang={code} href={pageUrl(code as Lang)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={pageUrl('es')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('tul.skip')}</a>
    <TulHeader lang={lang} path={path} />
    <slot />
    <script>
      import '../scripts/tul.ts';
    </script>
  </body>
</html>
